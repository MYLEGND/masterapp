<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.core" Version="2.9.3" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <!-- Pin patched transitive packages used by the net10 Microsoft.Identity.Web.TokenCache test graph. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentPortal\AgentPortal.csproj" />
    <ProjectReference Include="..\ClientApp\ClientApp.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\ParfaitApp\ParfaitApp.csproj" />
    <ProjectReference Include="..\Protect-Website\ProtectWebsite.csproj" />
    <ProjectReference Include="..\SHARED\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\\.github\\workflows\\agentportal-production-deploy.yml"
          Link="agentportal-production-deploy.yml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\.github\\workflows\\legend-production-readonly-diagnostic.yml"
          Link="legend-production-readonly-diagnostic.yml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\diagnostics\\LegendProductionConvergenceGate.cs"
          Link="LegendProductionConvergenceGate.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\scripts\\db.sh"
          Link="db.sh"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\AgentPortal\\wwwroot\\js\\legend-founder-ai.js"
          Link="legend-founder-ai.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\AgentPortal\\wwwroot\\css\\legend-founder-ai.css"
          Link="legend-founder-ai.css"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\AgentPortal\\Views\\Shared\\_LegendFounderAiModal.cshtml"
          Link="legend-founder-ai-modal.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-ios\\Legend\\Features\\Home\\LegendApplicationShell.swift"
          Link="LegendApplicationShell.swift"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-Android\\app\\build.gradle.kts"
          Link="Legend-Android.build.gradle.kts"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-Android\\app\\src\\main\\java\\com\\mylegnd\\legend\\registered\\core\\network\\LegendApi.kt"
          Link="LegendApi.kt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-Android\\app\\src\\main\\java\\com\\mylegnd\\legend\\registered\\data\\LegendRepositories.kt"
          Link="LegendRepositories.kt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-Android\\app\\src\\main\\java\\com\\mylegnd\\legend\\registered\\ui\\LegendFounderAiConversation.kt"
          Link="LegendFounderAiConversation.kt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\Legend-Design\\legend-design.tokens.json"
          Link="legend-design.tokens.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\\AgentPortal\\Views\\LegendConnect\\Index.cshtml"
          Link="legend-connect-index.cshtml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureTestHostRuntimeConfig" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutDir)AgentPortal.runtimeconfig.json"
      DestinationFiles="$(OutDir)testhost.runtimeconfig.json"
      Condition="Exists('$(OutDir)AgentPortal.runtimeconfig.json')" />
  </Target>
</Project>
