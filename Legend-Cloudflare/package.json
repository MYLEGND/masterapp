    "test:website-routing": "node --test tests/website-routing/*.test.mjs",
    "check:website-routing": "wrangler deploy --dry-run --config wrangler.website-routing.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  }
}
