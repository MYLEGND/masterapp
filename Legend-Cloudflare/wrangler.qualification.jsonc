{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legend-foundation-qualification",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "84bf137174ac3966d6d24e9806f0c392",
  "ai": { "binding": "AI" },
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "LEGEND_GOVERNANCE", "class_name": "LegendGovernance" }]
  },
  "migrations": [{ "tag": "governance-v1", "new_sqlite_classes": ["LegendGovernance"] }],
  "vars": {
    "LEGEND_ACCOUNT_ID": "84bf137174ac3966d6d24e9806f0c392",
    "LEGEND_RUNTIME_MODE": "qualification",
    "LEGEND_DEPLOYMENT_ENVIRONMENT": "qualification",
    "LEGEND_TOOL_CALLBACK_ENABLED": "false",
    "LEGEND_BUDGET_POLICY_JSON": "{\"period\":\"lifetime\",\"requestMicrousd\":0,\"userMicrousd\":0,\"tenantMicrousd\":0,\"accountMicrousd\":0,\"requestConcurrency\":0,\"userConcurrency\":0,\"tenantConcurrency\":0,\"accountConcurrency\":0,\"retentionMs\":86400000}"
  }
