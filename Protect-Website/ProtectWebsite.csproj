<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;publish-*/**;publish-macos/**;publish-azure/**;**/*.zip;</DefaultItemExcludes>
    <UserSecretsId>680ba4b7-8e6b-4176-abe9-f48152a6867c</UserSecretsId>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <ItemGroup>
    <Content Include="../Legend-Design/legend-web-foundation.css" Link="wwwroot/design/legend-web-foundation.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-favicon.svg" Link="wwwroot/images/favicon/legend-favicon.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-favicon.jpg" Link="wwwroot/images/favicon/legend-favicon.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <ProjectReference Include="..\\Infrastructure\\Infrastructure.csproj" />
    <ProjectReference Include="..\\CommerceCore\\LegendCommerce.csproj" />
    <ProjectReference Include="..\\Domain\\Domain.csproj" />
    <ProjectReference Include="..\\SHARED\\Shared.csproj" />

    <!-- MailKit for SMTP (patched MimeKit) -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />

    <!-- Microsoft Graph client library -->
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />

    <!-- Microsoft Identity Client (MSAL) -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />

    <!-- Azure Identity for ClientSecretCredential -->
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.21.1" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- JWT & JsonWebTokens -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />
  </ItemGroup>

    <ItemGroup>
    <Content Include="..\SHARED\WebsitePlatform\legend-public-web.css"
             Link="wwwroot\design\legend-public-web.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\legend-public-web.js"
             Link="wwwroot\design\legend-public-web.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\tracking.js"
             Link="wwwroot\js\tracking.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\meta-signal-intelligence.js"
             Link="wwwroot\js\meta-signal-intelligence.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\openai-measurement.js"
             Link="wwwroot\js\openai-measurement.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\public-inquiry-form.mjs"
             Link="wwwroot\js\public-inquiry-form.mjs"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\public-inquiry-form.css"
             Link="wwwroot\css\public-inquiry-form.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Legend-Design\legend-public-inquiry.js"
             Link="wwwroot\js\legend-public-inquiry.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SHARED\WebsitePlatform\legend-public-cms.js"
             Link="wwwroot\design\legend-public-cms.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Legend-Design\legend-design.tokens.json"
             Link="wwwroot\design\legend-design.tokens.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The publication compiler packages the exact shared website build and DOM
       dependencies. No independently maintained business HTML is checked in. -->
  <Target Name="RestoreBusinessWebsiteCompiler" BeforeTargets="BuildBusinessWebsiteCompiler"
          Inputs="$(MSBuildProjectDirectory)/../Legend-Website/package-lock.json"
          Outputs="$(MSBuildProjectDirectory)/../Legend-Website/node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../Legend-Website" Command="npm ci --omit=dev --ignore-scripts --no-audit --no-fund" />
  </Target>
  <Target Name="BuildBusinessWebsiteCompiler" BeforeTargets="Build;Publish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../Legend-Website" Command="node scripts/build.mjs" />
    <ItemGroup>
      <_WebsiteCompilerDist Include="../Legend-Website/dist/**/*" />
      <_WebsiteCompilerModules Include="../Legend-Website/node_modules/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="CopyBusinessWebsiteCompilerToOutput" AfterTargets="Build" DependsOnTargets="BuildBusinessWebsiteCompiler">
    <Copy SourceFiles="@(_WebsiteCompilerDist)" DestinationFiles="@(_WebsiteCompilerDist->'$(TargetDir)WebsiteCompiler/dist/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WebsiteCompilerModules)" DestinationFiles="@(_WebsiteCompilerModules->'$(TargetDir)WebsiteCompiler/node_modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../Legend-Website/scripts/render-business.mjs;../Legend-Website/scripts/render-business-cli.mjs" DestinationFolder="$(TargetDir)WebsiteCompiler/scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../Legend-Website/src/business-content.mjs;../Legend-Website/src/runtime-config.mjs" DestinationFolder="$(TargetDir)WebsiteCompiler/src" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBusinessWebsiteCompilerToPublish" AfterTargets="Publish" DependsOnTargets="BuildBusinessWebsiteCompiler">
    <Copy SourceFiles="@(_WebsiteCompilerDist)" DestinationFiles="@(_WebsiteCompilerDist->'$(PublishDir)WebsiteCompiler/dist/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WebsiteCompilerModules)" DestinationFiles="@(_WebsiteCompilerModules->'$(PublishDir)WebsiteCompiler/node_modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../Legend-Website/scripts/render-business.mjs;../Legend-Website/scripts/render-business-cli.mjs" DestinationFolder="$(PublishDir)WebsiteCompiler/scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../Legend-Website/src/business-content.mjs;../Legend-Website/src/runtime-config.mjs" DestinationFolder="$(PublishDir)WebsiteCompiler/src" SkipUnchangedFiles="true" />
  </Target>

  <!-- One source for Parfait storefront Razor and branded media, linked into this host.
       No generic website theme is allowed to replace these original sources.
       Route publication remains separately gated. -->
  <ItemGroup>
    <Content Include="../ParfaitApp/Views/Store/*.cshtml" Link="Views/Store/%(Filename)%(Extension)" />
    <Content Include="../ParfaitApp/Views/Shared/_Layout.cshtml" Link="Views/Shared/_CommerceParfaitLayout.cshtml" />
    <Content Include="../ParfaitApp/Views/Shared/_ScopedWebsiteStoreLayout.cshtml" Link="Views/Shared/_ScopedWebsiteStoreLayout.cshtml" />
    <Content Include="../ParfaitApp/Views/Shared/_ParfaitCommerceTracking.cshtml" Link="Views/Shared/_ParfaitCommerceTracking.cshtml" />
    <Content Include="../ParfaitApp/Views/Home/Terms.cshtml;../ParfaitApp/Views/Home/Privacy.cshtml"
             Link="Views/StoreLegal/%(Filename)%(Extension)" />
    <Content Include="../ParfaitApp/wwwroot/css/**/*"
             Exclude="../ParfaitApp/wwwroot/css/internal.css;../ParfaitApp/wwwroot/css/parfait-agentportal-analytics.css;../ParfaitApp/wwwroot/css/home.css"
             Link="wwwroot/store-assets/css/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/js/**/*"
             Exclude="../ParfaitApp/wwwroot/js/parfait-agentportal-analytics.js"
             Link="wwwroot/store-assets/js/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/lib/**/*" Link="wwwroot/store-assets/lib/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/images/**/*" Exclude="../ParfaitApp/wwwroot/images/company-icons/**/*"
             Link="wwwroot/store-assets/images/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/uploads/parfait-products/**/*"
             Link="wwwroot/uploads/parfait-products/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Published merchant management views also come from the exact same
       Parfait sources; the website host does not activate these endpoints. -->
  <ItemGroup>
    <Content Include="../ParfaitApp/Views/InternalModules/*.cshtml" Link="Views/InternalModules/%(Filename)%(Extension)" />
    <Content Include="../ParfaitApp/Views/InternalSettings/Canonical*.cshtml" Link="Views/InternalSettings/%(Filename)%(Extension)" />
    <Content Include="../ParfaitApp/Views/Dashboard/Index.cshtml" Link="Views/Dashboard/Index.cshtml" />
    <Content Include="../ParfaitApp/Views/Shared/_InternalLayout.cshtml" Link="Views/Shared/_InternalLayout.cshtml" />
    <None Include="../ParfaitApp/wwwroot/images/favicon/parfait-logo.png" Link="wwwroot/images/favicon/parfait-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/Views/Shared/_MarketingProviderSetup.cshtml" Link="Views/Shared/_MarketingProviderSetup.cshtml" />
    <Content Include="../ParfaitApp/wwwroot/css/internal.css" Link="wwwroot/css/internal.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/css/parfait-agentportal-analytics.css"
             Link="wwwroot/css/parfait-agentportal-analytics.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ParfaitApp/wwwroot/js/parfait-agentportal-analytics.js"
             Link="wwwroot/js/parfait-agentportal-analytics.js"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
