@{
    ViewData["Title"] = "Contact Us";
    ViewData["PageKey"] = "contact";
    ViewData["SeoTitle"] = $"Contact {Shared.Branding.LegendBrand.ProtectionName}";
    ViewData["SeoDescription"] = $"Contact {Shared.Branding.LegendBrand.ProtectionName} for help with protection planning, insurance reviews, family coverage, and financial clarity.";
}
<section class="page-hero">
    <p class="eyebrow">CONTACT @Shared.Branding.LegendBrand.ProtectionUpper</p>
    <h1>Clear questions deserve clear next steps.</h1>
    <p>Ask about protection planning, an existing review, available coverage paths, or what to do next. We’ll help you understand the next step without pressure.</p>
</section>

<section class="section surface">
    <div class="section-head">
        <p class="eyebrow">START A CONVERSATION</p>
        <h2>Send the protection team a message.</h2>
        <p class="lead">Your inquiry is saved to the scoped website owner’s CRM, tracked through the canonical analytics pipeline, and routed to that account’s primary email.</p>
    </div>
    <div data-legend-public-inquiry-form data-owner-label="@Shared.Branding.LegendBrand.ProtectionName"></div>
</section>

<section class="section">
    <div class="section-head">
        <p class="eyebrow">PREFER STRUCTURE?</p>
        <h2>Start with the risk assessment.</h2>
        <p class="lead">Organize income, obligations, existing protection, and priorities before discussing products.</p>
    </div>
    <div class="actions">
        <a class="btn primary" href="/RiskAssessment" data-cta="contact_assessment" data-website-action-key="protect_risk_assessment" data-website-analytics-event="risk_assessment_click">Start assessment</a>
    </div>
</section>

<section class="cta">
    <p class="eyebrow">@Shared.Branding.LegendBrand.RegisteredUpper ECOSYSTEM</p>
    <h2>Protection is one part of a stronger life.</h2>
    <p>For the broader @Shared.Branding.LegendBrand.RegisteredUpper community, personal growth, wellness, and stewardship experience, visit the main @Shared.Branding.LegendBrand.RegisteredUpper website.</p>
    <div class="actions"><a class="btn primary" href="https://www.mylegnd.com/">Visit @Shared.Branding.LegendBrand.RegisteredUpper</a></div>
</section>

