@{
    ViewData["Title"] = "Contact Us";
    ViewData["PageKey"] = "contact";
    ViewData["SeoTitle"] = "Contact Legend";
    ViewData["SeoDescription"] = "Contact Legend for help with protection planning, insurance reviews, family coverage, and financial clarity.";
}
<link rel="stylesheet" href="~/css/public-inquiry-form.css" asp-append-version="true" />

<section class="page-hero">
    <p class="eyebrow">CONTACT LEGEND LEGACY PROTECTION</p>
    <h1>Clear questions deserve clear next steps.</h1>
    <p>Ask about protection planning, an existing review, available coverage paths, or what to do next. We’ll help you understand the next step without pressure.</p>
</section>

<section class="section surface">
    <div class="section-head">
        <p class="eyebrow">START A CONVERSATION</p>
        <h2>Send the protection team a message.</h2>
        <p class="lead">Your inquiry is saved to the scoped website owner’s CRM, tracked through the canonical analytics pipeline, and routed to that account’s primary email.</p>
    </div>
    <div data-legend-public-inquiry-form data-owner-label="LEGEND Legacy Protection"></div>
</section>

<section class="section">
    <div class="section-head">
        <p class="eyebrow">PREFER STRUCTURE?</p>
        <h2>Start with the risk assessment.</h2>
        <p class="lead">Organize income, obligations, existing protection, and priorities before discussing products.</p>
    </div>
    <div class="actions">
        <a class="btn primary" href="/RiskAssessment" data-cta="contact_assessment" data-website-action-key="protect_risk_assessment" data-website-analytics-event="risk_assessment_click">Start assessment</a>
    </div>
</section>

<section class="cta">
    <p class="eyebrow">LEGEND ECOSYSTEM</p>
    <h2>Protection is one part of a stronger life.</h2>
    <p>For the broader LEGEND community, personal growth, wellness, and stewardship experience, visit the main LEGEND website.</p>
    <div class="actions"><a class="btn primary" href="https://www.mylegnd.com/">Visit LEGEND</a></div>
</section>

@section Scripts {
    <script type="module" src="~/js/public-inquiry-form.mjs" asp-append-version="true"></script>
}
