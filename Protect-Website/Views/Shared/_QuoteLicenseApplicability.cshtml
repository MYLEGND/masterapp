<script>
(() => {
    function refresh(root = document) {
        root.querySelectorAll('[data-license-detail]').forEach(field => {
            const form = field.form;
            if (!form) return;
            const prefix = field.name.includes('.') ? field.name.slice(0, field.name.lastIndexOf('.') + 1) : '';
            const status = form.elements.namedItem(prefix + 'DLStatus');
            const required = status?.value !== 'Not Licensed';
            field.required = required;
            field.dataset.originalRequired = required ? '1' : '0';
            // Preserve entered values and step-owned disabled state. Returning to
            // a licensed status restores required validation without data loss.
            field.labels?.forEach(label => label.querySelectorAll('.text-danger').forEach(mark => { mark.hidden = !required; }));
        });
    }
    window.LegendQuoteLicenseRequirements = Object.freeze({ refresh });
    document.addEventListener('change', event => {
        if (event.target?.name === 'DLStatus' || event.target?.name?.endsWith('.DLStatus')) refresh();
    }, true);
    document.addEventListener('DOMContentLoaded', () => refresh(), { once: true });
    window.addEventListener('legend:website-content-rendered', () => refresh());
})();
</script>
