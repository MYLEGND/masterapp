    <script>
        // Preserve agent slug across internal navigation
        (function () {
            const slug = window.AGENT_TRACKING_SLUG;
            const isFounderPath = !!window.IS_FOUNDER_PATH;
            if (!slug || isFounderPath) return;
            const prefix = `/a/${slug}`;
            const shouldRewrite = (url) => {
                if (!url) return false;
                if (!url.startsWith('/')) return false;           // only internal absolute paths
                if (url.startsWith('/a/')) return false;          // already has slug
                if (url.startsWith('/api')) return false;         // leave API calls untouched
                return true;
            };
            const rewrite = (url) => {
                if (!shouldRewrite(url)) return url;
                return url === '/' ? prefix : `${prefix}${url}`;
            };
            // Eager rewrite of existing DOM links/forms
            document.querySelectorAll('a[href]').forEach(a => {
                const href = a.getAttribute('href');
                const newHref = rewrite(href);
                if (newHref && newHref !== href) a.setAttribute('href', newHref);
            });
            document.querySelectorAll('form[action]').forEach(f => {
                const action = f.getAttribute('action');
                const newAction = rewrite(action);
                if (newAction && newAction !== action) f.setAttribute('action', newAction);
            });

            // Defensive: intercept clicks to enforce rewrite even if href was added later
            document.addEventListener('click', (e) => {
                const anchor = e.target.closest('a[href]');
                if (!anchor) return;
                const href = anchor.getAttribute('href');
                const newHref = rewrite(href);
                if (newHref && newHref !== href) {
                    e.preventDefault();
                    window.location.href = newHref;
                }
            });

            // Defensive: intercept form submit to enforce rewrite even if action was added later
            document.addEventListener('submit', (e) => {
                const form = e.target;
                if (!(form instanceof HTMLFormElement)) return;
                const action = form.getAttribute('action') || window.location.pathname;
                const newAction = rewrite(action);
                if (newAction && newAction !== action) {
                    form.setAttribute('action', newAction);
                }
            }, true);
        })();
    </script>
<script>
    (function () {
        const nav = document.querySelector('.navbar');
        const toggle = document.getElementById('navToggle');
        const links = document.getElementById('navLinks');
        const login = document.getElementById('navLogin');
        const loginToggle = document.getElementById('navLoginToggle');

        if (!nav || !toggle || !links) return;

        function closeLoginMenu() {
            if (!login || !loginToggle) return;
            login.classList.remove('open');
            loginToggle.setAttribute('aria-expanded', 'false');
        }

        function closeNav() {
            nav.classList.remove('mobile-open');
            toggle.setAttribute('aria-expanded', 'false');
            closeLoginMenu();
        }

        toggle.addEventListener('click', function () {
            const isOpen = nav.classList.toggle('mobile-open');
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (!isOpen) closeLoginMenu();
        });

        links.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
                closeLoginMenu();
                closeNav();
            });
        });

        if (login && loginToggle) {
            loginToggle.addEventListener('click', function (e) {
                e.preventDefault();
                const isOpen = login.classList.toggle('open');
                loginToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
        }

        document.addEventListener('click', function (e) {
            if (login && !login.contains(e.target)) {
                closeLoginMenu();
            }

            if (nav.classList.contains('mobile-open')) {
                if (nav.contains(e.target) || e.target === toggle) return;
                closeNav();
            }
        });

        window.addEventListener('resize', function () {
            if (window.innerWidth > 820) {
                closeNav();
            } else {
                closeLoginMenu();
            }
        });
    }());
</script>
<script>
    (function () {
        const trigger = document.getElementById('psalmsTrigger');
        const modal = document.getElementById('psalmsModal');
        if (!trigger || !modal) return;

        const textEl = document.getElementById('psalmsText');
        const refEl = document.getElementById('psalmsReference');
        const translationEl = document.getElementById('psalmsTranslation');
        const dayEl = document.getElementById('psalmsDay');
        const closeEl = document.getElementById('psalmsClose');
        const streakEl = document.getElementById('psalmsStreak');
        const streakNoteEl = document.getElementById('psalmsStreakNote');

        // Simple public-domain verses; swap with an API if desired.
        const chapters = [
            {
                reference: 'Psalm 23',
                translation: 'KJV (public domain)',
                verses: [
                    'The LORD is my shepherd; I shall not want.',
                    'He maketh me to lie down in green pastures: he leadeth me beside the still waters.',
                    'He restoreth my soul: he leadeth me in the paths of righteousness for his name\'s sake.',
                    'Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me.',
                    'Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over.',
                    'Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the LORD for ever.'
                ]
            },
            {
                reference: 'Psalm 121',
                translation: 'KJV (public domain)',
                verses: [
                    'I will lift up mine eyes unto the hills, from whence cometh my help.',
                    'My help cometh from the LORD, which made heaven and earth.',
                    'He will not suffer thy foot to be moved: he that keepeth thee will not slumber.',
                    'Behold, he that keepeth Israel shall neither slumber nor sleep.',
                    'The LORD is thy keeper: the LORD is thy shade upon thy right hand.',
                    'The sun shall not smite thee by day, nor the moon by night.',
                    'The LORD shall preserve thee from all evil: he shall preserve thy soul.',
                    'The LORD shall preserve thy going out and thy coming in from this time forth, and even for evermore.'
                ]
            },
            {
                reference: 'Psalm 1',
                translation: 'KJV (public domain)',
                verses: [
                    'Blessed is the man that walketh not in the counsel of the ungodly, nor standeth in the way of sinners, nor sitteth in the seat of the scornful.',
                    'But his delight is in the law of the LORD; and in his law doth he meditate day and night.',
                    'And he shall be like a tree planted by the rivers of water, that bringeth forth his fruit in his season; his leaf also shall not wither; and whatsoever he doeth shall prosper.',
                    'The ungodly are not so: but are like the chaff which the wind driveth away.',
                    'Therefore the ungodly shall not stand in the judgment, nor sinners in the congregation of the righteous.',
                    'For the LORD knoweth the way of the righteous: but the way of the ungodly shall perish.'
                ]
            }
        ];

        const dayKey = new Date().toISOString().slice(0, 10);
        const streakKey = 'psalmsStreak';
        const lastDayKey = 'psalmsLastDay';

        function pickChapter() {
            const idx = Math.abs(hashCode(dayKey)) % chapters.length;
            return chapters[idx];
        }

        function hashCode(str) {
            let h = 0;
            for (let i = 0; i < str.length; i++) {
                h = ((h << 5) - h) + str.charCodeAt(i);
                h |= 0;
            }
            return h;
        }

        function updateStreak() {
            const lastDay = localStorage.getItem(lastDayKey);
            let streak = parseInt(localStorage.getItem(streakKey) || '0', 10);
            if (lastDay === dayKey) {
                // same day; no change
            } else if (lastDay) {
                // consecutive?
                const prev = new Date(lastDay);
                const today = new Date(dayKey);
                const diff = (today - prev) / (1000 * 60 * 60 * 24);
                streak = (diff === 1) ? streak + 1 : 1;
            } else {
                streak = 1;
            }
            localStorage.setItem(lastDayKey, dayKey);
            localStorage.setItem(streakKey, String(streak));
            return streak;
        }

        function fillContent() {
            const chapter = pickChapter();
            dayEl.textContent = dayKey;
            refEl.textContent = chapter.reference;
            translationEl.textContent = chapter.translation;
            textEl.innerHTML = chapter.verses.map(v => `<p>${v}</p>`).join('');
            const streak = updateStreak();
            streakEl.textContent = `${streak} day${streak === 1 ? '' : 's'}`;
            streakNoteEl.textContent = streak >= 7 ? 'Nice streak. Keep going.' : 'Tap daily to build momentum.';
        }

        function openModal() {
            fillContent();
            modal.classList.add('open');
            document.body.classList.add('no-scroll');
            modal.setAttribute('aria-hidden', 'false');
            modal.querySelector('.scripture-card')?.focus();
        }
        function closeModal() {
            modal.classList.remove('open');
            document.body.classList.remove('no-scroll');
            modal.setAttribute('aria-hidden', 'true');
        }

        trigger.addEventListener('click', openModal);
        closeEl?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
    })();
</script>
