@* Shared presentation shell for Auto, Home, Commercial, and Risk Assessment.
   Paint consumes the scoped Website Studio theme; authored inline colors remain authoritative. *@
<style>
    body {
        background:
            radial-gradient(circle at top, color-mix(in srgb, var(--web-navy) 14%, transparent), transparent 30%),
            linear-gradient(180deg, var(--web-navy-deep) 0%, var(--web-navy) 18%, var(--web-navy-deep) 100%);
        color: var(--web-surface);
    }

    main.layout-content {
        padding-bottom: 72px;
    }

    .container-narrow {
        width: min(100%, 1280px);
        margin: 0 auto;
        padding: 18px 16px 64px;
    }

    .pcq-shell {
        width: 100%;
    }

    .pcq-surface {
        --pcq-shell-bg: linear-gradient(180deg, var(--web-navy) 0%, var(--web-navy-deep) 54%, var(--web-navy-deep) 100%);
        --pcq-surface-bg: linear-gradient(180deg, color-mix(in srgb, var(--web-navy) 98%, transparent) 0%, color-mix(in srgb, var(--web-navy-deep) 99%, transparent) 100%);
        --pcq-card-bg: linear-gradient(180deg, color-mix(in srgb, var(--web-navy-deep) 96%, transparent) 0%, color-mix(in srgb, var(--web-navy-deep) 98%, transparent) 52%, color-mix(in srgb, var(--web-navy-deep) 99%, transparent) 100%);
        --pcq-card-soft-bg: linear-gradient(180deg, color-mix(in srgb, var(--web-navy-deep) 92%, transparent) 0%, color-mix(in srgb, var(--web-navy-deep) 96%, transparent) 100%);
        --pcq-panel-bg: linear-gradient(180deg, color-mix(in srgb, var(--web-navy) 94%, transparent) 0%, color-mix(in srgb, var(--web-navy-deep) 98%, transparent) 100%);
        --pcq-pill-bg: linear-gradient(180deg, color-mix(in srgb, var(--web-navy-deep) 82%, transparent) 0%, color-mix(in srgb, var(--web-navy-deep) 90%, transparent) 100%);
        --pcq-border-strong: color-mix(in srgb, var(--web-gold) 50%, transparent);
        --pcq-text-primary: var(--web-surface);
        --pcq-text-strong: var(--web-white);
        --pcq-text-muted: color-mix(in srgb, var(--web-surface) 82%, transparent);
        --pcq-text-soft: color-mix(in srgb, var(--web-surface) 90%, transparent);
        --pcq-text-danger: #ff8f94;
        --pcq-ink-contrast: var(--web-navy-deep);
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        border: 1.6px solid var(--pcq-border-strong);
        background: var(--pcq-shell-bg);
        padding: clamp(18px, 2vw, 26px);
        box-shadow:
            0 28px 80px color-mix(in srgb, var(--web-navy-deep) 42%, transparent),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .pcq-surface::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--web-navy) 12%, transparent), transparent 42%),
            radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--web-gold) 12%, transparent), transparent 34%),
            linear-gradient(135deg, rgba(255, 255, 255, 0.02), transparent 42%);
        pointer-events: none;
    }

    .pcq-surface > * {
        position: relative;
        z-index: 1;
    }

    .pcq-hero-entry[hidden],
    .pcq-form-shell[hidden] {
        display: none !important;
    }

    .pcq-hero-entry {
        display: grid;
        gap: 14px;
    }

    .pcq-hero-banner-wrap {
        position: relative;
        width: min(100%, 720px);
        margin: 0 auto;
        border-radius: 24px;
        overflow: hidden;
        border: 1.5px solid var(--pcq-border-strong);
        box-shadow:
            0 22px 50px rgba(0, 0, 0, 0.28),
            inset 0 1px 0 rgba(255, 255, 255, 0.08);
        background: var(--pcq-surface-bg);
    }

    .pcq-hero-banner-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--web-gold-strong) 12%, transparent);
    }

    .pcq-hero-banner-image {
        display: block;
        width: 100%;
        height: auto;
    }

    .pcq-proof-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .pcq-proof-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 48px;
        padding: 10px 14px;
        border-radius: 999px;
        border: 1.4px solid var(--pcq-border-strong);
        background: var(--pcq-pill-bg);
        box-shadow:
            0 14px 28px rgba(0, 0, 0, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        color: var(--pcq-text-primary);
        font-size: 0.88rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        text-align: center;
    }

    .pcq-proof-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .pcq-step-copy {
        text-align: center;
        display: grid;
        gap: 8px;
        max-width: 720px;
        margin: 0 auto;
    }

    .pcq-step-copy-title {
        color: var(--web-white);
        font-size: clamp(1.38rem, 2.1vw, 1.82rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -0.02em;
    }

    .pcq-step-copy-helper {
        margin: 0;
        color: var(--pcq-text-muted);
        font-size: 0.93rem;
        line-height: 1.55;
        font-weight: 600;
    }

    .pcq-hero-actions {
        display: grid;
        gap: 10px;
        justify-items: center;
        max-width: 780px;
        margin: 0 auto;
    }

    .btn-gold:not(form[data-form-key] *) {
        min-height: 50px;
        padding: 11px 24px;
        border-radius: 14px;
        border: 1.5px solid var(--web-gold);
        background: var(--web-gold);
        color: var(--pcq-ink-contrast);
        font-size: 0.96rem;
        font-weight: 900;
        letter-spacing: -0.01em;
        box-shadow:
            0 12px 28px color-mix(in srgb, var(--web-gold) 20%, transparent);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;

}

    .btn-gold {
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

    .btn-gold:hover:not(form[data-form-key] *),
.btn-gold:focus:not(form[data-form-key] *) {
        color: var(--pcq-ink-contrast);
        transform: translateY(-1px);
        filter: brightness(1.02);
        box-shadow:
            0 12px 28px color-mix(in srgb, var(--web-gold) 20%, transparent);

}

    .btn-gold:hover,
.btn-gold:focus {
        transform: translateY(-1px);
        filter: brightness(1.02);
}

    .pcq-primary-start-cta {
        width: min(100%, 660px);
        min-height: 68px;
        padding: 14px 28px;
        border-radius: 18px;
        font-size: clamp(1.04rem, 1.55vw, 1.16rem);
        box-shadow:
            0 12px 28px color-mix(in srgb, var(--web-gold) 20%, transparent);
    }

    .pcq-primary-start-cta:hover,
    .pcq-primary-start-cta:focus {
        box-shadow:
            0 12px 28px color-mix(in srgb, var(--web-gold) 20%, transparent);
    }

    .pcq-start-note {
        color: var(--pcq-text-soft);
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1.4;
        text-align: center;
    }

    .pcq-form-shell {
        display: grid;
}

    .pcq-form-heading {
        display: grid;
        gap: 8px;
        text-align: center;
        margin: 2px auto 0;
    }

    .pcq-form-heading-title {
        margin: 0;
        color: var(--legend-form-label, var(--pcq-text-strong));
        font-size: clamp(1.3rem, 1.9vw, 1.6rem);
        font-weight: 900;
        letter-spacing: -0.02em;
    }

    .pcq-form-heading-copy {
        margin: 0;
        color: var(--legend-form-help, var(--pcq-text-muted));
        font-size: 0.92rem;
        line-height: 1.5;
        font-weight: 600;
    }

    .required-note {
        margin: 0;
        color: var(--legend-form-help, var(--pcq-text-soft));
        font-size: 0.88rem;
        font-weight: 700;
    }

    .required-note strong {
        color: var(--legend-form-label, var(--pcq-text-strong));
    }

    .required-note .text-danger {
        color: #ff767c !important;
    }

    .alert.alert-danger,
    .validation-summary-errors {
        border: 1px solid rgba(255, 118, 124, 0.5);
        border-radius: 18px;
        background: rgba(74, 13, 23, 0.5);
        color: #ffe4e6;
        box-shadow: 0 18px 38px rgba(0, 0, 0, 0.18);
    }

    .wizard-steps {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        max-width: 1180px;
}

    .wizard-pill {
        border: 1.35px solid var(--pcq-border-strong);
        color: color-mix(in srgb, var(--web-surface) 76%, transparent);
        background: var(--pcq-pill-bg);
        user-select: none;
        box-shadow:
            0 10px 24px rgba(0, 0, 0, 0.14),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

    .wizard-pill.active {
        color: var(--pcq-ink-contrast);
        background: var(--web-gold);
        border-color: var(--web-gold);
        box-shadow:
            0 14px 30px rgba(0, 0, 0, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.34);
}

    .wizard-top {
        position: relative;
        display: grid;
}

    .wizard-steptext {
        font-weight: 900;
        color: var(--legend-form-label, var(--pcq-text-strong));
        position: relative;
        z-index: 1;
    }

    .wizard-progress {
        width: 100%;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--web-gold) 26%, transparent);
        position: relative;
        z-index: 1;
}

    .wizard-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--web-gold-strong) 0%, var(--web-gold) 100%);
        box-shadow: 0 0 18px color-mix(in srgb, var(--web-gold) 34%, transparent);
        transition: width 0.25s ease;
    }

    .wizard-step {
        display: none;
    }

    .wizard-step.active {
        display: block;
    }

    .form-step {
        display: none;
    }

    .form-step.active {
        display: block;
    }

    .pcq-form-frame,
#commercialQuoteForm {
        width: 100%;
}

    .section-card h5,
    .mini-card h5 {
        margin-top: 0;
        margin-bottom: 12px;
        font-weight: 900;
        color: var(--legend-form-label, var(--pcq-text-strong));
    }

    .pcq-surface {
        color: var(--pcq-text-primary);

}

    .pcq-surface .fw-bold,
.pcq-surface .fw-semibold,
.pcq-surface legend,
.pcq-surface p,
.pcq-surface li {
        color: inherit;

}

    .pcq-surface .muted-help,
    .pcq-surface small {
        color: var(--legend-form-help, var(--pcq-text-muted));
    }

    /* Bootstrap text-muted is an important utility; inherit the canonical form
       help role so light inquiry panels retain readable dark helper text. */
    .pcq-surface .text-muted {
        color: var(--legend-form-help, var(--pcq-text-muted)) !important;
    }

    .required-star {
        color: #ff767c;
        margin-left: 2px;
        font-weight: 900;
    }

    .form-control,
.form-select,
textarea {
        transition: box-shadow 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

    .form-control::placeholder,
    textarea::placeholder {
        color: color-mix(in srgb, var(--web-ink) 50%, transparent);
    }

    .form-control:hover,
.form-select:hover,
textarea:hover {
        transform: translateY(-1px);
}

    .form-control:disabled,
.form-select:disabled,
textarea:disabled {
        opacity: 1;
}

    .pcq-surface .field-validation-error,
    .pcq-surface .text-danger {
        color: var(--pcq-text-danger) !important;
        font-weight: 800;
    }

    .pcq-surface .wizard-pill {
        color: color-mix(in srgb, var(--web-surface) 76%, transparent);
        background: var(--pcq-pill-bg);
        border-color: var(--pcq-border-strong);
}

    .pcq-surface .wizard-pill.active {
        color: var(--web-navy-deep);
        background: var(--web-gold);
        border-color: var(--web-gold);
}

    .btn-secondary:not(form[data-form-key] *),
.btn-outline-gold:not(form[data-form-key] *) {
        min-height: 54px;
        padding: 12px 24px;
        border-radius: 14px;
        border: 1.5px solid var(--pcq-border-strong);
        background: var(--pcq-pill-bg);
        color: var(--web-white);
        font-weight: 900;
        box-shadow:
            0 12px 28px rgba(0, 0, 0, 0.16),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;

}

    .btn-secondary,
.btn-outline-gold {
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

    .btn-secondary:hover:not(form[data-form-key] *),
.btn-secondary:focus:not(form[data-form-key] *),
.btn-outline-gold:hover:not(form[data-form-key] *),
.btn-outline-gold:focus:not(form[data-form-key] *) {
        background: linear-gradient(180deg, var(--web-navy) 0%, var(--web-navy-deep) 100%);
        color: var(--web-gold-strong);
        border-color: color-mix(in srgb, var(--web-gold) 82%, transparent);
        transform: translateY(-1px);
        box-shadow:
            0 16px 30px rgba(0, 0, 0, 0.2),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);

}

    .btn-secondary:hover,
.btn-secondary:focus,
.btn-outline-gold:hover,
.btn-outline-gold:focus {
        transform: translateY(-1px);
}

    .wizard-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
}

    .pcq-choice-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
}

    .form-check {
        display: flex;
        align-items: flex-start;
}

    .form-check-input {
        width: 22px;
        height: 22px;
        margin: 0;
        border: 1.8px solid color-mix(in srgb, var(--web-gold) 92%, transparent);
        border-radius: 7px;
        background-color: color-mix(in srgb, var(--web-navy-deep) 90%, transparent);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--web-gold) 16%, transparent);
        flex: 0 0 22px;
    }

    .form-check-input:checked {
        background-color: var(--web-gold);
        border-color: color-mix(in srgb, var(--web-gold-strong) 92%, transparent);
    }

    .form-check-input:focus {
        border-color: color-mix(in srgb, var(--web-gold) 98%, transparent);
        box-shadow:
            0 0 0 0.18rem color-mix(in srgb, var(--web-gold) 22%, transparent),
            0 0 0 1px color-mix(in srgb, var(--web-gold) 18%, transparent);
    }

    hr {
        border-color: color-mix(in srgb, var(--web-gold) 22%, transparent);
        opacity: 1;
    }

    @@media (min-width: 1200px) {
        main.layout-content {
            width: min(94vw, 1380px);
            max-width: 1380px;
            margin-left: auto;
            margin-right: auto;
        }

        .container-narrow {
            width: min(100%, 1320px);
            padding: 18px 18px 42px;
        }

        .pcq-surface {
            padding: 20px 22px 26px;
        }

        .pcq-form-heading {
            max-width: 880px;
        }

        .wizard-steps {
            max-width: 1180px;
}
    }

    @@media (max-width: 991.98px) {
        .pcq-proof-row {
            grid-template-columns: 1fr;
        }

        .pcq-choice-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .container-narrow {
            padding: 12px 10px 28px;
        }

        .pcq-surface {
            border-radius: 22px;
            padding: 12px;
        }

        .pcq-hero-banner-wrap {
            border-radius: 18px;
        }

        .pcq-hero-entry {
            gap: 12px;

}

        .pcq-step-copy,
        .pcq-form-heading {
            max-width: none;
            margin: 0;
            text-align: left;
            gap: 6px;
        }

        .pcq-step-copy-title,
        .pcq-form-heading-title {
            font-size: clamp(1.14rem, 5.4vw, 1.34rem);
            line-height: 1.08;
        }

        .pcq-step-copy-helper,
        .pcq-start-note,
        .pcq-form-heading-copy {
            font-size: 0.84rem;
            line-height: 1.42;
            text-align: left;
        }

        .wizard-steps {
            flex-wrap: nowrap;
            overflow-x: auto;
            justify-content: flex-start;
            scrollbar-width: none;
}

        .wizard-steps::-webkit-scrollbar {
            display: none;
        }

        .wizard-pill {
            flex: 0 0 auto;
            white-space: nowrap;
        }

        .wizard-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .wizard-actions .btn-gold,
        .wizard-actions .btn-secondary,
        .wizard-actions .btn-outline-gold {
            width: 100%;
        }

        .pcq-primary-start-cta {
            min-height: 64px;
            padding-inline: 24px;
        }
    }
</style>
