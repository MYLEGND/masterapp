                                        <div class="lq-step-actions">
                                            <button type="button" class="btn-ghost" data-step-back="0">Back</button>
                                        </div>
                                    </div>

                                    <div class="lq-micro-step" data-micro-step="2" hidden>
                                        <div class="lq-choice-group" role="radiogroup" aria-labelledby="dqCurrentCoverageLabel">
                                            <div class="lq-choice-label" id="dqCurrentCoverageLabel">What best describes your current dental, vision, and hearing coverage?</div>
                                            <div class="lq-choice-grid">
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CurrentCoverage == "No current DVH coverage")">
                                                    <input type="radio" name="CurrentCoverage" value="No current DVH coverage" @CheckedIf(form.CurrentCoverage == "No current DVH coverage") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-coverage"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">No current DVH coverage</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CurrentCoverage == "Employer plan")">
                                                    <input type="radio" name="CurrentCoverage" value="Employer plan" @CheckedIf(form.CurrentCoverage == "Employer plan") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-coverage"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Employer plan</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CurrentCoverage == "Medical only / need DVH")">
                                                    <input type="radio" name="CurrentCoverage" value="Medical only / need DVH" @CheckedIf(form.CurrentCoverage == "Medical only / need DVH") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-coverage"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Medical only / need DVH</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CurrentCoverage == "Spouse / family plan")">
                                                    <input type="radio" name="CurrentCoverage" value="Spouse / family plan" @CheckedIf(form.CurrentCoverage == "Spouse / family plan") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-coverage"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Spouse / family plan</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CurrentCoverage == "Not sure")">
                                                    <input type="radio" name="CurrentCoverage" value="Not sure" @CheckedIf(form.CurrentCoverage == "Not sure") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-coverage"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Not sure</span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="lq-choice-error" id="err-CurrentCoverage">Please choose your current coverage status.</div>
                                        </div>
                                        <div class="lq-step-actions">
                                            <button type="button" class="btn-ghost" data-step-back="1">Back</button>
                                        </div>
                                    </div>

                                    <div class="lq-micro-step" data-micro-step="3" hidden>
                                        <div class="lq-choice-group" role="radiogroup" aria-labelledby="dqCoverageTypeLabel">
                                            <div class="lq-choice-label" id="dqCoverageTypeLabel">What kind of dental, vision, and hearing coverage review are you looking for?</div>
                                            <div class="lq-choice-grid">
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CoverageType == "Individual coverage")">
                                                    <input type="radio" name="CoverageType" value="Individual coverage" @CheckedIf(form.CoverageType == "Individual coverage") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-income"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Individual coverage</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CoverageType == "Family coverage")">
                                                    <input type="radio" name="CoverageType" value="Family coverage" @CheckedIf(form.CoverageType == "Family coverage") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-income"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Family coverage</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CoverageType == "Dental, vision & hearing guidance")">
                                                    <input type="radio" name="CoverageType" value="Dental, vision & hearing guidance" @CheckedIf(form.CoverageType == "Dental, vision & hearing guidance") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-income"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Dental, vision & hearing guidance</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CoverageType == "Dental, vision & hearing options")">
                                                    <input type="radio" name="CoverageType" value="Dental, vision & hearing options" @CheckedIf(form.CoverageType == "Dental, vision & hearing options") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-income"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Dental, vision & hearing options</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.CoverageType == "Not sure / need guidance")">
                                                    <input type="radio" name="CoverageType" value="Not sure / need guidance" @CheckedIf(form.CoverageType == "Not sure / need guidance") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-income"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Not sure / need guidance</span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="lq-choice-error" id="err-CoverageType">Please choose the type of review you want.</div>
                                        </div>
                                        <div class="lq-step-actions">
                                            <button type="button" class="btn-ghost" data-step-back="2">Back</button>
                                        </div>
                                    </div>

                                    <div class="lq-micro-step" data-micro-step="4" hidden>
                                        <div class="lq-choice-group" role="radiogroup" aria-labelledby="dqPrimaryConcernLabel">
                                            <div class="lq-choice-label" id="dqPrimaryConcernLabel">What matters most in your dental, vision, and hearing coverage review?</div>
                                            <div class="lq-choice-grid">
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.PrimaryConcern == "Lower Monthly Premium")">
                                                    <input type="radio" name="PrimaryConcern" value="Lower Monthly Premium" @CheckedIf(form.PrimaryConcern == "Lower Monthly Premium") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-priority"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Lower Monthly Premium</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.PrimaryConcern == "Lower Deductible")">
                                                    <input type="radio" name="PrimaryConcern" value="Lower Deductible" @CheckedIf(form.PrimaryConcern == "Lower Deductible") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-priority"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Lower Deductible</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.PrimaryConcern == "Better Doctor Network")">
                                                    <input type="radio" name="PrimaryConcern" value="Better Doctor Network" @CheckedIf(form.PrimaryConcern == "Better Doctor Network") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-priority"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Better Doctor Network</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.PrimaryConcern == "Prescription Coverage")">
                                                    <input type="radio" name="PrimaryConcern" value="Prescription Coverage" @CheckedIf(form.PrimaryConcern == "Prescription Coverage") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-priority"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Prescription Coverage</span>
                                                    </span>
                                                </label>
                                                <label class="lq-card lq-card-rich @SelectedClassIf(form.PrimaryConcern == "Not Sure / Need Guidance")">
                                                    <input type="radio" name="PrimaryConcern" value="Not Sure / Need Guidance" @CheckedIf(form.PrimaryConcern == "Not Sure / Need Guidance") />
                                                    <span class="lq-card-visual" aria-hidden="true"><svg class="lq-card-icon" viewBox="0 0 48 48" fill="none"><use href="#dq-icon-priority"></use></svg></span>
                                                    <span class="lq-card-copy">
                                                        <span class="lq-card-title">Not Sure / Need Guidance</span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="lq-choice-error" id="err-PrimaryConcern">Please choose what matters most in this review.</div>
                                        </div>
                                        <div class="lq-step-actions">
                                            <button type="button" class="btn-ghost" data-step-back="3">Back</button>
                                            <button type="button" class="btn-gold btn-progress btn-block" id="dqContinueToContactBtn" data-cta="dvh_see_review">Continue My DVH Review</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="lq-step-panel dq-processing-panel" id="dqProcessingPanel" hidden>
                                <div class="lq-step-panel-pad">
                                    <div class="dq-processing-ring" aria-hidden="true">
                                        <svg viewBox="0 0 48 48" fill="none"><use href="#dq-icon-check"></use></svg>
                                    </div>
                                    <div class="lq-step-progress">One moment</div>
                                    <h2 class="lq-step-title" id="dqProcessingHeading">Pulling together your dental, vision, and hearing review.</h2>
                                    <div class="dq-processing-track" aria-hidden="true">
                                        <span class="dq-processing-fill" id="dqProcessingFill"></span>
                                    </div>
                                    <div class="dq-processing-note">Getting your coverage snapshot ready.</div>
                                </div>
                            </div>

                            <div class="lq-step-panel" id="dqContactPanel" @((showContactStepByDefault ? null : "hidden"))>
                                <div class="lq-step-panel-pad">
                                    <div class="lq-step-progress">Final step</div>
                                    <div class="dq-contact-capture-wrap" id="dvhContactCaptureWrap">
                                        <div class="dq-contact-head">
                                            <div class="dq-contact-kicker">Send the review</div>
                                            <div class="dq-contact-title">Where should we send your dental, vision, and hearing review?</div>
                                            <div class="dq-contact-copy">We will use your answers to focus the conversation on affordability, network fit, current coverage gaps, and the type of plan guidance that fits your household best.</div>
                                        </div>

                                        <div class="dq-review-summary" id="dvhReviewSummary" aria-live="polite"></div>

                                        <div class="dq-contact-hint">Share the same key contact details we need to save your review and continue the conversation clearly.</div>

                                        <div class="lq-field-row two full">
                                            <div class="lq-field">
                                                <label for="FirstName">First Name <span class="lq-required-star">*</span></label>
                                                <input type="text" id="FirstName" name="FirstName" class="form-control" value="@form.FirstName" autocomplete="given-name" />
                                                <div class="lq-field-err" id="err-FirstName">Please enter your first name.</div>
                                            </div>
                                            <div class="lq-field">
                                                <label for="LastName">Last Name <span class="lq-optional-tag">(optional)</span></label>
                                                <input type="text" id="LastName" name="LastName" class="form-control" value="@form.LastName" autocomplete="family-name" />
                                                <div class="lq-field-err" id="err-LastName"></div>
                                            </div>
                                        </div>

                                        <div class="lq-field-row two full">
                                            <div class="lq-field">
                                                <label for="Email">Email for a written copy <span class="lq-optional-tag">(optional)</span></label>
                                                <input type="email" id="Email" name="Email" class="form-control" value="@form.Email" placeholder="you@example.com" autocomplete="email" inputmode="email" />
                                                <div class="lq-field-err" id="err-Email">Please enter a valid email address.</div>
                                            </div>
                                            <div class="lq-field">
                                                <label for="Phone">Phone Number <span class="lq-required-star">*</span></label>
                                                <input type="tel" id="Phone" name="Phone" class="form-control" value="@form.Phone" placeholder="(555) 555-5555" autocomplete="tel" inputmode="tel" />
                                                <div class="lq-field-err" id="err-Phone">Please enter a valid phone number.</div>
                                            </div>
                                        </div>

                                        <div class="full lq-field-help" id="lifeContactMethodHelp">@contactMethodHelperText</div>
                                        <div class="full lq-field-err" id="err-ContactMethod">@contactMethodErrorText</div>

                                        <label class="lq-consent" for="AcknowledgedDisclaimer">
                                            <input type="checkbox" id="AcknowledgedDisclaimer" name="AcknowledgedDisclaimer" value="true" @(form.AcknowledgedDisclaimer ? "checked" : null) />
                                            <span class="consent-text">
                                                <span class="consent-main">@consentPromptText <span class="lq-required-star">*</span></span>
                                            </span>
                                        </label>
                                        <input type="hidden" name="AcknowledgedDisclaimer" value="false" />
                                        <input type="hidden" id="ContactMethod" name="ContactMethod" value="@(string.IsNullOrWhiteSpace(form.ContactMethod) ? "Phone" : form.ContactMethod)" />
                                        <input type="hidden" id="BestTimeToContact" name="BestTimeToContact" value="@(string.IsNullOrWhiteSpace(form.BestTimeToContact) ? "Not specified" : form.BestTimeToContact)" />
                                        <div class="lq-field-err" id="err-AcknowledgedDisclaimer">@consentErrorText</div>

                                        <div class="lq-step-actions">
                                            <button type="button" class="btn-ghost" id="dqBackToQuestionsBtn">Back to answers</button>
                                            <div class="btn-block">
                                                <p class="dq-submit-note">Private review. No obligation. You stay in control.</p>
                                                <button type="submit" class="btn-gold btn-progress btn-block" id="dqSubmitBtn" data-cta="dvh_submit_review">Get My DVH Review</button>
                                            </div>
                                        </div>

                                        <div class="lq-error" id="dvhError"></div>
                                        <div class="lq-success" id="dvhSuccess">Thanks! We received your request.</div>
                                    </div>

                                    <div class="lq-post-submit-slot" id="dvhPostSubmitSlot" hidden></div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </form>

@await Html.PartialAsync("_QuoteMetaSignalBootstrap")

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        'use strict';

        var track = (window.LegendAnalytics?.track && typeof window.LegendAnalytics.track === 'function')
            ? window.LegendAnalytics.track
            : (window.legendTrack && typeof window.legendTrack === 'function')
                ? window.legendTrack
                : function () {};

        var form = document.getElementById('dvhQuoteForm');
        if (!form) return;

        var body = document.body;
        var pageKey = '@pageKey';
        var formKey = form.getAttribute('data-form-key') || '@formKey';
        var heroEntryPanel = document.getElementById('dvhHeroEntryPanel');
        var educationPanel = document.getElementById('dvhEducationPanel');
        var startButton = document.getElementById('dvhHeroStartCta');
        var step1Panel = document.getElementById('dqStep1Panel');
        var processingPanel = document.getElementById('dqProcessingPanel');
        var contactPanel = document.getElementById('dqContactPanel');
        var contactFirstPanel = document.getElementById('dvhEducationContactPanel');
        var contactCaptureWrap = document.getElementById('dvhContactCaptureWrap');
        var postSubmitSlot = document.getElementById('dvhPostSubmitSlot');
        var progressLabel = document.getElementById('dqStep1Progress');
        var progressFill = document.getElementById('dqStep1ProgressFill');
        var processingFill = document.getElementById('dqProcessingFill');
        var continueButton = document.getElementById('dqContinueToContactBtn');
        var backToQuestionsButton = document.getElementById('dqBackToQuestionsBtn');
        var submitButton = document.getElementById('dqSubmitBtn');
        var errorBanner = document.getElementById('dvhError');
        var successBanner = document.getElementById('dvhSuccess');
        var reviewSummary = document.getElementById('dvhReviewSummary');
        var ageHidden = document.getElementById('Age');
        var contactMethodInput = document.getElementById('ContactMethod');
        var bestTimeInput = document.getElementById('BestTimeToContact');
        var submitDefaultLabel = submitButton ? asTrimmed(submitButton.textContent) : 'Get My DVH Review';
        var bookingExperienceUrl = '@Url.Action("ActivatePublicBookingExperience", "DentalVisionHearingQuote")';
        var bookingConfirmationUrl = '@Url.Action("ConfirmPublicBookingExperience", "DentalVisionHearingQuote")';
        var microSteps = Array.prototype.slice.call(step1Panel ? step1Panel.querySelectorAll('[data-micro-step]') : []);
        var hasServerErrors = '@(hasServerErrors ? "true" : "false")' === 'true';
        var showContactStepByDefault = '@(showContactStepByDefault ? "true" : "false")' === 'true';
        var ageRangeToAge = Object.freeze({
            '18-24': '21',
            '25-34': '30',
            '35-44': '40',
            '45-54': '50',
            '55-64': '60',
            '65+': '70'
        });
        var microStepConfigs = [
            { field: 'AgeRange', errorId: 'err-AgeRange', viewEvent: 'first_question_view' },
            { field: 'HouseholdSize', errorId: 'err-HouseholdSize', viewEvent: 'quote_step_view' },
            { field: 'CurrentCoverage', errorId: 'err-CurrentCoverage', viewEvent: 'quote_step_view' },
            { field: 'CoverageType', errorId: 'err-CoverageType', viewEvent: 'quote_step_view' },
            { field: 'PrimaryConcern', errorId: 'err-PrimaryConcern', viewEvent: 'quote_step_view' }
        ];
        var completedSteps = {};
        var viewedMicroSteps = {};
        var currentMicroStep = 0;
        var autoAdvanceTimer = null;
        var processingTimer = null;
        var contactStepTracked = false;
        var thankYouTracked = false;
        var latestSubmitResponse = null;
        var publicBookingState = null;
        var publicBookingEmbedViewed = false;
        var publicBookingBookedConfirmed = false;
        var publicBookingConfirmationRequested = false;
        var publicBookingSlotSelectedTracked = false;
        var publicBookingFallbackClicked = false;
        var publicBookingLoadingText = 'Preparing your scheduling options...';
        var publicBookingDisabledText = 'Your dental, vision, and hearing coverage review is saved. Scheduling is not available in this view right now, but a licensed agent can still continue the review with you.';

        function asTrimmed(value) {
            return typeof value === 'string' ? value.trim() : '';
        }

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function setBannerMessage(element, message) {
            if (!element) return;
            element.textContent = message || '';
            element.style.display = message ? 'block' : 'none';
        }

        function clearServerFeedback() {
            setBannerMessage(errorBanner, '');
            setBannerMessage(successBanner, '');
        }

        function resetPostSubmitShell() {
            latestSubmitResponse = null;
            publicBookingState = null;
            publicBookingEmbedViewed = false;
            publicBookingBookedConfirmed = false;
            publicBookingConfirmationRequested = false;
            publicBookingSlotSelectedTracked = false;
            publicBookingFallbackClicked = false;

            if (contactFirstPanel) {
                contactFirstPanel.classList.remove('qf-final-panel-no-chrome', 'qf-final-review-flat-mode', 'is-submitted', 'is-submit-loading');
            }

            if (contactCaptureWrap) {
                contactCaptureWrap.hidden = false;
            }

            if (postSubmitSlot) {
                postSubmitSlot.hidden = true;
                postSubmitSlot.innerHTML = '';
            }

            if (processingFill) {
                processingFill.style.width = '0%';
            }
        }

        function populateAttributionFields() {
            var ids = window.legendTrackingIds;
            var params = new URLSearchParams(window.location.search);
            var attr = ids && ids.getAttribution ? (ids.getAttribution() || {}) : {};

            function setHidden(name, value) {
                var input = document.getElementById(name) || form.querySelector('input[name="' + name + '"]');
                if (input && value != null) input.value = value;
            }

            setHidden('SessionId', ids && ids.getSessionId ? ids.getSessionId() : '');
            setHidden('VisitorId', ids && ids.getVisitorId ? ids.getVisitorId() : '');
            setHidden('UtmSource', attr.utmSource || params.get('utm_source') || '');
            setHidden('UtmMedium', attr.utmMedium || params.get('utm_medium') || '');
            setHidden('UtmCampaign', attr.utmCampaign || params.get('utm_campaign') || '');
            setHidden('UtmId', attr.utmId || params.get('utm_id') || '');
            setHidden('UtmTerm', attr.utmTerm || params.get('utm_term') || '');
            setHidden('UtmContent', attr.utmContent || params.get('utm_content') || '');
            setHidden('MetaCampaignId', attr.metaCampaignId || params.get('meta_campaign_id') || '');
            setHidden('MetaAdSetId', attr.metaAdSetId || params.get('meta_adset_id') || '');
            setHidden('MetaAdId', attr.metaAdId || params.get('meta_ad_id') || '');
            setHidden('Fbclid', attr.fbclid || params.get('fbclid') || '');
            setHidden('ReferrerUrl', document.referrer || '');
            setHidden('LandingPageUrl', window.location.href || '');
        }

        function trackCta(elementKey, label) {
            track({
                EventType: 'cta_click',
                ElementKey: elementKey,
                ButtonLabel: label,
                PageKey: pageKey
            });
            track({
                EventType: 'quote_cta_click',
                ElementKey: elementKey,
                ButtonLabel: label,
                PageKey: pageKey
            });
        }

        function setStartedState(started) {
            body.classList.toggle('dvh-quote-started', !!started);
            if (heroEntryPanel) heroEntryPanel.hidden = !!started;
            if (educationPanel) educationPanel.hidden = !started;
        }

        function setFinalStepState(active) {
            body.classList.toggle('dvh-final-step-active', !!active);
        }

        function updateProgress(stepIndex) {
            var stepNumber = Math.max(0, Math.min(microSteps.length - 1, stepIndex)) + 1;
            if (progressLabel) progressLabel.textContent = 'Question ' + stepNumber + ' of ' + microSteps.length;
            if (progressFill) progressFill.style.width = ((stepNumber / microSteps.length) * 100) + '%';
        }

        function syncChoiceCards(groupName) {
            Array.prototype.forEach.call(document.querySelectorAll('input[name="' + groupName + '"]'), function (radio) {
                var card = radio.closest('.lq-card');
                if (!card) return;
                card.classList.toggle('lq-selected', !!radio.checked);
                if (radio.checked) card.classList.remove('lq-invalid');
            });
        }

        function clearGroupError(groupName, errorId) {
            Array.prototype.forEach.call(document.querySelectorAll('input[name="' + groupName + '"]'), function (radio) {
                var card = radio.closest('.lq-card');
                if (card) card.classList.remove('lq-invalid');
            });
            var error = document.getElementById(errorId);
            if (error) error.classList.remove('visible');
        }

        function showGroupError(groupName, errorId) {
            Array.prototype.forEach.call(document.querySelectorAll('input[name="' + groupName + '"]'), function (radio) {
                var card = radio.closest('.lq-card');
                if (card) card.classList.add('lq-invalid');
            });
            var error = document.getElementById(errorId);
            if (error) error.classList.add('visible');
        }

        function requireSelection(groupName, errorId) {
            var checked = form.querySelector('input[name="' + groupName + '"]:checked');
            if (!checked) {
                showGroupError(groupName, errorId);
                return false;
            }
            clearGroupError(groupName, errorId);
            return true;
        }

        function syncAgeHidden() {
            var selectedAgeRange = form.querySelector('input[name="AgeRange"]:checked');
            if (!ageHidden) return;
            ageHidden.value = selectedAgeRange ? (ageRangeToAge[selectedAgeRange.value] || ageHidden.value || '30') : (ageHidden.value || '30');
        }

        function syncDerivedContactFields() {
            var phoneValue = asTrimmed(document.getElementById('Phone') ? document.getElementById('Phone').value : '');
            var emailValue = asTrimmed(document.getElementById('Email') ? document.getElementById('Email').value : '');

            if (contactMethodInput) {
                contactMethodInput.value = phoneValue ? 'Phone' : (emailValue ? 'Email' : 'Phone');
            }

            if (bestTimeInput && !asTrimmed(bestTimeInput.value)) {
                bestTimeInput.value = 'Not specified';
            }
        }

        function readSelectedValue(name) {
            var input = form.querySelector('input[name="' + name + '"]:checked');
            return input ? asTrimmed(input.value) : '';
        }

        function focusCurrentMicroStep() {
            var currentStepEl = microSteps[currentMicroStep];
            if (!currentStepEl) return;
            var focusTarget = currentStepEl.querySelector('input, button');
            if (focusTarget && typeof focusTarget.focus === 'function') {
                window.setTimeout(function () {
                    focusTarget.focus({ preventScroll: true });
                }, 110);
            }
            currentStepEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function trackMicroStepView(index) {
            if (viewedMicroSteps[index]) return;
            viewedMicroSteps[index] = true;
            var config = microStepConfigs[index];
            if (!config) return;
            track({
                EventType: config.viewEvent,
                PageKey: pageKey,
                FormKey: formKey,
                MetadataJson: JSON.stringify({ stepNumber: index + 1, field: config.field })
            });
        }

        function trackStepComplete(stepNumber, nextStep, source) {
            if (completedSteps[stepNumber]) return;
            completedSteps[stepNumber] = true;
            var metadataJson = JSON.stringify({ stepNumber: stepNumber, nextStep: nextStep, source: source });
            if (stepNumber === 1) {
                track({
                    EventType: 'first_question_answered',
                    FormKey: formKey,
                    PageKey: pageKey,
                    MetadataJson: metadataJson
                });
            }
            track({
                EventType: 'quote_step_complete',
                FormKey: formKey,
                PageKey: pageKey,
                MetadataJson: metadataJson
            });
        }

        function showMicroStep(index) {
            if (index < 0 || index >= microSteps.length) return;
            resetPostSubmitShell();
            currentMicroStep = index;
            if (step1Panel) step1Panel.hidden = false;
            if (processingPanel) processingPanel.hidden = true;
            if (contactPanel) contactPanel.hidden = true;
            setStartedState(true);
            setFinalStepState(false);
            microSteps.forEach(function (step, idx) {
                step.hidden = idx !== index;
            });
            updateProgress(index);
            trackMicroStepView(index);
            focusCurrentMicroStep();
        }

        function buildReviewSummaryHtml() {
            var ageRange = readSelectedValue('AgeRange') || 'Age range';
            var householdSize = readSelectedValue('HouseholdSize') || 'Household';
            var currentCoverage = readSelectedValue('CurrentCoverage') || 'Current coverage';
            var coverageType = readSelectedValue('CoverageType') || 'Coverage goal';
            var primaryConcern = readSelectedValue('PrimaryConcern') || 'Priority';

            var signal = 'Your answers suggest this review should focus on benefit fit first, then narrow dental, vision, hearing, and monthly cost tradeoffs.';
            if (currentCoverage === 'No current DVH coverage') {
                signal = 'No current DVH coverage means the review should start with affordable options and how quickly you want benefits in place.';
            } else if (currentCoverage === 'Employer plan') {
                signal = 'Employer coverage can still leave gaps in deductibles, network fit, or family needs, so the conversation should start there.';
            } else if (primaryConcern === 'Lower Monthly Premium') {
                signal = 'Because monthly affordability matters most, the conversation should stay centered on balancing premium, deductible, and day-to-day budget pressure.';
            } else if (primaryConcern === 'Better Doctor Network') {
                signal = 'Because provider access matters most, the review should stay focused on keeping the doctors, facilities, and specialists you trust in network.';
            }

            return ''
                + '<div class="dq-review-kicker">Review snapshot</div>'
                + '<div class="dq-review-title">We will pick up the conversation from these answers.</div>'
