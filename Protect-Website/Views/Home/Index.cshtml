@inject Infrastructure.Bookings.IPublicBookingResolver PublicBookingResolver
@{
    ViewData["Title"] = "Home";
    ViewData["PageKey"] = "home";
    ViewData["SeoTitle"] = "Life Insurance, Mortgage Protection & Family Coverage";
    ViewData["SeoDescription"] = "Protect your income, family, and future with clear insurance planning and protection guidance rooted in stewardship.";

    var segs = (Context?.Request?.Path.Value ?? string.Empty).Split('/', StringSplitOptions.RemoveEmptyEntries);
    var agentSlug = (segs.Length >= 2 && segs[0].Equals("a", StringComparison.OrdinalIgnoreCase)) ? segs[1] : null;
    var slugPrefix = !string.IsNullOrWhiteSpace(agentSlug) ? $"/a/{agentSlug}" : string.Empty;
    var bookingConfig = PublicBookingResolver.Resolve(agentSlug);
    var bookingLink = bookingConfig.Enabled ? bookingConfig.FallbackUrl ?? bookingConfig.EmbedUrl ?? "#" : "#";

    string Link(string relative)
    {
        var basePath = Context?.Request?.PathBase.Value ?? string.Empty;
        return $"{basePath}{slugPrefix}{relative}";
    }
}

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">LEGEND LEGACY PROTECTION</p>
        <h1>Bring order to your life before life demands it from you.</h1>
        <p class="hero-line">Protection planning rooted in clarity, responsibility, and stewardship.</p>
        <p>A cleaner way to understand your risks, protect your income, and make confident decisions around family, debt, coverage, and long-term legacy.</p>
        <div class="actions">
            <a class="btn primary" href="@Link("/RiskAssessment")" data-cta="home_start_assessment" data-website-action-key="protect_risk_assessment" data-website-analytics-event="risk_assessment_click">Start Assessment</a>
            <a class="btn ghost" href="@Link("/Quote")" data-cta="home_get_quote" data-website-action-key="protect_quote" data-website-analytics-event="quote_click">Explore Coverage</a>
        </div>
    </div>
    <div class="hero-mark">
        <div class="halo"></div>
        <img src="~/images/company-icons/legend-protect-transparent.png" asp-append-version="true" alt="LEGEND Legacy Protection" />
        <span>CLARITY × PROTECTION × STEWARDSHIP × LEGACY</span>
    </div>
</section>

<section class="section">
    <div class="section-head">
        <p class="eyebrow">THE PROTECTION APPROACH</p>
        <h2>See the whole picture before choosing a product.</h2>
        <p class="lead">Income, family responsibilities, mortgage and debt exposure, existing coverage, and long-term goals belong in one conversation.</p>
    </div>
    <div class="card-grid">
        <article class="card"><p class="eyebrow feature-marker">01 · INCOME</p><h3>Income risk</h3><p>Understand what happens to the household plan when earned income is interrupted.</p></article>
        <article class="card"><p class="eyebrow feature-marker">02 · FAMILY</p><h3>Family protection</h3><p>Protect the people and responsibilities that depend on you with coverage that reflects real life.</p></article>
        <article class="card"><p class="eyebrow feature-marker">03 · HOME</p><h3>Debt & mortgage</h3><p>Account for housing, debts, and obligations that do not disappear when life changes.</p></article>
        <article class="card"><p class="eyebrow feature-marker">04 · LEGACY</p><h3>Legacy structure</h3><p>Build protection decisions around what you want preserved, transferred, and sustained.</p></article>
    </div>
</section>

<section class="section surface">
    <div class="section-head">
        <p class="eyebrow">CLARITY FIRST</p>
        <h2>Start with the area that deserves attention first.</h2>
        <p class="lead">Choose one starting point, review the gap, then move through a simple path without pressure.</p>
    </div>
    <div class="split">
        <article>
            <p class="eyebrow feature-marker">01 · INCOME</p>
            <h3>Protect the income that funds everything.</h3>
            <p>Your income supports the home, family, lifestyle, goals, and future. Start by seeing what changes if it stops.</p>
            <div class="actions"><a class="btn primary" href="@Link("/RiskAssessment")" data-cta="home_income_assessment" data-website-action-key="protect_risk_assessment" data-website-analytics-event="risk_assessment_click">Assess income risk</a></div>
        </article>
        <article>
            <p class="eyebrow feature-marker">02 · COVERAGE</p>
            <h3>Explore protection paths at your pace.</h3>
            <p>Review life, mortgage protection, disability, term, whole life, final expense, and other available coverage paths.</p>
            <div class="actions"><a class="btn primary" href="@Link("/Quote")" data-cta="home_coverage_paths" data-website-action-key="protect_quote" data-website-analytics-event="quote_click">Explore coverage</a></div>
        </article>
    </div>
</section>

<section class="section dark">
    <div class="section-head">
        <p class="eyebrow">A SIMPLE NEXT STEP</p>
        <h2>Assess. Design. Decide.</h2>
        <p class="lead">The process is designed to make the decision easier to understand today and easier to explain later.</p>
    </div>
    <div class="steps">
        <span>01 • ASSESS<small>Organize goals, income, obligations, existing coverage, and gaps.</small></span>
        <span>02 • DESIGN<small>Review appropriate protection options and the tradeoffs between them.</small></span>
        <span>03 • DECIDE<small>Choose what fits your responsibilities, budget, and priorities.</small></span>
        <span>04 • REVIEW<small>Keep the plan aligned as life, income, family, and goals change.</small></span>
    </div>
</section>

<section class="section">
    <div class="section-head">
        <p class="eyebrow">WHY CLIENTS MOVE FORWARD</p>
        <h2>Calm, documented guidance. No pressure.</h2>
    </div>
    <div class="card-grid">
        <article class="card"><p class="eyebrow feature-marker">01 · DOCUMENTED</p><h3>Documented next steps</h3><p>Facts, gaps, and the action plan are organized so the recommendation remains understandable.</p></article>
        <article class="card"><p class="eyebrow feature-marker">02 · GUIDANCE</p><h3>No-pressure guidance</h3><p>Review tradeoffs, costs, and choices before anything moves forward.</p></article>
        <article class="card"><p class="eyebrow feature-marker">03 · FIT</p><h3>Protection that fits real life</h3><p>Income, family, mortgage, debts, and long-term goals are considered together.</p></article>
        <article class="card"><p class="eyebrow feature-marker">04 · STEWARDSHIP</p><h3>Faithful stewardship</h3><p>Build around clarity, responsibility, affordability, and decisions that can actually be maintained.</p></article>
    </div>
</section>

<section class="section surface">
    <div class="section-head">
        <p class="eyebrow">EXPLORE AT YOUR PACE</p>
        <h2>Protection paths for different starting points.</h2>
        <p class="lead">Browse the area that is relevant to you without forcing every decision into one product.</p>
    </div>
    <div class="card-grid">
        <a class="card" href="@Link("/Quote/Life")" data-cta="home_life" data-website-action-key="protect_quote_life" data-website-analytics-event="quote_click"><p class="eyebrow feature-marker">01 · LIFE</p><h3>Life Insurance</h3><p>Family, income, legacy, and long-term protection.</p></a>
        <a class="card" href="@Link("/Quote/Mortgage-Protection")" data-cta="home_mortgage" data-website-action-key="protect_quote_mortgage_protection" data-website-analytics-event="quote_click"><p class="eyebrow feature-marker">02 · MORTGAGE</p><h3>Mortgage Protection</h3><p>Plan around the obligation that keeps the household anchored.</p></a>
        <a class="card" href="@Link("/Quote/Term-Life")" data-cta="home_term" data-website-action-key="protect_quote_term_life" data-website-analytics-event="quote_click"><p class="eyebrow feature-marker">03 · TERM</p><h3>Term Life</h3><p>Focused coverage for defined protection periods and responsibilities.</p></a>
        <a class="card" href="@Link("/Quote/Disability")" data-cta="home_disability" data-website-action-key="protect_quote_disability" data-website-analytics-event="quote_click"><p class="eyebrow feature-marker">04 · INCOME</p><h3>Disability Insurance</h3><p>Protect earning power when health interrupts the ability to work.</p></a>
    </div>
</section>

<section class="section">
    <div class="section-head">
        <p class="eyebrow">COMMON QUESTIONS</p>
        <h2>Get the important questions answered before you begin.</h2>
    </div>
    <div class="split">
        <article><h3>What happens in the assessment?</h3><p>We organize goals, income, obligations, and current coverage so protection gaps and next steps are easier to see.</p></article>
        <article><h3>Is this just insurance?</h3><p>No. The process starts with organization and risk clarity, then matches protection options to the actual need and budget.</p></article>
        <article><h3>Is there pressure to buy?</h3><p>No. You review the options, tradeoffs, and cost structure first. You decide what makes sense.</p></article>
        <article><h3>Can other professionals review it?</h3><p>Yes. Recommendations can be organized so your CPA, attorney, or other appropriate professional can review the relevant pieces.</p></article>
    </div>
</section>

<section class="cta">
    <p class="eyebrow">READY WHEN YOU ARE</p>
    <h2>Start with clarity. Protect what matters. Build with intention.</h2>
    <p>The best next step is the one that makes the picture clearer. Begin the assessment, explore coverage, or talk first if you want a human walkthrough.</p>
    <div class="actions">
        <a class="btn primary" href="@Link("/RiskAssessment")" data-cta="home_final_assessment" data-website-action-key="protect_risk_assessment" data-website-analytics-event="risk_assessment_click">Start Assessment</a>
        <a class="btn ghost" href="@Link("/Quote")" data-cta="home_final_quote" data-website-action-key="protect_quote" data-website-analytics-event="quote_click">Explore Coverage</a>
        @if (bookingConfig.Enabled)
        {
            <a class="btn ghost" href="@bookingLink" data-cta="home_book_conversation" data-website-action-key="protect_schedule" data-website-analytics-event="cta_click">Talk First</a>
        }
    </div>
</section>

<section class="disclosure">
    <p>Insurance products and services are offered through appropriately licensed professionals and are subject to eligibility, underwriting, carrier approval, state availability, and applicable terms. Educational content is general information and is not individualized legal, tax, investment, or financial advice.</p>
</section>
