<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AgentPortal.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
  <!-- IIS filters requests before MVC's RequestSizeLimit runs. Keep this
       transport allowance aligned with SocialMediaUploadLimits (100 MiB media,
       1 MiB preview, 1 MiB multipart envelope). The contract test prevents drift.
       This location covers both direct uploads and /stage on iOS and Android. -->
  <location path="api/v1/mobile/social/posts/media" inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="106954752" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
