<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- IIS transport ceiling; action/form and media validation remain authoritative.
           Keep this in the application handler scope, not a virtual API path. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="106954752" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\AgentPortal.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
