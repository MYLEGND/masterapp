@{
    var appointmentTitle = (ViewData["AppointmentSectionTitle"] as string ?? "Latest Appointment").Trim();
    var appointmentCopy = (ViewData["AppointmentSectionCopy"] as string ?? "Latest structured appointment record linked to this contact.").Trim();
    var showStatusEditor = ViewData["ShowAppointmentStatusEditor"] as bool? ?? false;
}

<details class="qv-panel crm-qv-disclosure qv-panel-data qv-disclosure" id="dAppointmentSection" hidden>
    <summary>
        <div class="qv-section-header">
            <div class="qv-section-title">@appointmentTitle</div>
            <div class="qv-section-copy">@appointmentCopy</div>
        </div>
    </summary>
    <div class="qv-section-body">
        <div class="qv-data-grid qv-data-grid-2">
            <div class="qv-data-card">
                <label>Status</label>
                <div id="dAppointmentStatus">—</div>
            </div>
            <div class="qv-data-card">
                <label>Appointment Time</label>
                <div id="dAppointmentTime">—</div>
            </div>
            <div class="qv-data-card">
                <label>Source</label>
                <div id="dAppointmentSource">—</div>
            </div>
            <div class="qv-data-card">
                <label>Requested Source</label>
                <div id="dAppointmentRequestedSource">—</div>
            </div>
            <div class="qv-data-card">
                <label>Confirmation</label>
                <div id="dAppointmentConfirmation">—</div>
            </div>
            <div class="qv-data-card">
                <label>Booking Config</label>
                <div id="dAppointmentBookingConfig">—</div>
            </div>
            <div class="qv-data-card">
                <label>Status Timestamp</label>
                <div id="dAppointmentTimeline">—</div>
            </div>
        </div>
        <div class="qv-data-grid qv-data-grid-2 qv-stack-md">
            <div class="qv-data-card qv-data-card-wide">
                <label>Meeting Link</label>
                <div id="dAppointmentMeetingLink">—</div>
            </div>
            <div class="qv-data-card qv-data-card-wide">
                <label>Calendar Event</label>
                <div id="dAppointmentCalendarLink">—</div>
            </div>
        </div>
        <div class="qv-data-card qv-data-card-wide qv-stack-md">
            <label>Manage Appointment</label>
            <div class="qv-inline-action-row">
                <button type="button" class="btn btn-gold" id="btnManageAppointment">Reschedule Appointment</button>
                <button type="button" class="btn btn-ghost" id="btnCancelAppointment">Cancel Appointment</button>
            </div>
        </div>
        @if (showStatusEditor)
        {
            <div class="qv-data-card qv-data-card-wide qv-stack-md">
                <label>Update Appointment Status</label>
                <div class="qv-inline-action-row">
                    <select id="dAppointmentStatusSelect">
                        <option value="Requested">Requested</option>
                        <option value="Booked">Booked</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Completed">Completed</option>
                        <option value="NoShow">No Show</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Rescheduled">Rescheduled</option>
                    </select>
                    <button type="button" class="btn btn-ghost" id="btnSaveAppointmentStatus">Save Appointment Status</button>
                </div>
            </div>
        }
    </div>
</details>
