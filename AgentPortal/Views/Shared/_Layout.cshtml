            NH: 'New Hampshire',
            NJ: 'New Jersey',
            NM: 'New Mexico',
            NY: 'New York',
            NC: 'North Carolina',
            ND: 'North Dakota',
            OH: 'Ohio',
            OK: 'Oklahoma',
            OR: 'Oregon',
            PA: 'Pennsylvania',
            RI: 'Rhode Island',
            SC: 'South Carolina',
            SD: 'South Dakota',
            TN: 'Tennessee',
            TX: 'Texas',
            UT: 'Utah',
            VT: 'Vermont',
            VA: 'Virginia',
            WA: 'Washington',
            WV: 'West Virginia',
            WI: 'Wisconsin',
            WY: 'Wyoming',
            PR: 'Puerto Rico',
            GU: 'Guam',
            VI: 'U.S. Virgin Islands',
            AS: 'American Samoa',
            MP: 'Northern Mariana Islands'
        });

        const US_STATE_CANONICAL_BY_KEY = Object.freeze(
            Object.values(US_STATE_NAME_BY_CODE).reduce((acc, name) => {
                acc[name.toUpperCase().replace(/[^A-Z]/g, '')] = name;
                return acc;
            }, {})
        );

        const US_STATE_CODE_BY_KEY = Object.freeze(
            Object.entries(US_STATE_NAME_BY_CODE).reduce((acc, [code, name]) => {
                acc[code] = code;
                acc[name.toUpperCase().replace(/[^A-Z]/g, '')] = code;
                return acc;
            }, {})
        );

        const DEFAULT_TIME_ZONE_BY_STATE = Object.freeze({
            AL: 'America/Chicago',
            AK: 'America/Anchorage',
            AZ: 'America/Phoenix',
            AR: 'America/Chicago',
            CA: 'America/Los_Angeles',
            CO: 'America/Denver',
            CT: 'America/New_York',
            DE: 'America/New_York',
            DC: 'America/New_York',
            FL: 'America/New_York',
            GA: 'America/New_York',
            HI: 'Pacific/Honolulu',
            IA: 'America/Chicago',
            ID: 'America/Denver',
            IL: 'America/Chicago',
            IN: 'America/New_York',
            KS: 'America/Chicago',
            KY: 'America/New_York',
            LA: 'America/Chicago',
            MA: 'America/New_York',
            MD: 'America/New_York',
            ME: 'America/New_York',
            MI: 'America/New_York',
            MN: 'America/Chicago',
            MO: 'America/Chicago',
            MS: 'America/Chicago',
            MT: 'America/Denver',
            NC: 'America/New_York',
            ND: 'America/Chicago',
            NE: 'America/Chicago',
            NH: 'America/New_York',
            NJ: 'America/New_York',
            NM: 'America/Denver',
            NV: 'America/Los_Angeles',
            NY: 'America/New_York',
            OH: 'America/New_York',
            OK: 'America/Chicago',
            OR: 'America/Los_Angeles',
            PA: 'America/New_York',
            RI: 'America/New_York',
            SC: 'America/New_York',
            SD: 'America/Chicago',
            TN: 'America/Chicago',
            TX: 'America/Chicago',
            UT: 'America/Denver',
            VA: 'America/New_York',
            VT: 'America/New_York',
            WA: 'America/Los_Angeles',
            WI: 'America/Chicago',
            WV: 'America/New_York',
            WY: 'America/Denver',
            PR: 'America/Puerto_Rico',
            GU: 'Pacific/Guam',
            VI: 'America/St_Thomas',
            AS: 'Pacific/Pago_Pago',
            MP: 'Pacific/Saipan'
        });

        function normalizeLocationKey(value) {
            return readString(value).toUpperCase().replace(/[^A-Z]/g, '');
        }

        function normalizeStateCode(value) {
            const raw = readString(value);
            if (!raw) return '';

            const key = raw.toUpperCase().replace(/[^A-Z]/g, '');
            return US_STATE_CODE_BY_KEY[key] || '';
        }

        function normalizeStateName(value) {
            const raw = readString(value);
            if (!raw) return '';

            const codeKey = raw.toUpperCase().replace(/[^A-Z]/g, '');
            if (US_STATE_NAME_BY_CODE[codeKey]) {
                return US_STATE_NAME_BY_CODE[codeKey];
            }

            return US_STATE_CANONICAL_BY_KEY[codeKey] || raw;
        }

        function getFirstName() {
            const firstName = readString(profile?.firstName);
            if (firstName) return firstName;

            const fullName = readString(profile?.fullName);
            if (fullName) {
                const parts = fullName.split(/\s+/).filter(Boolean);
                if (parts.length) return parts[0];
            }

            return 'Agent';
        }

        function formatPhoneDisplay(value) {
            const raw = readString(value);
            if (!raw) return '';

            const digits = raw.replace(/\D/g, '');
            if (digits.length === 10) {
                return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
            }

            if (digits.length === 11 && digits.startsWith('1')) {
                return `1 (${digits.slice(1, 4)}) ${digits.slice(4, 7)}-${digits.slice(7)}`;
            }

            return raw;
        }

        function getLead() {
            const bridgeLead = window.LeadBridge?.getCurrentLead?.();
            if (bridgeLead && typeof bridgeLead === 'object') return bridgeLead;

            const currentLead = window.__currentLead;
            return currentLead && typeof currentLead === 'object' ? currentLead : null;
        }

        function getLeadFirstName() {
            const lead = getLead();
            const leadFirstName = readString(lead?.firstName);
            if (leadFirstName) return leadFirstName;

            const leadName = firstToken(lead?.name || `${lead?.firstName || ''} ${lead?.lastName || ''}`);
            return leadName || 'Client';
        }

        function getLeadFullName() {
            const lead = getLead();
            const leadName = readString(lead?.name);
            if (leadName) return leadName;

            const firstName = readString(lead?.firstName);
            const lastName = readString(lead?.lastName);
            const fullName = `${firstName} ${lastName}`.trim();
            if (fullName) return fullName;

            return firstName || 'Client';
        }

        function getLeadState() {
            const lead = getLead();
            return normalizeStateName(lead?.state) || 'State';
        }

        function resolveLeadTimeZone() {
            const lead = getLead();
            const stateCode = normalizeStateCode(lead?.state);
            const cityKey = normalizeLocationKey(lead?.city);
            const countyKey = normalizeLocationKey(lead?.county);

            if (!stateCode) return '';

            const matchesAny = (value, options) => options.includes(value);

            switch (stateCode) {
                case 'FL':
                    if (matchesAny(countyKey, ['BAY', 'CALHOUN', 'ESCAMBIA', 'GULF', 'HOLMES', 'JACKSON', 'OKALOOSA', 'SANTAROSA', 'WALTON', 'WASHINGTON'])
                        || matchesAny(cityKey, ['PENSACOLA', 'CRESTVIEW', 'DESTIN', 'FORTWALTONBEACH', 'MARIANNA', 'NAVARRE', 'NICEVILLE', 'PANAMACITY'])) {
                        return 'America/Chicago';
                    }
                    break;
                case 'ID':
                    if (matchesAny(countyKey, ['BENEWAH', 'BONNER', 'BOUNDARY', 'CLEARWATER', 'IDAHO', 'LATAH', 'LEWIS', 'NEZPERCE', 'SHOSHONE'])
                        || matchesAny(cityKey, ['COEURDALENE', 'HAYDEN', 'LEWISTON', 'MOSCOW', 'POSTFALLS', 'RATHDRUM', 'SANDPOINT'])) {
                        return 'America/Los_Angeles';
                    }
                    break;
                case 'IN':
                    if (matchesAny(countyKey, ['DUBOIS', 'GIBSON', 'JASPER', 'KNOX', 'LAKE', 'LAPORTE', 'NEWTON', 'PERRY', 'PIKE', 'PORTER', 'POSEY', 'PULASKI', 'SPENCER', 'STARKE', 'VANDERBURGH', 'WARRICK'])
                        || matchesAny(cityKey, ['EVANSVILLE', 'GARY', 'HAMMOND', 'JASPER', 'MERRILLVILLE', 'PORTAGE', 'TELLCITY', 'VALPARAISO', 'VINCENNES'])) {
                        return 'America/Chicago';
                    }
                    break;
                case 'KY':
                    if (matchesAny(countyKey, ['ADAIR', 'ALLEN', 'BALLARD', 'BARREN', 'BRECKINRIDGE', 'BUTLER', 'CALDWELL', 'CALLOWAY', 'CARLISLE', 'CHRISTIAN', 'CLINTON', 'CRITTENDEN', 'CUMBERLAND', 'DAVIESS', 'EDMONSON', 'FULTON', 'GRAVES', 'GRAYSON', 'HANCOCK', 'HENDERSON', 'HICKMAN', 'HOPKINS', 'LIVINGSTON', 'LOGAN', 'LYON', 'MARSHALL', 'MCCRAKEN', 'MCLEAN', 'METCALFE', 'MONROE', 'MUHLENBERG', 'OHIO', 'SIMPSON', 'TODD', 'TRIGG', 'UNION', 'WARREN', 'WEBSTER'])
                        || matchesAny(cityKey, ['BOWLINGGREEN', 'HENDERSON', 'HOPKINSVILLE', 'MADISONVILLE', 'MAYFIELD', 'MURRAY', 'OWENSBORO', 'PADUCAH'])) {
                        return 'America/Chicago';
                    }
                    break;
                case 'MI':
                    if (matchesAny(countyKey, ['DICKINSON', 'GOGEBIC', 'IRON', 'MENOMINEE'])
                        || matchesAny(cityKey, ['IRONMOUNTAIN', 'IRONWOOD', 'MENOMINEE'])) {
                        return 'America/Chicago';
                    }
                    break;
                case 'ND':
                    if (matchesAny(countyKey, ['ADAMS', 'BILLINGS', 'BOWMAN', 'DUNN', 'GOLDENVALLEY', 'HETTINGER', 'MCKENZIE', 'SLOPE', 'STARK'])
                        || matchesAny(cityKey, ['BEACH', 'BOWMAN', 'DICKINSON', 'HETTINGER', 'KILLDEER', 'MEDORA', 'WATFORDCITY', 'WILLISTON'])) {
                        return 'America/Denver';
                    }
                    break;
                case 'NE':
                    if (matchesAny(countyKey, ['BANNER', 'BOXBUTTE', 'CHEYENNE', 'DAWES', 'DEUEL', 'GARDEN', 'KIMBALL', 'MORRILL', 'SCOTTSBLUFF', 'SHERIDAN', 'SIOUX'])
                        || matchesAny(cityKey, ['ALLIANCE', 'CHADRON', 'GERING', 'KIMBALL', 'OGALLALA', 'SCOTTSBLUFF', 'SIDNEY'])) {
                        return 'America/Denver';
                    }
                    break;
                case 'OR':
                    if (countyKey === 'MALHEUR' || matchesAny(cityKey, ['NYSSA', 'ONTARIO', 'VALE'])) {
                        return 'America/Denver';
                    }
                    break;
                case 'SD':
                    if (matchesAny(countyKey, ['BUTTE', 'CUSTER', 'FALLRIVER', 'HARDING', 'LAWRENCE', 'MEADE', 'PENNINGTON', 'PERKINS'])
                        || matchesAny(cityKey, ['DEADWOOD', 'HOTSPRINGS', 'RAPIDCITY', 'SPEARFISH', 'STURGIS'])) {
                        return 'America/Denver';
                    }
                    break;
                case 'TN':
                    if (matchesAny(countyKey, ['ANDERSON', 'BLEDSOE', 'BLOUNT', 'BRADLEY', 'CAMPBELL', 'CARTER', 'CLAIBORNE', 'COCKE', 'GRAINGER', 'GREENE', 'HAMBLEN', 'HAMILTON', 'HANCOCK', 'HAWKINS', 'JEFFERSON', 'JOHNSON', 'KNOX', 'LOUDON', 'MCMINN', 'MEIGS', 'MONROE', 'MORGAN', 'POLK', 'RHEA', 'ROANE', 'SCOTT', 'SEQUATCHIE', 'SEVIER', 'SULLIVAN', 'UNICOI', 'UNION', 'WASHINGTON'])
                        || matchesAny(cityKey, ['ATHENS', 'BRISTOL', 'CHATTANOOGA', 'CLEVELAND', 'GREENEVILLE', 'JOHNSONCITY', 'KINGSPORT', 'KNOXVILLE', 'MARYVILLE', 'MORRISTOWN', 'OAKRIDGE'])) {
                        return 'America/New_York';
                    }
                    break;
                case 'TX':
                    if (matchesAny(countyKey, ['ELPASO', 'HUDSPETH']) || matchesAny(cityKey, ['ANTHONY', 'ELPASO', 'HORIZONCITY'])) {
                        return 'America/Denver';
                    }
                    break;
            }

            return DEFAULT_TIME_ZONE_BY_STATE[stateCode] || '';
        }

        function getLeadGreeting() {
            const timeZone = resolveLeadTimeZone();
            if (!timeZone) return 'Hello';

            try {
                const hour = Number(
                    new Intl.DateTimeFormat('en-US', {
                        hour: 'numeric',
                        hour12: false,
                        timeZone
                    }).format(new Date())
                );

                if (Number.isFinite(hour)) {
                    if (hour < 12) return 'Good morning';
                    if (hour < 17) return 'Good afternoon';
                    return 'Good evening';
                }
            } catch {}

            return 'Hello';
        }

        function normalizeScriptMessage(value) {
            return String(value ?? '')
                .replace(/\u00a0/g, ' ')
                .replace(/\r/g, '')
                .split('\n')
                .map(line => line.trimEnd())
                .join('\n')
                .replace(/\n{3,}/g, '\n\n')
                .trim();
        }

        function resolveScriptRuntimeTokens(message) {
            let resolved = normalizeScriptMessage(message);
            if (!resolved) return '';

            const hasAppointmentTimeToken =
                /<\s*(?:appointment time|time)\s*>/i.test(resolved)
                || /{{\s*appointmenttime\s*}}/i.test(resolved);

            if (!hasAppointmentTimeToken) {
                return resolved;
            }

            const entered = window.prompt('Enter the appointment time for this message:', lastAppointmentTime || '');
            const appointmentTime = normalizeScriptMessage(entered);
            if (!appointmentTime) return '';

            lastAppointmentTime = appointmentTime;
            return normalizeScriptMessage(
                resolved
                    .replace(/<\s*appointment time\s*>/gi, appointmentTime)
                    .replace(/<\s*time\s*>/gi, appointmentTime)
                    .replace(/{{\s*appointmenttime\s*}}/gi, appointmentTime)
            );
        }

        function getLeadPhoneDigits() {
            const lead = getLead();
            const raw = readString(lead?.phone) || readString(lead?.phone2);
            return raw.replace(/\D/g, '');
        }

        function buildSmsLaunchHref(rawDigits, message) {
            const digits = readString(rawDigits).replace(/\D/g, '');
            const recipient = digits.length === 10 ? `+1${digits}` : digits;
            if (!recipient) return '';
            return `sms:${recipient}&body=${encodeURIComponent(normalizeScriptMessage(message))}`;
        }

        function getAgentPhone() {
            return formatPhoneDisplay(profile?.phone);
        }

        function extractScriptText(source) {
            if (!source) return '';
            return normalizeScriptMessage(source.innerText || source.textContent || '');
        }

        async function copyScriptTextMessage(message) {
            const resolved = resolveScriptRuntimeTokens(api.fillTextMessagePlaceholders(message));
            if (!resolved) return false;

            try {
                await navigator.clipboard.writeText(resolved);
                return true;
            } catch {
                return false;
            }
        }

        async function openTextComposer(message) {
            const normalized = normalizeScriptMessage(message);
            if (!normalized) return false;

            const digits = getLeadPhoneDigits();
            if (!digits) {
                window.alert('No phone number is available on the current contact card.');
                return false;
            }

            try {
                await navigator.clipboard.writeText(normalized);
            } catch {}

            const smsHref = buildSmsLaunchHref(digits, normalized);
            if (!smsHref) return false;
            window.location.href = smsHref;
            return true;
        }

        async function sendScriptTextMessage(message) {
            const normalized = resolveScriptRuntimeTokens(api.fillTextMessagePlaceholders(message));
            if (!normalized) return false;

            if (window.LeadBridge?.sendTextMessage) {
                const sent = await window.LeadBridge.sendTextMessage({ message: normalized });
                if (sent) return true;
            }

            return openTextComposer(normalized);
        }

        function replacePlaceholderVariants(source, token, value) {
            const escapedToken = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return source
                .replace(new RegExp(`<\\s*${escapedToken}\\s*>`, 'gi'), value)
                .replace(new RegExp(`&lt;\\s*${escapedToken}\\s*&gt;`, 'gi'), value);
        }

        function hasSupportedPlaceholder(value) {
            return /(?:<|&lt;)\s*(?:greeting|your full name|your name|agent first name|agent name|your phone number|office number|office phone number|phone number|client first name|client full name|client name|client|name|state)\s*(?:>|&gt;)/i.test(String(value ?? ''));
        }

        function fillLeadPlaceholders(text, options = {}) {
            const leadGreeting = getLeadGreeting();
            const agentFirstName = getFirstName();
            const agentPhone = getAgentPhone();
            const leadFirstName = getLeadFirstName();
            const leadFullName = getLeadFullName();
            const leadState = getLeadState();
            const preferFirstNameOnly = options.firstNameOnly === true;
            const preferredLeadName = preferFirstNameOnly ? leadFirstName : leadFullName;
            let rendered = String(text ?? '');

            rendered = replacePlaceholderVariants(rendered, 'greeting', leadGreeting);
            rendered = replacePlaceholderVariants(rendered, 'your full name', agentFirstName);
            rendered = replacePlaceholderVariants(rendered, 'your name', agentFirstName);
            rendered = replacePlaceholderVariants(rendered, 'agent first name', agentFirstName);
            rendered = replacePlaceholderVariants(rendered, 'agent name', agentFirstName);
            rendered = replacePlaceholderVariants(rendered, 'client first name', leadFirstName);
            rendered = replacePlaceholderVariants(rendered, 'client full name', preferFirstNameOnly ? leadFirstName : leadFullName);
            rendered = replacePlaceholderVariants(rendered, 'client name', preferredLeadName);
            rendered = replacePlaceholderVariants(rendered, 'client', preferredLeadName);
            rendered = replacePlaceholderVariants(rendered, 'name', preferredLeadName);
            rendered = replacePlaceholderVariants(rendered, 'state', leadState);
            if (agentPhone) {
                rendered = replacePlaceholderVariants(rendered, 'your phone number', agentPhone);
                rendered = replacePlaceholderVariants(rendered, 'office number', agentPhone);
                rendered = replacePlaceholderVariants(rendered, 'office phone number', agentPhone);
                rendered = replacePlaceholderVariants(rendered, 'phone number', agentPhone);
            }

            return rendered;
        }

        const api = {
            get() {
                return profile;
            },
            getFirstName,
            getLead,
            getLeadFirstName,
            getLeadFullName,
            getLeadState,
            getLeadTimeZone: resolveLeadTimeZone,
            getLeadGreeting,
            getPhone() {
                return getAgentPhone();
            },
            extractScriptText,
            copyTextMessage(message) {
                return copyScriptTextMessage(message);
            },
            sendTextMessage(message) {
                return sendScriptTextMessage(message);
            },
            fillScriptPlaceholders(text) {
                return fillLeadPlaceholders(text, { firstNameOnly: false });
            },
            fillTextMessagePlaceholders(text) {
                return fillLeadPlaceholders(text, { firstNameOnly: true });
            },
            applyScriptTemplates(root) {
                if (!root) return;

                const blocks = [];
                if (root.nodeType === Node.ELEMENT_NODE && root.classList?.contains('script')) {
                    blocks.push(root);
                }
                if (root.nodeType === Node.ELEMENT_NODE || root.nodeType === Node.DOCUMENT_FRAGMENT_NODE || root.nodeType === Node.DOCUMENT_NODE) {
                    root.querySelectorAll?.('.script').forEach(block => blocks.push(block));
                }

                blocks.forEach((block) => {
                    const template = scriptTemplateCache.get(block) ?? block.innerHTML;
                    if (!scriptTemplateCache.has(block) && hasSupportedPlaceholder(template)) {
                        scriptTemplateCache.set(block, template);
                    }

                    const source = scriptTemplateCache.get(block);
                    if (!source) return;

                    const rendered = api.fillScriptPlaceholders(source);
                    if (block.dataset.raw !== undefined) {
                        block.dataset.raw = rendered;
                    }
                    if (block.innerHTML !== rendered) {
                        block.innerHTML = rendered;
                    }
                });
            },
            applyPlaceholders(root) {
                if (!root) return;

                api.applyScriptTemplates(root);

                const applyToTextNode = (node) => {
                    if (!node || typeof node.nodeValue !== 'string') return;
                    const template = textTemplateCache.get(node) ?? node.nodeValue;
                    if (!textTemplateCache.has(node)) {
                        textTemplateCache.set(node, template);
                    }

                    const nextValue = api.fillScriptPlaceholders(template);
                    if (nextValue !== node.nodeValue) {
                        node.nodeValue = nextValue;
                    }
                };

                if (root.nodeType === Node.TEXT_NODE) {
                    applyToTextNode(root);
                    return;
                }

                const isSupportedRoot =
                    root.nodeType === Node.ELEMENT_NODE
                    || root.nodeType === Node.DOCUMENT_FRAGMENT_NODE
                    || root.nodeType === Node.DOCUMENT_NODE;

                if (!isSupportedRoot) return;

                const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                    acceptNode(node) {
                        const parentTag = node.parentElement?.tagName;
                        const template = textTemplateCache.get(node) ?? node.nodeValue;
                        if (!template || !hasSupportedPlaceholder(template)) {
                            return NodeFilter.FILTER_REJECT;
                        }

                        if (parentTag === 'SCRIPT' || parentTag === 'STYLE' || parentTag === 'TEXTAREA' || parentTag === 'OPTION') {
                            return NodeFilter.FILTER_REJECT;
                        }

                        if (node.parentElement?.closest('.script')) {
                            return NodeFilter.FILTER_REJECT;
                        }

                        return api.fillScriptPlaceholders(template) === node.nodeValue
                            ? NodeFilter.FILTER_REJECT
                            : NodeFilter.FILTER_ACCEPT;
                    }
                });

                const nodesToUpdate = [];
                while (walker.nextNode()) {
                    nodesToUpdate.push(walker.currentNode);
                }

                nodesToUpdate.forEach(applyToTextNode);
            }
        };

        window.LegendAgentProfile = Object.freeze({ ...profile, firstName: getFirstName() });
        window.LegendAgentProfileApi = api;

        const workstationRoots = () => Array.from(document.querySelectorAll('#mpShell, #rbShell'));

        const syncWorkstationPlaceholders = () => {
            workstationRoots().forEach(root => api.applyPlaceholders(root));
        };

        const mountWorkstationPlaceholderObserver = () => {
            const roots = workstationRoots();
            if (!roots.length || window.__legendWorkstationPlaceholderObserver) return;

            let syncing = false;
            const observer = new MutationObserver((mutations) => {
                if (syncing) return;
                syncing = true;

                try {
                    mutations.forEach((mutation) => {
                        if (mutation.type === 'characterData') {
                            api.applyPlaceholders(mutation.target);
                            return;
                        }

                        mutation.addedNodes.forEach((node) => {
                            api.applyPlaceholders(node);
                        });
                    });
                } finally {
                    syncing = false;
                }
            });

            roots.forEach((root) => {
                observer.observe(root, {
                    childList: true,
                    subtree: true,
                    characterData: true
                });
            });

            window.__legendWorkstationPlaceholderObserver = observer;
        };

        const mountWorkstationTimeRefresh = () => {
            if (window.__legendWorkstationTimeRefreshTimer) return;

            window.__legendWorkstationTimeRefreshTimer = window.setInterval(() => {
                syncWorkstationPlaceholders();
            }, 60000);
        };

        function findScriptSource(trigger, selector) {
            if (!trigger || !selector) return null;

            const scopes = [
                trigger.closest('.body'),
                trigger.closest('.prosper-body'),
                trigger.closest('.section'),
                trigger.closest('.prosper-stage'),
                trigger.closest('.content-body'),
                document
            ].filter(Boolean);

            for (const scope of scopes) {
                const found = scope.querySelector?.(selector);
                if (found) return found;
            }

            return document.querySelector(selector);
        }

        function flashScriptActionButton(button, nextLabel) {
            if (!button || !nextLabel) return;

            const original = button.dataset.originalLabel || button.textContent || '';
            if (!button.dataset.originalLabel) {
                button.dataset.originalLabel = original;
            }

            if (button.__legendResetLabelTimer) {
                window.clearTimeout(button.__legendResetLabelTimer);
            }

            button.textContent = nextLabel;
            button.__legendResetLabelTimer = window.setTimeout(() => {
                button.textContent = button.dataset.originalLabel || original;
            }, 1100);
        }

        const bindWorkstationScriptButtons = () => {
            if (window.__legendWorkstationScriptButtonsBound) return;

            document.addEventListener('click', async (event) => {
                const copyButton = event.target.closest('[data-copy-script-selector]');
                if (copyButton) {
                    event.preventDefault();

                    const selector = readString(copyButton.getAttribute('data-copy-script-selector'));
                    if (!selector) return;

                    const source = findScriptSource(copyButton, selector);
                    if (!source) return;

                    const message = extractScriptText(source);
                    if (!message) return;

                    const copied = await copyScriptTextMessage(message);
                    if (copied) {
                        flashScriptActionButton(copyButton, 'Copied');
                    }
                    return;
                }

                const textButton = event.target.closest('[data-send-script-selector]');
                if (!textButton) return;

                event.preventDefault();

                const selector = readString(textButton.getAttribute('data-send-script-selector'));
                if (!selector) return;

                const source = findScriptSource(textButton, selector);
                if (!source) return;

                const message = extractScriptText(source);
                if (!message) return;

                await sendScriptTextMessage(message);
            });

            window.__legendWorkstationScriptButtonsBound = true;
        };

        const bootWorkstationPlaceholderSync = () => {
            syncWorkstationPlaceholders();
            mountWorkstationPlaceholderObserver();
            mountWorkstationTimeRefresh();
            bindWorkstationScriptButtons();
        };

        window.addEventListener('leadbridge:currentLead', syncWorkstationPlaceholders);

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootWorkstationPlaceholderSync, { once: true });
        } else {
            bootWorkstationPlaceholderSync();
        }
    })();
</script>

