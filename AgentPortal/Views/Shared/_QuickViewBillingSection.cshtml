<section class="qv-panel crm-qv-disclosure qv-panel-data qv-disclosure" id="dBillingSection" hidden open aria-label="Client portal subscription">
    <div class="qv-section-header">
        <div>
            <div class="qv-section-title">Subscription</div>
            <div class="qv-section-copy" id="dBillingStatus">No subscription configured.</div>
        </div>
        <div class="qv-inline-action-row">
            <button type="button" class="btn btn-gold" id="btnBillingConfigureSubscription">Set Subscription</button>
        </div>
    </div>
    <div class="qv-section-body">
        <div class="qv-stack-md" id="dBillingSubscriptionSetup" hidden>
            <div class="qv-grid-two">
                <div class="qv-field">
                    <label for="dBillingSubscriptionPriceType">Monthly Tier</label>
                    <select id="dBillingSubscriptionPriceType">
                        <option value="Fixed50">$50 / month</option>
                        <option value="Fixed75">$75 / month</option>
                        <option value="Fixed100">$100 / month</option>
                        <option value="Fixed150">$150 / month</option>
                        <option value="Custom">Custom</option>
                    </select>
                </div>
                <div class="qv-field" id="dBillingSubscriptionCustomAmountWrap" hidden>
                    <label for="dBillingSubscriptionCustomAmount">Custom Monthly Amount</label>
                    <input id="dBillingSubscriptionCustomAmount" type="number" min="50" max="2500" step="0.01" inputmode="decimal" placeholder="50.00" />
                </div>
                <div class="qv-field">
                    <label for="dBillingSubscriptionAnchor">Billing Anchor</label>
                    <select id="dBillingSubscriptionAnchor">
                        <option value="FirstOfMonth">1st of month</option>
                        <option value="FifteenthOfMonth">15th of month</option>
                        <option value="SpecificDayOfMonth" data-founder-only hidden>Agent-selected day</option>
                    </select>
                </div>
                <div class="qv-field" id="dBillingSubscriptionAnchorDayWrap" hidden>
                    <label for="dBillingSubscriptionAnchorDay">Agent-Selected Day</label>
                    <input id="dBillingSubscriptionAnchorDay" type="number" min="1" max="31" step="1" inputmode="numeric" placeholder="15" />
                </div>
            </div>
            <div class="qv-inline-action-row">
                <button type="button" class="btn btn-gold" id="btnBillingSaveSubscription">Send Activation Invitation</button>
                <button type="button" class="btn btn-ghost" id="btnBillingCancelSubscriptionSetup">Cancel</button>
            </div>
        </div>
        <div class="qv-data-grid qv-data-grid-2">
            <div class="qv-data-card">
                <label>Offer</label>
                <div id="dBillingOffer">—</div>
            </div>
            <div class="qv-data-card">
                <label>Invitation</label>
                <div id="dBillingInvitation">—</div>
            </div>
            <div class="qv-data-card">
                <label>Subscription</label>
                <div id="dBillingSubscription">—</div>
            </div>
            <div class="qv-data-card">
                <label>Entitlement</label>
                <div id="dBillingEntitlement">—</div>
            </div>
            <div class="qv-data-card">
                <label>Next Billing Date</label>
                <div id="dBillingNextBilling">—</div>
            </div>
            <div class="qv-data-card">
                <label>Invitation Delivery</label>
                <div id="dBillingDelivery">—</div>
            </div>
        </div>
        <div class="qv-data-card qv-data-card-wide qv-stack-md">
            <label>Billing Actions</label>
            <div class="qv-inline-action-row">
                <button type="button" class="btn btn-gold" id="btnBillingResendInvite">Resend Invitation</button>
                <button type="button" class="btn btn-ghost" id="btnBillingRevokeInvite">Revoke Invitation</button>
                <button type="button" class="btn btn-ghost" id="btnBillingCancelPeriodEnd">Cancel At Period End</button>
            </div>
        </div>
    </div>
</section>
