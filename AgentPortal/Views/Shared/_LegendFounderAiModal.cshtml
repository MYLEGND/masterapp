<div class="modal fade legend-founder-ai-modal" data-legend-modal-surface
     id="legendFounderAiModal"
     tabindex="-1"
     aria-labelledby="legendFounderAiTitle"
     aria-hidden="true"
     data-chat-url="@Url.Action("Chat", "LegendFounderAi")"
     data-history-url="@Url.Action("Conversations", "LegendFounderAi")">

    <div class="modal-dialog modal-dialog-centered" data-legend-modal-panel>
        <div class="modal-content legend-founder-ai-shell" data-legend-modal-panel>

            <header class="legend-founder-ai-header">
                <div class="legend-founder-ai-identity">
                    <div class="legend-founder-ai-logo-frame">
                        <img src="~/images/legend-ai/legendai.png"
                             asp-append-version="true"
                             alt=""
                             class="legend-founder-ai-logo legend-founder-ai-logo-image" />
                    </div>

                    <div class="legend-founder-ai-heading">
                        <div class="legend-founder-ai-title-row">
                            <h2 id="legendFounderAiTitle">
                                Legend<sup>®</sup> Ai
                            </h2>
                        </div>
                    </div>
                </div>

                <div class="legend-founder-ai-header-actions">
                    <button type="button"
                            id="legendFounderAiMobileMenu"
                            class="legend-founder-ai-mobile-menu"
                            aria-expanded="false"
                            aria-controls="legendFounderAiSidebar"
                            aria-label="Open conversations and Legend® Ai controls">
                        <span aria-hidden="true">☰</span>
                    </button>

                    <button type="button"
                            class="legend-founder-ai-close"
                            data-bs-dismiss="modal"
                            aria-label="Close Legend® Ai">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </header>

            <div class="legend-founder-ai-workspace">

                <aside class="legend-founder-ai-sidebar"
                       id="legendFounderAiSidebar"
                       aria-label="Legend® Ai conversations">

                    <div class="legend-founder-ai-sidebar-top">
                        <button type="button"
                                id="legendFounderAiSidebarCollapse"
                                class="legend-founder-ai-sidebar-collapse"
                                aria-expanded="true"
                                aria-label="Collapse conversation sidebar"
                                title="Collapse sidebar">
                            <span aria-hidden="true">‹</span>
                        </button>

                        <button type="button"
                                id="legendFounderAiNew"
                                class="legend-founder-ai-new-conversation">
                            <span class="legend-founder-ai-new-icon"
                                  aria-hidden="true">＋</span>
                            <span class="legend-founder-ai-sidebar-label">
                                New conversation
                            </span>
                        </button>
                    </div>

                    <div id="legendFounderAiMobileControls"
                         class="legend-founder-ai-mobile-controls"
                         aria-label="Legend® Ai conversation controls">
<div id="legendFounderAiModebar"
                             class="legend-founder-ai-modebar">
                            <div class="legend-founder-ai-mode-tabs"
                                 role="tablist"
                                 aria-label="Conversation mode">
                                <button type="button"
                                        class="legend-founder-ai-mode is-active"
                                        data-legend-ai-mode="legend"
                                        role="tab"
                                        aria-selected="true">
                                    <span class="legend-founder-ai-mode-dot" aria-hidden="true"></span>
                                    Legend<sup>®</sup> Ai
                                </button>

                                <button type="button"
                                        class="legend-founder-ai-mode"
                                        data-legend-ai-mode="teacher"
                                        role="tab"
                                        aria-selected="false">
                                    <span class="legend-founder-ai-mode-dot" aria-hidden="true"></span>
                                    OpenAI
                                    <span class="visually-hidden">Direct OpenAI mode; native LEGEND responder bypassed</span>
                                </button>
                            </div>

                            <label class="legend-founder-ai-native-only"
                                   for="legendFounderAiNativeOnly">
                                <input type="checkbox"
                                       id="legendFounderAiNativeOnly" />
                                <span>
                                    <strong>Block all external providers</strong>
                                    <small>Disable external answering, research, and Azure translation.</small>
                                </span>
                            </label>
                            <label class="legend-founder-ai-native-only" for="legendFounderAiExternalAnsweringBlocked">
                                <input type="checkbox" id="legendFounderAiExternalAnsweringBlocked" />
                                <span>
                                    <strong>Block external answering</strong>
                                    <small>Allow authorized research and translation.</small>
                                </span>
                            </label>
                        </div>
                    </div>

                    <button type="button"
                            id="legendFounderAiRetry"
                            class="legend-founder-ai-sidebar-retry"
                            hidden>
                        Check or retry the same request
                    </button>

                    <section class="legend-founder-ai-sidebar-section legend-founder-ai-governed-action-section">
                        <div class="legend-founder-ai-sidebar-heading">
                            <span class="legend-founder-ai-sidebar-label">Governed action</span>
                        </div>
                        <label class="legend-founder-ai-mutation-confirmation"
                               for="legendFounderAiFounderCommandConfirmed">
                            <input type="checkbox" id="legendFounderAiFounderCommandConfirmed" />
                            <span><strong>Allow governed action</strong><small>Authorize only this request’s bounded action. Release approval stays separate.</small></span>
                        </label>
                    </section>

                    <section class="legend-founder-ai-sidebar-section legend-founder-ai-conversations-section">
                        <div class="legend-founder-ai-sidebar-heading">
                            <span class="legend-founder-ai-sidebar-label">
                                Conversations
                            </span>
                            <span class="legend-founder-ai-count"
                                  id="legendFounderAiConversationCount">0</span>
                        </div>

                        <div class="legend-founder-ai-history"
                             id="legendFounderAiHistory">
                        </div>

                        <div class="legend-founder-ai-history-empty"
                             id="legendFounderAiHistoryEmpty">
                            No previous conversations yet.
                        </div>
                    </section>

                    <section class="legend-founder-ai-sidebar-section legend-founder-ai-settings">
                        <div class="legend-founder-ai-sidebar-heading">
                            <span class="legend-founder-ai-sidebar-label">Settings</span>
                        </div>

                        <button type="button" class="legend-founder-ai-setting" data-legend-ai-setting="model">
                            <span class="legend-founder-ai-setting-icon" aria-hidden="true">◉</span>
                            <span class="legend-founder-ai-setting-summary"><strong>Model</strong><small>Choose response mode</small></span>
                            <span class="legend-founder-ai-setting-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="legend-founder-ai-setting" data-legend-ai-setting="tools">
                            <span class="legend-founder-ai-setting-icon" aria-hidden="true">◇</span>
                            <span class="legend-founder-ai-setting-summary"><strong>Tools &amp; data</strong><small>Governed access</small></span>
                            <span class="legend-founder-ai-setting-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="legend-founder-ai-setting" data-legend-ai-setting="behavior">
                            <span class="legend-founder-ai-setting-icon" aria-hidden="true">✦</span>
                            <span class="legend-founder-ai-setting-summary"><strong>Behavior</strong><small>Action permissions</small></span>
                            <span class="legend-founder-ai-setting-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="legend-founder-ai-setting" data-legend-ai-setting="history">
                            <span class="legend-founder-ai-setting-icon" aria-hidden="true">⌁</span>
                            <span class="legend-founder-ai-setting-summary"><strong>History</strong><small>Conversation controls</small></span>
                            <span class="legend-founder-ai-setting-chevron" aria-hidden="true">›</span>
                        </button>
                    </section>

                    <div class="legend-founder-ai-sidebar-spacer"></div>

                </aside>

                <button type="button"
                        id="legendFounderAiSidebarScrim"
                        class="legend-founder-ai-sidebar-scrim"
                        aria-label="Close conversations">
                </button>

                <section id="legendFounderAiSettingsPanel"
                         class="legend-founder-ai-settings-panel"
                         aria-modal="true"
                         role="dialog"
                         aria-labelledby="legendFounderAiSettingsTitle"
                         hidden>
                    <header>
                        <div>
                            <span class="legend-founder-ai-settings-kicker">Legend® Ai settings</span>
                            <h3 id="legendFounderAiSettingsTitle">Settings</h3>
                        </div>
                        <button type="button" id="legendFounderAiSettingsClose" aria-label="Close Legend® Ai settings">×</button>
                    </header>
                    <div id="legendFounderAiSettingsBody" class="legend-founder-ai-settings-body"></div>
                </section>

                <section class="legend-founder-ai-main">
                    <main class="legend-founder-ai-transcript"
                          id="legendFounderAiTranscript"
                          aria-live="polite"
                          aria-label="Legend® Ai conversation">
                        <div class="legend-founder-ai-welcome"
                             id="legendFounderAiWelcome">
                            <div class="legend-founder-ai-welcome-brand">
                                <h3>
                                    <span>LEGEND<sup>®</sup></span>
                                    <span class="legend-founder-ai-welcome-ai">AI</span>
                                </h3>
                                <p>Ideas. Answers. Next Steps.</p>
                            </div>

                            <div class="legend-founder-ai-welcome-greeting">
                                <span class="legend-founder-ai-welcome-mark" aria-hidden="true">
                                    <img src="~/images/legend-ai/legendai.png"
                                         asp-append-version="true"
                                         alt=""
                                         class="legend-founder-ai-logo-image" />
                                </span>
                                <div class="legend-founder-ai-welcome-bubble">
                                    Hi! I’m Legend<sup>®</sup> Ai.<br />
                                    How can I help you today?
                                </div>
                            </div>

                            <div class="legend-founder-ai-suggestions"
                                 aria-label="Suggested prompts">
                                <button type="button"
                                        class="legend-founder-ai-suggestion"
                                        data-legend-ai-suggestion="Summarize this page">
                                    Summarize this page
                                </button>
                                <button type="button"
                                        class="legend-founder-ai-suggestion"
                                        data-legend-ai-suggestion="Help me plan">
                                    Help me plan
                                </button>
                                <button type="button"
                                        class="legend-founder-ai-suggestion"
                                        data-legend-ai-suggestion="Answer a question">
                                    Answer a question
                                </button>
                                <button type="button"
                                        class="legend-founder-ai-suggestion"
                                        data-legend-ai-suggestion="Explore ideas">
                                    Explore ideas
                                </button>
                            </div>
                        </div>

                        <div class="legend-founder-ai-status"
                             id="legendFounderAiStatus"
                             aria-live="polite"
                             hidden>
                            <span class="legend-founder-ai-thinking-pill">
                                <span class="legend-founder-ai-thinking-orbit" aria-hidden="true"></span>
                                Legend thinking
                            </span>
                            <span class="legend-founder-ai-thinking-detail"></span>
                        </div>
                    </main>

                    <footer class="legend-founder-ai-composer">
                        <form id="legendFounderAiForm"
                              autocomplete="off">
                            @Html.AntiForgeryToken()

                            <div class="legend-founder-ai-input-wrap">
                                <button type="button"
                                        id="legendFounderAiComposerMenu"
                                        class="legend-founder-ai-composer-tool"
                                        aria-controls="legendFounderAiSidebar"
                                        aria-label="Open conversations and Legend® Ai controls">
                                    <span aria-hidden="true">＋</span>
                                </button>

                                <textarea id="legendFounderAiInput"
                                          rows="1"
                                          maxlength="20000"
                                          placeholder="Message Legend® Ai…"
                                          aria-label="Message Legend® Ai"></textarea>

                                <button type="button"
                                        id="legendFounderAiVoiceFocus"
                                        class="legend-founder-ai-voice-focus"
                                        aria-label="Focus message field for device dictation">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 15.25a3.75 3.75 0 0 0 3.75-3.75V6.25a3.75 3.75 0 1 0-7.5 0v5.25A3.75 3.75 0 0 0 12 15.25Z"></path>
                                        <path d="M5.75 11.25a6.25 6.25 0 0 0 12.5 0M12 17.5V21M8.75 21h6.5"></path>
                                    </svg>
                                </button>

                                <button type="submit"
                                        id="legendFounderAiSend"
                                        class="legend-founder-ai-send"
                                        aria-label="Send message">
                                    <span id="legendFounderAiSendIcon" aria-hidden="true">↑</span>
                                </button>
                            </div>

                        </form>
                    </footer>
                </section>
            </div>
        </div>
    </div>
</div>
