@using AgentPortal.Models
@model AgentPortal.Models.FounderLegendConnectDashboardVm
@{
    var dashboard = Model.Dashboard;
    var accountUsage = Model.AccountUsage;
    var accountScale = Model.AccountScale;
}

<section class="dashboard-analytics-panel legend-connect-client-management" aria-labelledby="account-usage-title" data-legend-copy-source="client-translation-usage">
    <div class="dashboard-section-head dashboard-section-head-tight">
        <div><span class="dashboard-section-kicker">Client CRM authority</span><h2 class="dashboard-section-title" id="account-usage-title">Active subscription translation accounts</h2></div>
        <partial name="_CopyButton" model="@("client-translation-usage")" />
    </div>
    <p class="dashboard-section-copy">Only active Client CRM records with a current paid subscription are searchable here. Historic access, usage, and removed accounts are not an account directory. Permission, entitlement, and consumption remain separate server authorities.</p>
    <form method="get" asp-action="Index" class="dashboard-search-panel" role="search" aria-label="Search active paying Client CRM accounts">
        @if (Model.SelectedLanguage is { } selectedLanguage)
        {
            <input type="hidden" name="language" value="@selectedLanguage.LanguageCode" />
        }
        @if (Model.SelectedPair is { } selectedPair)
        {
            <input type="hidden" name="pair" value="@selectedPair.PairKey" />
        }
        <div class="dashboard-form-grid">
            <label class="dashboard-form-field dashboard-form-field--wide"><span>Find a Client CRM account</span><input type="search" name="account" value="@Model.AccountSearchQuery" maxlength="120" autocomplete="off" placeholder="Name, email, or LEGEND client ID" /></label>
        </div>
        <div class="search-actions">
            <button type="submit" class="dashboard-command-action btn-carrier-settings">Search clients</button>
            @if (!string.IsNullOrWhiteSpace(Model.AccountSearchQuery))
            {
                <a asp-action="Index" asp-route-language="@(Model.SelectedLanguage?.LanguageCode)" asp-route-pair="@(Model.SelectedPair?.PairKey)" class="dashboard-command-action btn-carrier-settings">Clear search</a>
            }
        </div>
    </form>

    @if (accountUsage.Count == 0)
    {
        <p class="dashboard-section-copy">No active, current-paying Client CRM account matched this search.</p>
    }
    else
    {
        <p class="dashboard-section-copy">Showing @accountUsage.Count preview@(accountUsage.Count == 1 ? string.Empty : "s")@(Model.HasAdditionalAccountResults ? ". Refine the search to locate another active subscriber." : ".")</p>
        <div class="dashboard-data-surface">
            <table class="table dashboard-data-table">
                <thead><tr><th>Client</th><th>Translation state</th><th>Current period</th><th>Founder parameters</th></tr></thead>
                <tbody>
                @foreach (var account in accountUsage)
                {
                    var entitlement = account.Entitlement;
                    var presetSource = entitlement.EntitlementSource.StartsWith("Preset:", StringComparison.OrdinalIgnoreCase)
                        ? entitlement.EntitlementSource["Preset:".Length..]
                        : string.Empty;
                    <tr>
                        <td>@account.DisplayName<br /><small>Client CRM · @account.Account.UserId</small></td>
                        <td>@account.AccessState<br /><small>Language: @(account.PreferredLanguage ?? "Not set")</small></td>
                        <td>@(entitlement.IsUnlimited ? "Unlimited" : $"{entitlement.ConsumedCharacters:N0} / {entitlement.CharacterAllowance:N0}")<br /><small>@(entitlement.IsUnlimited ? "Fully metered" : $"{entitlement.RemainingCharacters?.ToString("N0") ?? "0"} remaining") · resets @entitlement.NextResetUtc.ToString("yyyy-MM-dd")</small></td>
                        <td>
                            <details class="legend-connect-account-parameters">
                                <summary>Set access and allowance</summary>
                                <form method="post" asp-action="UpdateEntitlement" class="dashboard-inline-command-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TargetUserId" value="@account.Account.UserId" />
                                    <input type="hidden" name="TargetParticipantType" value="@account.Account.ParticipantType" />
                                    <input type="hidden" name="ReturnAccountSearch" value="@Model.AccountSearchQuery" />
                                    <label><span class="visually-hidden">Access</span><select name="AccessGranted"><option value="true" selected="@(account.AccessState == "Granted")">Grant</option><option value="false" selected="@(account.AccessState != "Granted")">Revoke</option></select></label>
                                    <label><span class="visually-hidden">Allowance mode</span><select name="EntitlementMode"><option value="Custom" selected="@(!entitlement.IsUnlimited && string.IsNullOrWhiteSpace(presetSource))">Custom</option><option value="Unlimited" selected="@entitlement.IsUnlimited">Unlimited</option><option value="Preset" selected="@(!string.IsNullOrWhiteSpace(presetSource))">Configured preset</option></select></label>
                                    <label><span class="visually-hidden">Preset key</span><select name="PresetKey"><option value="">Select preset</option>@foreach (var preset in Model.EntitlementPresets) { <option value="@preset.Key" selected="@(string.Equals(presetSource, preset.Key, StringComparison.OrdinalIgnoreCase))">@preset.DisplayName (@preset.CharacterAllowance.ToString("N0"))</option> }</select></label>
                                    <label><span class="visually-hidden">Custom monthly character allowance</span><input type="number" name="CustomCharacterAllowance" min="0" value="@entitlement.CharacterAllowance" /></label>
                                    <button type="submit" class="dashboard-command-action btn-carrier-settings">Save parameters</button>
                                </form>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="dashboard-hero-stats legend-connect-metrics legend-connect-metrics--three" aria-label="Client translation account monitoring">
        <div class="dashboard-stat-card @LegendConnectMetricTone.Failure(accountScale.HighConsumptionAccountCount)" data-legend-live-card="high-consumption-accounts"><span class="dashboard-stat-label">High consumption accounts</span><span class="dashboard-stat-value" data-legend-live-value="high-consumption-accounts">@accountScale.HighConsumptionAccountCount.ToString("N0")</span></div>
    </div>

    <div class="dashboard-section-head dashboard-section-head-tight legend-connect-subsection-heading">
        <div><span class="dashboard-section-kicker">Privacy-safe learning telemetry</span><h3 class="dashboard-section-title">Consented live translation learning</h3></div>
    </div>
    <p class="dashboard-section-copy">Aggregate counts only; private message bodies and identities remain outside Founder telemetry.</p>
    <div class="dashboard-hero-stats legend-connect-metrics legend-connect-metrics--three" aria-label="Consented live translation learning">
        <div class="dashboard-stat-card @LegendConnectMetricTone.InformationalActivity(dashboard.ConsentedLiveLearningAccountCount)" data-legend-live-card="consented-accounts"><span class="dashboard-stat-label">Consented accounts</span><span class="dashboard-stat-value" data-legend-live-value="consented-accounts">@dashboard.ConsentedLiveLearningAccountCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.PendingWork(dashboard.EligibleConsentedLiveTranslationCount)" data-legend-live-card="eligible-live-translations"><span class="dashboard-stat-label">Eligible live translations</span><span class="dashboard-stat-value" data-legend-live-value="eligible-live-translations">@dashboard.EligibleConsentedLiveTranslationCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.BeneficialActivity(dashboard.PromotedConsentedLiveTranslationCount)" data-legend-live-card="promoted-to-learning"><span class="dashboard-stat-label">Promoted to learning</span><span class="dashboard-stat-value" data-legend-live-value="promoted-to-learning">@dashboard.PromotedConsentedLiveTranslationCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.BeneficialActivity(dashboard.ReusedConsentedLiveTranslationCount)" data-legend-live-card="canonical-reuse-prevented-duplicates"><span class="dashboard-stat-label">Canonical reuse prevented duplicates</span><span class="dashboard-stat-value" data-legend-live-value="canonical-reuse-prevented-duplicates">@dashboard.ReusedConsentedLiveTranslationCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.PendingWork(dashboard.PendingConsentedLiveTranslationCount)" data-legend-live-card="awaiting-corpus-processing"><span class="dashboard-stat-label">Awaiting corpus processing</span><span class="dashboard-stat-value" data-legend-live-value="awaiting-corpus-processing">@dashboard.PendingConsentedLiveTranslationCount.ToString("N0")</span></div>
    </div>
</section>

<section class="dashboard-analytics-panel legend-connect-manual-training" aria-labelledby="manual-training-title" data-legend-copy-source="founder-training">
    <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Approved knowledge</span><h2 class="dashboard-section-title" id="manual-training-title">Founder manual training</h2></div><partial name="_CopyButton" model="@("founder-training")" /></div>
    <p class="dashboard-section-copy">Source submissions preserve provenance and decompose into canonical atomic units. Fix Target Translation attaches Founder-approved targets only to existing canonical sources.</p>
    <div class="dashboard-hero-stats legend-connect-metrics legend-connect-metrics--three" aria-label="Founder training ingestion status">
        <div class="dashboard-stat-card @LegendConnectMetricTone.InformationalActivity(dashboard.FounderRawSubmissionCount)" data-legend-live-card="raw-submissions-retained"><span class="dashboard-stat-label">Raw submissions retained</span><span class="dashboard-stat-value" data-legend-live-value="raw-submissions-retained">@dashboard.FounderRawSubmissionCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.BeneficialActivity(dashboard.FounderAtomicLearningUnitCount)" data-legend-live-card="atomic-learning-units"><span class="dashboard-stat-label">Atomic learning units</span><span class="dashboard-stat-value" data-legend-live-value="atomic-learning-units">@dashboard.FounderAtomicLearningUnitCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.BeneficialActivity(dashboard.ActiveDirectionalAtomicAlignmentCount)" data-legend-live-card="active-directional-alignments"><span class="dashboard-stat-label">Active directional alignments</span><span class="dashboard-stat-value" data-legend-live-value="active-directional-alignments">@dashboard.ActiveDirectionalAtomicAlignmentCount.ToString("N0")</span></div>
        <div class="dashboard-stat-card @LegendConnectMetricTone.InformationalActivity(dashboard.SupersededLegacyMultiUnitAssetCount)" data-legend-live-card="legacy-multi-unit-assets-retired"><span class="dashboard-stat-label">Legacy multi-unit assets retired</span><span class="dashboard-stat-value" data-legend-live-value="legacy-multi-unit-assets-retired">@dashboard.SupersededLegacyMultiUnitAssetCount.ToString("N0")</span></div>
    </div>
    <form method="post" asp-action="SubmitKnowledge" class="dashboard-search-panel" data-verified-target-form>
        @Html.AntiForgeryToken()
        <label class="dashboard-form-field">
            <span>Founder mode</span>
            <span><input type="checkbox" name="FixTargetTranslation" value="true" id="legendConnectFixTargetTranslation" data-verified-target-toggle /> Fix Target Translation</span>
            <small id="legendConnectVerifiedTargetModeHelp">Off: preserve normal Founder curriculum submission. On: resolve existing canonical sources and attach verified targets only.</small>
        </label>
        <div class="dashboard-form-grid">
            <label class="dashboard-form-field"><span>Source language</span><select name="SourceLanguageCode" required><option value="">Select language</option>@foreach (var language in dashboard.Languages) { <option value="@language.LanguageCode">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
            <label class="dashboard-form-field"><span data-verified-target-language-label>Target language (optional — leave empty to queue autonomous expansion)</span><select name="TargetLanguageCode" data-verified-target-language><option value="">Approved source seed</option>@foreach (var language in dashboard.Languages) { <option value="@language.LanguageCode">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
            <label class="dashboard-form-field"><span>Context / category</span><input name="ContextCategory" maxlength="120" placeholder="Vocabulary, phrase, idiom, sentence pattern" /></label>
            <label class="dashboard-form-field"><span>Usage</span><input name="UsageRegister" maxlength="80" placeholder="Formal, informal, regional" /></label>
            <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-normal-fields><span>Source training text</span><textarea name="SourceText" required maxlength="30000" aria-describedby="source-training-help" data-verified-target-normal-input></textarea><small id="source-training-help">Up to 30,000 characters and 500 atomic units. Raw text is preserved for provenance; only the atomic units become reusable learning assets.</small></label>
            <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-normal-fields><span>Target text</span><textarea name="TargetText" maxlength="10000" data-verified-target-normal-input></textarea></label>
            <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-rows hidden>
                <span>Existing source | Founder-approved target</span>
                <textarea name="TargetTranslationRows" disabled maxlength="30000" aria-describedby="verified-target-rows-help" data-verified-target-rows-input placeholder="The package should arrive today. | Pake a ta dwe rive jodi a."></textarea>
                <small id="verified-target-rows-help">One exact canonical source and verified target per line. The selected target language applies to every row. Unmatched or ambiguous sources make no mutation for that row.</small>
            </label>
        </div>
        <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings" data-verified-target-submit>Save approved knowledge</button></div>
    </form>

    <details class="legend-connect-disclosure legend-connect-disclosure--curriculum">
        <summary class="legend-connect-disclosure-summary"><span><span class="dashboard-section-title">Teach advanced English conversation intelligence</span></span><span class="legend-connect-disclosure-status">Curriculum</span></summary>
        <div class="legend-connect-disclosure-body">
            <p class="dashboard-section-copy">
                Train reusable meaning, realization, composition, and discourse—not canned sentences. A manifest may contain many explicit semantic families; every family remains independently language-isolated, evidence-backed, contradiction-aware, and production-gated.
            </p>
            <div class="dashboard-search-panel" role="note" aria-label="Advanced curriculum authoring rules">
                <strong>Founder authoring standard</strong>
                <p class="dashboard-section-copy">
                    Use <code>@@family family.key | Semantic category</code>, then 2–100 distinct controlled English examples, then <code>@@end</code>. Build deliberate contrasts across conversation function, intent, polarity, tense/aspect, modality, mood, certainty, register, discourse role, condition, reference, and clause behavior. When meaning is visibly realized in the utterance, also identify exact surface components such as <code>agent=you</code>, <code>predicate=send</code>, <code>object=the document</code>, <code>time_expression=tomorrow</code>, <code>modal_marker=would</code>, or a multi-word <code>phrase=give up</code>. Stable dimensions and exact phrases let the existing structural authority accumulate reusable evidence instead of memorizing sentence shells.
                </p>
                <p class="dashboard-section-copy">
                    Model real interaction: openings, questions and answers, acknowledgment, clarification, repair, requests, offers, permissions, commitments, refusals, agreement and disagreement, negotiation, scheduling, causality, conditions, reference/coreference, embedded clauses, reported speech, idioms, lexical senses, politeness, topic shifts, interruption recovery, summaries, and closings. Vary vocabulary, participants, predicates, objects, sentence length, and context so support comes from independent evidence. Do not label slang, sarcasm, dialect, humor, or culturally specific pragmatics as universal unless the family deliberately scopes that distinction.
                </p>
                <p class="dashboard-section-copy">
                    Declare every family yourself. LEGEND will not guess, merge, silently split, truncate, promote provider repetition to Founder truth, or bypass the canonical curriculum/corpus/evidence/composition/Azure fallback authorities.
                </p>
            </div>
            <form method="post" asp-action="SubmitCurriculum" class="dashboard-search-panel">
                @Html.AntiForgeryToken()
                <div class="dashboard-form-grid">
                    <label class="dashboard-form-field dashboard-form-field--wide">
                        <span>English semantic curriculum manifest</span>
                        <textarea name="Manifest" required maxlength="120000" spellcheck="false"
                            placeholder="@@family conversation.request.action | Action request&#10;Could you send the document today? | function=request; intent=request_action; mood=interrogative; register=polite; agent=you; predicate=send; object=the document; time_expression=today; modal_marker=Could&#10;Please send the document today. | function=request; intent=request_action; mood=imperative; register=polite; agent=you; predicate=send; object=the document; time_expression=today&#10;Send the document today. | function=request; intent=request_action; mood=imperative; register=direct; agent=you; predicate=send; object=the document; time_expression=today&#10;@@end&#10;&#10;@@family conversation.clarification.repair | Clarification and repair&#10;What do you mean by that? | function=clarification_request; intent=clarify_meaning; mood=interrogative; agent=you&#10;I mean the meeting tomorrow. | function=clarification_response; intent=clarify_meaning; mood=declarative; agent=I; object=the meeting; time_expression=tomorrow&#10;Do you mean the meeting tomorrow? | function=confirmation_request; intent=confirm_understanding; mood=interrogative; agent=you; object=the meeting; time_expression=tomorrow&#10;No, I mean the call tomorrow. | function=correction; intent=correct_misunderstanding; polarity=negative; mood=declarative; agent=I; object=the call; time_expression=tomorrow&#10;@@end&#10;&#10;@@family conversation.condition.commitment | Conditional commitment&#10;If you call, I will answer. | function=commitment; intent=conditional_commitment; condition_type=real; condition_marker=If; agent=I; predicate=answer; modal_marker=will&#10;If you send the address, I will come. | function=commitment; intent=conditional_commitment; condition_type=real; condition_marker=If; agent=I; predicate=come; object=the address; modal_marker=will&#10;If you called, I would answer. | function=hypothetical_commitment; intent=conditional_commitment; condition_type=hypothetical; condition_marker=If; agent=I; predicate=answer; modal_marker=would&#10;@@end"></textarea>
                        <small>
                            Preflight is manifest-wide: one invalid family rejects the manifest with zero partial curriculum mutation. Use deliberate semantic dimensions plus exact surface components where known; preserve multi-word phrases; vary independent evidence; never create dimensions merely as decorative metadata.
                        </small>
                    </label>
                </div>
                <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Validate and save curriculum</button></div>
            </form>
        </div>
    </details>
</section>

<section class="category-container legend-connect-active-languages" aria-labelledby="active-languages-title" data-legend-copy-source="active-languages-registry">
    <div class="category-head"><div><span class="dashboard-section-kicker">Registry health</span><h2 class="dashboard-section-title" id="active-languages-title">Active languages</h2></div><partial name="_CopyButton" model="@("active-languages-registry")" /></div>
    <div class="dashboard-data-surface">
        <table class="table dashboard-data-table">
            <thead><tr><th>Language</th><th>Dataset</th><th>Entries</th><th>Pairs</th><th>Approved / pending candidates</th><th>Provider dependency</th><th>Last provider / Founder expansion</th><th>Health</th></tr></thead>
            <tbody>
            @foreach (var language in dashboard.Languages)
            {
                var providerDependencyTone = LegendConnectMetricTone.Dependency(language.AzureDependencyRate, language.DemandCount);
                <tr>
                    <td><a asp-action="Index" asp-route-language="@language.LanguageCode" aria-haspopup="dialog">@language.DisplayName (@language.LanguageCode)</a></td>
                    <td><span class="@LegendConnectMetricTone.Info">@language.StoragePartition</span></td>
                    <td><span class="@LegendConnectMetricTone.BeneficialActivity(language.CanonicalEntryCount)">@language.CanonicalEntryCount</span></td>
                    <td><span class="@LegendConnectMetricTone.BeneficialActivity(language.DirectionalPairs.Count)">@language.DirectionalPairs.Count</span></td>
                    <td><span class="@LegendConnectMetricTone.BeneficialActivity(language.ApprovedCandidateCount)">@language.ApprovedCandidateCount</span> <span class="legend-connect-metric-separator">/</span> <span class="@LegendConnectMetricTone.PendingWork(language.PendingCandidateCount)">@language.PendingCandidateCount</span></td>
                    <td><span class="@providerDependencyTone">@language.AzureDependencyRate.ToString("P0")</span></td>
                    <td><span class="@LegendConnectMetricTone.Expansion(language.LastProviderAcquisitionUtc)">@(language.LastProviderAcquisitionUtc?.ToString("u") ?? "None")</span><br /><small>Founder: <span class="@LegendConnectMetricTone.Expansion(language.LastFounderTrainingUtc)">@(language.LastFounderTrainingUtc?.ToString("u") ?? "None")</span></small></td>
                    <td><span class="@LegendConnectMetricTone.Health(language.HealthState)">@language.HealthState</span><span class="legend-connect-metric-separator"> · </span><span class="@LegendConnectMetricTone.Quality(language.QualityState)">@language.QualityState</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
