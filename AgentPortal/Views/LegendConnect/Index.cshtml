@using AgentPortal.Models
@model FounderLegendConnectPageVm
@{
    ViewData["Title"] = "Legend Connect";
    var shell = Model.Shell;
    var selected = shell.SelectedLanguage;
}

@section Styles {
    <link rel="stylesheet" href="~/css/legend-connect.css" asp-append-version="true" />
}

<main class="dashboard-page-shell legend-connect-page" data-legend-connect-shell data-language="@selected?.LanguageCode">
    <section class="dashboard-command-center-panel" aria-labelledby="legend-connect-title">
        <div class="dashboard-command-center-top">
            <div class="dashboard-hero-copy">
                <span class="dashboard-eyebrow">Founder · Language intelligence</span>
                <h1 class="dashboard-hero-title" id="legend-connect-title">Legend® Connect</h1>
                <p class="dashboard-section-copy">This page opens with a bounded language shell. Curriculum, evidence, relationships, learning, models, and retained knowledge load only when you open that section.</p>
                <form method="get" asp-action="Index" class="dashboard-search-panel">
                    <label class="dashboard-form-field"><span>Current language</span><select name="language" onchange="this.form.submit()">@foreach (var language in shell.Languages) { <option value="@language.LanguageCode" selected="@(language.LanguageCode == selected?.LanguageCode)">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
                    <noscript><button type="submit" class="dashboard-command-action btn-carrier-settings">Load language</button></noscript>
                </form>
            </div>
            @if (selected is not null)
            {
                <div class="dashboard-hero-stats" aria-label="Selected language summary">
                    <div class="dashboard-stat-card is-primary"><span class="dashboard-stat-label">Language health</span><span class="dashboard-stat-value">@selected.HealthState</span></div>
                    <div class="dashboard-stat-card"><span class="dashboard-stat-label">Canonical entries</span><span class="dashboard-stat-value">@selected.CanonicalEntryCount.ToString("N0")</span></div>
                    <div class="dashboard-stat-card"><span class="dashboard-stat-label">Curriculum examples</span><span class="dashboard-stat-value">@selected.CurriculumExampleCount.ToString("N0")</span></div>
                    <div class="dashboard-stat-card"><span class="dashboard-stat-label">Compositional anchors</span><span class="dashboard-stat-value">@selected.CompositionalAnchorCount.ToString("N0")</span></div>
                    <div class="dashboard-stat-card"><span class="dashboard-stat-label">Open issues</span><span class="dashboard-stat-value">@selected.OpenIssueCount.ToString("N0")</span></div>
                </div>
            }
        </div>
    </section>

    @if (TempData["LegendConnectSuccess"] is string success) { <section class="dashboard-analytics-panel" role="status"><p>@success</p></section> }
    @if (TempData["LegendConnectError"] is string error) { <section class="dashboard-analytics-panel" role="alert"><p>@error</p></section> }

    <section class="dashboard-analytics-panel legend-connect-manual-training" aria-labelledby="founder-curriculum-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Founder controls</span><h2 class="dashboard-section-title" id="founder-curriculum-title">Submit governed curriculum</h2></div></div>
        <p class="dashboard-section-copy">Submission is accepted through the established Founder pipeline. Processing stays durable and independent of the inspection panels below.</p>
        <form method="post" asp-action="SubmitKnowledge" class="dashboard-search-panel" data-verified-target-form>
            @Html.AntiForgeryToken()
            <label class="dashboard-form-field"><span><input type="checkbox" name="FixTargetTranslation" value="true" data-verified-target-toggle /> Fix Target Translation</span><small data-verified-target-help>Attach a Founder-approved target only to an exact existing canonical source.</small></label>
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field"><span>Source language</span><select name="SourceLanguageCode" required>@foreach (var language in shell.Languages) { <option value="@language.LanguageCode" selected="@(language.LanguageCode == selected?.LanguageCode)">@language.DisplayName</option> }</select></label>
                <label class="dashboard-form-field"><span>Target language</span><select name="TargetLanguageCode" data-verified-target-language><option value="">Approved source seed</option>@foreach (var language in shell.Languages) { <option value="@language.LanguageCode">@language.DisplayName</option> }</select></label>
                <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-normal-fields><span>Source training text</span><textarea name="SourceText" required maxlength="30000" data-verified-target-normal-input></textarea></label>
                <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-normal-fields><span>Target text</span><textarea name="TargetText" maxlength="10000" data-verified-target-normal-input></textarea></label>
                <label class="dashboard-form-field dashboard-form-field--wide" data-verified-target-rows hidden><span>Existing source | Founder-approved target</span><textarea name="TargetTranslationRows" disabled maxlength="30000" data-verified-target-rows-input></textarea></label>
            </div>
            <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings" data-verified-target-submit>Save approved knowledge</button></div>
        </form>
        <details class="legend-connect-disclosure">
            <summary class="legend-connect-disclosure-summary"><span><span class="dashboard-section-title">Advanced English curriculum manifest</span></span><span class="legend-connect-disclosure-status">Curriculum</span></summary>
            <div class="legend-connect-disclosure-body"><form method="post" asp-action="SubmitCurriculum" class="dashboard-search-panel">@Html.AntiForgeryToken()<label class="dashboard-form-field dashboard-form-field--wide"><span>English semantic curriculum manifest</span><textarea name="Manifest" required maxlength="120000" spellcheck="false" placeholder="@@family conversation.example | Semantic category&#10;Controlled example | function=...; intent=...&#10;@@end"></textarea><small>Family boundaries and semantic dimensions remain explicit Founder authority. One invalid family rejects the manifest without a partial mutation.</small></label><div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Validate and save curriculum</button></div></form></div>
        </details>
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="founder-mode-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Founder mode</span><h2 class="dashboard-section-title" id="founder-mode-title">Composition boundary</h2></div><span class="legend-connect-disclosure-status">@Model.RuntimePolicy.ContextualCompositionMode</span></div>
        <p class="dashboard-section-copy">Changing this server policy leaves curriculum governance, contradiction gates, and native inference authorities unchanged.</p>
        <div class="search-actions">@foreach (var mode in new[] { "Disabled", "Shadow", "Active" }) { <form method="post" asp-action="SetCompositionMode" class="dashboard-inline-command-form">@Html.AntiForgeryToken()<input type="hidden" name="ContextualCompositionMode" value="@mode" /><button type="submit" class="dashboard-command-action btn-carrier-settings" disabled="@(mode == Model.RuntimePolicy.ContextualCompositionMode)">@mode</button></form> }</div>
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="founder-inspection-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">On-demand inspection</span><h2 class="dashboard-section-title" id="founder-inspection-title">Explore governed LEGEND state</h2></div></div>
        <p class="dashboard-section-copy">Open one section to request its first server-ranked page. Searches run in SQL across the full eligible history; paging does not redefine what LEGEND knows.</p>
        @foreach (var panel in new[]
        {
            ("curriculum", "Curriculum", "Semantic families; expand one family to retrieve only its examples."),
            ("candidates", "Candidates", "Target-realization hypotheses and their governed lifecycle."),
            ("evidence", "Evidence", "Founder-controlled compositional anchors."),
            ("relationships", "Relationships", "Matured structural relationships and contradiction state."),
            ("learning", "Learning", "Durable learning work and processing state."),
            ("models", "Models", "Governed model-training lifecycle records."),
            ("health", "Health", "Operational health events for the selected language."),
            ("retained-knowledge", "Retained Knowledge", "Searchable, eligible canonical text only."),
            ("language-pairs", "Language Pairs", "Directional language-pair status."),
            ("provider-observations", "Provider Observations", "Provider-derived observations kept separate from Founder authority.")
        })
        {
            <details class="legend-connect-disclosure" data-legend-section="@panel.Item1"><summary class="legend-connect-disclosure-summary"><span><span class="dashboard-section-title">@panel.Item2</span></span><span class="legend-connect-disclosure-status">Load on demand</span></summary><div class="legend-connect-disclosure-body" data-legend-section-body><p class="dashboard-section-copy">@panel.Item3</p></div></details>
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/legend-connect.js" asp-append-version="true"></script>
}
