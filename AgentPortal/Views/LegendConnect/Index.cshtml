@model AgentPortal.Models.FounderLegendConnectDashboardVm
@{
    ViewData["Title"] = "Legend Connect";
    var dashboard = Model.Dashboard;
    var configuredCapacity = dashboard.ConfiguredMonthlyCapacity > 0
        ? dashboard.ConfiguredMonthlyCapacity.ToString("N0")
        : "Not configured";
    var remainingCapacity = dashboard.RemainingSafeCapacity?.ToString("N0") ?? "Not limited";
    var accountUsage = Model.AccountUsage;
    var accountScale = Model.AccountScale;
    var policy = Model.RuntimePolicy;
    var readiness = Model.ProductionReadiness;
    var priority = Model.PriorityProgress;
}

<main class="dashboard-page-shell">
    <section class="dashboard-command-center-panel" aria-labelledby="legend-connect-title">
        <div class="dashboard-command-center-top">
            <div class="dashboard-hero-copy">
                <span class="dashboard-eyebrow">Founder · Language intelligence</span>
                <h1 class="dashboard-hero-title" id="legend-connect-title">Legend® Connect</h1>
                <p>Server-owned language, learning, quality, and capacity operations.</p>
            </div>
            <div class="dashboard-hero-stats" aria-label="Legend Connect operational snapshot">
                <div class="dashboard-stat-card is-primary"><span class="dashboard-stat-label">Active languages</span><span class="dashboard-stat-value">@dashboard.Languages.Count</span></div>
                <div class="dashboard-stat-card"><span class="dashboard-stat-label">Directional pairs</span><span class="dashboard-stat-value">@dashboard.Pairs.Count</span></div>
                <div class="dashboard-stat-card"><span class="dashboard-stat-label">Learning failures</span><span class="dashboard-stat-value">@dashboard.FailedLearningJobCount</span></div>
                <div class="dashboard-stat-card"><span class="dashboard-stat-label">Duplicates prevented</span><span class="dashboard-stat-value">@dashboard.DuplicatePreventionCount</span></div>
            </div>
        </div>
    </section>

    @if (TempData["LegendConnectSuccess"] is string success)
    {
        <section class="dashboard-analytics-panel" role="status"><p>@success</p></section>
    }
    @if (TempData["LegendConnectError"] is string error)
    {
        <section class="dashboard-analytics-panel" role="alert"><p>@error</p></section>
    }

    <section class="dashboard-analytics-panel" aria-labelledby="production-readiness-title">
        <div class="dashboard-section-head dashboard-section-head-tight">
            <div><span class="dashboard-section-kicker">Founder operations / activation</span><h2 class="dashboard-section-title" id="production-readiness-title">Legend® Connect production readiness</h2></div>
            <span class="dashboard-status-chip">@readiness.State</span>
        </div>
        <p class="dashboard-section-copy">@readiness.Summary</p>
        <div class="dashboard-data-surface">
            <table class="table dashboard-data-table">
                <thead><tr><th>Gate</th><th>Status</th><th>Safe operational detail</th></tr></thead>
                <tbody>@foreach (var check in readiness.Checks) { <tr><td>@check.Name</td><td>@check.State</td><td>@check.Detail</td></tr> }</tbody>
            </table>
        </div>
        <div class="dashboard-hero-stats" aria-label="Approved corpus readiness">
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Approved candidates</span><span class="dashboard-stat-value">@readiness.ApprovedCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Eligible pending</span><span class="dashboard-stat-value">@readiness.PendingCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Rejected / ineligible</span><span class="dashboard-stat-value">@readiness.RejectedOrIneligibleCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Duplicates prevented</span><span class="dashboard-stat-value">@readiness.DuplicateCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Pairs awaiting knowledge</span><span class="dashboard-stat-value">@readiness.AwaitingKnowledgePairCount.ToString("N0")</span></div>
        </div>
        <form method="post" asp-action="UpdateRuntimePolicy" class="dashboard-search-panel">
            @Html.AntiForgeryToken()
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field"><span>Monthly provider capacity</span><input name="MonthlyProviderCapacityCharacters" type="number" min="0" value="@policy.MonthlyProviderCapacityCharacters" required /></label>
                <label class="dashboard-form-field"><span>Protected live translation reserve</span><input name="LiveTranslationReserveCharacters" type="number" min="0" value="@policy.LiveTranslationReserveCharacters" required /></label>
                <label class="dashboard-form-field"><span>Maximum safe corpus consumption</span><input name="MaximumSafeCorpusConsumptionCharacters" type="number" min="0" value="@policy.MaximumSafeCorpusConsumptionCharacters" required /></label>
                <label class="dashboard-form-field"><span>Contextual composition mode</span><select name="ContextualCompositionMode"><option value="Disabled" selected="@(policy.ContextualCompositionMode == "Disabled")">Disabled</option><option value="Shadow" selected="@(policy.ContextualCompositionMode == "Shadow")">Shadow</option><option value="Active" selected="@(policy.ContextualCompositionMode == "Active")">Active</option></select></label>
                <label class="dashboard-form-field"><span>Contextual minimum confidence</span><input name="ContextualMinimumConfidence" type="number" min="0.90" max="1" step="0.01" value="@policy.ContextualMinimumConfidence.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                <label class="dashboard-form-field"><span>Learning pipeline</span><span><input name="LearningEnabled" type="checkbox" value="true" @(policy.LearningEnabled ? "checked" : null) /> Enable autonomous learning processing</span></label>
            </div>
            <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Save runtime policy</button></div>
        </form>
        <div class="search-actions">
            <form method="post" asp-action="ActivateAutonomousAcquisition" class="dashboard-inline-command-form">@Html.AntiForgeryToken()<button type="submit" class="dashboard-command-action btn-carrier-settings">Activate autonomous acquisition</button></form>
            <form method="post" asp-action="PauseAutonomousAcquisition" class="dashboard-inline-command-form">@Html.AntiForgeryToken()<button type="submit" class="dashboard-command-action btn-carrier-settings">Pause autonomous acquisition</button></form>
        </div>
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="priority-override-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Existing autonomous planner</span><h2 class="dashboard-section-title" id="priority-override-title">Language / pair priority</h2></div><span class="dashboard-status-chip">@policy.PriorityMode</span></div>
        <p class="dashboard-section-copy">Automatic mode uses the existing demand, coverage, quality, and dependency score. A Founder override changes only the existing planner’s work order; corpus eligibility, deduplication, capacity protection, and worker claiming remain mandatory.</p>
        <div class="dashboard-hero-stats" aria-label="Founder priority progress">
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Priority status</span><span class="dashboard-stat-value">@priority.Status</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Eligible missing coverage</span><span class="dashboard-stat-value">@priority.EligibleMissingCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Pending candidates</span><span class="dashboard-stat-value">@priority.PendingCandidateCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Internal coverage</span><span class="dashboard-stat-value">@priority.CurrentInternalCoverage.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Azure dependency</span><span class="dashboard-stat-value">@priority.AzureDependencyRate.ToString("P0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Priority characters consumed</span><span class="dashboard-stat-value">@priority.CharactersConsumed.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Last successful expansion</span><span class="dashboard-stat-value">@(priority.LastSuccessfulExpansionUtc?.ToString("u") ?? "None")</span></div>
        </div>
        <p class="dashboard-section-copy">@(priority.Detail ?? "No Founder priority override is active.")</p>
        <form method="post" asp-action="ConfigurePriorityOverride" class="dashboard-search-panel">
            @Html.AntiForgeryToken()
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field"><span>Target language (optional when selecting a pair)</span><select name="LanguageCode"><option value="">No language-wide override</option>@foreach (var language in dashboard.Languages) { <option value="@language.LanguageCode" selected="@(policy.PriorityLanguageCode == language.LanguageCode)">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
                <label class="dashboard-form-field"><span>Directional pair (optional)</span><select name="PairKey"><option value="">No pair-specific override</option>@foreach (var pair in dashboard.Pairs) { <option value="@pair.PairKey" selected="@(policy.PriorityPairKey == pair.PairKey)">@pair.PairKey</option> }</select></label>
            </div>
            <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Enable / change Founder override</button></div>
        </form>
        <form method="post" asp-action="DisablePriorityOverride" class="dashboard-inline-command-form">@Html.AntiForgeryToken()<button type="submit" class="dashboard-command-action btn-carrier-settings">Return to automatic — demand driven</button></form>
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="translation-operations-title">
        <div class="dashboard-section-head dashboard-section-head-tight">
            <div><span class="dashboard-section-kicker">Live translation</span><h2 class="dashboard-section-title" id="translation-operations-title">Translation operations</h2></div>
        </div>
        <div class="dashboard-hero-stats">
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Same-language bypasses</span><span class="dashboard-stat-value">@dashboard.SameLanguageBypassCount</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Translation Memory hits</span><span class="dashboard-stat-value">@dashboard.TranslationMemoryHitCount</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Azure fallbacks</span><span class="dashboard-stat-value">@dashboard.AzureFallbackCount</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Trusted contextual served</span><span class="dashboard-stat-value">@dashboard.ContextualInternalServeCount</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Provider avoidance</span><span class="dashboard-stat-value">@dashboard.ProviderAvoidanceRate.ToString("P0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Azure dependency</span><span class="dashboard-stat-value">@dashboard.AzureDependencyRate.ToString("P0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Azure characters used</span><span class="dashboard-stat-value">@dashboard.AzureCharactersUsed.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Consumed live characters</span><span class="dashboard-stat-value">@dashboard.ConsumedLiveCharacters.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Consumed corpus characters</span><span class="dashboard-stat-value">@dashboard.ConsumedCorpusCharacters.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Provider characters reserved</span><span class="dashboard-stat-value">@dashboard.ReservedProviderCharacters.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Monthly capacity</span><span class="dashboard-stat-value">@configuredCapacity</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Live reserve</span><span class="dashboard-stat-value">@dashboard.LiveReserveCharacters.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Remaining safe capacity</span><span class="dashboard-stat-value">@remainingCapacity</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Safe acquisition capacity</span><span class="dashboard-stat-value">@(dashboard.SafeAcquisitionCapacity?.ToString("N0") ?? "Not configured")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Billing period</span><span class="dashboard-stat-value">@(dashboard.BillingPeriodStart?.ToString("yyyy-MM-dd") ?? "Not started")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Pending learning jobs</span><span class="dashboard-stat-value">@dashboard.LearningJobCount</span></div>
        </div>
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="account-usage-title">
        <div class="dashboard-section-head dashboard-section-head-tight">
            <div><span class="dashboard-section-kicker">Client CRM authority</span><h2 class="dashboard-section-title" id="account-usage-title">Active subscription translation accounts</h2></div>
        </div>
        <p class="dashboard-section-copy">Only active Client CRM records with a current paid subscription are searchable here. Historic access, usage, and removed accounts are not an account directory. Permission, entitlement, and consumption remain separate server authorities.</p>
        <div class="dashboard-hero-stats" aria-label="Current account translation usage">
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Provider operations</span><span class="dashboard-stat-value">@dashboard.ProviderOperationCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Provider-billable characters</span><span class="dashboard-stat-value">@dashboard.ProviderBillableCharacters.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Same-language avoided</span><span class="dashboard-stat-value">@dashboard.SameLanguageCharactersAvoided.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Memory avoided</span><span class="dashboard-stat-value">@dashboard.TranslationMemoryCharactersAvoided.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Context avoided</span><span class="dashboard-stat-value">@dashboard.ContextualCharactersAvoided.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Quota denied</span><span class="dashboard-stat-value">@dashboard.QuotaDeniedRequestCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Provider failures</span><span class="dashboard-stat-value">@dashboard.ProviderFailureCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">Group target reuse</span><span class="dashboard-stat-value">@dashboard.GroupUniqueTargetReuseCount.ToString("N0")</span></div>
            <div class="dashboard-stat-card"><span class="dashboard-stat-label">High consumption accounts</span><span class="dashboard-stat-value">@accountScale.HighConsumptionAccountCount</span></div>
        </div>

        <form method="get" asp-action="Index" class="dashboard-search-panel" role="search" aria-label="Search active paying Client CRM accounts">
            @if (Model.SelectedLanguage is { } selectedLanguage)
            {
                <input type="hidden" name="language" value="@selectedLanguage.LanguageCode" />
            }
            @if (Model.SelectedPair is { } selectedPair)
            {
                <input type="hidden" name="pair" value="@selectedPair.PairKey" />
            }
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field dashboard-form-field--wide"><span>Find a Client CRM account</span><input type="search" name="account" value="@Model.AccountSearchQuery" maxlength="120" autocomplete="off" placeholder="Name, email, or LEGEND client ID" /></label>
            </div>
            <div class="search-actions">
                <button type="submit" class="dashboard-command-action btn-carrier-settings">Search clients</button>
                @if (!string.IsNullOrWhiteSpace(Model.AccountSearchQuery))
                {
                    <a asp-action="Index" asp-route-language="@(Model.SelectedLanguage?.LanguageCode)" asp-route-pair="@(Model.SelectedPair?.PairKey)" class="dashboard-command-action btn-carrier-settings">Clear search</a>
                }
            </div>
        </form>

        @if (accountUsage.Count == 0)
        {
            <p class="dashboard-section-copy">No active, current-paying Client CRM account matched this search.</p>
        }
        else
        {
            <p class="dashboard-section-copy">Showing @accountUsage.Count preview@(accountUsage.Count == 1 ? string.Empty : "s")@(Model.HasAdditionalAccountResults ? ". Refine the search to locate another active subscriber." : ".")</p>
            <div class="dashboard-data-surface">
                <table class="table dashboard-data-table">
                    <thead><tr><th>Client</th><th>Translation state</th><th>Current period</th><th>Founder parameters</th></tr></thead>
                    <tbody>
                    @foreach (var account in accountUsage)
                    {
                        var entitlement = account.Entitlement;
                        var presetSource = entitlement.EntitlementSource.StartsWith("Preset:", StringComparison.OrdinalIgnoreCase)
                            ? entitlement.EntitlementSource["Preset:".Length..]
                            : string.Empty;
                        <tr>
                            <td>@account.DisplayName<br /><small>Client CRM · @account.Account.UserId</small></td>
                            <td>@account.AccessState<br /><small>Language: @(account.PreferredLanguage ?? "Not set")</small></td>
                            <td>@(entitlement.IsUnlimited ? "Unlimited" : $"{entitlement.ConsumedCharacters:N0} / {entitlement.CharacterAllowance:N0}")<br /><small>@(entitlement.IsUnlimited ? "Fully metered" : $"{entitlement.RemainingCharacters?.ToString("N0") ?? "0"} remaining") · resets @entitlement.NextResetUtc.ToString("yyyy-MM-dd")</small></td>
                            <td>
                                <details>
                                    <summary>Set access and allowance</summary>
                                    <form method="post" asp-action="UpdateEntitlement" class="dashboard-inline-command-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="TargetUserId" value="@account.Account.UserId" />
                                        <input type="hidden" name="TargetParticipantType" value="@account.Account.ParticipantType" />
                                        <input type="hidden" name="ReturnAccountSearch" value="@Model.AccountSearchQuery" />
                                        <label><span class="visually-hidden">Access</span><select name="AccessGranted"><option value="true" selected="@(account.AccessState == "Granted")">Grant</option><option value="false" selected="@(account.AccessState != "Granted")">Revoke</option></select></label>
                                        <label><span class="visually-hidden">Allowance mode</span><select name="EntitlementMode"><option value="Custom" selected="@(!entitlement.IsUnlimited && string.IsNullOrWhiteSpace(presetSource))">Custom</option><option value="Unlimited" selected="@entitlement.IsUnlimited">Unlimited</option><option value="Preset" selected="@(!string.IsNullOrWhiteSpace(presetSource))">Configured preset</option></select></label>
                                        <label><span class="visually-hidden">Preset key</span><select name="PresetKey"><option value="">Select preset</option>@foreach (var preset in Model.EntitlementPresets) { <option value="@preset.Key" selected="@(string.Equals(presetSource, preset.Key, StringComparison.OrdinalIgnoreCase))">@preset.DisplayName (@preset.CharacterAllowance.ToString("N0"))</option> }</select></label>
                                        <label><span class="visually-hidden">Custom monthly character allowance</span><input type="number" name="CustomCharacterAllowance" min="0" value="@entitlement.CharacterAllowance" /></label>
                                        <button type="submit" class="dashboard-command-action btn-carrier-settings">Save parameters</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="category-container" aria-labelledby="active-languages-title">
        <div class="category-head"><div><span class="dashboard-section-kicker">Registry health</span><h2 class="dashboard-section-title" id="active-languages-title">Active languages</h2></div></div>
        <div class="dashboard-data-surface">
            <table class="table dashboard-data-table">
                <thead><tr><th>Language</th><th>Dataset</th><th>Entries</th><th>Pairs</th><th>Approved / pending candidates</th><th>Azure dependency</th><th>Last provider / Founder expansion</th><th>Health</th></tr></thead>
                <tbody>
                @foreach (var language in dashboard.Languages)
                {
                    <tr>
                        <td><a asp-action="Index" asp-route-language="@language.LanguageCode" aria-haspopup="dialog">@language.DisplayName (@language.LanguageCode)</a></td>
                        <td>@language.StoragePartition</td><td>@language.CanonicalEntryCount</td><td>@language.DirectionalPairs.Count</td><td>@language.ApprovedCandidateCount / @language.PendingCandidateCount</td><td>@language.AzureDependencyRate.ToString("P0")</td><td>@(language.LastProviderAcquisitionUtc?.ToString("u") ?? "None")<br /><small>Founder: @(language.LastFounderTrainingUtc?.ToString("u") ?? "None")</small></td><td>@language.HealthState · @language.QualityState</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="category-container" aria-labelledby="active-pairs-title">
        <div class="category-head"><div><span class="dashboard-section-kicker">Directional health</span><h2 class="dashboard-section-title" id="active-pairs-title">Active directional pairs</h2></div></div>
        <div class="dashboard-data-surface">
            <table class="table dashboard-data-table">
                <thead><tr><th>Pair</th><th>Demand</th><th>Memory / context served</th><th>Azure dependency</th><th>Internal coverage</th><th>Quality confidence</th><th>Approved backlog</th><th>30-day additions</th><th>Health</th></tr></thead>
                <tbody>
                @foreach (var pair in dashboard.Pairs)
                {
                    <tr>
                        <td><a asp-action="Index" asp-route-pair="@pair.PairKey">@pair.PairKey</a></td><td>@pair.DemandCount</td><td>@pair.TranslationMemoryReuseCount / @pair.ContextualInternalServeCount</td><td>@pair.AzureFallbackCount (@pair.AzureDependencyRate.ToString("P0"))</td><td>@pair.InternalCoverageRate.ToString("P0")</td><td>@pair.InternalQualityConfidence.ToString("P0") · @pair.QualityState</td><td>@pair.ApprovedBacklog</td><td>@pair.CoverageAdditionsLast30Days</td><td>@pair.HealthState</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.SelectedPair is { } selectedPair)
    {
        <section class="dashboard-analytics-panel" aria-labelledby="pair-health-title">
            <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Pair health</span><h2 class="dashboard-section-title" id="pair-health-title">@selectedPair.PairKey</h2></div></div>
            <p class="dashboard-section-copy">@selectedPair.HealthState · @selectedPair.QualityState · @selectedPair.FailureCount failure@(selectedPair.FailureCount == 1 ? string.Empty : "s")</p>
            @if (selectedPair.RecentAlignments.Count > 0)
            {
                <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Approved source</th><th>Approved target</th><th>Quality</th><th>Updated</th></tr></thead><tbody>
                @foreach (var alignment in selectedPair.RecentAlignments)
                {
                    <tr><td>@alignment.SourceText</td><td>@alignment.TargetText</td><td>@alignment.QualityState</td><td>@alignment.UpdatedUtc.ToString("u")</td></tr>
                }
                </tbody></table></div>
            }
        </section>
    }

    <section class="dashboard-analytics-panel" aria-labelledby="manual-training-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Approved knowledge</span><h2 class="dashboard-section-title" id="manual-training-title">Founder manual training</h2></div></div>
        <form method="post" asp-action="SubmitKnowledge" class="dashboard-search-panel">
            @Html.AntiForgeryToken()
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field"><span>Source language</span><select name="SourceLanguageCode" required><option value="">Select language</option>@foreach (var language in dashboard.Languages) { <option value="@language.LanguageCode">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
                <label class="dashboard-form-field"><span>Target language (optional for monolingual knowledge)</span><select name="TargetLanguageCode"><option value="">Monolingual entry</option>@foreach (var language in dashboard.Languages) { <option value="@language.LanguageCode">@language.DisplayName (@language.LanguageCode)</option> }</select></label>
                <label class="dashboard-form-field"><span>Context / category</span><input name="ContextCategory" maxlength="120" placeholder="Vocabulary, phrase, idiom, sentence pattern" /></label>
                <label class="dashboard-form-field"><span>Usage</span><input name="UsageRegister" maxlength="80" placeholder="Formal, informal, regional" /></label>
                <label class="dashboard-form-field dashboard-form-field--wide"><span>Source text</span><textarea name="SourceText" required maxlength="10000"></textarea></label>
                <label class="dashboard-form-field dashboard-form-field--wide"><span>Target text</span><textarea name="TargetText" maxlength="10000"></textarea></label>
            </div>
            <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Save approved knowledge</button></div>
        </form>
    </section>

    @if (Model.SelectedPair is { } correctionPair && correctionPair.RecentAlignments.Count > 0)
    {
        <section class="dashboard-analytics-panel" aria-labelledby="correction-title">
            <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Audit-preserving correction</span><h2 class="dashboard-section-title" id="correction-title">Supersede a pair alignment</h2></div></div>
            <form method="post" asp-action="CorrectKnowledge" class="dashboard-search-panel">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SourceLanguageCode" value="@correctionPair.SourceLanguageCode" />
                <input type="hidden" name="TargetLanguageCode" value="@correctionPair.TargetLanguageCode" />
                <div class="dashboard-form-grid">
                    <label class="dashboard-form-field dashboard-form-field--wide"><span>Alignment to supersede</span><select name="SupersededAlignmentId" required>@foreach (var alignment in correctionPair.RecentAlignments) { <option value="@alignment.Id">@alignment.SourceText → @alignment.TargetText</option> }</select></label>
                    <label class="dashboard-form-field dashboard-form-field--wide"><span>Context / category</span><input name="ContextCategory" maxlength="120" /></label>
                    <label class="dashboard-form-field dashboard-form-field--wide"><span>Replacement source text</span><textarea name="SourceText" required maxlength="10000"></textarea></label>
                    <label class="dashboard-form-field dashboard-form-field--wide"><span>Replacement target text</span><textarea name="TargetText" required maxlength="10000"></textarea></label>
                </div>
                <div class="search-actions"><button type="submit" class="dashboard-command-action btn-carrier-settings">Save correction and supersede</button></div>
            </form>
        </section>
    }

    <section class="dashboard-analytics-panel" aria-labelledby="runtime-audit-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Founder audit</span><h2 class="dashboard-section-title" id="runtime-audit-title">Recent operational changes</h2></div></div>
        @if (Model.RuntimeAudit.Count == 0)
        {
            <p class="dashboard-section-copy">No Founder runtime-policy or priority changes have been recorded.</p>
        }
        else
        {
            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>When</th><th>Founder</th><th>Action</th><th>Language / pair</th><th>Result</th><th>Change</th></tr></thead><tbody>
            @foreach (var item in Model.RuntimeAudit)
            {
                <tr><td>@item.OccurredUtc.ToString("u")</td><td>@item.FounderUserId</td><td>@item.Action</td><td>@(item.PairKey ?? (string.IsNullOrWhiteSpace(item.LanguageCode) ? "Global" : item.LanguageCode))</td><td>@item.Result</td><td>@item.Detail</td></tr>
            }
            </tbody></table></div>
        }
    </section>

    <section class="dashboard-analytics-panel" aria-labelledby="operational-events-title">
        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Bounded diagnostics</span><h2 class="dashboard-section-title" id="operational-events-title">Recent backend events</h2></div></div>
        @if (dashboard.RecentOperationalEvents.Count == 0)
        {
            <p>No recorded Legend Connect operational events.</p>
        }
        else
        {
            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>When</th><th>Category</th><th>Severity</th><th>Language / pair</th><th>Status</th><th>Code</th></tr></thead><tbody>
            @foreach (var item in dashboard.RecentOperationalEvents)
            {
                <tr><td>@item.OccurredUtc.ToString("u")</td><td>@item.Category</td><td>@item.Severity</td><td>@(item.PairKey ?? item.LanguageCode ?? "Global")</td><td>@item.Status</td><td>@item.ErrorCode</td></tr>
            }
            </tbody></table></div>
        }
    </section>
</main>

@if (Model.SelectedLanguageKnowledge is { } languageKnowledge)
{
    var health = languageKnowledge.Health;
    var canonicalDisplayed = Math.Min(health.CanonicalEntryCount, (long)languageKnowledge.DetailRecordLimit);
    var alignmentDisplayed = Math.Min(health.TranslationMemoryRelationshipCount, (long)languageKnowledge.DetailRecordLimit);
    var contextDisplayed = Math.Min(health.ContextRelationshipCount, (long)languageKnowledge.DetailRecordLimit);
    var activityDisplayed = Math.Min(languageKnowledge.LearningActivityCount, (long)languageKnowledge.DetailRecordLimit);

    <div class="modal fade legend-modal dashboard-detail-modal" id="languageKnowledgeModal" tabindex="-1" aria-labelledby="languageKnowledgeModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="dashboard-section-kicker">Stored learning dataset</span>
                        <h2 class="modal-title" id="languageKnowledgeModalTitle">@health.DisplayName (@health.LanguageCode)</h2>
                        <p class="dashboard-section-copy">@health.StoragePartition · @health.HealthState · @health.QualityState</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close language dataset"></button>
                </div>
                <div class="modal-body">
                    <div class="dashboard-hero-stats dashboard-detail-modal-metrics" aria-label="Language dataset totals">
                        <div class="dashboard-stat-card"><span class="dashboard-stat-label">Canonical entries</span><span class="dashboard-stat-value">@health.CanonicalEntryCount</span></div>
                        <div class="dashboard-stat-card"><span class="dashboard-stat-label">Active alignments</span><span class="dashboard-stat-value">@health.TranslationMemoryRelationshipCount</span></div>
                        <div class="dashboard-stat-card"><span class="dashboard-stat-label">Context links</span><span class="dashboard-stat-value">@health.ContextRelationshipCount</span></div>
                        <div class="dashboard-stat-card"><span class="dashboard-stat-label">Learning events</span><span class="dashboard-stat-value">@languageKnowledge.LearningActivityCount</span></div>
                    </div>
                    <p class="dashboard-section-copy">This is a live server projection. Approved entries, active alignments, and context links expose the actual retained learning data. Learning-event rows intentionally show only metadata so private message bodies never enter Founder operations.</p>

                    <section class="dashboard-detail-modal-section" aria-labelledby="canonical-entries-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Approved canonical assets</span><h3 class="dashboard-section-title" id="canonical-entries-title">Entries used for learning</h3></div></div>
                        @if (languageKnowledge.CanonicalEntries.Count == 0)
                        {
                            <p class="dashboard-section-copy">No approved canonical entries are stored in @health.StoragePartition yet. This is the real empty dataset state.</p>
                        }
                        else
                        {
                            <p class="dashboard-section-copy">Showing the newest @canonicalDisplayed of @health.CanonicalEntryCount retained @(health.CanonicalEntryCount == 1 ? "entry" : "entries").</p>
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Approved text</th><th>Provenance</th><th>Created</th><th>Updated</th></tr></thead><tbody>
                            @foreach (var entry in languageKnowledge.CanonicalEntries)
                            {
                                <tr><td>@entry.Text</td><td>@entry.Provenance</td><td>@entry.CreatedUtc.ToString("u")</td><td>@entry.UpdatedUtc.ToString("u")</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="dashboard-detail-modal-section" aria-labelledby="active-alignments-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Directional translation memory</span><h3 class="dashboard-section-title" id="active-alignments-title">Active approved alignments</h3></div></div>
                        @if (languageKnowledge.ActiveAlignments.Count == 0)
                        {
                            <p class="dashboard-section-copy">No active approved directional alignments are stored for this language yet.</p>
                        }
                        else
                        {
                            <p class="dashboard-section-copy">Showing the newest @alignmentDisplayed of @health.TranslationMemoryRelationshipCount active alignment@(health.TranslationMemoryRelationshipCount == 1 ? string.Empty : "s").</p>
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Pair</th><th>Approved source</th><th>Approved target</th><th>Provider</th><th>Quality</th><th>Observations</th><th>Updated</th></tr></thead><tbody>
                            @foreach (var alignment in languageKnowledge.ActiveAlignments)
                            {
                                <tr><td>@alignment.PairKey</td><td>@alignment.SourceText</td><td>@alignment.TargetText</td><td>@alignment.Provider</td><td>@alignment.QualityState</td><td>@alignment.ObservationCount</td><td>@alignment.UpdatedUtc.ToString("u")</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="dashboard-detail-modal-section" aria-labelledby="context-relationships-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Reusable context</span><h3 class="dashboard-section-title" id="context-relationships-title">Stored context relationships</h3></div></div>
                        @if (languageKnowledge.ContextRelationships.Count == 0)
                        {
                            <p class="dashboard-section-copy">No approved context relationships are stored for this language yet.</p>
                        }
                        else
                        {
                            <p class="dashboard-section-copy">Showing the newest @contextDisplayed of @health.ContextRelationshipCount relationship@(health.ContextRelationshipCount == 1 ? string.Empty : "s").</p>
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Pair</th><th>Source asset</th><th>Related asset</th><th>Kind</th><th>Context</th><th>Usage</th><th>Quality</th><th>Updated</th></tr></thead><tbody>
                            @foreach (var relationship in languageKnowledge.ContextRelationships)
                            {
                                <tr><td>@(relationship.PairKey ?? "Monolingual")</td><td>@relationship.SourceText</td><td>@relationship.RelatedText</td><td>@relationship.RelationshipKind</td><td>@(relationship.ContextCategory ?? "Not classified")</td><td>@(relationship.UsageRegister ?? "Not specified")</td><td>@relationship.QualityState</td><td>@relationship.UpdatedUtc.ToString("u")</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="dashboard-detail-modal-section" aria-labelledby="language-pairs-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Directional health</span><h3 class="dashboard-section-title" id="language-pairs-title">Connected language pairs</h3></div></div>
                        @if (languageKnowledge.DirectionalPairs.Count == 0)
                        {
                            <p class="dashboard-section-copy">No enabled directional pair is configured for this language yet.</p>
                        }
                        else
                        {
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Pair</th><th>Demand</th><th>Memory reuse</th><th>Azure fallback</th><th>Coverage</th><th>Quality</th><th>Health</th></tr></thead><tbody>
                            @foreach (var pair in languageKnowledge.DirectionalPairs)
                            {
                                <tr><td>@pair.PairKey</td><td>@pair.DemandCount</td><td>@pair.TranslationMemoryReuseCount</td><td>@pair.AzureFallbackCount (@pair.AzureFallbackRate.ToString("P0"))</td><td>@pair.Coverage</td><td>@pair.QualityState</td><td>@pair.HealthState</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="dashboard-detail-modal-section" aria-labelledby="learning-activity-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Privacy-safe pipeline audit</span><h3 class="dashboard-section-title" id="learning-activity-title">Learning activity</h3></div></div>
                        @if (languageKnowledge.RecentLearningActivity.Count == 0)
                        {
                            <p class="dashboard-section-copy">No learning-pipeline activity has been recorded for this language yet.</p>
                        }
                        else
                        {
                            <p class="dashboard-section-copy">Showing the newest @activityDisplayed of @languageKnowledge.LearningActivityCount activity record@(languageKnowledge.LearningActivityCount == 1 ? string.Empty : "s"). Text is intentionally excluded here.</p>
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>Pair</th><th>Provenance</th><th>Eligibility</th><th>State</th><th>Attempts</th><th>Created</th><th>Processed</th><th>Failure</th></tr></thead><tbody>
                            @foreach (var activity in languageKnowledge.RecentLearningActivity)
                            {
                                <tr><td>@activity.PairKey</td><td>@activity.Provenance</td><td>@activity.EligibilityState</td><td>@activity.ProcessingState</td><td>@activity.AttemptCount</td><td>@activity.CreatedUtc.ToString("u")</td><td>@(activity.ProcessedUtc?.ToString("u") ?? "Not processed")</td><td>@(activity.FailureCode ?? "None")</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="dashboard-detail-modal-section" aria-labelledby="language-errors-title">
                        <div class="dashboard-section-head dashboard-section-head-tight"><div><span class="dashboard-section-kicker">Bounded diagnostics</span><h3 class="dashboard-section-title" id="language-errors-title">Recent errors</h3></div></div>
                        @if (health.RecentErrors.Count == 0)
                        {
                            <p class="dashboard-section-copy">No current language or directional-pair errors are recorded.</p>
                        }
                        else
                        {
                            <div class="dashboard-data-surface"><table class="table dashboard-data-table"><thead><tr><th>When</th><th>Category</th><th>Pair</th><th>State</th><th>Code</th><th>Summary</th></tr></thead><tbody>
                            @foreach (var diagnostic in health.RecentErrors)
                            {
                                <tr><td>@diagnostic.OccurredUtc.ToString("u")</td><td>@diagnostic.Category</td><td>@(diagnostic.PairKey ?? "Language")</td><td>@diagnostic.Status</td><td>@diagnostic.ErrorCode</td><td>@diagnostic.Summary</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.SelectedLanguageKnowledge is not null)
    {
        <script>
            (() => {
                const element = document.getElementById("languageKnowledgeModal");
                if (!element || !window.bootstrap?.Modal) return;
                const modal = bootstrap.Modal.getOrCreateInstance(element);
                element.addEventListener("hidden.bs.modal", () => {
                    const url = new URL(window.location.href);
                    url.searchParams.delete("language");
                    window.history.replaceState({}, "", url);
                }, { once: true });
                modal.show();
            })();
        </script>
    }
}
