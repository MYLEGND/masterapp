@* Views/FactFinder/Younger.cshtml *@
@model AgentPortal.Models.FactFinderViewModel

@{
    ViewData["Title"] = "Younger Fact Finder";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-home-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Shared/css/legend-factfinder-shared.css" asp-append-version="true" />
}

<div class="dashboard-page-shell factfinder-page-shell">
<div class="ff-shell">

    @if (ViewBag.Success != null)
    {
        <div class="success-message">@ViewBag.Success</div>
    }

    <div class="ff-hero">
        <div class="ff-hero-inner">
            <div class="ff-title">
                <h1>Fact Finder - Younger (18-34)</h1>
            </div>

            <p class="required-note">
                <strong><span class="text-danger">*</span> Fields marked with a red asterisk are required.</strong>
            </p>
        </div>
    </div>

    <!-- Progress (Young-only) -->
    <div class="ff-progress-wrap">
        <div class="ff-progress-top">
            <div class="ff-step-pill">
                Step <span id="ffStepNowYoung">1</span> of <span id="ffStepTotalYoung">5</span>
            </div>
            <div class="ff-step-copy" id="ffStepLabelYoung">
                Life + Direction
            </div>
        </div>
        <div class="ff-progress"><div id="ffProgressBarYoung"></div></div>
    </div>

    <div id="ffErrorSummaryYoung"></div>

    <div id="ffYoungApp">
        <form id="factFinderFormYoung" method="post" asp-action="Submit" asp-controller="FactFinder" novalidate>
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="FormType" value="Young" />

            <!-- =========================================================
                 STEP 1 — TRUST + VALUES + DIRECTION (BEFORE MONEY)
            ========================================================== -->
            <section class="wizard-step active" data-step="1" data-label="Life + Direction">
                <div class="section-card">
                    <div class="section-title">Younger Fact Finder — Part 1: Life, Direction & Ownership</div>
                    <div class="subtle">We start with what matters to you — then we build the plan around it.</div>

                    <div class="stack">

                        <div class="block ff-no-collapse">
                            <div class="block-title">Personal</div>

                            <div class="row two">
                                <div class="field">
                                    <label>Full Name<span class="req">*</span></label>
                                    <input asp-for="Young.Person.Name" class="form-control" placeholder="Full Name*" required />
                                    <span asp-validation-for="Young.Person.Name" class="text-danger"></span>
                                </div>
                                <div class="field">
                                    <label>Date of Birth<span class="req">*</span></label>
                                    <input asp-for="Young.Person.DOB" type="date" class="form-control" required />
                                    <span asp-validation-for="Young.Person.DOB" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>City / State</label>
                                    <input asp-for="Young.Person.Location" class="form-control" placeholder="City, State" />
                                </div>
                                <div class="field">
                                    <label>Relationship Status</label>
                                    <select asp-for="Young.Person.RelationshipStatus" class="form-select">
                                        <option value="">Select</option>
                                        <option>Single</option>
                                        <option>In a Relationship</option>
                                        <option>Married</option>
                                        <option>Engaged</option>
                                        <option>Divorced</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>Do you have kids or dependents?</label>
                                    <select asp-for="Young.Person.HasDependents" class="form-select">
                                        <option value="">Select</option>
                                        <option>No</option>
                                        <option>Yes</option>
                                        <option>Not yet, but planned</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>If yes, how many?</label>
                                    <input asp-for="Young.Person.DependentsCount" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="block">
                            <div class="block-title">Direction & Motivation</div>

                            <div class="field">
                                <label>1) What do you want your life to look like in 3–5 years?</label>
                                <textarea asp-for="Young.Direction.ThreeToFiveYears" class="form-control ff-textarea-lg"></textarea>
                            </div>


                            <div class="field">
                                <label>3) What are you most stressed about financially right now?</label>
                                <textarea asp-for="Young.Direction.CurrentStress" class="form-control ff-textarea-lg"></textarea>
                            </div>


                            <div class="field">
                                <label>5) If we could fix one thing first that would make the biggest impact, what do you think it is?</label>
                                <textarea asp-for="Young.Direction.OneThingFirst" class="form-control ff-textarea-lg"></textarea>
                            </div>
                        </div>

                        <div class="block">
                            <div class="block-title">Financial Priorities</div>

                            <div class="field">
                                <label>What does financial stability mean to you?</label>
                                <textarea asp-for="Young.Ownership.StabilityMeaning" class="form-control ff-textarea-lg"></textarea>
                            </div>



                            <div class="wizard-actions">
                                <div></div>
                                <button type="button" class="btn btn-gold" data-next>Next</button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- =========================================================
                 STEP 2 — WORK + SYSTEM + HABITS (THEN MONEY)
            ========================================================== -->
            <section class="wizard-step" data-step="2" data-label="Work + System">
                <div class="section-card">
                    <div class="section-title">Part 2 — Work, Habits & Your Financial System</div>
                    <div class="subtle">We establish stability and structure first — then we measure the numbers.</div>

                    <div class="stack">

                        <div class="block">
                            <div class="block-title">Work, Income & Stability</div>

                            <div class="field">
                                <label>6) What do you do for work right now?</label>
                                <input asp-for="Young.Work.Role" class="form-control" placeholder="Job title / role" />
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>Employer / Company</label>
                                    <input asp-for="Young.Work.Employer" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>How long have you been there?</label>
                                    <input asp-for="Young.Work.Tenure" class="form-control" placeholder="Example: 1 year" />
                                </div>
                            </div>

                            <div class="row three">
                                <div class="field">
                                    <label>Income Type</label>
                                    <select asp-for="Young.Work.IncomeType" class="form-select">
                                        <option value="">Select</option>
                                        <option>Salary</option>
                                        <option>Hourly</option>
                                        <option>Commission</option>
                                        <option>Gig / Contract</option>
                                        <option>Business Owner</option>
                                        <option>Mixed</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Annual Income (Approx.)</label>
                                    <input asp-for="Young.Work.AnnualIncome" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>Income Stability</label>
                                    <select asp-for="Young.Work.IncomeStability" class="form-select">
                                        <option value="">Select</option>
                                        <option>Stable</option>
                                        <option>Somewhat unstable</option>
                                        <option>Unpredictable</option>
                                    </select>
                                </div>
                            </div>

                            <div class="field">
                                <label>7) What’s your biggest obstacle to increasing income right now? (skills, confidence, time, opportunities, debt, health, mindset)</label>
                                <textarea asp-for="Young.Work.ObstacleToIncreaseIncome" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="field">
                                <label>8) Are you building toward a career path, entrepreneurship, or still exploring?</label>
                                <textarea asp-for="Young.Work.PathExploration" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="mini-title">Benefits (if employed)</div>
                            <div class="row two">
                                <div class="checkline"><input asp-for="Young.Benefits.Health" type="checkbox" id="youngBenHealth" /><label for="youngBenHealth" class="ff-label-reset">Health</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.Dental" type="checkbox" id="youngBenDental" /><label for="youngBenDental" class="ff-label-reset">Dental</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.Vision" type="checkbox" id="youngBenVision" /><label for="youngBenVision" class="ff-label-reset">Vision</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.RetirementPlan" type="checkbox" id="youngBenRet" /><label for="youngBenRet" class="ff-label-reset">401(k)/403(b)</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.HSA" type="checkbox" id="youngBenHsa" /><label for="youngBenHsa" class="ff-label-reset">HSA</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.GroupLife" type="checkbox" id="youngBenGL" /><label for="youngBenGL" class="ff-label-reset">Group Life</label></div>
                                <div class="checkline"><input asp-for="Young.Benefits.GroupDI" type="checkbox" id="youngBenDI" /><label for="youngBenDI" class="ff-label-reset">Group Disability</label></div>
                            </div>

                        </div>

                        <div class="block">
                            <div class="block-title">Cash Flow + Habits (System First)</div>


                            <div class="field">
                                <label>10) What’s the #1 thing that throws your money off each month?</label>
                                <textarea asp-for="Young.Cashflow.OffTrack" class="form-control ff-textarea-lg"></textarea>
                            </div>



                            <div class="mini-title">Banking Setup</div>
<div class="mini-title">Monthly Reality Check (Numbers)</div>
                            <div class="row three">
                                <div class="field">
                                    <label>Monthly Income (Net)</label>
                                    <input asp-for="Young.Cashflow.NetIncome" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>Monthly Fixed Bills</label>
                                    <input asp-for="Young.Cashflow.FixedBills" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>Monthly Variable Spending</label>
                                    <input asp-for="Young.Cashflow.VariableSpending" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>

                            <div class="row three">
                                <div class="field">
                                    <label>Monthly Savings (if any)</label>
                                    <input asp-for="Young.Cashflow.MonthlySavings" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>Monthly Debt Payments</label>
                                    <input asp-for="Young.Cashflow.DebtPayments" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>“End of Month” Usually</label>
                                    <select asp-for="Young.Cashflow.EndOfMonth" class="form-select">
                                        <option value="">Select</option>
                                        <option>Money left over</option>
                                        <option>Break even</option>
                                        <option>Negative / behind</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="block">
                            <div class="block-title">Emergency Fund + “Oh No” Plan</div>

                            <div class="row two">
                                <div class="field">
                                    <label>Emergency Fund Amount</label>
                                    <input asp-for="Young.Emergency.Amount" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="field">
                                    <label>Months Covered</label>
                                    <input asp-for="Young.Emergency.Months" class="form-control" placeholder="Example: 0, 1, 3, 6" />
                                </div>
                            </div>


                            <div class="field">
                                <label>15) Do you ever use credit cards to survive the month?</label>
                                <select asp-for="Young.Emergency.UsesCreditToSurvive" class="form-select">
                                    <option value="">Select</option>
                                    <option>No</option>
                                    <option>Sometimes</option>
                                    <option>Often</option>
                                </select>
                            </div>

                            <div class="field">
                                <label>16) If an unexpected $1,000 expense hit this week, how would you pay it?</label>
                                <textarea asp-for="Young.Emergency.Unexpected1k" class="form-control ff-textarea-lg"></textarea>
                            </div>

                        </div>

                    </div>

                    <div class="wizard-actions">
                        <button type="button" class="btn btn-ghost" data-prev>Back</button>
                        <button type="button" class="btn btn-gold" data-next>Next</button>
                    </div>
                </div>
            </section>

            <!-- =========================================================
                 STEP 3 — DEBT + CREDIT
            ========================================================== -->
            <section class="wizard-step" data-step="3" data-label="Debt + Credit">
                <div class="section-card">
                    <div class="section-title">Part 3 — Debt, Credit & Major Decisions</div>
                    <div class="subtle">This step is about control. Debt can be a tool or a trap.</div>

                    <div class="stack">

                        <div class="block">
                            <div class="block-title">Debt Inventory</div>

                            <div class="mini-title">Debts</div>
                            <div class="subtle">Starts with one row. Add only what applies.</div>

                            @{
                                var ydCount = Model.Young?.Debt?.Count ?? 0;
                                var ydRender = Math.Max(1, ydCount);
                            }

                            <div id="debtListYoung">
                                @for (int i = 0; i < ydRender; i++)
                                {
                                    var d = (Model.Young?.Debt != null && Model.Young.Debt.Count > i)
                                        ? Model.Young.Debt[i]
                                        : null;

                                    <div class="table-like repeater-item">
                                        <div class="row five">
                                            <div class="field"><label>Type</label><input name="Young.Debt[@i].Type" value="@(d?.Type ?? "")" class="form-control" placeholder="Credit Card / Student / Auto / Personal / Other" /></div>
                                            <div class="field"><label>Balance</label><input name="Young.Debt[@i].Balance" value="@(d?.Balance?.ToString() ?? "")" type="number" step="0.01" class="form-control" /></div>
                                            <div class="field"><label>Rate</label><input name="Young.Debt[@i].Rate" value="@(d?.Rate ?? "")" class="form-control" placeholder="%" /></div>
                                            <div class="field"><label>Monthly Payment</label><input name="Young.Debt[@i].Payment" value="@(d?.Payment?.ToString() ?? "")" type="number" step="0.01" class="form-control" /></div>
                                            <div class="field"><label>Notes</label><input name="Young.Debt[@i].Notes" value="@(d?.Notes ?? "")" class="form-control" placeholder="Any notes" /></div>
                                        </div>

                                        <div class="repeater-actions">
                                            <button type="button" class="btn btn-gold" data-repeater-add="debtListYoung" data-template="tplYoungDebt">+ Add Debt</button>
                                            <button type="button" class="btn btn-danger btn-delete-row" data-repeater-del title="Delete">Delete</button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="field">
                                <label>18) Do you have a clear payoff plan, or is it “just paying what I can”?</label>
                                <textarea asp-for="Young.DebtNarrative.PayoffPlan" class="form-control ff-textarea-lg"></textarea>
                            </div>


                            <div class="mini-title">Credit</div>
                            <div class="row two">
                                <div class="field">
                                    <label>Do you know your credit score range?</label>
                                    <select asp-for="Young.Credit.KnowsScoreRange" class="form-select">
                                        <option value="">Select</option>
                                        <option>No</option>
                                        <option>Yes — 500–599</option>
                                        <option>Yes — 600–659</option>
                                        <option>Yes — 660–719</option>
                                        <option>Yes — 720–759</option>
                                        <option>Yes — 760+</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Have you had late payments in the last 24 months?</label>
                                    <select asp-for="Young.Credit.LatePayments" class="form-select">
                                        <option value="">Select</option>
                                        <option>No</option>
                                        <option>Yes</option>
                                        <option>Not sure</option>
                                    </select>
                                </div>
                            </div>

                            <div class="field">
                                <label>20) What major purchase are you aiming for next? (car, house, business, wedding, move, travel)</label>
                                <textarea asp-for="Young.Credit.NextMajorPurchase" class="form-control ff-textarea-lg"></textarea>
                            </div>
                        </div>

                        <div class="block">
                            <div class="block-title">Big Moves & Lifestyle</div>

                            <div class="field">
                                <label>21) Are you planning to buy a home in the next 1–3 years?</label>
                                <select asp-for="Young.Housing.PlanBuyHome" class="form-select">
                                    <option value="">Select</option>
                                    <option>No</option>
                                    <option>Yes</option>
                                    <option>Not sure</option>
                                </select>
                            </div>

                            <div class="field">
                                <label>If yes, what’s your target timeline and price range?</label>
                                <textarea asp-for="Young.Housing.TimelineAndRange" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="field">
                                <label>22) Are you planning marriage, kids, or a major life transition soon?</label>
                                <textarea asp-for="Young.LifeTransitions" class="form-control ff-textarea-lg"></textarea>
                            </div>


                        </div>

                    </div>

                    <div class="wizard-actions">
                        <button type="button" class="btn btn-ghost" data-prev>Back</button>
                        <button type="button" class="btn btn-gold" data-next>Next</button>
                    </div>
                </div>
            </section>

            <!-- =========================================================
                 STEP 4 — PROTECTION BASICS
            ========================================================== -->
            <section class="wizard-step" data-step="4" data-label="Protection Basics">
                <div class="section-card">
                    <div class="section-title">Part 4 — Protection Basics (Health, Life, Disability)</div>
                    <div class="subtle">Protection isn’t “extra” — it’s what keeps one event from resetting your life.</div>

                    <div class="stack">

                        <div class="block">
                            <div class="block-title">Health Coverage</div>

                            <div class="field">
                                <label>25) What health coverage do you currently have?</label>
                                <textarea asp-for="Young.Health.Coverage" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>Do you know your deductible?</label>
                                    <input asp-for="Young.Health.Deductible" class="form-control" placeholder="If known" />
                                </div>
                                <div class="field">
                                    <label>Do you know your out-of-pocket max?</label>
                                    <input asp-for="Young.Health.OOPMax" class="form-control" placeholder="If known" />
                                </div>
                            </div>

                            <div class="field">
                                <label>26) Have medical bills ever set you back financially?</label>
                                <textarea asp-for="Young.Health.MedicalBillsSetback" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="field">
                                <label>27) If a health event happened this year, how would you pay your bills?</label>
                                <textarea asp-for="Young.Health.HowPayBillsIfHealthEvent" class="form-control ff-textarea-lg"></textarea>
                            </div>
                        </div>

                        <div class="block">
                            <div class="block-title">Life + Disability (Foundation)</div>

                            <div class="row two">
                                <div class="field">
                                    <label>Do you have life insurance today?</label>
                                    <select asp-for="Young.Protection.HasLife" class="form-select">
                                        <option value="">Select</option>
                                        <option>No</option>
                                        <option>Yes — through work</option>
                                        <option>Yes — personal policy</option>
                                        <option>Yes — both</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>If yes, how much?</label>
                                    <input asp-for="Young.Protection.LifeAmount" class="form-control" placeholder="Approx. amount" />
                                </div>
                            </div>

                            <div class="field">
                                <label>28) If you died unexpectedly, who would be financially impacted and how?</label>
                                <textarea asp-for="Young.Protection.WhoImpactedIfDie" class="form-control ff-textarea-lg"></textarea>
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>Do you have disability coverage?</label>
                                    <select asp-for="Young.Protection.HasDI" class="form-select">
                                        <option value="">Select</option>
                                        <option>No</option>
                                        <option>Yes — through work</option>
                                        <option>Yes — personal</option>
                                        <option>Not sure</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>If you couldn’t work for 3 months, what happens?</label>
                                    <textarea asp-for="Young.Protection.IfCannotWork3Mo" class="form-control ff-textarea-lg"></textarea>
                                </div>
                            </div>


                        </div>

                    </div>

                    <div class="wizard-actions">
                        <button type="button" class="btn btn-ghost" data-prev>Back</button>
                        <button type="button" class="btn btn-gold" data-next>Next</button>
                    </div>
                </div>
            </section>

            <!-- =========================================================
                 STEP 5 — SAVINGS + INVESTING + NEXT STEP + SUBMIT
            ========================================================== -->
            <section class="wizard-step" data-step="5" data-label="Savings + Next Step">
                <div class="section-card">
                    <div class="section-title">Part 5 — Savings, Investing & Your Next Step</div>
                    <div class="subtle">This step moves you from “aware” to “intentional.”</div>

                    <div class="stack">

                        <div class="block">
                            <div class="block-title">Savings + Investing</div>

                            <div class="field">
                                <label>31) Do you currently save money consistently?</label>
                                <select asp-for="Young.Savings.SavesConsistently" class="form-select">
                                    <option value="">Select</option>
                                    <option>No</option>
                                    <option>Sometimes</option>
                                    <option>Yes</option>
                                </select>
                            </div>

                            <div class="row two">
                                <div class="field">
                                    <label>Where do you save today?</label>
                                    <input asp-for="Young.Savings.Where" class="form-control" placeholder="Savings / HYSA / Cash / Other" />
                                </div>
                                <div class="field">
                                    <label>Approx. total saved</label>
                                    <input asp-for="Young.Savings.TotalSaved" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>

                            <div class="field">
                                <label>32) Are you investing currently (401k, Roth IRA, brokerage, crypto, etc.)?</label>
                                <textarea asp-for="Young.Investing.CurrentInvesting" class="form-control ff-textarea-lg"></textarea>
                            </div>


                        </div>

                        <div class="block">
                            <div class="block-title">Ownership + Commitment (Action)</div>


                        </div>

                        <!-- Disclaimer + Submit -->
                        <div class="section-card ff-disclaimer-card">
                            <div class="block ff-disclaimer-block ff-no-collapse">
                                <div class="checkline ff-checkline-light">
                                    <input asp-for="Young.AcknowledgedDisclaimer"
                                           type="checkbox"
                                           class="form-check-input"
                                           id="disclaimerCheckboxYoung"
                                           required />
                                    <label for="disclaimerCheckboxYoung" class="form-check-label ack-text ff-checkline-label">
                                        I acknowledge that by submitting this form, I authorize the company/agent to contact me regarding this Fact Finder intake.<span class="req">*</span>
                                    </label>
                                </div>
                                <span asp-validation-for="Young.AcknowledgedDisclaimer" class="text-danger"></span>

                                <div class="wizard-actions ff-actions-top">
                                    <button type="button" class="btn btn-ghost" data-prev>Back</button>
                                    <button type="submit" class="btn btn-gold">Submit & Download PDF</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        </form>
    </div>

</div>

@* =========================
   REPEATER TEMPLATES
========================= *@
<template id="tplYoungDebt">
    <div class="table-like repeater-item">
        <div class="row five">
            <div class="field"><label>Type</label><input name="Young.Debt[__i__].Type" class="form-control" placeholder="Credit Card / Student / Auto / Personal / Other" /></div>
            <div class="field"><label>Balance</label><input name="Young.Debt[__i__].Balance" type="number" step="0.01" class="form-control" /></div>
            <div class="field"><label>Rate</label><input name="Young.Debt[__i__].Rate" class="form-control" placeholder="%" /></div>
            <div class="field"><label>Monthly Payment</label><input name="Young.Debt[__i__].Payment" type="number" step="0.01" class="form-control" /></div>
            <div class="field"><label>Notes</label><input name="Young.Debt[__i__].Notes" class="form-control" placeholder="Any notes" /></div>
        </div>

        <div class="repeater-actions">
            <button type="button" class="btn btn-gold" data-repeater-add="debtListYoung" data-template="tplYoungDebt">+ Add Debt</button>
            <button type="button" class="btn btn-danger btn-delete-row" data-repeater-del title="Delete">Delete</button>
        </div>
    </div>
</template>

<script>
    (function () {
        const root = document.getElementById('ffYoungApp');
        if (!root) return;

        const form = root.querySelector('#factFinderFormYoung');
        if (!form) return;

        const steps = Array.from(root.querySelectorAll('.wizard-step'));
        const total = steps.length;

        const stepNowEl = document.getElementById('ffStepNowYoung');
        const stepTotalEl = document.getElementById('ffStepTotalYoung');
        const stepLabelEl = document.getElementById('ffStepLabelYoung');
        const bar = document.getElementById('ffProgressBarYoung');

        const summaryHost = document.getElementById('ffErrorSummaryYoung');

        if (stepTotalEl) stepTotalEl.textContent = String(total);

        function currentStepIndex() {
            return steps.findIndex(s => s.classList.contains('active'));
        }

        function updateProgress(idx) {
            const stepNum = idx + 1;

            if (stepNowEl) stepNowEl.textContent = String(stepNum);

            const label = steps[idx].getAttribute('data-label') || '';
            if (stepLabelEl) stepLabelEl.textContent = label;

            const pct = Math.round((stepNum / total) * 100);
            if (bar) bar.style.width = pct + '%';

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showStep(idx) {
            steps.forEach((s, i) => s.classList.toggle('active', i === idx));
            updateProgress(idx);
            if (window.LegendFactFinderSections) {
                window.LegendFactFinderSections.sync(root);
            }
        }

        // -----------------------------
        // VALIDATION VISUAL HELPERS
        // -----------------------------
        function clearVisualErrors() {
            if (summaryHost) summaryHost.innerHTML = "";
            root.querySelectorAll('.ff-field-invalid').forEach(el => el.classList.remove('ff-field-invalid'));
            root.querySelectorAll('.ff-fix-tag').forEach(el => el.remove());
        }

        function getFieldLabel(el) {
            const field = el.closest('.field');
            if (!field) return "Field";
            const lbl = field.querySelector('label');
            return (lbl && lbl.textContent) ? lbl.textContent.replace('*', '').trim() : "Field";
        }

        function getStepLabel(el) {
            const stepEl = el.closest('.wizard-step');
            return (stepEl && stepEl.getAttribute('data-label')) ? stepEl.getAttribute('data-label') : "Form";
        }

        function markFieldInvalid(el, message) {
            const field = el.closest('.field') || el.closest('.checkline') || el.parentElement;
            if (!field) return;

            field.classList.add('ff-field-invalid');

            if (field.querySelector('.ff-fix-tag')) return;

            const tag = document.createElement('div');
            tag.className = 'ff-fix-tag';
            tag.textContent = message || 'Required — fix this';

            const label = field.querySelector('label');
            if (label && label.parentNode) {
                label.insertAdjacentElement('afterend', tag);
            } else {
                field.insertAdjacentElement('afterbegin', tag);
            }
        }

        function buildSummary(invalidEls) {
            if (!summaryHost) return;
            if (!invalidEls.length) { summaryHost.innerHTML = ""; return; }

            const items = invalidEls.map((el, idx) => {
                if (!el.id) el.id = "ff_invalid_young_" + idx;
                return { id: el.id, step: getStepLabel(el), label: getFieldLabel(el) };
            });

            summaryHost.innerHTML = `
                <div class="ff-error-summary">
                    <div class="title">
                        <div>Needs attention before submit</div>
                        <div class="count">${items.length}</div>
                    </div>
                    <ul>
                        ${items.map(i => `<li><a href="#${i.id}" data-jump="${i.id}">${i.step}: ${i.label}</a></li>`).join('')}
                    </ul>
                </div>
            `;

            summaryHost.querySelectorAll('a[data-jump]').forEach(a => {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    const id = a.getAttribute('data-jump');
                    const target = document.getElementById(id);
                    if (!target) return;

                    const stepEl = target.closest('.wizard-step');
                    if (stepEl) {
                        const idx = steps.indexOf(stepEl);
                        if (idx >= 0) showStep(idx);
                    }

                    setTimeout(() => {
                        target.scrollIntoView({ behavior: "smooth", block: "center" });
                        target.focus();
                    }, 80);
                });
            });
        }

        function getInvalidElements() {
            const all = Array.from(form.querySelectorAll("input, select, textarea"));
            return all.filter(el => !el.checkValidity());
        }

        function revealValidation() {
            clearVisualErrors();

            const invalidEls = getInvalidElements();
            invalidEls.forEach(el => markFieldInvalid(el, el.validationMessage || "Fix this field"));
            buildSummary(invalidEls);

            return invalidEls;
        }

        function focusFirstInvalid(invalidEls) {
            const firstInvalid = invalidEls[0];
            if (!firstInvalid) return;

            const stepEl = firstInvalid.closest('.wizard-step');
            if (stepEl) {
                const idx = steps.indexOf(stepEl);
                if (idx >= 0) showStep(idx);
            }

            setTimeout(() => {
                firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
                firstInvalid.focus();
            }, 80);
        }

        // -----------------------------
        // SERVER-SIDE (ModelState) ERROR REVEAL
        // -----------------------------
        function revealServerModelStateErrors() {
            const invalidInputs = Array.from(form.querySelectorAll('.input-validation-error'));

            const msgSpans = Array.from(form.querySelectorAll('span.field-validation-error, span.text-danger'))
                .filter(s => s && s.getAttribute('data-valmsg-for') && (s.textContent || '').trim().length > 0);

            msgSpans.forEach(sp => {
                const key = sp.getAttribute('data-valmsg-for');
                if (!key) return;
                const el = form.querySelector(`[name="${CSS.escape(key)}"]`);
                if (el && !invalidInputs.includes(el)) invalidInputs.push(el);
            });

            if (!invalidInputs.length) return;

            clearVisualErrors();

            invalidInputs.forEach(el => {
                let msg = el.validationMessage || "Fix this field";
                const name = el.getAttribute('name');
                if (name) {
                    const span = form.querySelector(`span[data-valmsg-for="${CSS.escape(name)}"]`);
                    if (span && (span.textContent || '').trim().length) msg = span.textContent.trim();
                }
                markFieldInvalid(el, msg);
            });

            buildSummary(invalidInputs);
            focusFirstInvalid(invalidInputs);
        }

        // -----------------------------
        // Repeater (Add/Delete) + Reindex
        // -----------------------------
        function getNextIndex(listEl) {
            const items = listEl.querySelectorAll('.repeater-item');
            return items.length;
        }

        function reindexList(listEl) {
            const items = Array.from(listEl.querySelectorAll('.repeater-item'));
            items.forEach((item, newIdx) => {
                item.querySelectorAll('input[name], select[name], textarea[name]').forEach(ctrl => {
                    const name = ctrl.getAttribute('name');
                    if (!name) return;
                    const updated = name.replace(/\[\d+\]/, '[' + newIdx + ']');
                    ctrl.setAttribute('name', updated);
                });
            });
        }

        function addRepeaterItem(listId, templateId) {
            const listEl = document.getElementById(listId);
            const tpl = document.getElementById(templateId);
            if (!listEl || !tpl) return;

            const idx = getNextIndex(listEl);
            const html = tpl.innerHTML.replace(/__i__/g, String(idx));
            const wrap = document.createElement('div');
            wrap.innerHTML = html.trim();
            const node = wrap.firstElementChild;
            if (!node) return;

            listEl.appendChild(node);
        }

        function ensureAtLeastOne(listEl, templateId) {
            const count = listEl.querySelectorAll('.repeater-item').length;
            if (count > 0) return;
            addRepeaterItem(listEl.id, templateId);
        }

        root.addEventListener('click', function (e) {
            const addBtn = e.target.closest('[data-repeater-add]');
            if (addBtn) {
                const listId = addBtn.getAttribute('data-repeater-add');
                const tplId = addBtn.getAttribute('data-template');
                addRepeaterItem(listId, tplId);
                return;
            }

            const delBtn = e.target.closest('[data-repeater-del]');
            if (delBtn) {
                const item = delBtn.closest('.repeater-item');
                const listEl = item ? item.parentElement : null;
                if (!item || !listEl) return;

                item.remove();
                reindexList(listEl);

                const map = {
                    debtListYoung: "tplYoungDebt"
                };

                const tplId = map[listEl.id];
                if (tplId) ensureAtLeastOne(listEl, tplId);

                return;
            }
        });

        // -----------------------------
        // Wizard nav (Next/Back)
        // -----------------------------
        root.addEventListener('click', function (e) {
            const nextBtn = e.target.closest('[data-next]');
            const prevBtn = e.target.closest('[data-prev]');
            if (!nextBtn && !prevBtn) return;

            const idx = currentStepIndex();
            const current = steps[idx];

            if (nextBtn) {
                const requiredFields = Array.from(current.querySelectorAll("input, select, textarea"))
                    .filter(el => el.hasAttribute("required"));

                const invalidCurrent = requiredFields.filter(el => !el.checkValidity());

                if (invalidCurrent.length) {
                    clearVisualErrors();
                    invalidCurrent.forEach(el => markFieldInvalid(el, el.validationMessage || "Required — fix this"));
                    buildSummary(invalidCurrent);
                    focusFirstInvalid(invalidCurrent);
                    return;
                }

                showStep(Math.min(idx + 1, total - 1));
            }

            if (prevBtn) {
                showStep(Math.max(idx - 1, 0));
            }
        });

        function sanitizeNumericInputs() {
            form.querySelectorAll("input[type='number']").forEach(function (el) {
                if (!el.value) return;

                let v = el.value.trim();
                if (/^\(.*\)$/.test(v)) v = "-" + v.slice(1, -1);
                v = v.replace(/[$,%\s,]/g, "");
                v = v.replace(/[^\d.-]/g, "");
                el.value = v;
            });
        }

        form.addEventListener('input', function (e) {
            const el = e.target;
            if (!el || !(el.matches("input, select, textarea"))) return;

            if (el.checkValidity()) {
                const field = el.closest('.field') || el.closest('.checkline') || el.parentElement;
                if (field) {
                    field.classList.remove('ff-field-invalid');
                    const tag = field.querySelector('.ff-fix-tag');
                    if (tag) tag.remove();
                }
            }
        });

        form.addEventListener('submit', function (event) {
            sanitizeNumericInputs();

            const checkbox = document.getElementById('disclaimerCheckboxYoung');
            if (checkbox && !checkbox.checked) {
                event.preventDefault();
                clearVisualErrors();
                markFieldInvalid(checkbox, "Required — acknowledge to proceed");
                buildSummary([checkbox]);

                alert('Please acknowledge the disclaimer to proceed.');
                checkbox.scrollIntoView({ behavior: "smooth", block: "center" });
                checkbox.focus();
                return;
            }
            // Per-step validation already ensured required fields are filled.
            // Server handles final validation before generating the PDF.
        });

        // Init wizard and reveal server-side errors
        showStep(0);
        setTimeout(revealServerModelStateErrors, 0);

    })();
</script>

</div>

</div>

@section Scripts {
    <script src="~/_content/Shared/js/legend-factfinder-shared.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
