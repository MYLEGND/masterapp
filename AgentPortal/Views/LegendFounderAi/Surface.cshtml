    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Shared/js/legend-modal.js" asp-append-version="true"></script>
    <script src="~/js/legend-founder-ai.js" asp-append-version="true"></script>
