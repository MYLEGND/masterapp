@{
    ViewData["Title"] = "Client Activity & Case History";
}
@section Styles { <link rel="stylesheet" href="~/css/crm-history.css" asp-append-version="true" /> }
<section class="history-workspace" id="crm-history" data-kind="@ViewData["Kind"]" data-relationship-id="@ViewData["RelationshipId"]" data-timezone="@ViewData["TimeZone"]" data-draft-scope="@ViewData["DraftScope"]">
    <header class="history-header">
        <div><p class="history-eyebrow">Relationship workspace</p><h1>Client Activity &amp; Case History</h1>
        <p id="history-subject" class="history-subject">@ViewData["RelationshipType"]: @ViewData["RelationshipName"]</p>
        <p class="history-caption">Internal relationship history · Note to Self</p></div>
        <button id="history-export" class="history-action" type="button">Export case history</button>
    </header>
    <form id="history-filters" class="history-filter-panel">
        @Html.AntiForgeryToken()
        <div class="history-filter-grid">
        <label class="history-field">Date range<select name="range" class="history-control"><option value="all">All time</option><option value="unknown">Unknown event date</option><option value="today">Today</option><option value="week">This week</option><option value="month">This month</option><option value="custom">Custom</option></select></label>
        <label class="history-field">Event type<select name="type" class="history-control"><option value="">All types</option>@foreach(var type in new[]{"FormSubmission","Note","Call","AttemptedCall","Meeting","Email","Message","Document","Milestone","FollowUp","Complaint","Addendum","Conversion"}) {<option>@type</option>}</select></label>
        <label class="history-field">Search internal history<input name="search" class="history-control" maxlength="200" /></label>
        <label class="history-field">Follow-ups<select name="obligations" class="history-control"><option value="">All records</option><option value="open">Open follow-ups / complaints</option><option value="overdue">Overdue follow-ups / complaints</option></select></label>
        </div>
        <details class="history-advanced"><summary>More filters <span>Dates, ownership &amp; evidence</span></summary><div class="history-filter-grid">
        <label class="history-field">From<input name="from" type="date" class="history-control" /></label>
        <label class="history-field">Through<input name="through" type="date" class="history-control" /></label>
        <label class="history-field">Group<select name="group" class="history-control"><option value="day">Day</option><option value="week">Week (Monday)</option><option value="month">Month</option><option value="none">None</option></select></label>
        <label class="history-field">Assigned owner<input name="owner" class="history-control" maxlength="450" /></label>
        <label class="history-field">Product<input name="product" class="history-control" maxlength="100" /></label>
        <label class="history-field">Case / application / policy<input name="caseReference" class="history-control" maxlength="200" /></label>
        <label class="history-field">Status<input name="status" class="history-control" maxlength="40" /></label>
        <label class="history-field">Evidence status<input name="evidence" class="history-control" maxlength="80" /></label>
        <label class="history-field">Time basis<select name="recordedTime" class="history-control"><option value="false">Event time</option><option value="true">Recorded time</option></select></label>
        </div></details>
        <div class="history-filter-actions"><button class="btn btn-primary">Apply filters</button> <button type="reset" class="history-action">Reset</button></div>
    </form>
    <div class="history-content-grid">
    <section class="history-timeline" aria-label="Case timeline">
    <div class="history-section-heading"><h2>Activity timeline</h2><span>Filed records</span></div>
    <p id="history-preservation-status" class="history-obligations" role="status"></p>
    <p id="history-status" role="status" aria-live="polite"></p>
    <div id="history-results" class="history-results"></div>
    <nav aria-label="History pages" class="history-pagination"><button id="history-previous" class="history-action">Previous</button> <button id="history-next" class="history-action">Next</button></nav>
    </section>
    <aside class="history-tools" aria-label="Case notes and evidence">
    <div class="history-section-heading"><h2>Case notes &amp; evidence</h2></div>
    <details class="history-tool"><summary>Log interaction <span>Notes, calls &amp; follow-ups</span></summary>
        <form id="history-interaction" class="history-form">
            <label>Type<select name="type" class="history-control">@foreach(var type in new[]{"Note","Call","AttemptedCall","Meeting","Email","Message","Document","Milestone","FollowUp","Complaint","Addendum","TaskCompleted","TaskCanceled"}) {<option>@type</option>}</select></label>
            <label>Date (leave blank if unknown)<input name="occurredDate" type="date" class="history-control" /></label>
            <label>Exact event time (UTC, if known; replaces date above)<input name="occurredUtc" type="datetime-local" class="history-control" /><small>Leave blank when only the date is known. Never estimate a missing time.</small></label>
            <label>Channel<input name="channel" class="history-control" maxlength="80" /></label>
            <label>Factual account<textarea name="account" class="history-control" rows="5" required maxlength="20000"></textarea></label>
            <label>Participants<input name="participants" class="history-control" maxlength="2000" /></label>
            <label>Direction<select name="direction" class="history-control"><option value="">Unknown / not applicable</option><option>Inbound</option><option>Outbound</option></select></label>
            <label>Outcome<textarea name="outcome" class="history-control" maxlength="4000"></textarea></label>
            <label>Next action<textarea name="nextAction" class="history-control" maxlength="4000"></textarea></label>
            <label>Case / application / policy<input name="caseReference" class="history-control" maxlength="200" /></label>
            <label>Product<input name="product" class="history-control" maxlength="100" /></label>
            <label>Follow-up owner<input name="assignedOwner" class="history-control" maxlength="450" value="@ViewData["AgentId"]" /></label>
            <label>Due time (UTC)<input name="dueUtc" type="datetime-local" class="history-control" /></label>
            <label>Evidence source (carrier, document or receipt name)<input name="evidenceSource" class="history-control" maxlength="500" /></label>
            <label>Protected source reference (no public file URLs)<input name="evidenceReference" class="history-control" maxlength="2000" /></label>
            <label>Evidence state<select name="evidenceState" class="history-control"><option>Evidence unavailable</option><option>Manual source reference</option><option>Human-reported source inspection</option><option>Later recollection</option></select></label>
            <p>Manual evidence is the recorder's account. It is not an independently captured client signature, carrier approval or active coverage.</p>
            <label>Related entry ID for addendum or follow-up<input name="relatedEntryId" class="history-control" /></label>
            <div><button class="btn btn-primary">File interaction</button></div>
        </form>
    </details>
    <details class="history-tool"><summary>Attach protected evidence</summary>
        <p>Upload an original PDF (maximum 20 MB). Each upload files an immutable version. A later version links to the original; it does not replace it. Identify missing pages or unavailable signature evidence explicitly.</p>
        <form id="history-evidence" class="history-form">
            <label>Original PDF<input type="file" name="file" accept="application/pdf,.pdf" class="history-control" required /></label>
            <label>Source<input name="source" class="history-control" required maxlength="500" /></label>
            <label>Completeness and limitations<textarea name="completeness" class="history-control" required maxlength="2000"></textarea></label>
            <label>Previous evidence entry ID (for a new version)<input name="previousVersion" class="history-control" /></label>
            <div><button class="history-action">File evidence version</button></div>
        </form>
    </details>
    <details class="history-tool"><summary>Correct a submission association</summary>
        <p>Open the current submission tile first, then choose the exact target relationship ID. No matching by name, email or phone is performed. The original submission and correction history are preserved.</p>
        <form id="history-association" class="history-form">
            <label>Submission ID<input name="submissionId" class="history-control" required /></label>
            <label>Target relationship<select name="targetKind" class="history-control"><option value="lead">Lead</option><option value="profile">Client profile</option></select></label>
            <label>Exact lead or client profile ID<input name="targetLeadId" class="history-control" required maxlength="100" /></label>
            <label>Reason<textarea name="reason" class="history-control" required maxlength="4000"></textarea></label>
            <div><button class="history-action">File association correction</button></div>
        </form>
    </details>
    <details class="history-tool"><summary>Unlinked owned submissions</summary><p>Only submissions with your existing verified ownership mapping appear here. Missing ownership is never inferred from matching contact information.</p><button id="history-unlinked-load" type="button" class="history-action">Load unlinked submissions</button><div id="history-unlinked-results"></div></details>
    @if (ViewData["MayManageHolds"] is true)
    {
        <a class="history-action my-3" href="/CrmHistory/Ownership">Review unresolved submission ownership</a>
        <details class="history-tool"><summary>Record preservation instruction</summary>
            <p>Records an attributed hold or release instruction. Releasing an instruction does not delete records or authorize disposition.</p>
            <form id="history-preservation" class="history-form">
                <label>Action<select name="release" class="history-control"><option value="false">Place preservation hold</option><option value="true">Record release of a hold</option></select></label>
                <label>Original hold ID (required for release)<input name="holdEntryId" class="history-control" /></label>
                <label>Instruction and basis<textarea name="reason" class="history-control" required maxlength="4000"></textarea></label>
                <div><button class="history-action">File preservation instruction</button></div>
            </form>
        </details>
    }
    </aside>
    </div>
    <dialog aria-labelledby="history-detail-title" id="history-detail" class="history-dialog"><button id="history-close" class="history-action">Close</button><h2 id="history-detail-title">Filed record</h2><div id="history-detail-content"></div></dialog>
</section>
@section Scripts { <script src="~/js/crm-history.js" asp-append-version="true"></script> }
