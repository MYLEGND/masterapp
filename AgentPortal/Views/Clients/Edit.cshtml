@model AgentPortal.Models.EditClientViewModel

@{
    Layout = "~/Views/Shared/_ClientWorkspaceLayout.cshtml";
    ViewData["Title"] = ViewData["Title"] ?? "Edit Client";

    var recordTypeLabel = Model?.RecordType == "BusinessClient" ? "Business Client" : (Model?.RecordType == "Client" ? "Client" : "Lead");
    var recordTypeHelp = Model?.HasPortalAccess == true
        ? "Switch between Lead, Client, and Business Client here. Existing portal access stays active after save."
        : "You can save this record as Lead, Client, or Business Client here. Choosing Client or Business Client will enable portal access on save.";
    var hasPortalAccess = Model?.HasPortalAccess == true;
    var childCount = Model?.Children?.Count ?? 0;

    ViewBag.ClientUserId = Model?.ClientUserId;
    ViewBag.ClientDisplayName = $"{Model?.FirstName} {Model?.LastName}".Trim();
    ViewBag.ClientRecordType = Model?.RecordType;

    var returnUrl =
        (string?)ViewBag.ReturnUrl
        ?? Context.Request.Query["returnUrl"].ToString()
        ?? Url.Action("Edit", "Clients", new { clientUserId = Model?.ClientUserId })
        ?? "/Clients";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-home-shared.css" asp-append-version="true" />
}

<main class="dashboard-page-shell client-create-page client-edit-page">
    <div class="client-create-shell">
    <div class="client-create-panel">
        <div class="client-create-header">
            <div>
                <div class="dashboard-eyebrow">Private client editing</div>
                <h2 class="client-create-title">Edit @recordTypeLabel</h2>
                <p class="client-create-subtitle">Update this record from the same client-ready experience used on the home hub, then return without opening the full CRM board.</p>
            </div>
            <a href="@returnUrl" class="client-create-button client-create-button-secondary">← Back</a>
        </div>

        <div class="client-create-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ClientUserId" />
                <input type="hidden" asp-for="IsDobLocked" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div asp-validation-summary="ModelOnly" class="client-create-summary text-danger"></div>

                <div class="client-edit-section client-edit-record-type-section">
                    <div class="client-edit-section-head">
                        <div>
                            <div class="client-create-section-title">Record Type</div>
                            <div class="client-edit-note">@recordTypeHelp</div>
                        </div>
                        <span class="client-edit-pill">@recordTypeLabel</span>
                    </div>
                    <div class="client-create-record-types">
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="Lead" />
                            <span>Lead</span>
                        </label>
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="Client" />
                            <span>Client</span>
                        </label>
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="BusinessClient" />
                            <span>Business Client</span>
                        </label>
                    </div>
                    <div class="client-edit-note client-edit-note-spaced">
                        @if (hasPortalAccess)
                        {
                            <text>Saving as Lead reclassifies the CRM bucket without deleting the existing portal login.</text>
                        }
                        else
                        {
                            <text>Saving as Client or Business Client will run the portal welcome flow after the record is updated.</text>
                        }
                    </div>
                    <span asp-validation-for="RecordType" class="text-danger client-create-validation"></span>
                </div>

                <div class="client-create-grid">
                    <div>
                        <label asp-for="FirstName" class="client-create-label"></label>
                        <input asp-for="FirstName" class="client-create-input" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="client-create-label"></label>
                        <input asp-for="LastName" class="client-create-input" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="client-create-label"></label>
                        <input asp-for="Email" class="client-create-input" autocomplete="email" inputmode="email" />
                        <span asp-validation-for="Email" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="Phone" class="client-create-label"></label>
                        <input asp-for="Phone" class="client-create-input" autocomplete="tel" inputmode="tel" />
                        <span asp-validation-for="Phone" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="MaritalStatus" class="client-create-label">Marital Status</label>
                        <select asp-for="MaritalStatus" class="client-create-input" id="MaritalStatus">
                            <option value="">-- Select --</option>
                            <option>Single</option>
                            <option>Married</option>
                            <option>Domestic Partnership</option>
                            <option>Divorced</option>
                            <option>Widowed</option>
                        </select>
                        <span asp-validation-for="MaritalStatus" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="DOB" class="client-create-label"></label>
                        @if (Model?.IsDobLocked == true)
                        {
                            <input asp-for="DOB" type="date" class="client-create-input" readonly />
                            <div class="client-edit-note client-edit-note-tight">DOB is locked because it has already been saved.</div>
                        }
                        else
                        {
                            <input asp-for="DOB" type="date" class="client-create-input" />
                            <div class="client-edit-note client-edit-note-tight">DOB is editable until it is saved the first time.</div>
                        }
                    </div>
                </div>

                <!-- Significant Other (conditional) -->
                <div id="soCard" class="client-edit-section client-edit-section-compact client-edit-section-spaced is-hidden">
                    <div class="client-edit-section-head">
                        <div>
                            <div class="client-create-section-title">Significant Other</div>
                            <div class="client-edit-note">Required for Married / Domestic Partnership.</div>
                        </div>
                        <span class="client-edit-pill">Required for this status</span>
                    </div>

                    <div class="client-create-grid">
                        <div>
                            <label asp-for="SignificantOtherFirstName" class="client-create-label">First Name</label>
                            <input asp-for="SignificantOtherFirstName" class="client-create-input" id="SignificantOtherFirstName" autocomplete="given-name" />
                            <span asp-validation-for="SignificantOtherFirstName" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherLastName" class="client-create-label">Last Name</label>
                            <input asp-for="SignificantOtherLastName" class="client-create-input" id="SignificantOtherLastName" autocomplete="family-name" />
                            <span asp-validation-for="SignificantOtherLastName" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherDOB" class="client-create-label">Date of Birth</label>
                            <input asp-for="SignificantOtherDOB" type="date" class="client-create-input" id="SignificantOtherDOB" />
                            <span asp-validation-for="SignificantOtherDOB" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherPhone" class="client-create-label">Phone</label>
                            <input asp-for="SignificantOtherPhone" class="client-create-input" autocomplete="tel" inputmode="tel" />
                            <span asp-validation-for="SignificantOtherPhone" class="text-danger client-create-validation"></span>
                        </div>

                        <div class="client-create-full">
                            <label asp-for="SignificantOtherEmail" class="client-create-label">Email</label>
                            <input asp-for="SignificantOtherEmail" class="client-create-input" autocomplete="email" inputmode="email" />
                            <span asp-validation-for="SignificantOtherEmail" class="text-danger client-create-validation"></span>
                        </div>
                    </div>
                </div>

                <div class="client-edit-section client-edit-section-compact client-edit-section-spaced">
                    <div class="client-edit-section-head">
                        <div>
                            <div class="client-create-section-title">Children</div>
                            <div class="client-edit-note">Shared household record.</div>
                        </div>
                        <button type="button" class="client-create-button client-create-button-secondary client-edit-button-small" id="addChildBtn">Add Child</button>
                    </div>

                    <div class="client-edit-child-list" id="childrenList" data-next-index="@childCount">
                        @for (var i = 0; i < childCount; i++)
                        {
                            <div class="client-edit-child-card" data-child-row>
                                <div class="client-edit-child-card-head">
                                    <div class="client-edit-child-title">Child</div>
                                    <button type="button" class="client-create-button client-create-button-secondary client-edit-button-small" data-remove-child>Remove</button>
                                </div>
                                <input asp-for="Children[i].Id" type="hidden" data-field="Id" />
                                <div class="client-create-grid">
                                    <div>
                                        <label asp-for="Children[i].FirstName" class="client-create-label">First Name</label>
                                        <input asp-for="Children[i].FirstName" class="client-create-input" autocomplete="off" data-field="FirstName" />
                                        <span asp-validation-for="Children[i].FirstName" class="text-danger client-create-validation" data-valmsg-field="FirstName"></span>
                                    </div>
                                    <div>
                                        <label asp-for="Children[i].LastName" class="client-create-label">Last Name</label>
                                        <input asp-for="Children[i].LastName" class="client-create-input" autocomplete="off" data-field="LastName" />
                                        <span asp-validation-for="Children[i].LastName" class="text-danger client-create-validation" data-valmsg-field="LastName"></span>
                                    </div>
                                    <div>
                                        <label asp-for="Children[i].DOB" class="client-create-label">Date of Birth</label>
                                        <input asp-for="Children[i].DOB" type="date" class="client-create-input" data-field="DOB" />
                                        <span asp-validation-for="Children[i].DOB" class="text-danger client-create-validation" data-valmsg-field="DOB"></span>
                                    </div>
                                    <div>
                                        <label asp-for="Children[i].Phone" class="client-create-label">Phone</label>
                                        <input asp-for="Children[i].Phone" class="client-create-input" autocomplete="tel" inputmode="tel" data-field="Phone" />
                                        <span asp-validation-for="Children[i].Phone" class="text-danger client-create-validation" data-valmsg-field="Phone"></span>
                                    </div>
                                    <div class="client-create-full">
                                        <label asp-for="Children[i].Email" class="client-create-label">Email</label>
                                        <input asp-for="Children[i].Email" class="client-create-input" autocomplete="email" inputmode="email" data-field="Email" />
                                        <span asp-validation-for="Children[i].Email" class="text-danger client-create-validation" data-valmsg-field="Email"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="client-edit-divider"></div>

                <div class="client-create-actions">
                    <button type="submit" class="client-create-button client-create-button-primary">Save Changes</button>
                    <a href="@returnUrl" class="client-create-button client-create-button-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const status = document.getElementById('MaritalStatus');
            const soCard = document.getElementById('soCard');

            const soFirst = document.getElementById('SignificantOtherFirstName');
            const soLast  = document.getElementById('SignificantOtherLastName');
            const soDob   = document.getElementById('SignificantOtherDOB');
            const childrenList = document.getElementById('childrenList');
            const addChildBtn = document.getElementById('addChildBtn');
            const form = childrenList?.closest('form');

            function needsSO(v) {
                if (!v) return false;
                v = v.toLowerCase();
                return v === 'married' || v === 'domestic partnership';
            }

            function applySO() {
                const v = status ? status.value : '';
                const required = needsSO(v);

                if (soCard) soCard.classList.toggle("is-hidden", !required);

                if (soFirst) soFirst.required = required;
                if (soLast)  soLast.required  = required;
                if (soDob)   soDob.required   = required;
            }

            function childTemplate(index) {
                return `
                    <div class="client-edit-child-card" data-child-row>
                        <div class="client-edit-child-card-head">
                            <div class="client-edit-child-title">Child</div>
                            <button type="button" class="client-create-button client-create-button-secondary client-edit-button-small" data-remove-child>Remove</button>
                        </div>
                        <input type="hidden" name="Children[${index}].Id" id="Children_${index}__Id" data-field="Id" />
                        <div class="client-create-grid">
                            <div>
                                <label class="client-create-label" for="Children_${index}__FirstName">First Name</label>
                                <input class="client-create-input" type="text" name="Children[${index}].FirstName" id="Children_${index}__FirstName" autocomplete="off" data-field="FirstName" />
                                <span class="text-danger client-create-validation" data-valmsg-for="Children[${index}].FirstName" data-valmsg-replace="true" data-valmsg-field="FirstName"></span>
                            </div>
                            <div>
                                <label class="client-create-label" for="Children_${index}__LastName">Last Name</label>
                                <input class="client-create-input" type="text" name="Children[${index}].LastName" id="Children_${index}__LastName" autocomplete="off" data-field="LastName" />
                                <span class="text-danger client-create-validation" data-valmsg-for="Children[${index}].LastName" data-valmsg-replace="true" data-valmsg-field="LastName"></span>
                            </div>
                            <div>
                                <label class="client-create-label" for="Children_${index}__DOB">Date of Birth</label>
                                <input class="client-create-input" type="date" name="Children[${index}].DOB" id="Children_${index}__DOB" data-field="DOB" />
                                <span class="text-danger client-create-validation" data-valmsg-for="Children[${index}].DOB" data-valmsg-replace="true" data-valmsg-field="DOB"></span>
                            </div>
                            <div>
                                <label class="client-create-label" for="Children_${index}__Phone">Phone</label>
                                <input class="client-create-input" type="tel" name="Children[${index}].Phone" id="Children_${index}__Phone" autocomplete="tel" inputmode="tel" data-field="Phone" />
                                <span class="text-danger client-create-validation" data-valmsg-for="Children[${index}].Phone" data-valmsg-replace="true" data-valmsg-field="Phone"></span>
                            </div>
                            <div class="client-create-full">
                                <label class="client-create-label" for="Children_${index}__Email">Email</label>
                                <input class="client-create-input" type="email" name="Children[${index}].Email" id="Children_${index}__Email" autocomplete="email" inputmode="email" data-field="Email" />
                                <span class="text-danger client-create-validation" data-valmsg-for="Children[${index}].Email" data-valmsg-replace="true" data-valmsg-field="Email"></span>
                            </div>
                        </div>
                    </div>`;
            }

            function reindexChildren() {
                if (!childrenList) return;
                childrenList.querySelectorAll('[data-child-row]').forEach((row, index) => {
                    row.querySelectorAll('[data-field]').forEach((input) => {
                        const field = input.getAttribute('data-field');
                        input.name = `Children[${index}].${field}`;
                        input.id = `Children_${index}__${field}`;
                    });
                    row.querySelectorAll('[data-valmsg-field]').forEach((span) => {
                        const field = span.getAttribute('data-valmsg-field');
                        span.setAttribute('data-valmsg-for', `Children[${index}].${field}`);
                    });
                    row.querySelectorAll('label[for]').forEach((label) => {
                        const field = label.getAttribute('for')?.split('__').pop() || '';
                        const target = row.querySelector(`[data-field="${field}"]`);
                        if (target) label.setAttribute('for', target.id);
                    });
                });
                childrenList.dataset.nextIndex = String(childrenList.querySelectorAll('[data-child-row]').length);
            }

            addChildBtn?.addEventListener('click', () => {
                if (!childrenList) return;
                const index = Number.parseInt(childrenList.dataset.nextIndex || '0', 10);
                childrenList.insertAdjacentHTML('beforeend', childTemplate(Number.isFinite(index) ? index : 0));
                reindexChildren();
            });

            childrenList?.addEventListener('click', (event) => {
                const remove = event.target.closest('[data-remove-child]');
                if (!remove) return;
                remove.closest('[data-child-row]')?.remove();
                reindexChildren();
            });

            if (status) {
                status.addEventListener('change', applySO);
                applySO();
            }
            form?.addEventListener('submit', reindexChildren);
            reindexChildren();
        })();
    </script>
}
