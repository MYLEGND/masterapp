@model AgentPortal.Models.CreateClientViewModel
@{
    var canSetFounderSubscriptionOptions = ViewData["CanSetFounderSubscriptionOptions"] is bool founderOptions && founderOptions;
    var customMinimum = canSetFounderSubscriptionOptions ? "0" : "50";
    var customAmountPlaceholder = canSetFounderSubscriptionOptions ? "0.00" : "50.00";
}

@{
    ViewData["Title"] = "Create Pipeline Record";

    // allows controller to redirect back to index with a target client
    var returnUrl = (string)(ViewBag.ReturnUrl ?? Context.Request.Query["returnUrl"].ToString() ?? Url.Action("Index", "Clients") ?? "/Clients");
    var conversionSourceName = (ViewData["ConversionSourceName"] as string ?? string.Empty).Trim();
    var emailErrors = ViewData.ModelState[nameof(Model.Email)]?.Errors;
    var blocked = emailErrors != null && emailErrors.Any(e => (e.ErrorMessage ?? "").Contains("BLOCKED", StringComparison.OrdinalIgnoreCase));
}

<main class="dashboard-page-shell client-create-page">
    <div class="client-create-shell">
    <div class="client-create-panel">
        <div class="client-create-header">
            <div>
                <div class="dashboard-eyebrow">Private client intake</div>
                <h2 class="client-create-title">Create Lead, Client, or Business Client</h2>
                <p class="client-create-subtitle">Open a new record from the home experience with the same client-ready look and a clean path back to the access hub.</p>
            </div>
            <a href="@returnUrl" class="client-create-button client-create-button-secondary">Back</a>
        </div>

        <div class="client-create-body">
            <form asp-action="Create" method="post" novalidate id="createClientForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="returnUrl" id="returnUrl" value="@returnUrl" />
                <input asp-for="SourceLeadClientUserId" type="hidden" />
                <input asp-for="SourceWorkstationLeadId" type="hidden" />

                @if (!string.IsNullOrWhiteSpace(conversionSourceName))
                {
                    <div class="client-create-section-copy" role="status">
                        Completing account setup for @conversionSourceName. Review the client type and subscription before creating access.
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="client-create-summary text-danger"></div>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div class="alert alert-danger client-create-validation-alert" role="alert">
                        @foreach (var entry in ViewData.ModelState)
                        {
                            foreach (var error in entry.Value.Errors)
                            {
                                <div>@(string.IsNullOrWhiteSpace(error.ErrorMessage) ? "Invalid input." : error.ErrorMessage)</div>
                            }
                        }
                    </div>
                }

                @if (blocked)
                {
                    <div class="client-create-blocked text-danger" role="alert">
                        Blocked for privacy: this email is already tied to an existing client profile.
                    </div>
                }

                <div class="client-create-section-shell">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">Record Type</div>
                        <p class="client-create-section-copy">Choose the workspace type first so required fields and downstream portal behavior stay aligned.</p>
                    </div>
                    <div class="client-create-record-types">
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="Lead" />
                            <span>Lead</span>
                        </label>
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="Client" />
                            <span>Client</span>
                        </label>
                        <label class="client-create-record-option">
                            <input asp-for="RecordType" type="radio" value="BusinessClient" />
                            <span>Business Client</span>
                        </label>
                    </div>
                    <span asp-validation-for="RecordType" class="text-danger client-create-validation"></span>
                </div>

                <div class="client-create-section client-create-section-shell">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">Client Details</div>
                        <p class="client-create-section-copy">Capture the primary contact information and household status used across the CRM and client workspace.</p>
                    </div>
                    <div class="client-create-grid">
                    <div>
                        <label asp-for="FirstName" class="client-create-label"></label>
                        <input asp-for="FirstName" class="client-create-input" autocomplete="given-name" data-client-required />
                        <span asp-validation-for="FirstName" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="client-create-label"></label>
                        <input asp-for="LastName" class="client-create-input" autocomplete="family-name" data-client-required />
                        <span asp-validation-for="LastName" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="client-create-label"></label>
                        <input asp-for="Email" class="client-create-input" autocomplete="email" inputmode="email" id="Email" data-client-required />
                        <span asp-validation-for="Email" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="Phone" class="client-create-label"></label>
                        <input asp-for="Phone" class="client-create-input" autocomplete="tel" inputmode="tel" />
                        <span asp-validation-for="Phone" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="DOB" class="client-create-label">Date of Birth</label>
                        <input asp-for="DOB" type="date" class="client-create-input" />
                        <span asp-validation-for="DOB" class="text-danger client-create-validation"></span>
                    </div>

                    <div>
                        <label asp-for="MaritalStatus" class="client-create-label">Marital Status</label>
                        <select asp-for="MaritalStatus" class="client-create-input" id="MaritalStatus">
                            <option value=""></option>
                            <option>Single</option>
                            <option>Married</option>
                            <option>Domestic Partnership</option>
                            <option>Divorced</option>
                            <option>Widowed</option>
                        </select>
                        <span asp-validation-for="MaritalStatus" class="text-danger client-create-validation"></span>
                    </div>
                </div>
                </div>

                <div id="soCard" class="client-create-section client-create-section-shell is-hidden">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">Significant Other</div>
                        <p class="client-create-section-copy">Required for married and domestic-partnership households so the client record opens with the right family context.</p>
                    </div>

                    <div class="client-create-grid">
                        <div>
                            <label asp-for="SignificantOtherFirstName" class="client-create-label">First Name</label>
                            <input asp-for="SignificantOtherFirstName" class="client-create-input" id="SignificantOtherFirstName" autocomplete="given-name" />
                            <span asp-validation-for="SignificantOtherFirstName" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherLastName" class="client-create-label">Last Name</label>
                            <input asp-for="SignificantOtherLastName" class="client-create-input" id="SignificantOtherLastName" autocomplete="family-name" />
                            <span asp-validation-for="SignificantOtherLastName" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherDOB" class="client-create-label">Date of Birth</label>
                            <input asp-for="SignificantOtherDOB" type="date" class="client-create-input" id="SignificantOtherDOB" />
                            <span asp-validation-for="SignificantOtherDOB" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label asp-for="SignificantOtherPhone" class="client-create-label">Phone</label>
                            <input asp-for="SignificantOtherPhone" class="client-create-input" autocomplete="tel" inputmode="tel" />
                            <span asp-validation-for="SignificantOtherPhone" class="text-danger client-create-validation"></span>
                        </div>

                        <div class="client-create-full">
                            <label asp-for="SignificantOtherEmail" class="client-create-label">Email</label>
                            <input asp-for="SignificantOtherEmail" class="client-create-input" autocomplete="email" inputmode="email" />
                            <span asp-validation-for="SignificantOtherEmail" class="text-danger client-create-validation"></span>
                        </div>
                    </div>
                </div>

                <div id="subscriptionCard" class="client-create-section client-create-section-shell is-hidden">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">Client Subscription</div>
                        <p class="client-create-section-copy">Portal clients can leave intake with an agent-scoped Client Portal subscription offer and activation invitation already prepared.</p>
                    </div>

                    <input asp-for="SubscriptionCurrency" type="hidden" value="USD" />

                    <div class="client-create-grid">
                        <div>
                            <label class="client-create-label" asp-for="SubscriptionPriceType">Monthly Tier</label>
                            <select asp-for="SubscriptionPriceType"
                                    class="client-create-input"
                                    id="SubscriptionPriceType"
                                    data-client-required>
                                <option value="">Select a subscription</option>
                                <option value="Fixed50">$50 / month</option>
                                <option value="Fixed75">$75 / month</option>
                                <option value="Fixed100">$100 / month</option>
                                <option value="Fixed150">$150 / month</option>
                                <option value="Custom">Custom</option>
                            </select>
                            <span asp-validation-for="SubscriptionPriceType" class="text-danger client-create-validation"></span>
                        </div>

                        <div id="subscriptionCustomAmountWrap" class="is-hidden">
                            <label class="client-create-label" asp-for="SubscriptionCustomMonthlyAmount">Custom Monthly Amount (USD)</label>
                            <input asp-for="SubscriptionCustomMonthlyAmount" class="client-create-input" id="SubscriptionCustomMonthlyAmount" type="number" min="@customMinimum" max="2500" step="0.01" placeholder="@customAmountPlaceholder" />
                            <span asp-validation-for="SubscriptionCustomMonthlyAmount" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label class="client-create-label" asp-for="SubscriptionBillingAnchorMode">Billing Anchor</label>
                            <select asp-for="SubscriptionBillingAnchorMode" class="client-create-input" id="SubscriptionBillingAnchorMode">
                                <option value="FirstOfMonth">1st of month</option>
                                <option value="FifteenthOfMonth">15th of month</option>
                                @if (canSetFounderSubscriptionOptions)
                                {
                                    <option value="SpecificDayOfMonth">Agent-selected day</option>
                                }
                            </select>
                            <span asp-validation-for="SubscriptionBillingAnchorMode" class="text-danger client-create-validation"></span>
                        </div>

                        @if (canSetFounderSubscriptionOptions)
                        {
                            <div id="subscriptionAnchorDayWrap" class="is-hidden">
                                <label class="client-create-label" asp-for="SubscriptionBillingAnchorDay">Agent-Selected Day</label>
                                <input asp-for="SubscriptionBillingAnchorDay" class="client-create-input" id="SubscriptionBillingAnchorDay" type="number" min="1" max="31" step="1" placeholder="15" />
                                <span asp-validation-for="SubscriptionBillingAnchorDay" class="text-danger client-create-validation"></span>
                            </div>
                        }

                        <div class="client-create-full">
                            <div class="client-create-section-copy">
                                @(canSetFounderSubscriptionOptions
                                    ? "Founder custom amounts can start at $0.00."
                                    : "Custom amounts start at $50.00.") Fixed tiers and billing anchors are enforced on the server.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="client-create-section client-create-section-shell" id="crmSeed">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">CRM</div>
                        <p class="client-create-section-copy">Seed relationship tracking details now if this record should land in a specific pipeline state the moment it is created.</p>
                    </div>

                    <div class="client-create-grid">
                        <div>
                            <label class="client-create-label" for="CrmStatus">CRM Status</label>
                            <select asp-for="CrmStatus" class="client-create-input" id="CrmStatus">
                                <option value="Lead">Lead</option>
                                <option value="Prospect">Prospect</option>
                                <option value="Active">Active Client</option>
                                <option value="Dormant">Inactive</option>
                            </select>
                        </div>

                        <div>
                            <label class="client-create-label" for="PipelineStage">Pipeline Stage</label>
                            <select asp-for="PipelineStage" class="client-create-input" id="PipelineStage">
                                <option value="NewLead">Lead</option>
                                <option value="Opportunities">Opportunities</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Client">Clients</option>
                                <option value="BusinessClient">Business Clients</option>
                                <option value="MeetingScheduled">Meeting Scheduled</option>
                                <option value="ProposalSent">Proposal Sent</option>
                                <option value="ApplicationStarted">Application Started</option>
                                <option value="Submitted">Submitted</option>
                                <option value="ClosedLost">Not Moving Forward</option>
                                <option value="Nurture">Nurture</option>
                            </select>
                        </div>

                        <div>
                            <label class="client-create-label" for="CrmPriority">Priority</label>
                            <select asp-for="CrmPriority" class="client-create-input" id="CrmPriority">
                                <option value="Low">Low</option>
                                <option value="Normal">Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>

                        <div>
                            <label class="client-create-label" for="CrmLastTouch">Last Touch</label>
                            <input asp-for="CrmLastTouch" type="date" class="client-create-input" id="CrmLastTouch" />
                            <span asp-validation-for="CrmLastTouch" class="text-danger client-create-validation"></span>
                        </div>

                        <div>
                            <label class="client-create-label" for="CrmNextDate">Next Action Date</label>
                            <input asp-for="CrmNextDate" type="date" class="client-create-input" id="CrmNextDate" />
                            <span asp-validation-for="CrmNextDate" class="text-danger client-create-validation"></span>
                        </div>

                        <div class="client-create-full">
                            <label class="client-create-label" for="CrmNextText">Next Action (what will you do?)</label>
                            <input asp-for="CrmNextText" type="text" class="client-create-input" id="CrmNextText" />
                            <span asp-validation-for="CrmNextText" class="text-danger client-create-validation"></span>
                        </div>

                        <div class="client-create-full">
                            <label class="client-create-label" for="CrmTags">Tags (comma separated)</label>
                            <input asp-for="CrmTags" type="text" class="client-create-input" id="CrmTags" />
                            <span asp-validation-for="CrmTags" class="text-danger client-create-validation"></span>
                        </div>

                        <div class="client-create-full">
                            <label class="client-create-label" for="CrmNotes">Relationship Notes</label>
                            <textarea asp-for="CrmNotes" class="client-create-input client-create-notes" id="CrmNotes"></textarea>
                            <span asp-validation-for="CrmNotes" class="text-danger client-create-validation"></span>
                        </div>
                    </div>

                    <div class="client-create-actions">
                        <button type="button" class="client-create-button" id="btnCrmTouchToday">Today for Last Touch</button>
                        <button type="button" class="client-create-button" id="btnCrmNextToday">Today for Next Action</button>
                        <button type="button" class="client-create-button" id="btnCrmClear">Clear CRM</button>
                    </div>
                </div>

                <div class="client-create-actions">
                    <button type="submit" class="client-create-button client-create-button-primary" id="submitCreateBtn">Create Lead</button>
                    <a href="@returnUrl" class="client-create-button client-create-button-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/clients-create.js" asp-append-version="true"></script>
}
