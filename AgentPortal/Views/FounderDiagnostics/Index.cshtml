@model IReadOnlyList<Domain.Entities.RuntimeDiagnosticIncident>
@{
    ViewData["Title"] = "Runtime diagnostics";
    var page = ViewData["Page"] as int? ?? 1;
    var batch = ViewData["Batch"] as Domain.Entities.FounderSoftwareRepairBatch;
    var completedBatches = ViewData["CompletedBatches"] as Domain.Entities.FounderSoftwareRepairBatch[] ?? [];
    var details = ViewData["Details"] as bool? == true;
}
<section class="container py-4">
    <h1>Runtime diagnostics</h1>
    <p>Sanitized runtime observations for Founder review. An observation does not prove a code defect. Review does not stage, merge, or publish a repair.</p>
    <p>Records expire after 30 days without another observation. Offline, startup, and fatal crashes may be missing.</p>
    <details class="mb-3">
        <summary>Capture coverage, limits and missing evidence</summary>
        <p>Server requests include elapsed middleware time through response serialization. Shared database capture distinguishes connection opening, command return and reader lifetime (including consumer work). HTTP timing ends at handler/header completion, not body consumption. Stage and dependency timings overlap; do not add them as separate wall-clock costs.</p>
        <p>Slow server samples begin at 10 seconds and are capped at one per minute per process. Each sample is at most 4 KiB, with 16 stage labels and four dependency kinds. Existing event admission and 30-day retention still apply. Public browser observations cannot assert server timing or verified cross-host revision.</p>
        <p>Missing evidence is unknown, not healthy. Before-host startup, uninstrumented workers, non-factory HTTP, network transfer after the middleware returns, provider internals, capture outages and fatal crashes may remain unobserved. Reader lifetime does not distinguish database wait from application decoding. Process counters reset on restart and are not fleet totals.</p>
        @if (ViewData["CaptureStatus"] is ValueTuple<long, long, long, DateTime?, long> status)
        {
            <p>Current Portal server-capture process: recorded @status.Item1; rate-limited @status.Item2; persistence failures @status.Item3; out-of-order/contending samples not retained @status.Item5; last recorded @(status.Item4?.ToString("u") ?? "none in this process"). Other hosts' capture loss is not observed by these local counters.</p>
        }
    </details>
    @if (!details)
    {
        <form method="get" class="mb-3" aria-label="Diagnostic observation filters">
            <label>Application <select name="app"><option value="">All</option>
                @foreach (var name in new[] { "AgentPortal", "ClientApp", "ParfaitApp", "ProtectWebsite" }) { <option value="@name" selected="@(ViewData["AppFilter"] as string == name)">@name</option> }
            </select></label>
            <label>Category <select name="category"><option value="">All</option>
                @foreach (var name in new[] { "Performance", "NetworkOrCapacity", "Network", "ExpectedCancellation", "SuspectedDefect", "Authentication" }) { <option value="@name" selected="@(ViewData["CategoryFilter"] as string == name)">@name</option> }
            </select></label>
            <button type="submit" class="btn btn-outline-secondary">Filter observations</button>
        </form>
    }
    @if (batch is not null)
    {
        <article class="card mb-3"><div class="card-body">
            <h2 class="h5">Repair batch · @batch.State</h2>
            <p>Source head: <code>@batch.HeadSha</code>. Pull request: @batch.PullRequestNumber</p>
            <p>Staging does not deploy. Publication requests the existing protected validation workflow; it does not bypass checks.</p>
            @if (batch.State == "Staged")
            {
                <details>
                    <summary>Review a focused GitHub validation run</summary>
                    <p>Use the exact patch digest and trusted workflow revision from the prepared validation manifest. This action does not deploy.</p>
                    <form asp-action="ReviewCandidateValidation" method="get">
                        <input type="hidden" name="pullRequestNumber" value="@batch.PullRequestNumber" />
                        <input type="hidden" name="headSha" value="@batch.HeadSha" />
                        <input type="hidden" name="baseSha" value="@batch.BaseSha" />
                        <label>Patch SHA-256 <input name="patchSha256" pattern="[0-9a-f]{64}" maxlength="64" required /></label>
                        <label>Trusted workflow commit <input name="trustedWorkflowSha" pattern="[0-9a-f]{40}" maxlength="40" required /></label>
                        <button type="submit" class="btn btn-outline-primary">Review exact validation</button>
                    </form>
                </details>
                <form asp-action="PublishBatch" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pullRequestNumber" value="@batch.PullRequestNumber" />
                    <input type="hidden" name="headSha" value="@batch.HeadSha" />
                    <label><input type="checkbox" name="confirmed" value="true" required /> I approve validation and publication of this exact reviewed batch.</label>
                    <button type="submit" class="btn btn-primary">Publish batch</button>
                </form>
            }
            else if (batch.State == "Empty") { <p>No patch is staged. A reviewed proposal can start this new batch without changing earlier preview branches.</p> }
            else { <p>Further writes remain locked. Refresh status to inspect remote observations; this does not retry or unlock an uncertain operation.</p> }
            @if (batch.State == "ValidationRequested")
            {
                <form asp-action="ArchiveDeployedBatch" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pullRequestNumber" value="@batch.PullRequestNumber" />
                    <input type="hidden" name="headSha" value="@batch.HeadSha" />
                    <input type="hidden" name="expectedRevision" value="@batch.Revision" />
                    <p>Archive requires matching merged source, protected workflow success, covered web projects, and the actual running source on every configured host. Native and unconfigured project changes cannot be archived here.</p>
                    <label><input type="checkbox" name="confirmed" value="true" required /> Verify this web rollout and start a new batch if verification succeeds. This does not confirm that a reported defect is fixed.</label>
                    <button type="submit" class="btn btn-outline-primary">Verify web deployment and archive batch</button>
                </form>
            }
            <form asp-action="RefreshBatchStatus" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Refresh remote batch status</button>
            </form>
            @if (ViewData["BatchObservation"] is string observation)
            {
                <p>Read-only observations. Successful deployment is not verified by this status refresh.</p>
                <pre>@observation</pre>
            }
        </div></article>
    }
    @if (ViewData["BatchCompletion"] is string completion) { <pre>@completion</pre> }
    @if (completedBatches.Length > 0)
    {
        <section aria-label="Verified web deployment history">
            <h2 class="h5">Web deployment archive</h2>
            <p>These records describe source verification at the recorded time. Functional fixes and current running revisions require separate evidence. Diagnostic reviews and recurrence remain unchanged.</p>
            @foreach (var completed in completedBatches)
            {
                <article class="card mb-3"><div class="card-body">
                    <p>Pull request @completed.PullRequestNumber · verified @completed.CompletionVerifiedUtc?.ToString("u") · workflow run @completed.DeploymentRunId</p>
                    <p>Merged source: <code>@completed.MergedSha</code> · tree: <code>@completed.DeployedTreeSha</code></p>
                    <details><summary>Verified host scope</summary><pre>@completed.DeploymentEvidenceJson</pre></details>
                </div></article>
            }
        </section>
    }
    @if (Model.Count == 0)
    {
        <p>No retained observations are available.</p>
    }
    @foreach (var item in Model)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h2 class="h5"><a asp-action="Details" asp-route-id="@item.Id">@item.AppIdentifier · @item.Platform · @item.ErrorName</a></h2>
                <p>@item.Summary</p>
                <dl class="row">
                    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@item.Category</dd>
                    <dt class="col-sm-3">Review</dt><dd class="col-sm-9">@(item.Disposition == "ConfirmedDefect" ? "Founder-confirmed — not independently reproduced by this system" : item.Disposition)</dd>
                    <dt class="col-sm-3">Route pattern</dt><dd class="col-sm-9"><code>@item.Route</code></dd>
                    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@item.StatusCode</dd>
                    <dt class="col-sm-3">Occurrences</dt><dd class="col-sm-9">@item.Occurrences</dd>
                    <dt class="col-sm-3">Last received UTC</dt><dd class="col-sm-9">@item.LastSeenUtc.ToString("u")</dd>
                    <dt class="col-sm-3">Release correlation</dt><dd class="col-sm-9">@(item.ReleaseVerified ? "Server assembly metadata" : "Unverified client claim or unavailable") <code>@item.GitCommitHash</code></dd>
                </dl>
                @{ var sample = AgentPortal.Models.RuntimeDiagnosticPerformanceView.Read(item.PerformanceEvidenceJson); }
                @if (sample is not null)
                {
                    <section aria-label="Retained performance sample" class="border rounded p-3 mb-3">
                        <h3 class="h6">Latest retained performance sample</h3>
                        <dl class="row">
                            <dt class="col-sm-3">Sample UTC</dt><dd class="col-sm-9">@sample.SampledUtc.ToString("u") (not necessarily the last occurrence)</dd>
                            <dt class="col-sm-3">Elapsed / outcome</dt><dd class="col-sm-9">@sample.Evidence.ElapsedMs ms · @sample.Evidence.Outcome.Replace('_', ' ')</dd>
                            <dt class="col-sm-3">Largest measured stage</dt><dd class="col-sm-9">@(sample.LargestStage is { } stage ? $"{stage.Stage.Replace('_', ' ')}: {stage.ElapsedMs} ms" : "Not observed")</dd>
                            <dt class="col-sm-3">Largest dependency aggregate</dt><dd class="col-sm-9">@(sample.LargestDependency is { } dependency ? $"{dependency.Kind.Replace('_', ' ')}: {dependency.ElapsedMs} ms across {dependency.Count} calls, {dependency.FailedCount} failed" : "Not observed")</dd>
                            <dt class="col-sm-3">Observed boundaries</dt><dd class="col-sm-9">@(sample.Evidence.InstrumentedBoundaries.Count > 0 ? string.Join(", ", sample.Evidence.InstrumentedBoundaries.Select(x => x.Replace('_', ' '))) : "None")</dd>
                            <dt class="col-sm-3">Missing boundaries</dt><dd class="col-sm-9">@(sample.MissingBoundaries.Length > 0 ? string.Join(", ", sample.MissingBoundaries.Select(x => x.Replace('_', ' '))) : "None of the declared boundaries; other platform gaps still apply")</dd>
                            <dt class="col-sm-3">Completeness</dt><dd class="col-sm-9">@(sample.Evidence.Truncated ? "Truncated — incomplete sample" : "Bounded sample; absence of a metric is not healthy proof")</dd>
                        </dl>
                        <p>Measured stages and dependencies overlap and are not causal attribution. Do not add them as independent wall-clock costs. Reader lifetime includes consumer work; HTTP ends at handler/headers.</p>
                        <details><summary>Encoded evidence and observed trace</summary>
                            <p>App/revision are bound to this incident. Trace may be inherited from a caller and never establishes identity or authorization.</p>
                            <pre>@item.PerformanceEvidenceJson</pre>
                        </details>
                    </section>
                }
                else { <p>No readable retained performance sample (historical, uninstrumented, suppressed, unsupported, or unavailable); no healthy result is inferred.</p> }
                @if (item.Recurred) { <p>Observed again after manual closure. A successful repair has not been verified.</p> }
                @if (details)
                {
                    <p>Version: @item.AppVersion</p>
                    <p>Source: <code>@item.SourceFilePath</code></p>
                    @if (!string.IsNullOrWhiteSpace(item.StackTrace)) { <pre>@item.StackTrace</pre> }
                    <p>Server-observed correlation (not identity proof): <code>@item.CorrelationId</code></p>
                    <p><a asp-action="RepairContext" asp-route-id="@item.Id">Open sanitized repair context</a></p>
                    @if (item.Disposition == "ConfirmedDefect")
                    {
                        <details><summary>Review and stage a prepared repair</summary>
                            <p>No paid analysis runs automatically. Supply a reviewed proposal with baseSha, title, summary, and changes (path/content). Only bounded existing source files are eligible; sensitive changes require the normal engineering review.</p>
                            <form asp-action="StagePatch" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <label for="proposal-@item.Id">Exact proposed file changes</label>
                                <textarea id="proposal-@item.Id" name="proposalJson" maxlength="200000" rows="12" class="form-control" required></textarea>
                                <label><input type="checkbox" name="confirmed" value="true" required /> I reviewed this exact source proposal and approve staging only.</label>
                                <button type="submit" class="btn btn-primary">Apply patch to staging</button>
                            </form>
                        </details>
                    }
                    <form asp-action="Disposition" asp-route-id="@item.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reviewVersion" value="@item.ReviewVersion" />
                        <label for="disposition-@item.Id">Disposition</label>
                        <select id="disposition-@item.Id" name="disposition" class="form-select">
                            <option value="Observed" selected="@(item.Disposition == "Observed")">Needs review</option>
                            <option value="ConfirmedDefect" selected="@(item.Disposition == "ConfirmedDefect")">Founder-confirmed defect</option>
                            <option value="Dismissed" selected="@(item.Disposition == "Dismissed")">Dismissed</option>
                            <option value="ManuallyClosed" selected="@(item.Disposition == "ManuallyClosed")">Manually closed (repair not verified)</option>
                        </select>
                        <div class="form-check my-2">
                            <input type="checkbox" name="confirmDefect" value="true" id="confirm-@item.Id" class="form-check-input" />
                            <label for="confirm-@item.Id" class="form-check-label">I have independently confirmed a code defect.</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Save review</button>
                    </form>
                }
            </div>
        </article>
    }
    <nav aria-label="Diagnostic pages">
        @if (details) { <a asp-route="FounderDiagnosticsIndex">All observations</a> }
        else
        {
            @if (page > 1) { <a asp-route="FounderDiagnosticsIndex" asp-route-page="@(page - 1)" asp-route-app="@(ViewData["AppFilter"] as string)" asp-route-category="@(ViewData["CategoryFilter"] as string)">Previous</a> }
            @if (ViewData["HasMore"] as bool? == true) { <a asp-route="FounderDiagnosticsIndex" asp-route-page="@(page + 1)" asp-route-app="@(ViewData["AppFilter"] as string)" asp-route-category="@(ViewData["CategoryFilter"] as string)">Next</a> }
        }
    </nav>
</section>
