@{
    ViewData["Title"] = "Partners";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Preserve named directory entries. A destination must be verified before
    // this page presents it as a partner link; carrier login placeholders were invalid.
    var contacts = new[]
    {
        new { Name = "Bryan Fobs", Category = "Mental Health", Description = "Contact details awaiting verification" },
        new { Name = "Bryan Fobbs", Category = "Physical Health", Description = "Contact details awaiting verification" },
        new { Name = "Kirk Quitno", Category = "Financial Health", Description = "Disability Insurance Specialist" },
        new { Name = "Darren Johnson", Category = "Financial Health", Description = "Real Estate Agent / Broker / Mortgage Lender" }
    };
}
<div class="container py-4">
    <h1>Partner Directory</h1>
    <p>Partner contact details are being verified. Verified destinations will appear here when available.</p>
    <div class="row g-3">
        @foreach (var contact in contacts)
        {
            <div class="col-12 col-md-6">
                <section class="card h-100">
                    <div class="card-body">
                        <p class="mb-1">@contact.Category</p>
                        <h2 class="h5">@contact.Name</h2>
                        <p>@contact.Description</p>
                        <span>Contact link unavailable</span>
                    </div>
                </section>
            </div>
        }
    </div>
</div>
