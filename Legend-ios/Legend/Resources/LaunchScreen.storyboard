<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB"
          version="3.0"
          toolsVersion="24132"
          targetRuntime="iOS.CocoaTouch"
          propertyAccessControl="none"
          useAutolayout="YES"
          launchScreen="YES"
          useTraitCollections="YES"
          colorMatched="YES"
          initialViewController="VC-LAUNCH">

    <device id="retina6_12" orientation="portrait" appearance="light"/>

    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24122"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
    </dependencies>

    <scenes>
        <scene sceneID="SCENE-LAUNCH">
            <objects>
                <viewController id="VC-LAUNCH" sceneMemberID="viewController">
                    <view key="view"
                          contentMode="scaleToFill"
                          id="VIEW-LAUNCH">

                        <rect key="frame"
                              x="0.0"
                              y="0.0"
                              width="393"
                              height="852"/>

                        <autoresizingMask key="autoresizingMask"
                                          widthSizable="YES"
                                          heightSizable="YES"/>

                        <subviews>
                            <imageView clipsSubviews="YES"
                                       userInteractionEnabled="NO"
                                       contentMode="scaleAspectFit"
                                       image="LegendLogo"
                                       translatesAutoresizingMaskIntoConstraints="NO"
                                       id="IMAGE-LEGEND-LOGO">

                                <rect key="frame"
                                      x="20"
                                      y="249.5"
                                      width="353"
                                      height="353"/>
                            </imageView>
                        </subviews>

                        <viewLayoutGuide key="safeArea"
                                         id="SAFE-AREA"/>

                        <color key="backgroundColor"
                               red="1"
                               green="1"
                               blue="1"
                               alpha="1"
                               colorSpace="custom"
                               customColorSpace="sRGB"/>

                        <constraints>
                            <constraint firstItem="IMAGE-LEGEND-LOGO"
                                        firstAttribute="centerX"
                                        secondItem="VIEW-LAUNCH"
                                        secondAttribute="centerX"
                                        id="CENTER-X"/>

                            <constraint firstItem="IMAGE-LEGEND-LOGO"
                                        firstAttribute="centerY"
                                        secondItem="VIEW-LAUNCH"
                                        secondAttribute="centerY"
                                        id="CENTER-Y"/>

                            <constraint firstItem="IMAGE-LEGEND-LOGO"
                                        firstAttribute="width"
                                        secondItem="VIEW-LAUNCH"
                                        secondAttribute="width"
                                        multiplier="0.90"
                                        id="LOGO-WIDTH"/>

                            <constraint firstItem="IMAGE-LEGEND-LOGO"
                                        firstAttribute="height"
                                        secondItem="IMAGE-LEGEND-LOGO"
                                        secondAttribute="width"
                                        id="LOGO-ASPECT"/>
                        </constraints>
                    </view>
                </viewController>

                <placeholder placeholderIdentifier="IBFirstResponder"
                             id="FIRST-RESPONDER"
                             sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>

    <resources>
        <image name="LegendLogo" width="1024" height="1024"/>
    </resources>
</document>
