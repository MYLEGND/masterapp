<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the restoring SDK's own NuGet format implementation, without
         introducing another dependency resolver or external package restore. -->
    <Reference Include="$(MSBuildSDKsPath)/../NuGet.*.dll" />
    <Reference Include="$(MSBuildSDKsPath)/../System.Security.Cryptography.Pkcs.dll" />
  </ItemGroup>
</Project>
