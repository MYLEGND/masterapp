@model Shared.Crm.BusinessTrainingCohort
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Training relationship"; var contact = Model.Contacts.Single(); }
<link rel="stylesheet" href="~/css/clients-index.css" asp-append-version="true" />
<div class="wrap density-comfort action-list-shell">
    <a class="action-inline-btn" href="/business/@Model.BusinessId/leads">Back to business contacts</a>
    <header class="actions-hub-toolbar">
        <div class="actions-hub-toolbar-copy">
            <h1>@contact.Name</h1>
            <p class="action-related">@contact.Email · @contact.Phone</p>
        </div>
        <span class="status-pill @(contact.HasPaid ? "status-completed" : "status-planned")">@(contact.HasPaid ? "Paid customer" : "Enrollment")</span>
    </header>
    <h2>Training terms</h2>
    <div class="action-table-wrap">
        <table class="action-table">
            <thead><tr><th scope="col">Plan</th><th scope="col">Status</th></tr></thead>
            <tbody>
            @foreach (var term in contact.Terms)
            {
                <tr>
                    <td><span class="action-title">@term.Plan</span><div class="action-related">@term.Currency @((term.MonthlyAmountCents / 100m).ToString("N2"))/month</div></td>
                    <td><span class="status-pill status-neutral">@(term.SubscriptionStatus ?? term.OfferStatus)</span><div class="action-related">Offer: @term.OfferStatus</div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
