@model Shared.Crm.BusinessTrainingCohort
@if (Model.Total > 0 || Model.Search.Length > 0)
{
<section class="action-list-shell" aria-label="Training relationships">
    <div class="actions-hub-toolbar">
        <div class="actions-hub-toolbar-copy">
            <h2>Training</h2>
            <span class="action-related">@Model.Total matching contacts · @Model.PaidCustomers paid customers, all time</span>
            @foreach (var amount in Model.NetCollectedMinor)
            { <span class="action-related">Net collected · @amount.Key @((amount.Value / 100m).ToString("N2"))</span> }
            @if (Model.UnsettledPayments > 0)
            { <span class="status-pill status-blocked">@Model.UnsettledPayments payments under review</span> }
        </div>
        <form method="get" class="action-inline-form">
            <label>Find contact <input name="search" value="@Model.Search" placeholder="Name, email or phone" /></label>
            <button class="btn btn-ghost" type="submit">Search</button>
        </form>
    </div>
    <div class="action-table-wrap">
    <table class="action-table">
        <thead><tr><th scope="col">Contact</th><th scope="col">Training status</th></tr></thead>
        <tbody>
        @foreach (var contact in Model.Contacts)
        {
            <tr><td><a class="action-title" href="/business/@Model.BusinessId/training/@contact.ProfileId">@contact.Name</a>
                <div class="action-related">@contact.Email · @contact.Phone</div></td>
                <td><span class="status-pill @(contact.HasPaid ? "status-completed" : "status-planned")">@(contact.HasPaid ? "Paid customer" : "Enrollment")</span></td></tr>
        }
        @if (Model.Contacts.Count == 0) { <tr><td colspan="2">No matching training contacts.</td></tr> }
        </tbody>
    </table>
    </div>
    <nav class="action-controls-inline" aria-label="Training contacts pages">
        @if (Model.Page > 1) { <a class="action-inline-btn" href="?search=@Uri.EscapeDataString(Model.Search)&amp;page=@(Model.Page-1)">Previous</a> }
        @if (Model.Page * 50 < Model.Total) { <a class="action-inline-btn" href="?search=@Uri.EscapeDataString(Model.Search)&amp;page=@(Model.Page+1)">Next</a> }
    </nav>
</section>
}
