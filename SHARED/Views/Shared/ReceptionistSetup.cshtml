@model Shared.Analytics.ReceptionistSetupPage
@using System.Globalization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Receptionist settings";
    var settings = Model.Input;
    var snapshot = Model.Snapshot;
    var accounting = Model.OperatingSnapshot?.Accounting;
    var recordedCurrency = Model.OperatingSnapshot?.Configuration?.Currency ?? "currency unknown";
    var readiness = Model.Readiness ?? new Shared.Analytics.ReceptionistReadinessProjection();
    string Amount(decimal value) => value.ToString(CultureInfo.InvariantCulture);
}
<section class="dashboard-page-shell py-4">
    <header class="dashboard-surface-panel p-3 mb-4">
        <div class="dashboard-hero-copy">
            <div><a class="btn btn-clear-search dashboard-command-action" href="@Model.ReturnUrl">Back to your workspace</a></div>
            <h1 class="dashboard-hero-title mt-3">Receptionist settings</h1>
            <p class="dashboard-section-copy">Choose how your receptionist answers callers, which services it can discuss, and the limits it must respect.</p>
            @if (Model.Message is not null)
            { <p class="dashboard-section-copy" role="status">@Model.Message</p> }
        </div>
    </header>
    <section class="dashboard-surface-panel p-3 mb-4" aria-labelledby="receptionist-call-status">
        <h2 class="dashboard-section-title mb-3" id="receptionist-call-status">Call status</h2>
        <dl class="row mb-2">
            <dt class="dashboard-stat-label col-sm-4">Owner permission</dt><dd class="col-sm-8">@(readiness.OwnerPermissionEnabled is true ? "Allowed when ready" : readiness.OwnerPermissionEnabled is false ? "Paused" : "Unknown — reload to verify")</dd>
            <dt class="dashboard-stat-label col-sm-4">Call readiness</dt><dd class="col-sm-8">@readiness.CallReadiness</dd>
            <dt class="dashboard-stat-label col-sm-4">Control-plane runtime</dt><dd class="col-sm-8">@readiness.RuntimeState</dd>
            <dt class="dashboard-stat-label col-sm-4">Editable settings version</dt><dd class="col-sm-8">@(snapshot.ConfigurationId.HasValue ? $"Version {snapshot.ConfigurationVersion}" : "No saved version")</dd>
            <dt class="dashboard-stat-label col-sm-4">Operating version</dt><dd class="col-sm-8">@(readiness.OperatingConfigurationVersion is { } operatingVersion ? $"Version {operatingVersion}" : readiness.BindingScope == "unaccepted" ? "No accepted operating configuration" : "Unknown — reload to verify")</dd>
            <dt class="dashboard-stat-label col-sm-4">Accepted binding scope</dt><dd class="col-sm-8">@readiness.BindingScope.Replace('_', ' ')</dd>
            <dt class="dashboard-stat-label col-sm-4">Application test window</dt><dd class="col-sm-8">@readiness.ApplicationWindowState.Replace('_', ' ')</dd>
            <dt class="dashboard-stat-label col-sm-4">Observed admission check</dt><dd class="col-sm-8">@readiness.AdmissionReason.Replace('_', ' ')</dd>
            <dt class="dashboard-stat-label col-sm-4">Current carrier route</dt><dd class="col-sm-8">@readiness.CarrierRouteState; @(readiness.CarrierRouteObservedUtc?.ToString("u") ?? "no verified observation")</dd>
            <dt class="dashboard-stat-label col-sm-4">Restricted AI call acceptance</dt><dd class="col-sm-8">@readiness.RestrictedAiAcceptanceState</dd>
            <dt class="dashboard-stat-label col-sm-4">Public AI call acceptance</dt><dd class="col-sm-8">@readiness.PublicAiAcceptanceState</dd>
            <dt class="dashboard-stat-label col-sm-4">Open call records</dt><dd class="col-sm-8">@(readiness.OpenCalls?.ToString() ?? "unknown")</dd>
            <dt class="dashboard-stat-label col-sm-4">Open without a current stop condition</dt><dd class="col-sm-8">@(readiness.OpenCallsWithoutStopCondition?.ToString() ?? "unknown") — not verified live call activity</dd>
            <dt class="dashboard-stat-label col-sm-4">Awaiting stop or provider closure</dt><dd class="col-sm-8">@(readiness.AwaitingStopOrClosure?.ToString() ?? "unknown")</dd>
            <dt class="dashboard-stat-label col-sm-4">Observed at (UTC)</dt><dd class="col-sm-8">@(readiness.ObservedUtc?.ToString("u") ?? "unknown")</dd>
        </dl>
        <p class="dashboard-section-copy mb-3">Owner permission is not runtime readiness. A valid application test window is not proof of a restricted carrier route or successful two-way AI audio. These read-only observations do not reserve capacity; every incoming call is checked again.</p>
        @if (accounting is not null && readiness.OwnerPermissionEnabled is not null)
        {
            <p class="dashboard-section-copy mb-3">Owner-account snapshot — recorded amounts, not current call funding eligibility.<br />
            Cash committed: @accounting.CashCommitted.ToString("0.00") @recordedCurrency; reserved for unresolved calls: @accounting.CashReserved.ToString("0.00") @recordedCurrency.<br />
            Service consumption committed: @accounting.ConsumptionCommitted.ToString("0.00") @recordedCurrency; reserved: @accounting.ConsumptionReserved.ToString("0.00") @recordedCurrency.</p>
        }
        @if (snapshot.ConfigurationId.HasValue)
        {
            <form action="@Model.AdmissionUrl" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExpectedRevision" value="@snapshot.ConnectionRevision" />
                <input type="hidden" name="Enabled" value="@(!snapshot.AdmissionEnabled ? "true" : "false")" />
                <button class="btn dashboard-command-action @(snapshot.AdmissionEnabled ? "btn-clear-search" : "btn-carrier-settings")" type="submit" disabled="@(!snapshot.AdmissionEnabled && !readiness.CanAllowOwnerPermission)">@(snapshot.AdmissionEnabled ? "Pause receptionist permission" : "Allow calls when ready")</button>
                <p class="dashboard-section-copy mt-2 mb-0">Pausing permission fences further dialogue and business actions through the existing stop handling; it does not promise an instantaneous provider hangup.</p>
            </form>
        }
    </section>
    <form action="@Model.PostUrl" method="post" class="d-grid gap-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ExpectedRevision" value="@settings.ExpectedRevision" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="dashboard-data-surface p-3" role="alert"></div>
        }
        <fieldset class="dashboard-surface-panel p-3">
            <legend class="dashboard-section-title mb-3">Business and conversation</legend>
            <div class="d-grid gap-3">
            <label class="dashboard-form-field"><span>Business name</span><input class="form-control" name="BusinessName" value="@settings.BusinessName" maxlength="200" required /></label>
            <label class="dashboard-form-field"><span>Greeting and conversation guidance</span><textarea class="form-control" name="ConversationInstructions" rows="8" maxlength="65536" required>@settings.ConversationInstructions</textarea></label>
            <label class="dashboard-form-field"><span>Business policy</span><textarea class="form-control" name="BusinessPolicy" rows="12" maxlength="65536" required>@settings.BusinessPolicy</textarea></label>
                <label class="dashboard-form-field" for="CompactVoicePolicy"><span>Optional concise voice policy</span>
                <textarea id="CompactVoicePolicy" name="CompactVoicePolicy" rows="8" maxlength="8000">@Model.Input.CompactVoicePolicy</textarea></label>
                <p>Leave blank to retain the full policy in conversation. If supplied, review it against the full policy above: include identity, listening, service boundaries, qualification, handoff limits, privacy and truthful results. Applying it requires content review; it does not change server permissions.</p>
            <label class="dashboard-form-field"><span>Contact permissions and retention policy</span><textarea class="form-control" name="ContactAndRetentionNotes" rows="5" maxlength="32768">@settings.ContactAndRetentionNotes</textarea></label>
        </div></fieldset>
        <fieldset class="dashboard-surface-panel p-3">
            <legend class="dashboard-section-title mb-3">Services and inquiries</legend>
            <div class="d-grid gap-3">
            <label class="client-create-record-option"><input type="checkbox" name="RequestIntake" value="true" checked="@settings.RequestIntake" /> Save caller-confirmed service inquiries</label>
            <input type="hidden" name="RequestIntake" value="false" />
            <label class="client-create-record-option"><input type="checkbox" name="NotifyOwner" value="true" checked="@settings.NotifyOwner" /> Use the workspace's existing inquiry notifications</label>
            <input type="hidden" name="NotifyOwner" value="false" />
            <p class="dashboard-section-copy mb-0">Add a service in the empty row and save to add another. Save settings before assigning a new service to a specific answer.</p>
            @for (var i = 0; i < (settings.Services?.Count ?? 0); i++)
            {
                var service = settings.Services![i] ?? new Shared.Analytics.ReceptionistServiceInput();
                <div class="dashboard-data-surface p-3 d-grid gap-2">
                    <h3 class="dashboard-section-title">@(string.IsNullOrEmpty(service.ServiceKey) ? "Add a service" : service.DisplayName)</h3>
                    <input type="hidden" name="Services[@i].ServiceKey" value="@service.ServiceKey" />
                    <label class="dashboard-form-field"><span>Service name</span><input class="form-control" name="Services[@i].DisplayName" value="@service.DisplayName" maxlength="120" /></label>
                    <label class="dashboard-form-field"><span>Ways callers ask for this service, one per line</span><textarea class="form-control" name="Services[@i].Aliases" rows="3" maxlength="4000">@service.Aliases</textarea></label>
                    <label class="dashboard-form-field"><span>Useful discovery question</span><input class="form-control" name="Services[@i].DiscoveryQuestion" value="@service.DiscoveryQuestion" maxlength="320" /></label>
                    <label class="dashboard-form-field"><span>Approved service summary</span><textarea class="form-control" name="Services[@i].PublicSummary" rows="3" maxlength="1600">@service.PublicSummary</textarea></label>
                    <label class="dashboard-form-field"><span>Inquiry destination</span><select class="form-select" name="Services[@i].CrmBucket">
                        <option value="">Choose a destination</option>
                        @foreach (var bucket in Model.CrmBuckets)
                        { <option value="@bucket" selected="@(service.CrmBucket == bucket)">@bucket</option> }
                    </select></label>
                    <details><summary>Approved appointment mapping for this service</summary>
                        <p>Use the existing calendar service approved for this workspace. Empty fields leave appointments unavailable for this service.</p>
                        <label class="dashboard-form-field"><span>Approved calendar service ID</span><input class="form-control" name="Services[@i].BookingServiceId" value="@service.BookingServiceId" maxlength="200" autocomplete="off" /></label>
                        <label class="dashboard-form-field"><span>Appointment timezone</span><input class="form-control" name="Services[@i].BookingTimeZoneId" value="@service.BookingTimeZoneId" maxlength="200" /></label>
                        <label class="dashboard-form-field"><span>Appointment duration in minutes</span><input class="form-control" type="number" name="Services[@i].BookingDurationMinutes" value="@service.BookingDurationMinutes" min="5" max="240" /></label>
                    </details>
                    @if (!string.IsNullOrEmpty(service.ServiceKey))
                    { <label class="client-create-record-option"><input type="checkbox" name="Services[@i].Remove" value="true" checked="@service.Remove" /> Remove this service when saving</label> }
                </div>
            }
        </div></fieldset>
        <fieldset class="dashboard-surface-panel p-3">
            <legend class="dashboard-section-title mb-3">Appointment readiness</legend>
            <input type="hidden" name="BookingFieldsPresent" value="true" />
            <p>Saving these settings requests a reviewed capability. It does not enable booking, authorize calendar access or send an invitation. Service mappings above must match the existing connected calendar.</p>
            <label><input type="checkbox" name="BookingEnabled" value="true" checked="@settings.BookingEnabled" /> Request appointment capability</label><input type="hidden" name="BookingEnabled" value="false" />
            <label><input type="checkbox" name="BookingQaOnly" value="true" checked="@settings.BookingQaOnly" /> Synthetic QA only: no calendar appointment or invitation</label><input type="hidden" name="BookingQaOnly" value="false" />
            <label><input type="checkbox" name="BookingAllowConsentedCustomerEmail" value="true" checked="@settings.BookingAllowConsentedCustomerEmail" /> Permit a customer email invitation only after the caller explicitly confirms it</label><input type="hidden" name="BookingAllowConsentedCustomerEmail" value="false" />
            <p>Workspace inquiry notifications are separate. If the caller declines the invitation, Shayla does not create an external appointment.</p>
            <label class="dashboard-form-field"><span>Reviewed calendar configuration fingerprint</span><input class="form-control" name="BookingCalendarConfigurationSha256" value="@settings.BookingCalendarConfigurationSha256" maxlength="64" autocomplete="off" /></label>
            <label class="dashboard-form-field"><span>Reviewed calendar target fingerprint</span><input class="form-control" name="BookingCalendarTargetSha256" value="@settings.BookingCalendarTargetSha256" maxlength="64" autocomplete="off" /></label>
            <label class="dashboard-form-field"><span>Approved booking privacy evidence reference</span><input class="form-control" name="BookingPrivacyAcceptanceReference" value="@settings.BookingPrivacyAcceptanceReference" maxlength="512" /></label>
            <label class="dashboard-form-field"><span>Existing authorized booking agent profile ID</span><input class="form-control" name="BookingAgentProfileId" value="@settings.BookingAgentProfileId" maxlength="36" /></label>
            <label class="dashboard-form-field"><span>Minimum notice in minutes</span><input class="form-control" type="number" name="BookingMinimumNoticeMinutes" value="@settings.BookingMinimumNoticeMinutes" min="0" max="43200" /></label>
            <label class="dashboard-form-field"><span>Maximum days ahead</span><input class="form-control" type="number" name="BookingMaximumAdvanceDays" value="@settings.BookingMaximumAdvanceDays" min="1" max="90" /></label>
        </fieldset>
        <fieldset class="dashboard-surface-panel p-3">
            <legend class="dashboard-section-title mb-3">Approved answers</legend>
            <div class="d-grid gap-3">
            <p class="dashboard-section-copy mb-0">Provide the caller questions this answer addresses. Use a dated answer when the information is only established as of a particular date.</p>
            @for (var i = 0; i < (settings.Answers?.Count ?? 0); i++)
            {
                var answer = settings.Answers![i] ?? new Shared.Analytics.ReceptionistAnswerInput();
                <div class="dashboard-data-surface p-3 d-grid gap-2">
                    <h3 class="dashboard-section-title">@(string.IsNullOrEmpty(answer.Key) ? "Add an answer" : $"Answer {i + 1}")</h3>
                    <input type="hidden" name="Answers[@i].Key" value="@answer.Key" />
                    <label class="dashboard-form-field"><span>Related service</span><select class="form-select" name="Answers[@i].ServiceKey">
                        <option value="">General business question</option>
                        @foreach (var service in (settings.Services ?? []).Where(x => x is not null && !string.IsNullOrEmpty(x.ServiceKey) && !x.Remove))
                        { <option value="@service.ServiceKey" selected="@(answer.ServiceKey == service.ServiceKey)">@service.DisplayName</option> }
                    </select></label>
                    <label class="dashboard-form-field"><span>Caller questions, one per line</span><textarea class="form-control" name="Answers[@i].Questions" rows="3" maxlength="4000">@answer.Questions</textarea></label>
                    <label class="dashboard-form-field"><span>Approved answer</span><textarea class="form-control" name="Answers[@i].Answer" rows="4" maxlength="2400">@answer.Answer</textarea></label>
                    <label class="dashboard-form-field"><span>Information status</span><select class="form-select" name="Answers[@i].Status">
                        <option value="">Choose a status</option>
                        <option value="approved" selected="@(answer.Status == "approved")">Approved</option>
                        <option value="dated" selected="@(answer.Status == "dated")">Dated information</option>
                    </select></label>
                    <label class="dashboard-form-field"><span>Information date, when dated</span><input class="form-control" type="date" name="Answers[@i].AsOfDate" value="@answer.AsOfDate" /></label>
                    @if (!string.IsNullOrEmpty(answer.Key))
                    { <label class="client-create-record-option"><input type="checkbox" name="Answers[@i].Remove" value="true" checked="@answer.Remove" /> Remove this answer when saving</label> }
                </div>
            }
        </div></fieldset>
        <fieldset class="dashboard-surface-panel p-3">
            <legend class="dashboard-section-title mb-3">Hours and limits</legend>
            <div class="d-grid gap-3">
            <label class="dashboard-form-field"><span>Business time zone</span><input class="form-control" name="TimeZoneId" value="@settings.TimeZoneId" maxlength="100" placeholder="Area/City" required /></label>
            <div class="dashboard-data-surface"><table class="dashboard-data-table"><thead><tr><th>Open</th><th>Day</th><th>From</th><th>Until</th></tr></thead><tbody>
            @for (var i = 0; i < (settings.Hours?.Count ?? 0); i++)
            {
                var hours = settings.Hours![i] ?? new Shared.Analytics.ReceptionistHoursInput();
                <tr><td><label class="client-create-record-option"><input type="checkbox" name="Hours[@i].Enabled" value="true" checked="@hours.Enabled" aria-label="Open on @hours.Day" /></label><input type="hidden" name="Hours[@i].Enabled" value="false" /></td>
                    <td>@hours.Day<input type="hidden" name="Hours[@i].Day" value="@hours.Day" /></td>
                    <td><div class="dashboard-form-field"><input class="form-control" type="time" name="Hours[@i].Start" value="@(hours.Start?.ToString("HH:mm", CultureInfo.InvariantCulture))" aria-label="@hours.Day start time" /></div></td>
                    <td><div class="dashboard-form-field"><input class="form-control" type="time" name="Hours[@i].End" value="@(hours.End?.ToString("HH:mm", CultureInfo.InvariantCulture))" aria-label="@hours.Day end time" /></div></td></tr>
            }
            </tbody></table></div>
            <div class="dashboard-form-grid">
                <label class="dashboard-form-field"><span>Currency</span><input class="form-control" name="Currency" value="@settings.Currency" maxlength="3" pattern="[A-Z]{3}" placeholder="Three-letter currency" required /></label>
                <label class="dashboard-form-field"><span>Monthly cash limit</span><input class="form-control" type="number" name="MonthlyCashLimit" value="@Amount(settings.MonthlyCashLimit)" min="0" step="0.0001" required /></label>
                <label class="dashboard-form-field"><span>Monthly service consumption limit</span><input class="form-control" type="number" name="MonthlyConsumptionLimit" value="@Amount(settings.MonthlyConsumptionLimit)" min="0" step="0.0001" required /></label>
                <label class="dashboard-form-field"><span>Monthly voice minutes</span><input class="form-control" type="number" name="MonthlyVoiceMinutesLimit" value="@Amount(settings.MonthlyVoiceMinutesLimit)" min="0" step="any" required /></label>
                <label class="dashboard-form-field"><span>Concurrent calls</span><input class="form-control" type="number" name="MaximumConcurrentCalls" value="@settings.MaximumConcurrentCalls" min="1" step="1" required /></label>
                <label class="dashboard-form-field"><span>Maximum seconds per call</span><input class="form-control" type="number" name="MaximumCallSeconds" value="@settings.MaximumCallSeconds" min="1" step="1" required /></label>
                <label class="dashboard-form-field"><span>New-call window, in seconds</span><input class="form-control" type="number" name="AdmissionWindowSeconds" value="@settings.AdmissionWindowSeconds" min="1" step="1" required /></label>
                <label class="dashboard-form-field"><span>Maximum calls starting within that window</span><input class="form-control" type="number" name="MaximumCallsPerWindow" value="@settings.MaximumCallsPerWindow" min="1" step="1" required /></label>
            </div>
            <p class="dashboard-section-copy mb-0">Cash and service consumption are tracked separately. Unresolved provider charges remain reserved. Changing these limits requires verification and does not add provider funds.</p>
        </div></fieldset>
        <div class="dashboard-surface-panel p-3">
            <p class="dashboard-section-copy mb-3">Saving creates an inactive version and pauses new calls until that version is verified. Existing charges and reservations remain accounted for.</p>
            <button class="btn btn-carrier-settings dashboard-command-action" type="submit">Save receptionist settings</button>
        </div>
    </form>
</section>

@if (Model.ContentReviewUrl is not null && Model.Snapshot.ConfigurationId is not null)
{
    <p><a href="@Model.ContentReviewUrl">Review saved content, apply it while paused, or restore an earlier draft</a></p>
}
