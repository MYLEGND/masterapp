@model Shared.Analytics.ReceptionistManagementPage
@{ ViewData["Title"] = "Receptionist connections"; }
<main class="container py-4">
    <a href="@Model.ReturnUrl">Back to receptionist settings</a>
    <h1>Receptionist connections</h1>
    <p>Connect the voice project dedicated to this workspace. Credentials are encrypted and never displayed after saving. Saving a connection does not accept the provider, enable calls or change your operating configuration.</p>
    @if (Model.Message is not null) { <p role="status">@Model.Message</p> }
    @if (Model.Summary.ConnectionRevision == Guid.Empty)
    {
        <p>Save your receptionist business settings before connecting a provider.</p>
    }
    else
    {
        <form action="@Model.SaveCredentialUrl" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ExpectedConnectionRevision" value="@Model.Summary.ConnectionRevision" />
            <label class="dashboard-form-field"><span>Dedicated OpenAI project ID</span><input class="form-control" name="ProviderProjectKey" required maxlength="200" placeholder="proj_…" /></label>
            <label class="dashboard-form-field"><span>Credential type</span><select class="form-select" name="Purpose"><option value="voice-api">Voice API key</option><option value="voice-webhook">Webhook signing secret</option></select></label>
            <label class="dashboard-form-field"><span>Credential</span><input class="form-control" type="password" name="Secret" required maxlength="16384" autocomplete="new-password" /></label>
            <button class="btn btn-primary" type="submit">Save protected credential</button>
        </form>
    }
    <h2>Saved credential versions</h2>
    <p>Replacing a credential creates a new version for review. Withdrawing a saved version prevents future activation using it; accepted calls retain their pinned credentials. Pause calls before changing active service access.</p>
    @foreach (var credential in Model.Summary.Credentials)
    {
        <section class="card p-3 my-2">
            <h3>@(credential.Purpose == "voice-api" ? "Voice API key" : "Webhook signing secret")</h3>
            <p>Project: @credential.ProviderProjectKey · Saved @credential.CreatedUtc.ToString("u") · @(credential.Revoked ? "Withdrawn" : "Saved; provider acceptance separate")</p>
            @if (!credential.Revoked)
            {
                <form action="@Model.RevokeCredentialUrl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="credentialId" value="@credential.Id" />
                    <input type="hidden" name="expectedConnectionRevision" value="@Model.Summary.ConnectionRevision" />
                    <button class="btn btn-outline-secondary" type="submit">Withdraw from future setup</button>
                </form>
            }
        </section>
    }
    @if (Model.Summary.ConnectionRevision != Guid.Empty && Model.PrepareUrl is not null)
    {
        <h2>Prepare website voice</h2>
        <p>Submit the observed provider, privacy, fallback and cost evidence for review. These entries are proposed facts, not automatic provider verification. Funding choices come from existing accounting; preparing this proposal neither adds funds nor enables calls. This proposal enables inquiry intake only. Replacing a binding removes any prior appointment acceptance; review the existing booking mapping separately before enabling appointments.</p>
        <form action="@Model.PrepareUrl" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ExpectedConnectionRevision" value="@Model.Summary.ConnectionRevision" />
            <input type="hidden" name="Operation" value="accept_binding" />
            <label class="dashboard-form-field"><span>Saved voice credential</span><select name="ApiCredentialVersionId" class="form-select" required>
                <option value="">Choose a saved credential</option>
                @foreach (var credential in Model.Summary.Credentials.Where(x => !x.Revoked && x.Purpose == "voice-api"))
                { <option value="@credential.Id">@credential.ProviderProjectKey · @credential.CreatedUtc.ToString("u")</option> }
            </select></label>
            <label class="dashboard-form-field"><span>Verified voice model</span><input name="Model" class="form-control" required maxlength="100" /></label>
            <label class="dashboard-form-field"><span>Verified voice</span><input name="Voice" class="form-control" required maxlength="100" /></label>
            <label class="dashboard-form-field"><span>Call mode</span><select name="ControlledTestOnly" class="form-select"><option value="true">Restricted acceptance testing</option><option value="false">Public, with separate activation evidence</option></select></label>
            <label class="dashboard-form-field"><span>Provider-enforced maximum call seconds</span><input name="MaximumSupportedCallSeconds" type="number" min="1" required class="form-control" /></label>
            <fieldset><legend>Verified maximum cost for each call</legend>
                <p>Include all provider exposure, including uncertain creation and cleanup. An alert-only project budget does not establish a hard limit.</p>
                <input type="hidden" name="Costs[0].Key" value="provider_voice" />
                <label class="dashboard-form-field"><span>Existing funding account</span><select name="Costs[0].FundingAccountId" class="form-select" required>
                    <option value="">Choose existing funding</option>
                    @foreach (var choice in Model.Summary.FundingChoices ?? []) { <option value="@choice.Id">@choice.Label</option> }
                </select></label>
                <label class="dashboard-form-field"><span>Maximum fixed cash exposure</span><input name="Costs[0].CashFixedMaximum" type="number" min="0" step="0.000001" required class="form-control" /></label>
                <label class="dashboard-form-field"><span>Maximum cash per second</span><input name="Costs[0].CashPerSecondMaximum" type="number" min="0" step="0.000001" required class="form-control" /></label>
                <label class="dashboard-form-field"><span>Maximum fixed service consumption</span><input name="Costs[0].ConsumptionFixedMaximum" type="number" min="0" step="0.000001" required class="form-control" /></label>
                <label class="dashboard-form-field"><span>Maximum service consumption per second</span><input name="Costs[0].ConsumptionPerSecondMaximum" type="number" min="0" step="0.000001" required class="form-control" /></label>
            </fieldset>
            @{ var kinds = new[] { "provider_setup", "exclusive_project", "cost_bounds", "disclosure", "retention", "website_fallback", "capability.canonical_intake", "public_activation" };
               var labels = new[] { "Provider setup", "Exclusive project", "Enforced exposure and cost bounds", "AI and recording disclosures", "Retention and privacy", "Website contact fallback", "Caller-confirmed inquiry route", "Public activation (public mode only)" }; }
            @for (var i = 0; i < kinds.Length; i++)
            {
                <fieldset><legend>@labels[i]</legend>
                    <input type="hidden" name="Evidence[@i].Kind" value="@kinds[i]" />
                    <label class="dashboard-form-field"><span>Evidence reference</span><input name="Evidence[@i].Reference" maxlength="512" class="form-control" /></label>
                    <label class="dashboard-form-field"><span>Evidence SHA-256</span><input name="Evidence[@i].Sha256" pattern="[a-f0-9]{64}" maxlength="64" class="form-control" /></label>
                    <label class="dashboard-form-field"><span>Observed at (UTC, ISO 8601 ending Z)</span><input name="Evidence[@i].ObservedUtc" placeholder="2026-10-26T12:00:00Z" class="form-control" /></label>
                </fieldset>
            }
            <button class="btn btn-primary" type="submit">Save proposal for review</button>
        </form>
        @if (Model.Summary.CanRunVoiceTest)
        {
        <section data-website-receptionist data-receptionist-test-grant="@Model.TestGrantUrl" data-receptionist-test-start="@Model.TestStartUrl">
            @Html.AntiForgeryToken()
            <h2>Test website voice</h2>
            <p>Requires an accepted restricted configuration, reviewed active test window and call permission. This uses real voice service and reserved budget; test inquiries are marked as QA.</p>
            <button type="button" data-receptionist-start>Start restricted voice test</button>
            <button type="button" data-receptionist-end hidden>End test</button>
            <audio data-receptionist-audio controls autoplay hidden></audio>
            <p data-receptionist-status aria-live="polite"></p>
        </section>
        }
        else if (Model.TestControlPlaneUrl is not null)
        {
            <p><a href="@Model.TestControlPlaneUrl">Open restricted voice testing in the management portal</a>. Sign in there with your workspace identity; your settings permission is checked again before testing.</p>
        }
        <h2>Restricted acceptance window</h2>
        <p>Each accepted test configuration can have one window of at most one hour. It cannot be extended or replaced, including after expiry or revocation. A new window requires a new accepted configuration. This proposal does not enable public calls.</p>
        @foreach (var operation in new[] { "create_acceptance_window", "revoke_acceptance_window" })
        {
            <form action="@Model.PrepareUrl" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExpectedConnectionRevision" value="@Model.Summary.ConnectionRevision" />
                <input type="hidden" name="Operation" value="@operation" />
                <input type="hidden" name="Evidence[0].Kind" value="@operation" />
                @if (operation == "create_acceptance_window")
                {
                    <label class="dashboard-form-field"><span>Starts at (UTC, ISO 8601 ending Z)</span><input name="WindowStartsUtc" required class="form-control" /></label>
                    <label class="dashboard-form-field"><span>Expires at (UTC, within one hour of start)</span><input name="WindowExpiresUtc" required class="form-control" /></label>
                }
                <label class="dashboard-form-field"><span>@(operation == "create_acceptance_window" ? "Restricted-route verification evidence" : "Revocation evidence")</span><input name="Evidence[0].Reference" maxlength="200" required class="form-control" /></label>
                <label class="dashboard-form-field"><span>Evidence SHA-256</span><input name="Evidence[0].Sha256" pattern="[a-f0-9]{64}" required class="form-control" /></label>
                <label class="dashboard-form-field"><span>Observed at (UTC, ISO 8601 ending Z)</span><input name="Evidence[0].ObservedUtc" required class="form-control" /></label>
                <button class="btn btn-outline-primary" type="submit">@(operation == "create_acceptance_window" ? "Propose test window" : "Propose permanent revocation")</button>
            </form>
        }
        <h2>Prepare call permission</h2>
        <form action="@Model.PrepareUrl" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ExpectedConnectionRevision" value="@Model.Summary.ConnectionRevision" />
            <input type="hidden" name="Operation" value="set_owner_admission" />
            <input type="hidden" name="Evidence[0].Kind" value="set_owner_admission" />
            <label class="dashboard-form-field"><span>Requested permission</span><select name="Enabled" class="form-select"><option value="false">Pause calls</option><option value="true">Allow calls when ready</option></select></label>
            <label class="dashboard-form-field"><span>Authorization evidence reference</span><input name="Evidence[0].Reference" maxlength="200" required class="form-control" /></label>
            <label class="dashboard-form-field"><span>Evidence SHA-256</span><input name="Evidence[0].Sha256" pattern="[a-f0-9]{64}" required class="form-control" /></label>
            <label class="dashboard-form-field"><span>Observed at (UTC, ISO 8601 ending Z)</span><input name="Evidence[0].ObservedUtc" required class="form-control" /></label>
            <button class="btn btn-outline-primary" type="submit">Save permission proposal for review</button>
        </form>
    }
    <h2>Operation reviews</h2>
    @if (Model.Summary.Operations.Count == 0) { <p>No saved operation reviews are available. Provider setup, routing, cost and capability evidence must be verified before activation.</p> }
    @foreach (var operation in Model.Summary.Operations)
    {
        <section class="card p-3 my-2">
            <p>@operation.Operation · @operation.ReviewState · Expires @operation.ExpiresUtc.ToString("u")</p>
            @if (operation.ReviewState == "accepted" || (operation.ReviewState == "pending" && Model.Summary.CanReview))
            {
                <form action="@Model.PlanUrl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="key" value="@operation.Key" />
                    <input type="hidden" name="sha256" value="@operation.Sha256" />
                    <input type="hidden" name="pendingReview" value="@(operation.ReviewState == "pending" ? "true" : "false")" />
                    <button class="btn btn-outline-primary" type="submit">Review exact change</button>
                </form>
            }
        </section>
    }
    @if (Model.Review is { } review)
    {
        <section class="card p-3 my-3" aria-label="Exact operation review">
            <h2>@review.Label</h2>
            <p>Operation: @review.Operation</p>
            @foreach (var blocker in review.Blockers) { <p role="status">@blocker</p> }
            <dl>
                @foreach (var fact in review.Facts) { <dt>@fact.Label</dt><dd>@fact.Value</dd> }
            </dl>
            @if (review.PendingReviewRevision is { } revision && Model.Summary.CanReview)
            {
                <p>Review the provider and capability evidence before accepting this operation. Acceptance does not execute it.</p>
                <form action="@Model.ReviewUrl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Guid.ParseExact(review.Key.Substring(6), "N")" />
                    <input type="hidden" name="expectedRevision" value="@revision" />
                    <input type="hidden" name="sha256" value="@review.Sha256" />
                    <button class="btn btn-primary" type="submit" name="accepted" value="true">Accept this exact review</button>
                    <button class="btn btn-outline-secondary" type="submit" name="accepted" value="false">Reject this review</button>
                </form>
            }
            @if (review.CanApply && review.ExpectedStateToken is not null)
            {
                <form action="@Model.ApplyUrl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PackageKey" value="@review.Key" />
                    <input type="hidden" name="PackageSha256" value="@review.Sha256" />
                    <input type="hidden" name="ExpectedStateToken" value="@review.ExpectedStateToken" />
                    <button class="btn btn-primary" type="submit">Apply this exact change</button>
                </form>
            }
        </section>
    }
</main>
<script src="~/js/legend-public-inquiry.js" asp-append-version="true" defer></script>
