@using Shared.Messaging
@model MessagingCommandCenterViewModel

<div id="messagingCommandCenter"
     class="messaging-command-center-modal"
     data-messaging-command-center
     data-current-user-id="@Model.CurrentUserId"
     data-messaging-compose-prompt="@Model.ComposePrompt"
     aria-hidden="true"
     hidden>
    <section class="messaging-command-center-window"
             role="dialog"
             aria-modal="true"
             aria-labelledby="messagingCommandCenterTitle"
             tabindex="-1">
        <form id="messagingAntiForgery" class="visually-hidden">@Html.AntiForgeryToken()</form>

        <header class="messaging-command-center-header">
            <div>
                <p class="messaging-command-center-kicker">Secure communication</p>
                <h2 id="messagingCommandCenterTitle">Messages</h2>
                @if (!string.IsNullOrWhiteSpace(Model.ServiceContactName) ||
                     !string.IsNullOrWhiteSpace(Model.ServiceContactPhone) ||
                     !string.IsNullOrWhiteSpace(Model.ServiceContactEmail))
                {
                    <div class="messaging-service-contact" aria-label="Your servicing agent contact details">
                        <span>Your servicing agent</span>
                        @if (!string.IsNullOrWhiteSpace(Model.ServiceContactName))
                        {
                            <strong>@Model.ServiceContactName</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ServiceContactPhone))
                        {
                            <a href="tel:@Model.ServiceContactPhone">@Model.ServiceContactPhone</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ServiceContactEmail))
                        {
                            <a href="mailto:@Model.ServiceContactEmail">@Model.ServiceContactEmail</a>
                        }
                    </div>
                }
            </div>
            <div class="messaging-command-center-header-actions">
                @if (Model.SupportsJourneyCircles)
                {
                    <button type="button"
                            class="messaging-command-center-journey"
                            id="messagingJourneyCirclesOpen"
                            aria-controls="messagingJourneyCircles"
                            aria-expanded="false">
                        <span class="messaging-journey-button-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="8" cy="8" r="3"></circle>
                                <circle cx="16.5" cy="9" r="2.5"></circle>
                                <path d="M3 20v-2a5 5 0 0 1 10 0v2"></path>
                                <path d="M14 15.5a4.5 4.5 0 0 1 6.5 4"></path>
                            </svg>
                        </span>
                        <span class="messaging-journey-button-label">Journey Circles</span>
                        <span class="messaging-journey-recommendation-badge"
                              id="messagingJourneyRecommendationBadge"
                              aria-label="0 Journey Circles recommendations">0</span>
                    </button>
                }
                <span class="messaging-command-center-unread" id="messagingCommandCenterUnread" hidden></span>
                <button type="button" class="messaging-command-center-close" id="messagingCommandCenterClose" aria-label="Close Messages">×</button>
            </div>
        </header>

        <div class="messaging-error" id="messagingError" role="alert" hidden></div>

        <section class="messaging-journey-panel" id="messagingJourneyCircles" aria-labelledby="messagingJourneyCirclesTitle" hidden>
            <header class="messaging-journey-header">
                <div class="messaging-journey-header-copy">
                    <div class="messaging-journey-title-lockup">
                        <span class="messaging-journey-title-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="8" cy="8" r="3"></circle>
                                <circle cx="16.5" cy="9" r="2.5"></circle>
                                <path d="M3 20v-2a5 5 0 0 1 10 0v2"></path>
                                <path d="M14 15.5a4.5 4.5 0 0 1 6.5 4"></path>
                            </svg>
                        </span>

                        <div class="messaging-journey-title-copy">
                            <p class="messaging-command-center-kicker">Profile-connected community</p>

                            <div class="messaging-journey-title-row">
                                <h3 id="messagingJourneyCirclesTitle">Journey Circles</h3>
                                <span class="messaging-journey-title-badge"
                                      id="messagingJourneyTitleBadge"
                                      aria-label="0 Journey Circles recommendations">0</span>
                            </div>

                            <p>Choose shared goals and preferences to find relevant, authorized connections.</p>
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="messaging-text-button messaging-journey-back"
                        id="messagingJourneyCirclesBack">
                    <span class="messaging-journey-back-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="m14 18-6-6 6-6"></path>
                            <path d="M8 12h11"></path>
                        </svg>
                    </span>
                    <span class="messaging-journey-back-label">Back to messages</span>
                </button>
            </header>

            <div class="messaging-journey-status"
                 id="messagingJourneyStatus"
                 role="status"
                 hidden></div>

            <div class="messaging-journey-content">
                <form id="messagingJourneyProfileForm"
                      class="messaging-journey-profile-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ConsentAffirmed" value="false" />
                    <input type="hidden" name="IsOptedIn" value="false" />
                    <input type="hidden" name="IsDiscoverable" value="false" />
                    <input type="hidden" name="AllowSuggestions" value="false" />
                    <input type="hidden" name="AllowConnectionRequests" value="false" />

                    <select name="PrivacyChoices"
                            class="messaging-journey-privacy-source"
                            multiple
                            tabindex="-1"
                            aria-hidden="true">
                        <option value="consent">I affirm the Journey Circles community consent</option>
                        <option value="opt-in">Join Journey Circles</option>
                        <option value="discoverable">Appear in relevant recommendations</option>
                        <option value="suggestions">Receive recommendations</option>
                        <option value="requests">Allow connection requests</option>
                    </select>

                    <section class="messaging-journey-profile-card">
                        <header class="messaging-journey-profile-heading">
                            <div class="messaging-journey-heading-lockup">
                                <span class="messaging-journey-icon">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                        <path d="M12 14v2"></path>
                                    </svg>
                                </span>

                                <div>
                                    <h4>Your connection profile</h4>
                                    <p>Build a private profile around the experiences and goals you choose to share.</p>
                                </div>
                            </div>

                            <button type="submit"
                                    class="messaging-primary-button messaging-journey-save">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 4h12l2 2v14H5z"></path>
                                    <path d="M8 4v6h8V4"></path>
                                    <rect x="8" y="14" width="8" height="6" rx="1"></rect>
                                </svg>
                                <span>Save profile</span>
                            </button>
                        </header>

                        <section class="messaging-journey-privacy-section">
                            <div class="messaging-journey-section-copy">
                                <h5>Participation and privacy</h5>
                                <p>You control every part of your visibility and participation.</p>
                            </div>

                            <div class="messaging-journey-privacy-grid"
                                 aria-label="Journey Circles participation and privacy choices">

                                <button type="button"
                                        class="messaging-journey-privacy-choice"
                                        data-journey-privacy-choice="consent"
                                        aria-pressed="false">
                                    <span class="messaging-journey-choice-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 3 4.5 6v5.5c0 4.6 3.1 7.8 7.5 9.5 4.4-1.7 7.5-4.9 7.5-9.5V6z"></path>
                                            <path d="m9 12 2 2 4-5"></path>
                                        </svg>
                                    </span>
                                    <strong>Consent</strong>
                                    <span>I affirm community consent</span>
                                </button>

                                <button type="button"
                                        class="messaging-journey-privacy-choice"
                                        data-journey-privacy-choice="opt-in"
                                        aria-pressed="false">
                                    <span class="messaging-journey-choice-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="8" cy="8" r="3"></circle>
                                            <circle cx="16.5" cy="9" r="2.5"></circle>
                                            <path d="M3 20v-2a5 5 0 0 1 10 0v2"></path>
                                            <path d="M14 15.5a4.5 4.5 0 0 1 6.5 4"></path>
                                        </svg>
                                    </span>
                                    <strong>Join</strong>
                                    <span>Participate in Journey Circles</span>
                                </button>

                                <button type="button"
                                        class="messaging-journey-privacy-choice"
                                        data-journey-privacy-choice="discoverable"
                                        aria-pressed="false">
                                    <span class="messaging-journey-choice-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="10.5" cy="10.5" r="6"></circle>
                                            <path d="m15 15 5 5"></path>
                                            <path d="M10.5 8v5"></path>
                                            <path d="M8 10.5h5"></path>
                                        </svg>
                                    </span>
                                    <strong>Appear</strong>
                                    <span>Be shown in relevant matches</span>
                                </button>

                                <button type="button"
                                        class="messaging-journey-privacy-choice"
                                        data-journey-privacy-choice="suggestions"
                                        aria-pressed="false">
                                    <span class="messaging-journey-choice-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m12 3 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9z"></path>
                                        </svg>
                                    </span>
                                    <strong>Receive</strong>
                                    <span>Get ranked recommendations</span>
                                </button>

                                <button type="button"
                                        class="messaging-journey-privacy-choice"
                                        data-journey-privacy-choice="requests"
                                        aria-pressed="false">
                                    <span class="messaging-journey-choice-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                            <path d="m4 7 8 6 8-6"></path>
                                        </svg>
                                    </span>
                                    <strong>Allow</strong>
                                    <span>Receive connection requests</span>
                                </button>
                            </div>
                        </section>

                        <div class="messaging-journey-fields">
                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M6 20V10"></path>
                                        <path d="M12 20V4"></path>
                                        <path d="M18 20v-7"></path>
                                    </svg>
                                    Life stages
                                </span>
                                <select name="LifeStages" multiple size="5"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M3 12h18"></path>
                                        <path d="M12 3a15 15 0 0 1 0 18"></path>
                                        <path d="M12 3a15 15 0 0 0 0 18"></path>
                                    </svg>
                                    Regions
                                </span>
                                <select name="Locations" multiple size="5"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M5 21V4"></path>
                                        <path d="M5 5h11l-2 4 2 4H5"></path>
                                    </svg>
                                    Goals
                                </span>
                                <select name="Goals" multiple size="6"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="m12 21-1.4-1.3C5.4 15 2 11.9 2 8.1 2 5 4.4 3 7.3 3c1.7 0 3.3.8 4.7 2.1C13.4 3.8 15 3 16.7 3 19.6 3 22 5 22 8.1c0 3.8-3.4 6.9-8.6 11.6z"></path>
                                    </svg>
                                    Interests
                                </span>
                                <select name="Interests" multiple size="6"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="8" cy="9" r="3"></circle>
                                        <circle cx="16" cy="9" r="3"></circle>
                                        <path d="M2.5 20a5.5 5.5 0 0 1 11 0"></path>
                                        <path d="M10.5 20a5.5 5.5 0 0 1 11 0"></path>
                                    </svg>
                                    Journey Circles
                                </span>
                                <select name="CircleCodes" multiple size="5"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M10 13a5 5 0 0 0 7.1.1l2-2A5 5 0 0 0 12 4l-1.1 1.1"></path>
                                        <path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"></path>
                                    </svg>
                                    Connection types
                                </span>
                                <select name="ConnectionTypes" multiple size="5"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
                                        <path d="M8 9h8"></path>
                                        <path d="M8 13h5"></path>
                                    </svg>
                                    Communication styles
                                </span>
                                <select name="CommunicationStyles" multiple size="5"></select>
                            </label>

                            <label class="messaging-journey-field">
                                <span class="messaging-journey-field-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 7v5l3 2"></path>
                                    </svg>
                                    Check-in cadence
                                </span>
                                <select name="AccountabilityFrequencies" multiple size="5"></select>
                            </label>
                        </div>

                        <label class="messaging-journey-field messaging-journey-introduction">
                            <span class="messaging-journey-field-label">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 5h16v12H7l-3 3z"></path>
                                    <path d="M8 9h8"></path>
                                    <path d="M8 13h5"></path>
                                </svg>
                                Introduction
                            </span>

                            <textarea name="Introduction"
                                      rows="3"
                                      maxlength="600"
                                      placeholder="Share a brief introduction with potential connections"></textarea>
                        </label>
                    </section>
                </form>

                <aside class="messaging-journey-results">
                    <section class="messaging-journey-result-section">
                        <header class="messaging-journey-result-heading">
                            <span class="messaging-journey-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m12 3 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9z"></path>
                                </svg>
                            </span>
                            <div>
                                <h4>Recommended connections</h4>
                                <p>Ranked from your shared saved selections.</p>
                            </div>
                        </header>
                        <div class="messaging-journey-card-list" id="messagingJourneyRecommendations"></div>
                    </section>

                    <section class="messaging-journey-result-section">
                        <header class="messaging-journey-result-heading">
                            <span class="messaging-journey-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="m4 7 8 6 8-6"></path>
                                </svg>
                            </span>
                            <div>
                                <h4>Incoming requests</h4>
                                <p>Review authorized connection invitations.</p>
                            </div>
                        </header>
                        <div class="messaging-journey-card-list" id="messagingJourneyRequests"></div>
                    </section>

                    <section class="messaging-journey-result-section">
                        <header class="messaging-journey-result-heading">
                            <span class="messaging-journey-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="8" cy="9" r="3"></circle>
                                    <circle cx="16" cy="9" r="3"></circle>
                                    <path d="M2.5 20a5.5 5.5 0 0 1 11 0"></path>
                                    <path d="M10.5 20a5.5 5.5 0 0 1 11 0"></path>
                                </svg>
                            </span>
                            <div>
                                <h4>Your connections</h4>
                                <p>People who have mutually accepted a connection.</p>
                            </div>
                        </header>
                        <div class="messaging-journey-card-list" id="messagingJourneyConnections"></div>
                    </section>

                    <section class="messaging-journey-trust-card">
                        <span class="messaging-journey-trust-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3 4.5 6v5.5c0 4.6 3.1 7.8 7.5 9.5 4.4-1.7 7.5-4.9 7.5-9.5V6z"></path>
                                <path d="m9 12 2 2 4-5"></path>
                            </svg>
                        </span>
                        <div>
                            <h4>Community you can trust</h4>
                            <p>You control your visibility, recommendations, requests, and participation.</p>
                        </div>
                    </section>
                </aside>
            </div>
        </section>

        <div class="messaging-command-center-grid" id="messagingCommandCenterGrid">
            <aside class="messaging-command-center-sidebar" aria-label="Conversations">
                <label class="visually-hidden" for="messagingUniversalSearch">@Model.SearchPlaceholder</label>
                <input id="messagingUniversalSearch"
                       class="messaging-command-center-search"
                       type="search"
                       placeholder="@Model.SearchPlaceholder"
                       autocomplete="off" />
                <div class="messaging-command-center-search-results" id="messagingSearchResults" hidden></div>
                <div class="messaging-conversation-list" id="messagingConversationList"></div>
            </aside>

            <main class="messaging-command-center-thread" aria-live="polite">
                <div class="messaging-thread-empty" id="messagingThreadEmpty">
                    <h3>Choose an authorized contact</h3>
                    <p>@Model.ComposePrompt</p>
                </div>

                <div id="messagingThreadContent" hidden>
                    <header class="messaging-thread-header">
                        <div class="messaging-thread-identity">
                            <span id="messagingThreadAvatar"></span>
                            <div>
                                <h3 id="messagingThreadTitle"></h3>
                                <p id="messagingThreadSubject"></p>
                            </div>
                        </div>
                        <div class="messaging-thread-actions">
                            <button type="button" class="messaging-text-button" id="messagingMuteConversation">Mute</button>
                            <button type="button" class="messaging-text-button" id="messagingCloseConversation">Close</button>
                        </div>
                    </header>
                    <div class="messaging-messages" id="messagingMessages"></div>
                    <button type="button" class="messaging-new-messages" id="messagingNewMessages" hidden>New messages</button>
                </div>

                <form id="messagingSendForm" class="messaging-send-form" enctype="multipart/form-data">
                    <div class="messaging-compose-target" id="messagingComposeTarget">@Model.ComposePrompt</div>
                    <label class="visually-hidden" for="messagingMessageBody">Write a message</label>
                    <textarea id="messagingMessageBody"
                              rows="3"
                              maxlength="10000"
                              placeholder="Write a message"
                              disabled></textarea>
                    <div class="messaging-send-actions">
                        <label class="messaging-file-label" for="messagingFiles">Attach files</label>
                        <input id="messagingFiles" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.txt,.doc,.docx,.xls,.xlsx" disabled />
                        <button type="submit" class="messaging-primary-button" id="messagingSendButton" disabled>Send</button>
                    </div>
                    <p class="messaging-attachment-note">Attachments remain unavailable until malware scanning marks them clean.</p>
                </form>
            </main>
        </div>
    </section>
</div>
