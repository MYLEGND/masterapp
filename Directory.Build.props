<Project>
  <PropertyGroup>
    <!-- Keep obj/bin off OneDrive. Isolated worktrees can select their own root without changing CI artifact paths. -->
    <MasterAppArtifactsRoot Condition="'$(MasterAppArtifactsRoot)' == ''">/tmp/masterapp</MasterAppArtifactsRoot>
    <BaseIntermediateOutputPath>$(MasterAppArtifactsRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MasterAppArtifactsRoot)/obj/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MasterAppArtifactsRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <!-- Application projects keep extension props disabled. AgentPortal.Tests alone imports
         the restored test-runner build props so VSTest/xUnit discovery is authoritative. -->
    <ImportProjectExtensionProps Condition="'$(MSBuildProjectName)' == 'AgentPortal.Tests'">true</ImportProjectExtensionProps>
    <ImportProjectExtensionProps Condition="'$(MSBuildProjectName)' != 'AgentPortal.Tests'">false</ImportProjectExtensionProps>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
</Project>
