<Project>
  <PropertyGroup>
    <!-- Keep obj/bin off OneDrive while still isolating per-project intermediates -->
    <BaseIntermediateOutputPath>/tmp/masterapp/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>/tmp/masterapp/obj/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>/tmp/masterapp/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <!-- Application projects keep extension props disabled. AgentPortal.Tests alone imports
         its restored runner build props so the native VSTest/xUnit discovery path is authoritative. -->
    <ImportProjectExtensionProps Condition="'$(MSBuildProjectName)' == 'AgentPortal.Tests'">true</ImportProjectExtensionProps>
    <ImportProjectExtensionProps Condition="'$(MSBuildProjectName)' != 'AgentPortal.Tests'">false</ImportProjectExtensionProps>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
</Project>
