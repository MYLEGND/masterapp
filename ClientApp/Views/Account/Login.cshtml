@model ClientApp.Models.ClientLoginViewModel
@{
    ViewData["Title"] = "Client Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/css/client-auth.css" asp-append-version="true" />
</head>
<body class="client-auth-page">
    <main class="client-auth-shell">
        <section class="client-auth-card" aria-labelledby="client-login-title">
            <header class="client-auth-brand">
                <img src="~/images/company-icons/legend-protect-transparent.png" asp-append-version="true" alt="Legend™" />
                <div class="client-auth-brand-copy">
                    <span class="client-auth-brand-name">LEGEND™</span>
                    <span class="client-auth-brand-label">CLIENT PORTAL</span>
                </div>
            </header>

            <div class="client-auth-content">
                <p class="client-auth-eyebrow">CLIENT SIGN-IN</p>
                <h1 id="client-login-title">Welcome back</h1>
                <p class="client-auth-intro">Sign in with the email linked to your active Legend Client Portal subscription.</p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="client-auth-alert" role="alert">@Model.Message</div>
                }

                <form class="client-auth-form" asp-action="LoginSubmit" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div class="client-auth-field">
                        <label asp-for="Email">Email on your client subscription</label>
                        <input asp-for="Email" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="client-auth-validation"></span>
                    </div>

                    <button type="submit" class="client-auth-primary">Continue securely</button>
                </form>

                <p class="client-auth-help">New to the portal? Use the activation link sent by your Legend agent.</p>
            </div>
        </section>
    </main>

    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
