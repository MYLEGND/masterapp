@model ClientApp.Models.ActivationRequiredViewModel
@{
    ViewData["Title"] = "Activation Required";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <p class="text-uppercase small text-muted mb-2">Client Access</p>
                        <h1 class="h3 mb-3">@Model.Title</h1>
                        <p class="text-muted mb-4">@Model.Message</p>
                        <div class="d-flex flex-column gap-2">
                            <a class="btn btn-dark" href="@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })">Back to Client Sign-In</a>
                            <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Return</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
