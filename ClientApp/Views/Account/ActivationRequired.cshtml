@model ClientApp.Models.ActivationRequiredViewModel
@{
    ViewData["Title"] = "Activation Required";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/css/client-auth.css" asp-append-version="true" />
</head>
<body class="client-auth-page">
    <main class="client-auth-shell">
        <section class="client-auth-card" aria-labelledby="activation-required-title">
            <header class="client-auth-brand">
                <img src="~/images/company-icons/legend-protect-transparent.png" asp-append-version="true" alt="Legend™" />
                <div class="client-auth-brand-copy">
                    <span class="client-auth-brand-name">LEGEND™</span>
                    <span class="client-auth-brand-label">CLIENT PORTAL</span>
                </div>
            </header>

            <div class="client-auth-content">
                <p class="client-auth-eyebrow">CLIENT ACCESS</p>
                <h1 id="activation-required-title">@Model.Title</h1>
                <p class="client-auth-intro">@Model.Message</p>
                <div class="client-auth-actions">
                    <a class="client-auth-primary" href="@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })">Go to client sign-in</a>
                    <a class="client-auth-secondary" href="@Model.ReturnUrl">Return</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
