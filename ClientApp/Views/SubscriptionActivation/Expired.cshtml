@model ClientApp.Models.SubscriptionActivationNoticeViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/_content/Shared/css/dashboard-home-shared.css" asp-append-version="true" />
</head>
<body class="subscription-activation-standalone">
    <main class="dashboard-page-shell client-create-page subscription-activation-shell">
        <section class="client-create-panel">
            <div class="client-create-header">
                <div>
                    <div class="dashboard-eyebrow">Activation Notice</div>
                    <h1 class="client-create-title">@Model.Title</h1>
                    <p class="client-create-subtitle">@Model.Message</p>
                </div>
            </div>
            <div class="client-create-body">
                <div class="subscription-activation-actions">
                    <a class="client-create-button client-create-button-secondary" href="@Model.ReturnUrl">Return</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
