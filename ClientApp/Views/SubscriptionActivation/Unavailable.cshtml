@model ClientApp.Models.SubscriptionActivationNoticeViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/css/subscription-activation.css" asp-append-version="true" />
</head>
<body class="subscription-activation-standalone">
    <main class="activation-page">
        <section class="activation-notice-card">
            <header>
                <p class="activation-brand">Legend Client Portal</p>
                <h1>@Model.Title</h1>
                <p>@Model.Message</p>
            </header>
            <div class="activation-notice-actions">
                <a class="activation-link is-primary" href="@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })">Open client sign-in</a>
                <a class="activation-link" href="@Model.ReturnUrl">Return</a>
            </div>
        </section>
    </main>
</body>
</html>
