@model ClientApp.Models.SubscriptionActivationPageViewModel
@{
    ViewData["Title"] = "Activate Legend Client Portal";
    Layout = null;
    var squareScriptUrl = string.Equals(Model.SquareEnvironment, "Production", StringComparison.OrdinalIgnoreCase)
        ? "https://web.squarecdn.com/v1/square.js"
        : "https://sandbox.web.squarecdn.com/v1/square.js";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Legend™</title>
    <link rel="stylesheet" href="~/css/subscription-activation.css" asp-append-version="true" />
</head>
<body class="subscription-activation-standalone">
    <main class="activation-page"
          data-subscription-activation
          data-square-app-id="@Model.SquareApplicationId"
          data-square-location-id="@Model.SquareLocationId">
        <section class="activation-card">
            <header class="activation-header">
                <div>
                    <p class="activation-brand">Legend Client Portal</p>
                    <h1>Activate your access</h1>
                    <p class="activation-client">@Model.ClientName · @Model.ClientEmail</p>
                </div>
                <div class="activation-summary" aria-label="Subscription summary">
                    <div class="activation-summary-item">
                        <span class="activation-summary-label">Monthly</span>
                        <span class="activation-summary-value">@Model.MonthlyAmountDisplay</span>
                    </div>
                    <div class="activation-summary-item">
                        <span class="activation-summary-label">First charge</span>
                        <span class="activation-summary-value" data-first-charge>@Model.FirstChargeDateDisplay</span>
                    </div>
                    <div class="activation-summary-item">
                        <span class="activation-summary-label">Renews</span>
                        <span class="activation-summary-value" data-anchor-label>@Model.BillingAnchorLabel</span>
                    </div>
                </div>
            </header>

            <div class="activation-body">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="activation-alert">@Model.ErrorMessage</div>
                }

                @if (!Model.BrowserPaymentReady)
                {
                    <div class="activation-alert">@Model.BrowserPaymentSetupMessage</div>
                }
                else
                {
                    <form asp-action="PaymentMethod" asp-route-token="@Model.Token" method="post" id="activationPaymentForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="SourceId" id="activationSourceId" />

                        <div asp-validation-summary="ModelOnly" class="activation-validation"></div>
                        <h2 class="activation-form-title">Payment details</h2>

                        <div class="activation-fields">
                            <div class="activation-field">
                                <label for="cardholderName">Name on card <span>*</span></label>
                                <input id="cardholderName" name="CardholderName" autocomplete="cc-name" required />
                            </div>
                            <div class="activation-field">
                                <label for="billingPostalCode">ZIP code <span>*</span></label>
                                <input id="billingPostalCode" name="BillingPostalCode" autocomplete="postal-code" required />
                            </div>
                            <div class="activation-field is-wide">
                                <label for="billingAddressLine1">Street address <span>*</span></label>
                                <input id="billingAddressLine1" name="BillingAddressLine1" autocomplete="address-line1" required />
                            </div>
                            <div class="activation-field">
                                <label for="billingCity">City <span>*</span></label>
                                <input id="billingCity" name="BillingCity" autocomplete="address-level2" required />
                            </div>
                            <div class="activation-field">
                                <label for="billingState">State <span>*</span></label>
                                <input id="billingState" name="BillingState" autocomplete="address-level1" required />
                            </div>
                            <div class="activation-field">
                                <label for="billingAddressLine2">Apartment or suite</label>
                                <input id="billingAddressLine2" name="BillingAddressLine2" autocomplete="address-line2" />
                            </div>
                            <div class="activation-field">
                                <label for="billingCountryCode">Country <span>*</span></label>
                                <select id="billingCountryCode" name="BillingCountryCode" autocomplete="country-name" required>
                                    <option value="US" selected>United States</option>
                                </select>
                            </div>
                            <div class="activation-field is-wide">
                                <label>Card details <span>*</span></label>
                                <div id="square-card" class="activation-card-surface"></div>
                            </div>
                        </div>

                        <div id="activationMessage" class="activation-alert" role="alert" hidden></div>

                        <label class="activation-authorization" for="billingAuthorizationAccepted">
                            <input type="checkbox" id="billingAuthorizationAccepted" name="BillingAuthorizationAccepted" value="true" required />
                            <span id="activationAuthorizationCopy" data-monthly-amount="@Model.MonthlyAmountDisplay">I authorize today’s @Model.MonthlyAmountDisplay charge and recurring monthly billing on @Model.BillingAnchorLabel, cancel anytime.</span>
                        </label>

                        <div class="activation-actions">
                            <button type="submit" class="activation-button" id="activationSubmitButton">Activate access</button>
                        </div>
                    </form>
                }
            </div>
        </section>
    </main>

    @if (Model.BrowserPaymentReady)
    {
        <script src="@squareScriptUrl"></script>
    }
    <script src="~/js/subscription-activation.js" asp-append-version="true"></script>
</body>
</html>
