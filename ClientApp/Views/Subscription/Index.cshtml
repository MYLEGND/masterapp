@model ClientApp.Models.ClientSubscriptionManagementViewModel
@{
    ViewData["Title"] = "Subscription";
    var notice = ViewData["SubscriptionNotice"] as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <p class="text-uppercase small text-muted mb-2">Client Billing</p>
                    <h1 class="h3 mb-3">@Model.ClientName</h1>

                    @if (!string.IsNullOrWhiteSpace(notice))
                    {
                        <div class="alert alert-info">@notice</div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Monthly amount</div>
                                <div class="fs-5 fw-semibold">@Model.MonthlyAmountDisplay</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Entitlement</div>
                                <div class="fs-5 fw-semibold">@Model.EntitlementStatus</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Subscription status</div>
                                <div class="fw-semibold">@Model.SubscriptionStatus</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Payment standing</div>
                                <div class="fw-semibold">@Model.PaymentStanding</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Next billing date</div>
                                <div class="fw-semibold">@Model.NextBillingDateDisplay</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small mb-1">Current period</div>
                                <div class="fw-semibold">@Model.CurrentPeriodDisplay</div>
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-4">
                        <div class="text-muted small mb-1">Cancellation state</div>
                        <div class="fw-semibold mb-2">@Model.CancellationState</div>
                        <p class="text-muted mb-0">@Model.PaymentRepairInstructions</p>
                    </div>

                    <div class="d-flex flex-column flex-md-row gap-2">
                        @if (Model.CanCancelAtPeriodEnd)
                        {
                            <form asp-action="CancelAtPeriodEnd" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit" class="btn btn-dark">Cancel At Period End</button>
                            </form>
                        }
                        <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
