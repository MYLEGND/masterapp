@model ClientApp.Models.ClientSubscriptionManagementViewModel
@{
    ViewData["Title"] = "Membership & Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var notice = ViewData["SubscriptionNotice"] as string;
    var squareScriptUrl = string.Equals(Model.SquareEnvironment, "Production", StringComparison.OrdinalIgnoreCase)
        ? "https://web.squarecdn.com/v1/square.js"
        : "https://sandbox.web.squarecdn.com/v1/square.js";
}

<div class="dashboard-page-shell membership-billing-page">
    <section class="membership-billing-hero">
        <div class="membership-billing-hero-copy">
            <div class="dashboard-eyebrow">Membership &amp; Billing</div>
            <h1>@Model.ClientName</h1>
            <p>Review your membership, billing schedule, payment method, and portal access.</p>
        </div>

        <div class="membership-billing-summary" aria-label="Membership summary">
            <div class="membership-billing-summary-item is-primary">
                <span>Monthly Amount</span>
                <strong>@Model.MonthlyAmountDisplay</strong>
            </div>

            <div class="membership-billing-summary-item">
                <span>Subscription</span>
                <strong>@Model.SubscriptionStatus</strong>
            </div>

            <div class="membership-billing-summary-item">
                <span>Next Billing</span>
                <strong>@Model.NextBillingDateDisplay</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <div class="membership-billing-notice" role="status">
            @notice
        </div>
    }

    <div class="membership-billing-layout">
        <div class="membership-billing-main">
            <section class="membership-billing-panel"
                     aria-labelledby="membership-overview-heading">
                <div class="membership-billing-panel-head">
                    <div>
                        <span class="membership-billing-kicker">Overview</span>
                        <h2 id="membership-overview-heading">Membership Details</h2>
                    </div>

                    <span class="membership-billing-badge">
                        <span class="membership-billing-dot" aria-hidden="true"></span>
                        @Model.SubscriptionStatus
                    </span>
                </div>

                <dl class="membership-billing-details">
                    <div>
                        <dt>Current Plan</dt>
                        <dd>@Model.CurrentPlanDisplay</dd>
                    </div>

                    <div>
                        <dt>Billing Frequency</dt>
                        <dd>@Model.BillingFrequencyDisplay</dd>
                    </div>

                    <div>
                        <dt>Monthly Amount</dt>
                        <dd>@Model.MonthlyAmountDisplay</dd>
                    </div>

                    <div>
                        <dt>Payment Standing</dt>
                        <dd>@Model.PaymentStanding</dd>
                    </div>

                    <div>
                        <dt>Portal Access</dt>
                        <dd>@Model.EntitlementStatus</dd>
                    </div>

                    <div>
                        <dt>Member Since</dt>
                        <dd>@Model.MemberSinceDisplay</dd>
                    </div>

                    <div>
                        <dt>Upcoming Renewal</dt>
                        <dd>@Model.NextBillingDateDisplay</dd>
                    </div>

                    <div>
                        <dt>Last Successful Payment</dt>
                        <dd>@Model.LastSuccessfulPaymentDisplay</dd>
                    </div>

                    <div>
                        <dt>Grace Period Ends</dt>
                        <dd>@Model.GracePeriodEndDisplay</dd>
                    </div>

                    <div class="membership-billing-details-wide">
                        <dt>Current Billing Period</dt>
                        <dd>@Model.CurrentPeriodDisplay</dd>
                    </div>
                </dl>
            </section>

            <section class="membership-billing-panel"
                     aria-labelledby="payment-method-heading">
                <div class="membership-billing-panel-head">
                    <div>
                        <span class="membership-billing-kicker">Payment</span>
                        <h2 id="payment-method-heading">Payment Method</h2>
                    </div>
                </div>

                @if (Model.PaymentMethods.Count > 0)
                {
                    <div class="membership-payment-method-list">
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <article class="membership-payment-method">
                                <div class="membership-payment-card-icon" aria-hidden="true">••••</div>

                                <div class="membership-payment-primary">
                                    <strong>@method.DisplayName</strong>
                                    <span>@method.CardDisplay · Expires @method.ExpirationDisplay</span>
                                </div>

                                <div class="membership-payment-meta">
                                    <span>Billing address</span>
                                    <strong>@method.BillingAddressDisplay</strong>
                                </div>

                                <div class="membership-payment-actions">
                                    @if (method.IsDefault)
                                    {
                                        <span class="membership-billing-payment-status">Default</span>
                                    }
                                    else if (Model.CanManagePaymentMethods)
                                    {
                                        <form action="/subscription/payment-methods/@method.Id/default" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                            <button type="submit" class="membership-billing-text-button">Set default</button>
                                        </form>
                                    }

                                    @if (Model.CanManagePaymentMethods)
                                    {
                                        <form action="/subscription/payment-methods/@method.Id/rename" method="post" class="membership-payment-rename-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                            <label class="visually-hidden" for="paymentMethodName-@method.Id">Payment method label</label>
                                            <input id="paymentMethodName-@method.Id" name="displayName" value="@method.DisplayName" maxlength="80" />
                                            <button type="submit" class="membership-billing-text-button">Rename</button>
                                        </form>

                                        <form action="/subscription/payment-methods/@method.Id/remove" method="post" onsubmit="return confirm('Remove this payment method?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                            <button type="submit" class="membership-billing-text-button is-danger">Remove</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="membership-billing-empty">
                        <strong>No payment method available</strong>
                        <span>No saved payment-method metadata is currently on file.</span>
                    </div>
                }

                @if (Model.CanManagePaymentMethods)
                {
                    <section class="membership-payment-add" aria-labelledby="add-payment-method-heading">
                        <div>
                            <span class="membership-billing-kicker">Secure update</span>
                            <h3 id="add-payment-method-heading">Add or replace a payment method</h3>
                            <p>New card details are secured directly with the payment provider. Your full card number is never stored here.</p>
                        </div>

                        @if (!Model.BrowserPaymentReady)
                        {
                            <div class="membership-billing-empty"><span>@Model.BrowserPaymentSetupMessage</span></div>
                        }
                        else
                        {
                            <form action="/subscription/payment-methods"
                                  method="post"
                                  data-square-payment-form
                                  data-square-app-id="@Model.SquareApplicationId"
                                  data-square-location-id="@Model.SquareLocationId"
                                  novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <input type="hidden" name="SourceId" data-square-source />

                                <div class="membership-payment-form-grid">
                                    <label>
                                        Card label
                                        <input name="DisplayName" maxlength="80" placeholder="e.g., Personal card" />
                                    </label>
                                    <label>
                                        Name on card
                                        <input name="CardholderName" autocomplete="cc-name" required />
                                    </label>
                                    <label class="is-wide">
                                        Street address
                                        <input name="BillingAddressLine1" autocomplete="address-line1" required />
                                    </label>
                                    <label>
                                        Apartment or suite
                                        <input name="BillingAddressLine2" autocomplete="address-line2" />
                                    </label>
                                    <label>
                                        ZIP code
                                        <input name="BillingPostalCode" autocomplete="postal-code" required />
                                    </label>
                                    <label>
                                        City
                                        <input name="BillingCity" autocomplete="address-level2" required />
                                    </label>
                                    <label>
                                        State
                                        <input name="BillingState" autocomplete="address-level1" required />
                                    </label>
                                    <label>
                                        Country
                                        <select name="BillingCountryCode" autocomplete="country-name" required>
                                            <option value="US" selected>United States</option>
                                        </select>
                                    </label>
                                    <label class="is-wide">
                                        Card details
                                        <span id="subscription-square-card" class="membership-square-card" data-square-card></span>
                                    </label>
                                </div>

                                <label class="membership-payment-default-choice">
                                    <input type="checkbox" name="MakeDefault" value="true" />
                                    Make this my default payment method
                                </label>
                                <div class="membership-payment-form-actions">
                                    <div class="membership-billing-notice" role="alert" data-square-message hidden></div>
                                    <button type="submit" class="membership-billing-button membership-billing-button-primary" data-square-submit>
                                        Save payment method
                                    </button>
                                </div>
                            </form>
                        }
                    </section>
                }
            </section>

            <section class="membership-billing-panel"
                     aria-labelledby="billing-history-heading">
                <div class="membership-billing-panel-head">
                    <div>
                        <span class="membership-billing-kicker">Payments</span>
                        <h2 id="billing-history-heading">Billing History</h2>
                    </div>
                </div>

                <div class="membership-billing-table-wrap">
                    <table class="membership-billing-table">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Type</th>
                                <th scope="col">Billing Period</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PaymentHistory.Count == 0)
                            {
                                <tr>
                                    <td colspan="5"
                                        class="membership-billing-table-empty">
                                        No subscription payments are on file.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var payment in Model.PaymentHistory)
                                {
                                    <tr>
                                        <td>@payment.DateDisplay</td>
                                        <td class="membership-billing-amount">
                                            @payment.AmountDisplay
                                        </td>
                                        <td>@payment.Kind</td>
                                        <td>@payment.BillingPeriodDisplay</td>
                                        <td>
                                            <span class="membership-billing-payment-status">
                                                @payment.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="membership-billing-sidebar">
            <section class="membership-billing-panel membership-billing-state"
                     aria-labelledby="membership-state-heading">
                <span class="membership-billing-kicker">Current State</span>
                <h2 id="membership-state-heading">Membership Status</h2>

                <div class="membership-billing-state-value">
                    <span class="membership-billing-dot" aria-hidden="true"></span>
                    <strong>@Model.CancellationState</strong>
                </div>

                <p>Your current membership lifecycle and portal-access standing.</p>
            </section>

            <section class="membership-billing-panel membership-billing-actions">
                <span class="membership-billing-kicker">Actions</span>
                <h2>Manage Membership</h2>
                <p>Return to your profile or manage the active membership.</p>

                <div class="membership-billing-action-list">
                    <a class="membership-billing-button membership-billing-button-primary"
                       href="@Model.ReturnUrl">
                        Back to Profile
                    </a>

                    @if (Model.CanCancelSubscription)
                    {
                        <form action="/subscription/cancel"
                              method="post"
                              onsubmit="return confirm('Cancel your subscription? This immediately ends portal access.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="returnUrl"
                                   value="@Model.ReturnUrl" />

                            <button type="submit"
                                    class="membership-billing-button membership-billing-button-danger">
                                Cancel Subscription
                            </button>
                        </form>
                    }

                    @if (Model.CanRetryPayment)
                    {
                        <form action="/subscription/retry-payment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="membership-billing-button membership-billing-button-primary">
                                Try Payment Again
                            </button>
                        </form>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    @if (Model.CanManagePaymentMethods && Model.BrowserPaymentReady)
    {
        <script src="@squareScriptUrl"></script>
        <script src="~/js/subscription-activation.js" asp-append-version="true"></script>
    }
}
