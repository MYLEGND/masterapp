@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var firstRowTools = new[]
    {
        new { Name = "Spiritual Health", Icon = "faith.png", Description = "When your spirit is nourished, everything else has room to grow. Whether you connect through prayer, meditation, nature, or community, anchoring to something bigger than yourself can soften anxiety, sharpen purpose, and make room for hope on hard days." },
        new { Name = "Mental Health", Icon = "mind.png", Description = "Your mind sets the tone for your day and how you show up for the people you love. Small, consistent practices such as sleep, movement, honest conversations, and asking for help create resilience. You are not meant to carry the heavy things alone." },
        new { Name = "Physical Health", Icon = "health.png", Description = "Treat your body like a trusted teammate. Gentle routines like stretching, walking, and fueling up with real food build steady energy and prove you are worth investing in one habit at a time." },
        new { Name = "Financial Health", Icon = "finance.png", Description = "Money touches nearly every decision, so confidence here brings real peace. A clear budget, a simple plan for saving, and protection against surprises all work together." }
    };

    var secondRowTools = new[]
    {
        new { Name = "Legal Risk", Icon = "legal.png", Description = "Put your wishes in writing before life gets noisy. Simple documents such as wills, powers of attorney, and beneficiary reviews keep decisions in your hands and reduce stress for the people you love." },
        new { Name = "Health Risk", Icon = "health-risk.png", Description = "Health can change quickly. Planning for care, costs, and who speaks for you when you cannot makes tough moments calmer and gives your family clearer guidance." },
        new { Name = "Life Risk", Icon = "life-event.jpg", Description = "Life throws curveballs. Protecting your paycheck and your family’s needs with the right coverage and cash buffers keeps a hard season from becoming a crisis." },
        new { Name = "Legacy Transfer", Icon = "legacy.png", Description = "Legacy is more than assets. With a plan, you decide how resources support people and causes you care about, and you leave clarity instead of confusion." }
    };

    var toolRows = new[] { firstRowTools, secondRowTools };
}

@section Styles {
    <link rel="stylesheet" href="~/_content/Shared/css/dashboard-home-shared.css" asp-append-version="true" />
}

<div class="dashboard-page-shell client-create-page">
    <section class="dashboard-command-center-panel">
        <div class="dashboard-command-center-top">
            <div class="dashboard-hero-copy">
                <div class="dashboard-eyebrow">Client Home</div>
                <h1 class="dashboard-hero-title">Legend™ Legacy Protection</h1>
                <p class="dashboard-analytics-copy">Your personal access point for life, wellness, and financial clarity inside the same dashboard system used by AgentPortal.</p>
            </div>
            <div class="d-grid gap-3" aria-label="Home page focus areas">
                <div class="dashboard-stat-card is-primary">
                    <div class="dashboard-stat-label">Clarity</div>
                    <div class="dashboard-stat-value">8</div>
                    <div class="dashboard-stat-note">Core planning lanes</div>
                </div>
                <div class="dashboard-stat-card">
                    <div class="dashboard-stat-label">Action</div>
                    <div class="dashboard-stat-value">1</div>
                    <div class="dashboard-stat-note">Protection snapshot</div>
                </div>
            </div>
        </div>
    </section>

    <section class="client-create-section-shell">
        <div class="client-create-section-head">
            <div class="client-create-section-title">Build And Protect Your Legacy</div>
            <p class="client-create-section-copy">Select any planning lane to open a focused explanation without leaving the dashboard.</p>
        </div>

        @foreach (var toolRow in toolRows)
        {
            <div class="client-dashboard-grid">
                @foreach (var tool in toolRow)
                {
                    <button type="button"
                            class="client-dashboard-tile category-trigger"
                            data-title="@tool.Name"
                            data-description="@tool.Description">
                        <span class="client-dashboard-tile-media">
                            <img src="@Url.Content($"~/images/company-icons/{tool.Icon}")"
                                 alt="@tool.Name"
                                 class="client-dashboard-tile-icon" />
                            <span class="legend-badge">Focus</span>
                        </span>
                        <span class="client-dashboard-tile-title">@tool.Name</span>
                        <span class="client-dashboard-tile-copy">@tool.Description</span>
                        <span class="client-dashboard-tile-foot">Open Insight</span>
                    </button>
                }
            </div>
        }
    </section>

    <section class="client-edit-section client-edit-section-spaced">
        <div class="client-edit-section-head">
            <div>
                <div class="client-create-section-title">Shared Client And Agent View</div>
                <p class="client-edit-note">Track readiness, legal and beneficiary reviews, life events, and follow-up focus in one premium workspace.</p>
            </div>
            <a class="client-create-button client-create-button-primary" asp-controller="ProtectionSnapshot" asp-action="Index">Launch Protection Snapshot</a>
        </div>
    </section>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="client-create-panel">
                <div class="client-create-header">
                    <div>
                        <div class="dashboard-eyebrow">Build And Protect Your Legacy</div>
                        <h2 class="client-create-title" id="categoryModalTitle">Focus Area</h2>
                    </div>
                    <button type="button" class="client-create-button client-create-button-secondary" data-bs-dismiss="modal">Close</button>
                </div>
                <div class="client-create-body">
                    <div class="client-edit-section client-edit-section-compact">
                        <p class="client-edit-note" id="categoryModalBody"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalEl = document.getElementById('categoryModal');
            const titleEl = document.getElementById('categoryModalTitle');
            const bodyEl = document.getElementById('categoryModalBody');
            const modalApi = window.bootstrap?.Modal;
            const modal = modalEl && modalApi
                ? (typeof modalApi.getOrCreateInstance === 'function' ? modalApi.getOrCreateInstance(modalEl) : new modalApi(modalEl))
                : null;

            document.querySelectorAll('.category-trigger').forEach((trigger) => {
                trigger.addEventListener('click', () => {
                    if (!modal || !titleEl || !bodyEl) return;
                    titleEl.textContent = trigger.getAttribute('data-title') || 'Focus Area';
                    bodyEl.textContent = trigger.getAttribute('data-description') || '';
                    modal.show();
                });
            });
        })();
    </script>
}
