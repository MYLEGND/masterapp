@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sections = new[]
    {
        new
        {
            Title = "Spiritual Health",
            Prompt = "Looking for guidance, clarity, or spiritual support in this season of life?",
            Tools = new[]
            {
                new { Name = "Jack Hawkins", Url = "https://connect.integrity.com/agent/dashboard", Icon = "integrity.png", Desc = "Life insurance quote tool, CRM, and life leads marketplace." }
            }
        },
        new
        {
            Title = "Mental Health",
            Prompt = "Need support strengthening your mindset, emotional health, or personal resilience?",
            Tools = new[]
            {
                new { Name = "Bryan Fobs", Url = "https://login.glic.com/", Icon = "guardian.png", Desc = "Top-rated carriers for life insurance and disability income." }
            }
        },
        new
        {
            Title = "Physical Health",
            Prompt = "Focused on improving your physical health, energy, or long-term vitality?",
            Tools = new[]
            {
                new { Name = "Bryan Fobbs", Url = "https://app.ezlynx.com/auth/account/login", Icon = "ezlynx.png", Desc = "Property and casualty quote access with CRM support." }
            }
        },
        new
        {
            Title = "Financial Health",
            Prompt = "Working to bring structure, confidence, and clarity to your financial life?",
            Tools = new[]
            {
                new { Name = "Anthony Synegal", Url = "https://app.ezlynx.com/auth/account/login", Icon = "ezlynx.png", Desc = "Property and casualty quote access with CRM support." }
            }
        }
    };
}

<div class="dashboard-page-shell client-create-page">
    <section class="dashboard-command-center-panel">
        <div class="dashboard-command-center-top">
            <div class="dashboard-hero-copy">
                <div class="dashboard-eyebrow">Trusted Partners</div>
                <h1 class="dashboard-hero-title">Meet Our Trusted Partners</h1>
                <p class="dashboard-analytics-copy">Search the network quickly, then jump straight into the partner or tool that supports the client’s next move.</p>
            </div>
            <div class="d-grid gap-3" aria-label="Trusted partner page summary">
                <div class="dashboard-stat-card is-primary">
                    <div class="dashboard-stat-label">Categories</div>
                    <div class="dashboard-stat-value">@sections.Length</div>
                    <div class="dashboard-stat-note">Partner lanes</div>
                </div>
                <div class="dashboard-stat-card">
                    <div class="dashboard-stat-label">Search</div>
                    <div class="dashboard-stat-value">Live</div>
                    <div class="dashboard-stat-note">Name or industry</div>
                </div>
            </div>
        </div>
    </section>

    <section class="client-create-section-shell">
        <div class="client-create-section-head">
            <div class="client-create-section-title">Partner Search</div>
            <p class="client-create-section-copy">Search partners by name or service focus, then open the result in a new tab.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <div class="search-input-wrap">
                <input type="text"
                       id="toolSearch"
                       class="search-input"
                       placeholder="Search partners or industry..."
                       autocomplete="off"
                       aria-label="Search trusted partners" />
                <div id="autocompleteList" class="autocomplete-list"></div>
            </div>
            <button type="button" id="clearSearch" class="client-create-button client-create-button-secondary">Clear Search</button>
        </div>
    </section>

    @foreach (var partnerSection in sections)
    {
        <section class="client-create-section-shell client-edit-section-spaced">
            <div class="client-create-section-head">
                <div class="client-create-section-title">@partnerSection.Title</div>
                <p class="client-create-section-copy">@partnerSection.Prompt</p>
            </div>
            <div class="client-dashboard-grid">
                @foreach (var tool in partnerSection.Tools)
                {
                    <a href="@tool.Url"
                       target="_blank"
                       rel="noopener"
                       class="client-dashboard-tile trusted-partner-card"
                       data-name="@tool.Name"
                       data-description="@tool.Desc">
                        <span class="client-dashboard-tile-media">
                            <img src="@Url.Content($"~/images/company-icons/{tool.Icon}")"
                                 alt="@tool.Name"
                                 class="client-dashboard-tile-icon" />
                            <span class="legend-badge">@partnerSection.Title</span>
                        </span>
                        <span class="client-dashboard-tile-title">@tool.Name</span>
                        <span class="client-dashboard-tile-copy">@tool.Desc</span>
                        <span class="client-dashboard-tile-foot">Launch Partner</span>
                    </a>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('toolSearch');
            const autocompleteList = document.getElementById('autocompleteList');
            const clearBtn = document.getElementById('clearSearch');
            const searchWrap = searchInput?.closest('.search-input-wrap');
            const tools = Array.from(document.querySelectorAll('.trusted-partner-card')).map((tool) => ({
                name: tool.getAttribute('data-name') || '',
                description: (tool.getAttribute('data-description') || '').toLowerCase(),
                href: tool.getAttribute('href') || '#',
                imgSrc: tool.querySelector('img')?.getAttribute('src') || ''
            }));

            function hideList() {
                if (!autocompleteList) return;
                autocompleteList.style.display = 'none';
                autocompleteList.innerHTML = '';
            }

            function positionList() {
                if (!searchInput || !autocompleteList || !searchWrap) return;
                const rect = searchInput.getBoundingClientRect();
                autocompleteList.style.left = `${Math.round(rect.left)}px`;
                autocompleteList.style.top = `${Math.round(rect.bottom + 8)}px`;
                autocompleteList.style.width = `${Math.round(Math.max(rect.width, searchWrap.getBoundingClientRect().width))}px`;
            }

            function renderMatches(matches) {
                if (!autocompleteList) return;
                autocompleteList.innerHTML = '';

                matches.forEach((tool) => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'autocomplete-item';
                    item.innerHTML = `
                        <span class="autocomplete-item-media">
                            <img src="${tool.imgSrc}" alt="" />
                        </span>
                        <span class="autocomplete-item-label">${tool.name}</span>
                    `;
                    item.addEventListener('click', () => window.open(tool.href, '_blank', 'noopener'));
                    autocompleteList.appendChild(item);
                });

                positionList();
                autocompleteList.style.display = matches.length ? 'block' : 'none';
            }

            clearBtn?.addEventListener('click', () => {
                if (searchInput) searchInput.value = '';
                hideList();
                searchInput?.focus();
            });

            searchInput?.addEventListener('input', () => {
                const value = (searchInput.value || '').trim().toLowerCase();
                if (!value) {
                    hideList();
                    return;
                }

                const matches = tools.filter((tool) =>
                    tool.name.toLowerCase().includes(value) || tool.description.includes(value));

                renderMatches(matches);
            });

            searchInput?.addEventListener('focus', () => {
                if (autocompleteList?.children.length) {
                    positionList();
                    autocompleteList.style.display = 'block';
                }
            });

            document.addEventListener('click', (event) => {
                if (!searchWrap?.contains(event.target)) {
                    hideList();
                }
            });

            window.addEventListener('resize', positionList);
            window.addEventListener('scroll', positionList, true);
        });
    </script>
}
