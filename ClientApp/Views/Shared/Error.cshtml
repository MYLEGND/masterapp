@model AgentPortal.Models.ErrorViewModel
@{
    ViewData["Title"] = "Unable to complete request";
    var accessDenied = Context.Response.StatusCode == 403;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <h1 class="h3">@(accessDenied ? "Access denied" : "We couldn't complete this request")</h1>
                    <p>@(accessDenied ? "Your current account does not have permission to open this page." : "Please try again. If the problem continues, contact support and share the request ID.")</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="mb-0">Request ID: <code translate="no">@Model.RequestId</code></p>
                    }
                    @if (ViewData["FounderDiagnosticsUrl"] is string diagnosticsUrl)
                    {
                        <a class="btn btn-outline-primary mt-3" href="@diagnosticsUrl">Open diagnostics</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
