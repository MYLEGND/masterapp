<script src="~/js/number-format.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        const isAgentView = @(isAgentView ? "true" : "false");
        const clientProfileId = @Html.Raw(JsonSerializer.Serialize(managedClientProfileId));
        const stopManagedViewUrl = @Html.Raw(JsonSerializer.Serialize(stopManagedViewUrl));
        const sessionFlagKey = "legendAgentViewActive";
        const sessionClientKey = "legendAgentViewClientProfileId";
        const launchCookieName = "impClientLaunch";

        function safeGet(getter, fallback) {
            try {
                return getter();
            } catch (error) {
                return fallback;
            }
        }

        function safeRun(callback) {
            try {
                callback();
            } catch (error) {
                /* ignore transient storage/cookie issues */
            }
        }

        function readCookie(name) {
            const prefix = `${name}=`;
            const cookies = document.cookie ? document.cookie.split(";") : [];
            for (const rawCookie of cookies) {
                const cookie = rawCookie.trim();
                if (cookie.startsWith(prefix)) {
                    return decodeURIComponent(cookie.substring(prefix.length));
                }
            }

            return "";
        }

        function deleteCookie(name) {
            document.cookie = `${name}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax`;
        }

        if (!isAgentView) {
            safeRun(() => sessionStorage.removeItem(sessionFlagKey));
            safeRun(() => sessionStorage.removeItem(sessionClientKey));
            deleteCookie(launchCookieName);
            return;
        }

        const sessionArmed = safeGet(() => sessionStorage.getItem(sessionFlagKey) === "1", false);
        const storedClientProfileId = safeGet(() => sessionStorage.getItem(sessionClientKey) || "", "");
        const launchClientProfileId = readCookie(launchCookieName);
        const sessionMatchesClient = sessionArmed && (!storedClientProfileId || storedClientProfileId === clientProfileId);
        const launchMatchesClient = !!launchClientProfileId && (!clientProfileId || launchClientProfileId === clientProfileId);

        if (!sessionMatchesClient && !launchMatchesClient) {
            safeRun(() => sessionStorage.removeItem(sessionFlagKey));
            safeRun(() => sessionStorage.removeItem(sessionClientKey));
            window.location.replace(stopManagedViewUrl);
            return;
        }

        safeRun(() => sessionStorage.setItem(sessionFlagKey, "1"));
        safeRun(() => sessionStorage.setItem(sessionClientKey, clientProfileId));
        deleteCookie(launchCookieName);
    })();
</script>
<script>
    (function () {
        const trigger = document.getElementById('exploreTrigger');
        const drawer = document.getElementById('exploreDrawer');
        const overlay = document.getElementById('exploreOverlay');
        const search = document.getElementById('exploreSearch');
        const list = document.getElementById('exploreList');

        if (!trigger || !drawer || !overlay || !search || !list) return;

        function openDrawer() {
            drawer.classList.add('open');
            overlay.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
            window.setTimeout(() => search.focus(), 80);
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            overlay.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');
        }

        trigger.addEventListener('click', function () {
            if (drawer.classList.contains('open')) closeDrawer();
            else openDrawer();
        });

        overlay.addEventListener('click', closeDrawer);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeDrawer();
        });

        search.addEventListener('input', function () {
            const q = (search.value || '').trim().toLowerCase();
            list.querySelectorAll('.explore-item').forEach(function (item) {
                const txt = item.textContent.toLowerCase();
                item.style.display = txt.includes(q) ? '' : 'none';
            });
        });

        // Close drawer when an explore link is selected
        list.querySelectorAll('.explore-item').forEach(function (item) {
            item.addEventListener('click', function () {
                closeDrawer();
            });
        });
    })();
</script>

<script src="~/_content/Shared/js/life-hac.js" asp-append-version="true"></script>
<script src="~/_content/Shared/js/legend-global-navigation.js" asp-append-version="true"></script>
@await Html.PartialAsync("~/Views/Messaging/_SignalRClient.cshtml")
