<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using System.Text.Json
@using Domain.Entities
@using System.IO
@using Shared.Messaging
@inject IHttpContextAccessor HttpContextAccessor
@inject ClientApp.Services.EffectiveClientContextService ClientContextService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var layoutController =
        (ViewContext.ActionDescriptor as Microsoft.AspNetCore.Mvc.Controllers.ControllerActionDescriptor)?.ControllerName
        ?? "";
    var loadSharedFinanceStyles = string.Equals(layoutController, "Finance", StringComparison.OrdinalIgnoreCase);
    var usesSharedDashboardHost =
        string.Equals(layoutController, "Home", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(layoutController, "Profile", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(layoutController, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var messagingClientContext = ClientContextService.ResolveAsync(User, Context.Request.Cookies).GetAwaiter().GetResult();
    var messagingActorId = messagingClientContext is { IsAgentView: false } &&
        !string.IsNullOrWhiteSpace(messagingClientContext.ClientUserId)
            ? messagingClientContext.ClientUserId.Trim()
            : "";
    var messagingServiceContactName = messagingClientContext is { IsAgentView: false }
        ? messagingClientContext.AgentDisplayName?.Trim()
        : null;
    var messagingServiceContactPhone = messagingClientContext is { IsAgentView: false }
        ? messagingClientContext.AgentPhone?.Trim()
        : null;
    var messagingServiceContactEmail = messagingClientContext is { IsAgentView: false }
        ? messagingClientContext.AgentEmail?.Trim()
        : null;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Html.Raw(ViewData["Title"]) - Legend™</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=20260528-royal2" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-inline.css?v=20260528-royal2" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Shared/css/dashboard-home-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LegendCorePlatform.styles.css" asp-append-version="true" />
    @if (loadSharedFinanceStyles)
    {
        <link rel="stylesheet" href="~/_content/Shared/css/legend-finance-shared.css" asp-append-version="true" />
    }
    @await Html.PartialAsync("~/Views/Diagnostics/_PageHealth.cshtml")
    @RenderSection("Styles", required: false)

    <!-- Google Font for Psalms 23 | Proverbs 3:5-6 -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

    <link rel="icon" type="image/png" href="~/images/favicon/favicon.png" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100@(loadSharedFinanceStyles ? " finance-page" : "")@(usesSharedDashboardHost ? " dashboard-shared-host" : "")">

<header>
    <nav class="navbar navbar-expand-sm navbar-dark legend-global-nav" data-legend-global-nav>
        <div class="container-fluid d-flex flex-wrap align-items-start justify-content-between">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/company-icons/legend-protect-transparent.png" asp-append-version="true" alt="Legend™" />
            </a>

            <button class="nav-toggle" id="clientNavToggle" data-legend-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
                <span class="nav-toggle-bars"></span>
            </button>

            <div class="navbar-left">
                <div class="nav-rows-grid">
                    <ul class="navbar-nav nav-row">
                        @{
                            var currentController =
                                (ViewContext.ActionDescriptor as Microsoft.AspNetCore.Mvc.Controllers.ControllerActionDescriptor)?.ControllerName;
                            string Active(string c) => c == currentController ? "active" : "";
                        }

                        @{
                            var ctx = messagingClientContext;
                            bool isBusinessClient = false;
                            string managedClientName = "Client";
                            var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
                            var stopManagedViewUrl = $"/support/stop-view-as-client?returnUrl={System.Uri.EscapeDataString(currentReturnUrl)}";
                            var isAgentView = ctx?.IsAgentView == true;
                            var managedClientProfileId = ctx?.ClientProfileId.ToString() ?? "";
                            if (ctx?.Profile != null)
                            {
                                isBusinessClient = string.Equals(ResolveRecordType(ctx.Profile), "BusinessClient", StringComparison.OrdinalIgnoreCase);
                                managedClientName = $"{ctx.Profile.FirstName} {ctx.Profile.LastName}".Trim();
                                if (string.IsNullOrWhiteSpace(managedClientName))
                                {
                                    managedClientName = "Client";
                                }
                            }
                        }

                        <li class="nav-item nav-item-explore">
                            <button id="exploreTrigger"
                                    type="button"
                                    class="explore-trigger"
                                    aria-label="Open Explore"
                                    aria-controls="exploreDrawer"
                                    aria-expanded="false">
                                <div class="explore-bars" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </button>
                        </li>

                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Finance")" asp-controller="Finance" asp-action="Index">Finance</a></li>
                        <li class="nav-item"><a class="nav-link" href="https://protect.mylegnd.com/Quote" target="_blank" rel="noopener">Insurance Quote</a></li>
                    </ul>
                    @if (isAgentView)
                    {
                        <div class="nav-context-row">
                            <span class="nav-context-pill">Managing <strong>@managedClientName</strong></span>
                            <a class="nav-context-exit" href="@stopManagedViewUrl">Exit View</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Center Psalms 23 | Proverbs 3:5-6 -->
            @await Html.PartialAsync("~/Views/Messaging/_LifeHacTrigger.cshtml")

            <div class="navbar-right">
            @{
                    var user = HttpContextAccessor.HttpContext?.User;
                    var isAuthenticated = user?.Identity?.IsAuthenticated == true;
                    string? CleanToken(string? s)
                    {
                        if (string.IsNullOrWhiteSpace(s)) return null;
                        var t = s.Trim();
                        if (t.Contains("@")) return null;
                        if (t.Contains(".")) return null;
                        var parts = t.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        return parts.Length > 0 ? parts[0] : null;
                    }
                    string? Initial(string? s)
                    {
                        if (string.IsNullOrWhiteSpace(s)) return null;
                        var t = s.Trim();
                        return t.Length > 0 ? t.Substring(0, 1).ToUpperInvariant() : null;
                    }

                    var displayName = "Agent";
                    string? first = null;
                    string? last = null;
                    string? avatarUrl = null;
                    string? userId = null;

                    if (isAuthenticated && user is not null)
                    {
                        if (!isAgentView && messagingClientContext?.Profile != null)
                        {
                            first = CleanToken(messagingClientContext.Profile.FirstName);
                            last = CleanToken(messagingClientContext.Profile.LastName);

                            displayName = string.Join(
                                " ",
                                new[] { first, last }.Where(x => !string.IsNullOrWhiteSpace(x)));

                            if (string.IsNullOrWhiteSpace(displayName))
                            {
                                displayName = "Client";
                            }
                        }
                        else
                        {
                            first =
                                CleanToken(user.FindFirst("given_name")?.Value)
                                ?? CleanToken(user.FindFirst(ClaimTypes.GivenName)?.Value)
                                ?? CleanToken(user.FindFirst("name")?.Value);

                            last =
                                CleanToken(user.FindFirst("family_name")?.Value)
                                ?? CleanToken(user.FindFirst(ClaimTypes.Surname)?.Value);

                            displayName =
                                (!string.IsNullOrWhiteSpace(first) || !string.IsNullOrWhiteSpace(last))
                                    ? string.Join(" ", new[] { first, last }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                    : user.FindFirst("name")?.Value
                                      ?? user.FindFirst(ClaimTypes.Name)?.Value
                                      ?? first
                                      ?? "Agent";
                        }

                        userId =
                            user.FindFirst("oid")?.Value
                            ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                            ?? user.Identity?.Name;

                        avatarUrl =
                            user.FindFirst("picture")?.Value
                            ?? user.FindFirst("photo")?.Value
                            ?? user.FindFirst("avatar")?.Value
                            ?? user.FindFirst("avatar_url")?.Value
                            ?? user.FindFirst("profile_image")?.Value
                            ?? user.FindFirst("image")?.Value;

                    }

                    var initials = (Initial(first) ?? "") + (Initial(last) ?? "");
                    if (string.IsNullOrWhiteSpace(initials))
                    {
                        initials = Initial(displayName) ?? "A";
                    }

                    if (avatarUrl == null && !string.IsNullOrWhiteSpace(userId))
                    {
                        avatarUrl = Url.Action("Current", "Avatar");
                    }
                }

                <a class="nav-link" href="https://www.mylegnd.com/store" target="_blank">Store</a>
                @if (!isAgentView && !string.IsNullOrWhiteSpace(messagingActorId))
                {
                    @await Html.PartialAsync("~/Views/Messaging/_NavButton.cshtml")
                }

                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <button class="profile-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@displayName">
                            <div class="profile-avatar">
                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="Profile photo" loading="lazy" />
                                }
                                else
                                {
                                    <span>@initials</span>
                                }
                            </div>
                            <div class="profile-meta">
                                <span class="profile-name">@displayName</span>
                                <span class="visually-hidden">Profile menu</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-contact-menu">
                            <li><a class="dropdown-item" href="/profile">VIEW/EDIT PROFILE</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>

        </div>
    </nav>
</header>

@if (!string.IsNullOrWhiteSpace(messagingActorId))
{
    @await Html.PartialAsync(
        "~/Views/Messaging/_CommandCenter.cshtml",
        new MessagingCommandCenterViewModel(
            messagingActorId,
            messagingServiceContactName,
            messagingServiceContactPhone,
            messagingServiceContactEmail,
            "Search your agent or Journey Circles connections...",
            "Choose your servicing agent or an accepted Journey Circles connection to begin.",
            SupportsJourneyCircles: !isAgentView,
            CurrentParticipantType: "Client"))
}

<div id="exploreOverlay" class="explore-overlay" aria-hidden="true"></div>

<aside id="exploreDrawer" class="explore-drawer" aria-label="Explore Panel">
