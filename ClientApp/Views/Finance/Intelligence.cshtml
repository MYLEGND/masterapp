@model Domain.FinancialIntelligence.FinancialIntelligenceSnapshot
@{
    ViewData["Title"] = "Financial Intelligence";
}

<div class="container-fluid finance-shell mt-5">
    <header class="finance-header text-center mb-4">
        <div class="finance-subtitle">Financial Intelligence</div>
        <p class="mb-2">Prioritized, explainable financial planning signals from your connected data and completed finance tools.</p>
        @if (Model.LastEvaluatedUtc is DateTime evaluatedUtc)
        {
            <p class="small mb-2">Last evaluated <time datetime="@evaluatedUtc.ToString("O")">@evaluatedUtc.ToString("u")</time>.</p>
        }
        else
        {
            <p class="small mb-2">No evaluation has been run yet.</p>
        }
        <form asp-controller="Finance" asp-action="EvaluateIntelligence" method="post">
            @Html.AntiForgeryToken()
            <button class="btn finance-toolbar-btn" type="submit">Refresh intelligence</button>
        </form>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="row g-3 finance-tools-row mx-auto">
        <div class="col-md-4 d-flex">
            <section class="finance-side-card w-100 p-3">
                <h2 class="h5">Data completeness</h2>
                <p class="mb-0">@Model.DataCompletenessScore.ToString("P0") coverage from currently reliable inputs.</p>
            </section>
        </div>
        <div class="col-md-4 d-flex">
            <section class="finance-side-card w-100 p-3">
                <h2 class="h5">Personalization</h2>
                <p class="mb-0">@Model.PersonalizationMaturity</p>
            </section>
        </div>
        <div class="col-md-4 d-flex">
            <section class="finance-side-card w-100 p-3">
                <h2 class="h5">Current summary</h2>
                <p class="mb-1">@Model.CurrentRiskSummary</p>
                <p class="mb-0">@Model.CurrentOpportunitySummary</p>
            </section>
        </div>
    </div>

    <section class="finance-main mt-4 p-3">
        <h1 class="h4">Prioritized findings</h1>
        <p class="small">These educational signals are not financial, tax, legal, insurance, investment, or credit advice. Review decisions with the appropriate professional.</p>
        @if (Model.Findings.Count == 0)
        {
            <p class="mb-0">No client-visible findings are available. Refresh after connecting data or completing a finance tool.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var finding in Model.Findings)
                {
                    <article class="col-12">
                        <div class="finance-side-card w-100 p-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <div>
                                    <h2 class="h5 mb-1">@finding.Title</h2>
                                    <p class="mb-1">@finding.Explanation</p>
                                    <p class="small mb-1"><strong>Why am I seeing this?</strong> @finding.EvidenceSummary</p>
                                    <p class="small mb-1">Confidence: @finding.Confidence.ToString("P0") · @finding.Urgency urgency</p>
                                    @if (!string.IsNullOrWhiteSpace(finding.Disclaimer))
                                    {
                                        <p class="small mb-0">@finding.Disclaimer</p>
                                    }
                                </div>
                                <form asp-controller="Finance" asp-action="IntelligenceFeedback" method="post" class="align-self-start">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="findingId" value="@finding.Id" />
                                    <label class="visually-hidden" for="feedback-@finding.Id">Update finding</label>
                                    <select id="feedback-@finding.Id" name="feedbackType" class="form-select form-select-sm mb-2">
                                        <option value="Viewed">Mark viewed</option>
                                        <option value="Helpful">Helpful</option>
                                        <option value="NotHelpful">Not helpful</option>
                                        <option value="Accepted">Accepted</option>
                                        <option value="Deferred">Defer</option>
                                        <option value="Dismissed">Dismiss</option>
                                        <option value="ActionStarted">Action started</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                    <button class="btn finance-toolbar-btn" type="submit">Save</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
