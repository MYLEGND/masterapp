<div id="financeRoot"
     data-client-profile-id="@ViewBag.ClientProfileId"
     data-client-user-id="@ViewBag.ClientUserId"
     data-finance-app="client"
     data-finance-scope-fallback="client"
     data-enable-growth-calculator="false"
     data-enable-advanced-wealth-forecast="false"
     data-enable-client-plan-search="false"
     data-enable-distribution-planner="false"
     data-is-business-client="@(((bool?)ViewBag.IsBusinessClient == true).ToString().ToLowerInvariant())"
     data-client-first-name="@(ViewBag.ClientFirstName ?? "")"
     data-spouse-first-name="@(ViewBag.SpouseFirstName ?? "")"
     data-has-spouse="@(((bool?)ViewBag.HasSpouse == true).ToString().ToLowerInvariant())"></div>
<form id="__af" method="post" class="finance-antiforgery-form">
    @Html.AntiForgeryToken()
</form>
@{
    ViewData["Title"] = "Finance";
}

<div class="container-fluid finance-shell mt-5">

    <div class="finance-header text-center mb-4">
        <div class="finance-subtitle">Pick a tool below — your goals, alerts, and calculators stay in sync.</div>

        <div class="finance-toolbar-shell mt-3">
            <div class="finance-selector-row">
                <div class="finance-select-wrap">
                    <select id="budgetDropdown" class="form-select finance-select shadow-sm" aria-label="Open another finance tool">
                        <option value="" selected disabled>Open Another Tool</option>
                    </select>
                </div>
                <button type="button"
                        class="btn finance-toolbar-btn finance-default-tool-btn"
                        id="btnFinancialHealthSnapshot"
                        aria-pressed="true">
                    Financial Health Snapshot
                </button>
                <button type="button" class="btn finance-toolbar-btn" id="btnToggleSupportPanels">Goals + Alerts</button>
            </div>
        </div>
    </div>

    <div class="row w-100 g-4 align-items-stretch finance-tools-row mx-auto">
        <div class="col-12 d-flex">
            <div id="budget-embed" class="finance-main flex-grow-1"></div>
        </div>
    </div>

    <div class="finance-support-overlay d-none" id="financeSupportPanels" aria-hidden="true">
        <div class="finance-support-backdrop" data-support-close="true"></div>
        <div class="finance-support-modal" role="dialog" aria-modal="true" aria-label="Goals and alerts">
            <div class="finance-support-modal-head">
                <strong>Goals &amp; Alerts</strong>
                <button type="button" class="btn finance-support-close" id="btnCloseSupportPanels" aria-label="Close">Close</button>
            </div>

            <div class="finance-support-grid">
                <div class="finance-action-container finance-side-card w-100">
                </div>
                <div class="finance-goals-container finance-side-card w-100">
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/_content/Shared/js/legend-living-balance-sheet.js" asp-append-version="true"></script>
<script src="~/_content/Shared/js/finance-tools.js" asp-append-version="true"></script>
<script src="~/_content/Shared/js/goals.js" asp-append-version="true"></script>
<script src="~/_content/Shared/js/alerts.js" asp-append-version="true"></script>
<script src="~/_content/Shared/js/finance-shell.js" asp-append-version="true"></script>
