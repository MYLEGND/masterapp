@model Domain.Entities.ClientProfile
@using Domain.Entities

@{
    ViewData["Title"] = "Profile";

    var viewMode = (string)(ViewBag.ViewMode ?? "client");
    viewMode = (viewMode ?? "client").Trim().ToLowerInvariant();
    var viewingClientName = ((string?)(ViewBag.ViewingClientName) ?? $"{Model.FirstName} {Model.LastName}").Trim();

    var badge = viewMode == "agent" ? "Agent View" : "My Profile";

    var so = ViewBag.SignificantOther as HouseholdMember;
    var children = (ViewBag.Children as IEnumerable<HouseholdMember>)?
        .Where(x =>
            !string.IsNullOrWhiteSpace(x.FirstName) ||
            !string.IsNullOrWhiteSpace(x.LastName) ||
            x.DOB.HasValue ||
            !string.IsNullOrWhiteSpace(x.Email) ||
            !string.IsNullOrWhiteSpace(x.Phone))
        .ToList() ?? new List<HouseholdMember>();

    HouseholdMember? soFallback = null;

    string T(string? v) => (v ?? "").Trim();

    var hasSoOnProfile =
        !string.IsNullOrWhiteSpace(T(Model.SignificantOtherFirstName)) ||
        !string.IsNullOrWhiteSpace(T(Model.SignificantOtherLastName)) ||
        Model.SignificantOtherDOB.HasValue ||
        !string.IsNullOrWhiteSpace(T(Model.SignificantOtherEmail)) ||
        !string.IsNullOrWhiteSpace(T(Model.SignificantOtherPhone));

    if (so == null && hasSoOnProfile)
    {
        soFallback = new HouseholdMember
        {
            FirstName = T(Model.SignificantOtherFirstName),
            LastName = T(Model.SignificantOtherLastName),
            DOB = Model.SignificantOtherDOB,
            Email = T(Model.SignificantOtherEmail),
            Phone = T(Model.SignificantOtherPhone),
            RelationshipType = "SignificantOther"
        };
    }

    var soToShow = so ?? soFallback;

    var needsSO =
        string.Equals((Model.MaritalStatus ?? "").Trim(), "Married", StringComparison.OrdinalIgnoreCase) ||
        string.Equals((Model.MaritalStatus ?? "").Trim(), "Domestic Partnership", StringComparison.OrdinalIgnoreCase);

    string DashIfBlank(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;
}

@section Styles {
    <link rel="stylesheet" href="~/_content/Shared/css/dashboard-home-shared.css" asp-append-version="true" />
}

<main class="dashboard-page-shell client-create-page client-edit-page">
    <div class="client-create-shell">
        <div class="client-create-panel">
            <div class="client-create-header">
                <div>
                    <div class="dashboard-eyebrow">Client Profile</div>
                    <h2 class="client-create-title">@(viewMode == "agent" ? $"Viewing {Model.FirstName} {Model.LastName}".Trim() : "My Profile")</h2>
                    <p class="client-create-subtitle">Review the household information currently shared across the client workspace and the agent portal.</p>
                </div>
                <span class="client-edit-pill">@badge</span>
            </div>

            <div class="client-create-body">
                @if (viewMode == "agent")
                {
                    <div class="client-edit-section client-edit-section-compact">
                        <div class="client-edit-section-head">
                            <div>
                                <div class="client-create-section-title">Agent Impersonation</div>
                                <p class="client-edit-note">You are viewing the live client experience for @viewingClientName.</p>
                            </div>
                            <a class="client-create-button client-create-button-secondary" href="/support/stop-view-as-client">End Impersonation</a>
                        </div>
                    </div>
                }

                <div class="client-create-section client-create-section-shell">
                    <div class="client-create-section-head">
                        <div class="client-create-section-title">Primary Profile</div>
                        <p class="client-create-section-copy">Core contact and household details from the current client record.</p>
                    </div>
                    <div class="client-create-grid">
                        <div>
                            <label class="client-create-label">First Name</label>
                            <input class="client-create-input" value="@DashIfBlank(Model.FirstName)" readonly />
                        </div>
                        <div>
                            <label class="client-create-label">Last Name</label>
                            <input class="client-create-input" value="@DashIfBlank(Model.LastName)" readonly />
                        </div>
                        <div>
                            <label class="client-create-label">Email</label>
                            <input class="client-create-input" value="@DashIfBlank(Model.Email)" readonly />
                        </div>
                        <div>
                            <label class="client-create-label">Phone</label>
                            <input class="client-create-input" value="@DashIfBlank(Model.Phone)" readonly />
                        </div>
                        <div>
                            <label class="client-create-label">Date of Birth</label>
                            <input class="client-create-input" value="@(Model.DOB.HasValue ? Model.DOB.Value.ToString("MM/dd/yyyy") : "—")" readonly />
                        </div>
                        <div>
                            <label class="client-create-label">Marital Status</label>
                            <input class="client-create-input" value="@DashIfBlank(Model.MaritalStatus)" readonly />
                        </div>
                    </div>
                </div>

                @if (soToShow != null)
                {
                    <div class="client-edit-section client-edit-section-spaced">
                        <div class="client-edit-section-head">
                            <div>
                                <div class="client-create-section-title">Significant Other</div>
                                <p class="client-edit-note">Household record connected to this client profile.</p>
                            </div>
                            <span class="client-edit-pill">@(!string.IsNullOrWhiteSpace(soToShow.RelationshipType) ? soToShow.RelationshipType : "Household")</span>
                        </div>
                        <div class="client-create-grid">
                            <div>
                                <label class="client-create-label">First Name</label>
                                <input class="client-create-input" value="@DashIfBlank(soToShow.FirstName)" readonly />
                            </div>
                            <div>
                                <label class="client-create-label">Last Name</label>
                                <input class="client-create-input" value="@DashIfBlank(soToShow.LastName)" readonly />
                            </div>
                            <div>
                                <label class="client-create-label">Date of Birth</label>
                                <input class="client-create-input" value="@(soToShow.DOB.HasValue ? soToShow.DOB.Value.ToString("MM/dd/yyyy") : "—")" readonly />
                            </div>
                            <div>
                                <label class="client-create-label">Phone</label>
                                <input class="client-create-input" value="@DashIfBlank(soToShow.Phone)" readonly />
                            </div>
                            <div class="client-create-full">
                                <label class="client-create-label">Email</label>
                                <input class="client-create-input" value="@DashIfBlank(soToShow.Email)" readonly />
                            </div>
                        </div>
                    </div>
                }
                else if (needsSO)
                {
                    <div class="client-create-blocked client-edit-section-spaced">
                        Significant Other is required for this marital status, but no household member is currently on file.
                    </div>
                }

                @if (children.Count > 0)
                {
                    <div class="client-edit-section client-edit-section-spaced">
                        <div class="client-edit-section-head">
                            <div>
                                <div class="client-create-section-title">Children</div>
                                <p class="client-edit-note">Household members currently attached to this client record.</p>
                            </div>
                            <span class="client-edit-pill">@children.Count on file</span>
                        </div>

                        <div class="client-edit-child-list">
                            @foreach (var child in children)
                            {
                                <div class="client-edit-child-card">
                                    <div class="client-edit-child-card-head">
                                        <div class="client-edit-child-title">@DashIfBlank($"{child.FirstName} {child.LastName}".Trim())</div>
                                    </div>
                                    <div class="client-create-grid">
                                        <div>
                                            <label class="client-create-label">Date of Birth</label>
                                            <input class="client-create-input" value="@(child.DOB.HasValue ? child.DOB.Value.ToString("MM/dd/yyyy") : "—")" readonly />
                                        </div>
                                        <div>
                                            <label class="client-create-label">Phone</label>
                                            <input class="client-create-input" value="@DashIfBlank(child.Phone)" readonly />
                                        </div>
                                        <div class="client-create-full">
                                            <label class="client-create-label">Email</label>
                                            <input class="client-create-input" value="@DashIfBlank(child.Email)" readonly />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="client-edit-divider"></div>

                <div class="client-create-actions">
                    @if (viewMode == "client")
                    {
                        <a class="client-create-button client-create-button-primary" href="/profile/edit">Edit My Profile</a>
                    }
                    else
                    {
                        <a class="client-create-button client-create-button-secondary" href="javascript:history.back()">Back</a>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
