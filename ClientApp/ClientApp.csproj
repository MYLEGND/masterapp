<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b6e2beb7-fc73-4454-8616-2aa0fb25034a</UserSecretsId>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>

    <!-- Prevent SDK.Web default content globs from publishing build/deploy artifact folders -->
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      publish/**;
      publish-client/**;
      publish-azure-client/**;
      bin/**;
      obj/**;
      App_Data/**;
      Views_backup/**;
      wwwroot_backup/**;
      **/*.zip;
      **/*.bak;
      **/*.db;
    </DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <ItemGroup>
    <Content Include="../Legend-Design/legend-web-foundation.css" Link="wwwroot/design/legend-web-foundation.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-app-shell.css" Link="wwwroot/design/legend-app-shell.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-website-management.css" Link="wwwroot/design/legend-website-management.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-website-management.js" Link="wwwroot/design/legend-website-management.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-design.tokens.json"
             Link="wwwroot/design/legend-design.tokens.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Legend-Design/legend-reaction-emoji.json"
             Link="wwwroot/design/legend-reaction-emoji.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The CRM and quick-view sources are shared with AgentPortal, not copied. -->
  <ItemGroup>
    <Content Include="../AgentPortal/Views/Clients/Index.cshtml" Link="Views/Clients/Index.cshtml" />
    <Content Include="../AgentPortal/Views/Clients/_Client*.cshtml" Link="Views/Clients/%(Filename)%(Extension)" />
    <Content Include="../AgentPortal/Views/Leads/Index.cshtml" Link="Views/Leads/Index.cshtml" />
    <Content Include="../AgentPortal/Views/Leads/_Lead*.cshtml" Link="Views/Leads/%(Filename)%(Extension)" />
    <Content Include="../AgentPortal/Views/Shared/_QuickView*.cshtml" Link="Views/Shared/%(Filename)%(Extension)" />
    <Content Include="../AgentPortal/Views/Workstation/_AdvancedMarketsInputSections.cshtml" Link="Views/Workstation/_AdvancedMarketsInputSections.cshtml" />
    <Content Include="../AgentPortal/wwwroot/css/clients-index.css" Link="wwwroot/css/clients-index.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AgentPortal/wwwroot/js/clients-index.js;../AgentPortal/wwwroot/js/leads-index.js;../AgentPortal/wwwroot/js/dp-*.js;../AgentPortal/wwwroot/js/zoom-quick-popup.js" Link="wwwroot/js/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../AgentPortal/wwwroot/js/scheduling/qv-*.js" Link="wwwroot/js/scheduling/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AgentPortal/wwwroot/js/billing/qv-billing-management.js" Link="wwwroot/js/billing/qv-billing-management.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../AgentPortal/Views/Leads/_ActionsTab.cshtml;../AgentPortal/Views/Leads/_CommitmentsTab.cshtml" Link="Views/Leads/%(Filename)%(Extension)" />
    <Content Include="../AgentPortal/Views/Shared/_ActionList.cshtml" Link="Views/Shared/_ActionList.cshtml" />
    <Content Include="../AgentPortal/Views/Actions/Edit.cshtml" Link="Views/Actions/Edit.cshtml" />
  </ItemGroup>

  <!-- Compile and publish the canonical analytics view/assets; no business copy. -->
  <ItemGroup>
    <Content Include="../AgentPortal/Views/WebsiteAnalytics/Index.cshtml" Link="Views/WebsiteAnalytics/Index.cshtml" />
    <Content Include="../AgentPortal/Views/WebsiteAnalytics/_AnalyticsIncidentModal.cshtml" Link="Views/WebsiteAnalytics/_AnalyticsIncidentModal.cshtml" />
    <Content Include="../AgentPortal/wwwroot/css/website-analytics.css" Link="wwwroot/css/website-analytics.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../AgentPortal/wwwroot/js/website-analytics*.js" Link="wwwroot/js/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Belt + suspenders: explicitly remove any accidental inclusion of these artifacts -->
  <ItemGroup>
    <RazorGenerate Remove="Views_backup/**" />
    <RazorGenerate Remove="wwwroot_backup/**" />
    <RazorGenerate Remove="publish/**" />
    <RazorGenerate Remove="publish-client/**" />
    <RazorGenerate Remove="publish-azure-client/**" />
    <RazorGenerate Remove="App_Data/**" />

    <Content Remove="publish/**" />
    <Content Remove="publish-client/**" />
    <Content Remove="publish-azure-client/**" />
    <Content Remove="bin/**" />
    <Content Remove="obj/**" />
    <Content Remove="App_Data/**" />
    <Content Remove="Views_backup/**" />
    <Content Remove="wwwroot_backup/**" />
    <Content Remove="**/*.zip" />
    <Content Remove="**/*.bak" />
    <Content Remove="**/*.db" />

    <None Remove="publish/**" />
    <None Remove="publish-client/**" />
    <None Remove="publish-azure-client/**" />
    <None Remove="bin/**" />
    <None Remove="obj/**" />
    <None Remove="App_Data/**" />
    <None Remove="Views_backup/**" />
    <None Remove="wwwroot_backup/**" />
    <None Remove="**/*.zip" />
    <None Remove="**/*.bak" />
    <None Remove="**/*.db" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\SHARED\Shared.csproj" />
  </ItemGroup>

  <Target Name="PrunePublishArtifacts" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('bin/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('obj/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('publish/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('publish-client/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('publish-azure-client/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('App_Data/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('Views_backup/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('wwwroot_backup/'))" />
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
</Project>
