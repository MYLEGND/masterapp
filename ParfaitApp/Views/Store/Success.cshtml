@model ParfaitApp.Models.ParfaitOrderSuccessViewModel
@{
    var order = Model.Order;
    var title = order is null ? "Order not found"
        : order.IsPaid ? "Order confirmed"
        : order.IsFailedPayment ? "Payment not completed"
        : order.IsPendingPayment ? "Payment pending" : "Order details";
    ViewData["Title"] = title;
    ViewData["BodyClass"] = "sp-body";
    ViewData["ContentContainerClass"] = "container-fluid";
    ViewData["LayoutContentClass"] = "sp-layout-content";
    var commerce = ViewData["CommerceStoreContext"] as ParfaitApp.Services.CommerceStoreContext;
    var storeRoot = ViewData["StoreRootPath"] as string ?? "/store";
    var storeName = commerce?.StoreName ?? "Parfait";
    static string Money(int cents) => "$" + (cents / 100m).ToString("0.00");
}

@section Styles {
    @await Html.PartialAsync("~/Views/Shared/_StorefrontStyles.cshtml")
}

<section class="sp-store-page sp-store-page--success">
    <article class="sp-shell sp-receipt" aria-labelledby="receipt-title">
        <header class="sp-receipt-header">
            <p class="sp-receipt-kicker">@storeName</p>
            <h1 id="receipt-title">@title</h1>
            @if (order is not null)
            {
                <p class="sp-receipt-reference"><span>Order @order.OrderNumber</span><span>Payment: @order.PaymentStatus</span></p>
            }
            @if (order is null)
            {
                <p class="sp-receipt-note">We could not find the order details for this confirmation page.</p>
            }
            else if (!order.IsPaid)
            {
                <p class="sp-receipt-note" role="status">@(order.IsFailedPayment
                    ? "Payment was not completed. Keep your order number for reference."
                    : order.IsPendingPayment
                        ? "Payment has not been confirmed. Keep your order number for reference."
                        : "The current payment and fulfillment status are shown below.")</p>
            }
        </header>
        @if (order is not null)
        {
            <div class="sp-receipt-body">
                <section class="sp-receipt-items" aria-labelledby="receipt-items-title">
                    <h2 id="receipt-items-title">Your items</h2>
                    @foreach (var item in order.Items)
                    {
                        var hasPhoto = !string.IsNullOrWhiteSpace(item.ImageUrl);
                        <div class="sp-receipt-item @(hasPhoto ? "sp-receipt-item--photo" : "")">
                            @if (hasPhoto)
                            {
                                <img class="sp-receipt-photo" src="@item.ImageUrl" alt="" width="48" height="56" />
                            }
                            <div class="sp-receipt-item-copy">
                                <h3>@item.Name</h3>
                                <p>@if (!string.IsNullOrWhiteSpace(item.Size)) { <span>Size @item.Size · </span> }<span>Qty @item.Quantity</span></p>
                            </div>
                            <strong class="sp-receipt-price">@Money(item.LineTotalCents)</strong>
                        </div>
                    }
                </section>
                <section class="sp-receipt-summary" aria-labelledby="receipt-summary-title">
                    <h2 id="receipt-summary-title">Order summary</h2>
                    <dl class="sp-receipt-totals">
                        <div><dt>Subtotal</dt><dd>@Money(order.SubtotalCents)</dd></div>
                        <div><dt>Shipping</dt><dd>@Money(order.ShippingCents)</dd></div>
                        <div><dt>Tax</dt><dd>@Money(order.TaxCents)</dd></div>
                        @if (order.DiscountCents > 0)
                        {
                            <div><dt>Discount @if (!string.IsNullOrWhiteSpace(order.DiscountCode)) { <span>(@order.DiscountCode)</span> }</dt><dd>-@Money(order.DiscountCents)</dd></div>
                        }
                        <div class="sp-receipt-total"><dt>@(order.IsPaid && order.RefundedCents == 0 ? "Total paid" : "Order total")</dt><dd>@Money(order.TotalCents)</dd></div>
                        @if (order.RefundedCents > 0)
                        {
                            <div><dt>Refunded</dt><dd>@Money(order.RefundedCents)</dd></div>
                        }
                    </dl>
                </section>
            </div>
            <div class="sp-receipt-details">
                <section aria-labelledby="receipt-shipping-title">
                    <h2 id="receipt-shipping-title">Shipping to</h2>
                    <address>
                        <strong>@order.FirstName @order.LastName</strong><br />
                        @order.AddressLine1<br />
                        @if (!string.IsNullOrWhiteSpace(order.AddressLine2)) { @order.AddressLine2<br /> }
                        @order.City, @order.State @order.PostalCode
                    </address>
                </section>
                <section aria-labelledby="receipt-contact-title">
                    <h2 id="receipt-contact-title">Order contact</h2>
                    <p>@order.Email</p>
                    @if (!string.IsNullOrWhiteSpace(order.Phone)) { <p>@order.Phone</p> }
                    <p class="sp-receipt-fulfillment">Fulfillment: <strong>@order.FulfillmentStatus</strong></p>
                </section>
            </div>
        }
        <footer class="sp-receipt-footer">
            <a class="sp-button sp-button--primary" href="@storeRoot">Continue shopping</a>
        </footer>
    </article>
</section>

@section Scripts {
    <script>
        document.querySelectorAll(".sp-receipt-photo").forEach(image => {
            const omitUnavailablePhoto = () => {
                image.closest(".sp-receipt-item")?.classList.remove("sp-receipt-item--photo");
                image.remove();
            };
            image.addEventListener("error", omitUnavailablePhoto, { once: true });
            if (image.complete && image.naturalWidth === 0) omitUnavailablePhoto();
        });
    </script>
    @if (Model.Order?.IsPaid == true)
    {
        <script>
            (async () => {
                const store = window.ParfaitStorefront;
                const key = store?.storageKey || "parfaitCart";
                const attemptId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Order!.CheckoutAttemptId));
                if (await store?.reconcilePaidCheckout(attemptId)) {
                    const attemptKey = key === "parfaitCart" ? "parfaitCheckoutAttemptId" : key + ":checkoutAttemptId";
                    if (window.sessionStorage.getItem(attemptKey) === attemptId) window.sessionStorage.removeItem(attemptKey);
                }
            })().catch(() => { const notice = document.createElement("p"); notice.setAttribute("role", "status"); notice.textContent = "Payment is confirmed. Your browser could not update the cart; review it before shopping again."; document.querySelector(".sp-receipt-footer")?.prepend(notice); });
        </script>
    }
}
