@{
    ViewData["Title"] = "Checkout";
    ViewData["BodyClass"] = "sp-body";
    ViewData["ContentContainerClass"] = "container-fluid";
    ViewData["LayoutContentClass"] = "sp-layout-content";
    var commerce = ViewData["CommerceStoreContext"] as ParfaitApp.Services.CommerceStoreContext;
    var storeRoot = ViewData["StoreRootPath"] as string ?? "/store";
    var storeCart = ViewData["StoreCartPath"] as string ?? "/store/cart";
    var storeName = commerce?.StoreName ?? "Parfait";

    var hosted = ViewBag.MerchantHostedCheckout is true;
    var appId = ViewBag.SquareApplicationId as string;
    var locationId = ViewBag.SquareLocationId as string;
    var environment = ViewBag.SquareEnvironment as string ?? "Sandbox";
    var checkoutAvailable = ViewBag.CheckoutAvailable as bool? ?? false;
    var squareScript = environment.Equals("Production", StringComparison.OrdinalIgnoreCase)
        ? "https://web.squarecdn.com/v1/square.js"
        : "https://sandbox.web.squarecdn.com/v1/square.js";

    var appIdJson = System.Text.Json.JsonSerializer.Serialize(appId ?? "");
    var locationIdJson = System.Text.Json.JsonSerializer.Serialize(locationId ?? "");
}


<section class="sp-store-page sp-store-page--checkout">
    <div class="sp-shell sp-transaction-page">
        <header class="sp-transaction-header">
            <div>
                <p class="sp-transaction-kicker">Secure Payment</p>
                <h1>Checkout</h1>
            </div>
            <div class="sp-transaction-actions">
                <a class="sp-button sp-button--ghost" href="@storeCart">Edit Cart</a>
            </div>
        </header>

        @Html.AntiForgeryToken()

        <section class="sp-flow-card sp-transaction-stack-card sp-transaction-stack-card--checkout">
            <div class="sp-checkout-shell">
                <div class="sp-checkout-section">
                    <div class="sp-checkout-section-head">
                        <span class="sp-flow-step">Step 01</span>
                        <h2>Contact Information</h2>
                    </div>

                    <div class="sp-field-grid">
                        <label class="sp-field">
                            <span>First Name</span>
                            <input id="firstName" autocomplete="given-name" required />
                        </label>
                        <label class="sp-field">
                            <span>Last Name</span>
                            <input id="lastName" autocomplete="family-name" required />
                        </label>
                        <label class="sp-field">
                            <span>Email</span>
                            <input id="email" type="email" autocomplete="email" required />
                        </label>
                        <label class="sp-field">
                            <span>Phone</span>
                            <input id="phone" autocomplete="tel" required />
                        </label>
                    </div>
                </div>

                <div class="sp-checkout-section">
                    <div class="sp-checkout-section-head">
                        <span class="sp-flow-step">Step 02</span>
                        <h2>Shipping Address</h2>
                    </div>

                    <div class="sp-field-grid">
                        <label class="sp-field">
                            <span>Address Line 1</span>
                            <input id="addressLine1" autocomplete="address-line1" required />
                        </label>
                        <label class="sp-field">
                            <span>Address Line 2</span>
                            <input id="addressLine2" autocomplete="address-line2" />
                        </label>
                    </div>

                    <div class="sp-field-grid sp-field-grid--triple">
                        <label class="sp-field">
                            <span>City</span>
                            <input id="city" autocomplete="address-level2" required />
                        </label>
                        <label class="sp-field">
                            <span>State</span>
                            <input id="state" autocomplete="address-level1" maxlength="2" required />
                        </label>
                        <label class="sp-field">
                            <span>ZIP</span>
                            <input id="postalCode" autocomplete="postal-code" required />
                        </label>
                    </div>
                </div>

                <div class="sp-checkout-section sp-checkout-section--review">
                    <div class="sp-checkout-section-head">
                        <div>
                            <span class="sp-flow-step">Step 03</span>
                            <h2>Final Order Total</h2>
                        </div>
                        <a class="sp-inline-link" href="@storeCart">Edit Cart</a>
                    </div>

                    <div id="spCheckoutSummary" class="sp-checkout-summary-host"></div>
                </div>

                <div class="sp-checkout-section sp-checkout-section--payment">
                    <div class="sp-checkout-section-head">
                        <div>
                            <span class="sp-flow-step">Step 04</span>
                            <h2>Payment</h2>
                        </div>
                    </div>

                    <div class="sp-payment-panel">
                        <div id="card-container" class="sp-card-container" role="status">@(checkoutAvailable
                            ? hosted ? "Continue to secure processor checkout to enter your payment details." : "Loading secure payment form…"
                            : "This store is not accepting online payments yet. Please return when payment setup is complete.")</div>
                    </div>
                </div>

                <label class="sp-checkout-consent" for="marketingEmailConsent">
                    <input type="checkbox" id="marketingEmailConsent" checked />
                    <span>@ParfaitApp.Services.ParfaitCustomerAutomationService.MarketingConsentText <small>Optional.</small></span>
                </label>
                <div class="sp-checkout-submit-row">
                    <button id="spPayButton" disabled="@(!checkoutAvailable)" class="sp-button sp-button--primary sp-button--checkout sp-button--purchase" type="button">
                        <span class="sp-button-main">
                            <span id="spPaySpinner" class="spinner-border spinner-border-sm" role="status" aria-hidden="true" hidden></span>
                            <span id="spPayButtonLabel">Complete Purchase</span>
                        </span>
                        <small class="sp-button-note">@(hosted ? "Secure encrypted checkout" : "Secure encrypted Square checkout")</small>
                    </button>
                </div>

                <div id="spCheckoutError" class="sp-checkout-error"></div>
            </div>
        </section>
        @if (commerce?.IsParfait == true)
        {
            <section class="sp-flow-card" aria-label="Checkout help">
                <h2>Need help with your order?</h2>
                <p>Send @storeName a message. Sending an inquiry does not place an order or sign you up for marketing.</p>
                <div data-legend-public-inquiry-form data-owner-label="@storeName"></div>
            </section>
        }
    </div>
</section>

@section Scripts {
    @if (!hosted) { <script src="@squareScript"></script> }
    <script>
        (() => {
            const store = window.ParfaitStorefront;
            const commerce = store?.context || {};
            const checkoutPath = commerce.checkoutPath || "/store/checkout";
            const quoteEndpoint = checkoutPath + "/quote";
            const payEndpoint = checkoutPath + "/pay";
            const successPath = commerce.successPath || "/store/success";
            const storeRoot = commerce.storeRootPath || "/store";
            const hosted = @Html.Raw(hosted ? "true" : "false");
            const appId = @Html.Raw(appIdJson);
            const locationId = @Html.Raw(locationIdJson);
            const payButton = document.getElementById("spPayButton");
            const paySpinner = document.getElementById("spPaySpinner");
            const payButtonLabel = document.getElementById("spPayButtonLabel");
            const errorHost = document.getElementById("spCheckoutError");
            const summaryHost = document.getElementById("spCheckoutSummary");
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

            if (!store || !payButton || !paySpinner || !payButtonLabel || !errorHost || !summaryHost) {
                return;
            }

            let latestQuote = null;
            let card = null;
            let syncMessage = "";
            let isSubmitting = false;
            const checkoutAttemptStorageKey = store.storageKey === "parfaitCart"
                ? "parfaitCheckoutAttemptId"
                : store.storageKey + ":checkoutAttemptId";
            const pendingStorageKey = checkoutAttemptStorageKey + ":pending";
            let pendingReference = null;
            try { pendingReference = JSON.parse(window.sessionStorage.getItem(pendingStorageKey) || "null"); } catch { }
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            const fields = {
                firstName: document.getElementById("firstName"),
                lastName: document.getElementById("lastName"),
                email: document.getElementById("email"),
                phone: document.getElementById("phone"),
                addressLine1: document.getElementById("addressLine1"),
                addressLine2: document.getElementById("addressLine2"),
                city: document.getElementById("city"),
                state: document.getElementById("state"),
                postalCode: document.getElementById("postalCode")
            };

            const requiredFields = [
                "firstName", "lastName", "email", "phone",
                "addressLine1", "city", "state", "postalCode"
            ];

            const createCheckoutAttemptId = () => {
                if (window.crypto?.randomUUID) {
                    return window.crypto.randomUUID();
                }

                return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`;
            };

            const ensureCheckoutAttemptId = () => {
                let current = window.sessionStorage.getItem(checkoutAttemptStorageKey);
                if (!current) {
                    current = createCheckoutAttemptId();
                    window.sessionStorage.setItem(checkoutAttemptStorageKey, current);
                }

                return current;
            };

            const clearCheckoutAttemptId = () => {
                window.sessionStorage.removeItem(checkoutAttemptStorageKey);
                lastLeadSignature = "";
            };

            const isValidEmail = value => emailPattern.test((value || "").trim());

            const setPayButtonAvailability = isAvailable => {
                if (isSubmitting) {
                    return;
                }

                payButton.disabled = !isAvailable && !pendingReference;
                payButton.classList.toggle("is-disabled", payButton.disabled);
            };

            const setSubmittingState = (submitting, label) => {
                isSubmitting = submitting;
                payButton.disabled = submitting || (!pendingReference && !latestQuote?.isValid);
                payButton.classList.toggle("is-disabled", payButton.disabled);
                paySpinner.hidden = !submitting;
                payButtonLabel.textContent = label;
            };

            const setError = message => {
                errorHost.textContent = message || "";
            };

            const quoteItems = cart => cart.map(item => ({
                id: item.id,
                size: item.size,
                quantity: item.quantity
            }));



            const renderEmptySummary = () => {
                if (!hosted) clearCheckoutAttemptId();
                latestQuote = null;
                summaryHost.innerHTML = `
                    <div class="sp-cart-empty">
                        <h2>Your cart is empty</h2>
                        <div class="sp-checkout-review-actions">
                            <a class="sp-button sp-button--primary" href="@storeRoot">Back to Shop</a>
                        </div>
                    </div>
                `;
                setPayButtonAvailability(false);
            };

            const orderItemCount = items => items.reduce(
                (count, item) => count + (Number(item.quantity || 0) || 0),
                0
            );

            const renderFinalTotal = (summary, itemCount, isPending) => `
                <div class="sp-checkout-final-total">
                    <div class="sp-checkout-final-total-copy">
                        <span>${itemCount} ${itemCount === 1 ? "item" : "items"} secured</span>
                        <small>${isPending ? "Final amount will refresh before payment." : "Shipping and tax are included."}</small>
                    </div>
                    <div class="sp-checkout-final-total-amount">
                        <span>Due today</span>
                        <strong>${summary.totalLabel || store.money(summary.totalCents || 0)}</strong>
                    </div>
                </div>
            `;

            const renderFallbackSummary = cart => {
                const visibleItems = cart.filter(item => Number(item.quantity || 0) > 0);

                if (!visibleItems.length) {
                    renderEmptySummary();
                    return;
                }

                latestQuote = null;
                summaryHost.innerHTML = renderFinalTotal(
                    { totalLabel: "Pending quote" },
                    orderItemCount(visibleItems),
                    true
                );
                setPayButtonAvailability(false);
            };

            const renderSummary = quote => {
                latestQuote = quote;

                if (!quote?.items?.length || !quote.items.some(item => Number(item.quantity || 0) > 0)) {
                    renderEmptySummary();
                    return;
                }

                const visibleItems = quote.items.filter(item => Number(item.quantity || 0) > 0);

                summaryHost.innerHTML = renderFinalTotal(
                    quote,
                    orderItemCount(visibleItems),
                    !quote.isValid
                );

                setPayButtonAvailability(Boolean(quote.isValid));
            };

            const getCustomer = () => ({
                firstName: fields.firstName.value.trim(),
                lastName: fields.lastName.value.trim(),
                email: fields.email.value.trim(),
                phone: fields.phone.value.trim(),
                addressLine1: fields.addressLine1.value.trim(),
                addressLine2: fields.addressLine2.value.trim(),
                city: fields.city.value.trim(),
                state: fields.state.value.trim(),
                postalCode: fields.postalCode.value.trim()
            });

            const validateCustomer = () => {
                for (const key of requiredFields) {
                    if (!fields[key] || !fields[key].value.trim()) {
                        fields[key]?.focus();
                        const label = fields[key]?.closest("label")?.querySelector("span")?.textContent?.trim() || "Field";
                        return `${label} is required.`;
                    }
                }

                const emailValue = fields.email.value;
                if (!isValidEmail(emailValue)) {
                    fields.email.focus();
                    return "Enter a valid email address.";
                }

                return "";
            };

            const requestQuote = async () => {
                const cart = store.readCart();
                if (!cart.length) {
                    renderSummary({ items: [], isValid: false, subtotalCents: 0, totalCents: 0, discountCents: 0 });
                    setError("");
                    return null;
                }

                try {
                    const response = await fetch(quoteEndpoint, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": tokenInput?.value || ""
                        },
                        body: JSON.stringify({
                            discountCode: store.readDiscountCode(),
                            items: quoteItems(cart)
                        })
                    });

                    const text = await response.text();
                    const quote = text ? JSON.parse(text) : {};
                    const applied = quote?.items ? await store.applyQuote(quote, cart.revision) : { changed: false };
                    if (applied.stale) return requestQuote();
                    const changed = applied.changed;

                    if (changed) {
                        syncMessage = "Checkout updated to current stock.";
                        return null;
                    }

                    renderSummary(quote);
                    setError(syncMessage || quote.error || quote.messages?.[0] || "");
                    syncMessage = "";
                    quote.cartRevision = cart.revision;
                    return quote;
                } catch (error) {
                    renderFallbackSummary(cart);
                    setError(error.message || "We could not refresh checkout right now.");
                    return null;
                }
            };

            async function startSquare() {
                if (!@System.Text.Json.JsonSerializer.Serialize(checkoutAvailable) && !pendingReference) return;
                const firstQuote = pendingReference ? null : await requestQuote();

                if (!hosted) {
                try {
                if (!window.Square) throw new Error("Square.js failed to load.");
                if (!appId || !locationId) throw new Error("Square Application ID or Location ID is missing.");

                const payments = window.Square.payments(appId, locationId);
                card = await payments.card();
                await card.attach("#card-container");
                } catch (error) { if (!pendingReference) throw error; }
                } else { document.getElementById("card-container").textContent = "Continue to your secure payment provider to complete your purchase."; }
                ensureCheckoutAttemptId();

                let declinedCheckout = false;
                let changedUnsubmittedCheckout = false;
                let checkingPayment = Boolean(pendingReference);
                let submittedPayload = null;
                let preparedRecovery = null;
                payButton.addEventListener("click", async () => {
                    if (changedUnsubmittedCheckout) {
                        if (!await store.abandonUnsubmittedCheckout(ensureCheckoutAttemptId())) { setError("This payment may already be processing. Check its status before starting another checkout."); return; }
                        clearCheckoutAttemptId(); changedUnsubmittedCheckout = false;
                    }
                    if (declinedCheckout) { clearCheckoutAttemptId(); declinedCheckout = false; submittedPayload = null; }
                    if (isSubmitting) {
                        return;
                    }

                    setSubmittingState(true, "Processing payment...");
                    setError("");

                    try {
                        let postPayment = false;
                        if (!checkingPayment) {
                        let quote;
                        if (preparedRecovery) {
                            if (preparedRecovery.merchantConnectionRevision !== @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Guid?)ViewBag.MerchantConnectionRevision)))
                                throw new Error("Payment setup changed. Refresh this page to reload the secure card form for this saved order.");
                            await store.ensurePaymentReady();
                            submittedPayload = { ...preparedRecovery, sourceId: null, marketingEmailConsent: false };
                            quote = preparedRecovery;
                        } else {
                            const customerError = validateCustomer();
                            if (customerError) throw new Error(customerError);
                            quote = await requestQuote();
                            if (!quote?.isValid) throw new Error(errorHost.textContent || "Review the updated order before paying.");
                            submittedPayload = {
                                marketingEmailConsent: document.getElementById("marketingEmailConsent").checked,
                                sourceId: null,
                                merchantConnectionRevision: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Guid?)ViewBag.MerchantConnectionRevision)),
                                checkoutAttemptId: ensureCheckoutAttemptId(), discountCode: store.readDiscountCode(), customer: getCustomer(),
                                items: quote.items.filter(item => Number(item.quantity || 0) > 0).map(item => ({ id: item.id, size: item.size, quantity: item.quantity }))
                            };
                        }
                        const customer = submittedPayload.customer;
                        const binding = preparedRecovery ? { submitted: false } : await store.bindCheckout(submittedPayload.checkoutAttemptId, submittedPayload.items, quote.cartRevision);
                        if (!hosted && !binding.submitted && !card) throw new Error("The secure card form is unavailable. Refresh this page before retrying this saved order.");
                        const result = (hosted || binding.submitted) ? { status: "OK", token: null } : await card.tokenize({
                            amount: (Number(quote.totalCents) / 100).toFixed(2), currencyCode: "USD", intent: "CHARGE",
                            customerInitiated: true, sellerKeyedIn: false,
                            billingContact: { givenName: customer.firstName, familyName: customer.lastName,
                                email: customer.email, phone: customer.phone, addressLines: [customer.addressLine1, customer.addressLine2].filter(Boolean),
                                city: customer.city, state: customer.state, postalCode: customer.postalCode, countryCode: "US" }
                        });
                        if (result.status !== "OK") throw new Error("Check your card details and try again.");

                        submittedPayload.sourceId = result.token;
                        if (!preparedRecovery) await store.markCheckoutSubmitted(submittedPayload.checkoutAttemptId);
                        pendingReference = { attemptId: submittedPayload.checkoutAttemptId };
                        window.sessionStorage.setItem(pendingStorageKey, JSON.stringify(pendingReference));
                        postPayment = true;
                        checkingPayment = true; // Network loss must reconcile this intent, never re-tokenize it.
                        }
                        const payload = submittedPayload;
                        const response = !postPayment && pendingReference
                            ? await fetch(checkoutPath + "/return?orderNumber=" + encodeURIComponent(pendingReference.orderNumber || "") + "&attempt=" + encodeURIComponent(pendingReference.attemptId), { headers: { "Accept": "application/json" } })
                            : await fetch(payEndpoint, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": tokenInput?.value || ""
                            },
                            body: JSON.stringify(payload)
                        });

                        if (submittedPayload) submittedPayload.sourceId = null;
                        const text = await response.text();
                        const data = text ? JSON.parse(text) : {};

                        if (data.paymentNotStarted) {
                            preparedRecovery = data.recovery;
                            renderSummary({ ...preparedRecovery, isValid: true });
                            for (const [name, value] of Object.entries(preparedRecovery.customer)) {
                                if (fields[name]) { fields[name].value = value || ""; fields[name].readOnly = true; }
                            }
                            checkingPayment = false;
                            setError(data.error); setSubmittingState(false, "Retry saved order"); return;
                        }
                        if (data.paymentPending) {
                            checkingPayment = true;
                            pendingReference = { orderNumber: data.orderNumber, attemptId: pendingReference?.attemptId || submittedPayload.checkoutAttemptId };
                            window.sessionStorage.setItem(pendingStorageKey, JSON.stringify(pendingReference));
                            setError(data.error);
                            setSubmittingState(false, "Check payment status");
                            return;
                        }
                        if (data.paymentDeclined) {
                            checkingPayment = false;
                            preparedRecovery = null;
                            for (const field of Object.values(fields)) field.readOnly = false;
                            pendingReference = null;
                            window.sessionStorage.removeItem(pendingStorageKey);
                            setError(data.error);
                            setSubmittingState(false, "Try another card");
                            declinedCheckout = true;
                            return;
                        }
                        if (!response.ok || !data.success) {
                            throw new Error(data.error || "Payment failed.");
                        }

                        window.sessionStorage.removeItem(pendingStorageKey);
                        window.location.href = data.redirectUrl || successPath;
                    } catch (error) {
                        if (submittedPayload) submittedPayload.sourceId = null;
                        if (error.code === "checkout_cart_changed") {
                            changedUnsubmittedCheckout = true;
                            setError(error.message); setSubmittingState(false, "Review updated checkout"); return;
                        }
                        setError(error.message || "Payment failed.");
                        setSubmittingState(false, checkingPayment ? "Check payment status" : "Complete Purchase");
                    }
                });

                if (pendingReference) { setError("Payment verification is pending."); setSubmittingState(false, "Check payment status"); }
                if (!firstQuote?.isValid) {
                    setPayButtonAvailability(false);
                }
            }

            window.addEventListener("parfait-cart-updated", () => {
                if (!pendingReference) requestQuote();
            });

            startSquare().catch(error => {
                setError(error.message || (hosted ? "Checkout failed to initialize." : "Square checkout failed to initialize."));
                setPayButtonAvailability(false);
            });
        })();
    </script>
}
