@{
    ViewData["Title"] = "Checkout";
    ViewData["BodyClass"] = "sp-body";
    ViewData["ContentContainerClass"] = "container-fluid";
    ViewData["LayoutContentClass"] = "sp-layout-content";

    var appId = ViewBag.SquareApplicationId as string;
    var locationId = ViewBag.SquareLocationId as string;
    var environment = ViewBag.SquareEnvironment as string ?? "Sandbox";
    var squareScript = environment.Equals("Production", StringComparison.OrdinalIgnoreCase)
        ? "https://web.squarecdn.com/v1/square.js"
        : "https://sandbox.web.squarecdn.com/v1/square.js";

    var appIdJson = System.Text.Json.JsonSerializer.Serialize(appId ?? "");
    var locationIdJson = System.Text.Json.JsonSerializer.Serialize(locationId ?? "");
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
}

<section class="sp-store-page sp-store-page--checkout">
    <div class="sp-shell sp-transaction-page">
        <header class="sp-transaction-header">
            <div>
                <p class="sp-transaction-kicker">Secure Payment</p>
                <h1>Checkout</h1>
            </div>
            <div class="sp-transaction-actions">
                <a class="sp-button sp-button--ghost" href="/store/cart">Edit Cart</a>
            </div>
        </header>

        @Html.AntiForgeryToken()

        <section class="sp-flow-card sp-transaction-stack-card sp-transaction-stack-card--checkout">
            <div class="sp-checkout-shell">
                <div class="sp-checkout-section">
                    <div class="sp-checkout-section-head">
                        <span class="sp-flow-step">Step 01</span>
                        <h2>Contact Information</h2>
                    </div>

                    <div class="sp-field-grid">
                        <label class="sp-field">
                            <span>First Name</span>
                            <input id="firstName" autocomplete="given-name" required />
                        </label>
                        <label class="sp-field">
                            <span>Last Name</span>
                            <input id="lastName" autocomplete="family-name" required />
                        </label>
                        <label class="sp-field">
                            <span>Email</span>
                            <input id="email" type="email" autocomplete="email" required />
                        </label>
                        <label class="sp-field">
                            <span>Phone</span>
                            <input id="phone" autocomplete="tel" required />
                        </label>
                    </div>
                </div>

                <div class="sp-checkout-section">
                    <div class="sp-checkout-section-head">
                        <span class="sp-flow-step">Step 02</span>
                        <h2>Shipping Address</h2>
                    </div>

                    <div class="sp-field-grid">
                        <label class="sp-field">
                            <span>Address Line 1</span>
                            <input id="addressLine1" autocomplete="address-line1" required />
                        </label>
                        <label class="sp-field">
                            <span>Address Line 2</span>
                            <input id="addressLine2" autocomplete="address-line2" />
                        </label>
                    </div>

                    <div class="sp-field-grid sp-field-grid--triple">
                        <label class="sp-field">
                            <span>City</span>
                            <input id="city" autocomplete="address-level2" required />
                        </label>
                        <label class="sp-field">
                            <span>State</span>
                            <input id="state" autocomplete="address-level1" maxlength="2" required />
                        </label>
                        <label class="sp-field">
                            <span>ZIP</span>
                            <input id="postalCode" autocomplete="postal-code" required />
                        </label>
                    </div>
                </div>

                <div class="sp-checkout-section sp-checkout-section--review">
                    <div class="sp-checkout-section-head">
                        <div>
                            <span class="sp-flow-step">Step 03</span>
                            <h2>Final Order Total</h2>
                        </div>
                        <a class="sp-inline-link" href="/store/cart">Edit Cart</a>
                    </div>

                    <div id="spCheckoutSummary" class="sp-checkout-summary-host"></div>
                </div>

                <div class="sp-checkout-section sp-checkout-section--payment">
                    <div class="sp-checkout-section-head">
                        <span class="sp-flow-step">Step 04</span>
                        <h2>Payment</h2>
                    </div>

                    <div id="card-container" class="sp-card-container"></div>
                </div>

                <div class="sp-checkout-submit-row">
                    <button id="spPayButton" class="sp-button sp-button--primary sp-button--checkout sp-button--purchase" type="button">
                        <span class="sp-button-main">
                            <span id="spPaySpinner" class="spinner-border spinner-border-sm" role="status" aria-hidden="true" hidden></span>
                            <span id="spPayButtonLabel">Complete Purchase</span>
                        </span>
                        <small class="sp-button-note">Secure encrypted Square checkout</small>
                    </button>
                    <p class="sp-checkout-submit-note">Your order is processed through Square over encrypted payment rails.</p>
                </div>

                <div id="spCheckoutError" class="sp-checkout-error"></div>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="@squareScript"></script>
    <script>
        (() => {
            const store = window.ParfaitStorefront;
            const appId = @Html.Raw(appIdJson);
            const locationId = @Html.Raw(locationIdJson);
            const payButton = document.getElementById("spPayButton");
            const paySpinner = document.getElementById("spPaySpinner");
            const payButtonLabel = document.getElementById("spPayButtonLabel");
            const errorHost = document.getElementById("spCheckoutError");
            const summaryHost = document.getElementById("spCheckoutSummary");
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

            if (!store || !payButton || !paySpinner || !payButtonLabel || !errorHost || !summaryHost) {
                return;
            }

            let latestQuote = null;
            let card = null;
            let syncMessage = "";
            let isSubmitting = false;
            let leadCaptureTimer = 0;
            let lastLeadSignature = "";
            const checkoutAttemptStorageKey = "parfaitCheckoutAttemptId";
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            const fields = {
                firstName: document.getElementById("firstName"),
                lastName: document.getElementById("lastName"),
                email: document.getElementById("email"),
                phone: document.getElementById("phone"),
                addressLine1: document.getElementById("addressLine1"),
                addressLine2: document.getElementById("addressLine2"),
                city: document.getElementById("city"),
                state: document.getElementById("state"),
                postalCode: document.getElementById("postalCode")
            };

            const requiredFields = [
                "firstName", "lastName", "email", "phone",
                "addressLine1", "city", "state", "postalCode"
            ];

            const createCheckoutAttemptId = () => {
                if (window.crypto?.randomUUID) {
                    return window.crypto.randomUUID();
                }

                return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`;
            };

            const ensureCheckoutAttemptId = () => {
                let current = window.sessionStorage.getItem(checkoutAttemptStorageKey);
                if (!current) {
                    current = createCheckoutAttemptId();
                    window.sessionStorage.setItem(checkoutAttemptStorageKey, current);
                }

                return current;
            };

            const clearCheckoutAttemptId = () => {
                window.sessionStorage.removeItem(checkoutAttemptStorageKey);
                lastLeadSignature = "";
            };

            const isValidEmail = value => emailPattern.test((value || "").trim());

            const setPayButtonAvailability = isAvailable => {
                if (isSubmitting) {
                    return;
                }

                payButton.disabled = !isAvailable;
                payButton.classList.toggle("is-disabled", !isAvailable);
            };

            const setSubmittingState = (submitting, label) => {
                isSubmitting = submitting;
                payButton.disabled = submitting || !latestQuote?.isValid;
                payButton.classList.toggle("is-disabled", payButton.disabled);
                paySpinner.hidden = !submitting;
                payButtonLabel.textContent = label;
            };

            const setError = message => {
                errorHost.textContent = message || "";
            };

            const quoteItems = cart => cart.map(item => ({
                id: item.id,
                size: item.size,
                quantity: item.quantity
            }));

            const syncCartWithQuote = quote => {
                const current = store.readCart();
                const next = [];
                let changed = false;

                current.forEach(entry => {
                    const quoted = quote.items.find(item => item.key === entry.key);
                    if (!quoted || Number(quoted.quantity || 0) <= 0) {
                        changed = true;
                        return;
                    }

                    const nextQuantity = Number(quoted.quantity || 0);
                    if (Number(entry.quantity || 0) !== nextQuantity) {
                        changed = true;
                    }

                    next.push({
                        ...entry,
                        quantity: nextQuantity,
                        priceCents: Number(quoted.unitPriceCents || entry.priceCents || 0),
                        compareAtPriceCents: Number(quoted.compareAtPriceCents || entry.compareAtPriceCents || 0),
                        imageUrl: quoted.imageUrl || entry.imageUrl,
                        name: quoted.name || entry.name,
                        slug: quoted.slug || entry.slug,
                        badge: quoted.badge || entry.badge,
                        size: quoted.size || entry.size
                    });
                });

                if (changed) {
                    store.writeCart(next);
                }

                return changed;
            };

            const renderEmptySummary = () => {
                clearCheckoutAttemptId();
                latestQuote = null;
                summaryHost.innerHTML = `
                    <div class="sp-cart-empty">
                        <h2>Your cart is empty</h2>
                        <div class="sp-checkout-review-actions">
                            <a class="sp-button sp-button--primary" href="/store">Back to Shop</a>
                        </div>
                    </div>
                `;
                setPayButtonAvailability(false);
            };

            const orderItemCount = items => items.reduce(
                (count, item) => count + (Number(item.quantity || 0) || 0),
                0
            );

            const renderFinalTotal = (summary, itemCount, isPending) => `
                <div class="sp-checkout-final-total">
                    <div class="sp-checkout-final-total-copy">
                        <span>${itemCount} ${itemCount === 1 ? "item" : "items"} secured</span>
                        <small>${isPending ? "Final amount will refresh before payment." : "Shipping and tax are included."}</small>
                    </div>
                    <div class="sp-checkout-final-total-amount">
                        <span>Due today</span>
                        <strong>${summary.totalLabel || store.money(summary.totalCents || 0)}</strong>
                    </div>
                </div>
            `;

            const renderFallbackSummary = cart => {
                const visibleItems = cart.filter(item => Number(item.quantity || 0) > 0);

                if (!visibleItems.length) {
                    renderEmptySummary();
                    return;
                }

                latestQuote = null;
                summaryHost.innerHTML = renderFinalTotal(
                    { totalLabel: "Pending quote" },
                    orderItemCount(visibleItems),
                    true
                );
                setPayButtonAvailability(false);
            };

            const renderSummary = quote => {
                latestQuote = quote;

                if (!quote?.items?.length || !quote.items.some(item => Number(item.quantity || 0) > 0)) {
                    renderEmptySummary();
                    return;
                }

                const visibleItems = quote.items.filter(item => Number(item.quantity || 0) > 0);

                summaryHost.innerHTML = renderFinalTotal(
                    quote,
                    orderItemCount(visibleItems),
                    !quote.isValid
                );

                setPayButtonAvailability(Boolean(quote.isValid));
                queueLeadCapture();
            };

            const getCustomer = () => ({
                firstName: fields.firstName.value.trim(),
                lastName: fields.lastName.value.trim(),
                email: fields.email.value.trim(),
                phone: fields.phone.value.trim(),
                addressLine1: fields.addressLine1.value.trim(),
                addressLine2: fields.addressLine2.value.trim(),
                city: fields.city.value.trim(),
                state: fields.state.value.trim(),
                postalCode: fields.postalCode.value.trim()
            });

            const buildLeadPayload = () => {
                const cart = store.readCart();
                const customer = getCustomer();
                const email = customer.email;

                if (!cart.length || !isValidEmail(email)) {
                    return null;
                }

                return {
                    checkoutAttemptId: ensureCheckoutAttemptId(),
                    discountCode: store.readDiscountCode(),
                    customer,
                    items: quoteItems(cart)
                };
            };

            const captureLead = async () => {
                const payload = buildLeadPayload();
                if (!payload) {
                    return;
                }

                const signature = JSON.stringify(payload);
                if (signature === lastLeadSignature) {
                    return;
                }

                try {
                    await fetch("/store/checkout/lead", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": tokenInput?.value || ""
                        },
                        body: signature
                    });
                    lastLeadSignature = signature;
                } catch {
                    // Lead capture should never interrupt checkout.
                }
            };

            const queueLeadCapture = () => {
                window.clearTimeout(leadCaptureTimer);
                leadCaptureTimer = window.setTimeout(() => {
                    captureLead();
                }, 520);
            };

            const validateCustomer = () => {
                for (const key of requiredFields) {
                    if (!fields[key] || !fields[key].value.trim()) {
                        fields[key]?.focus();
                        const label = fields[key]?.closest("label")?.querySelector("span")?.textContent?.trim() || "Field";
                        return `${label} is required.`;
                    }
                }

                const emailValue = fields.email.value;
                if (!isValidEmail(emailValue)) {
                    fields.email.focus();
                    return "Enter a valid email address.";
                }

                return "";
            };

            const requestQuote = async () => {
                const cart = store.readCart();
                if (!cart.length) {
                    renderSummary({ items: [], isValid: false, subtotalCents: 0, totalCents: 0, discountCents: 0 });
                    setError("");
                    return null;
                }

                try {
                    const response = await fetch("/store/checkout/quote", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": tokenInput?.value || ""
                        },
                        body: JSON.stringify({
                            discountCode: store.readDiscountCode(),
                            items: quoteItems(cart)
                        })
                    });

                    const text = await response.text();
                    const quote = text ? JSON.parse(text) : {};
                    const changed = quote?.items ? syncCartWithQuote(quote) : false;

                    if (changed) {
                        syncMessage = "Checkout updated to current stock.";
                        return null;
                    }

                    renderSummary(quote);
                    setError(syncMessage || quote.error || quote.messages?.[0] || "");
                    syncMessage = "";
                    return quote;
                } catch {
                    renderFallbackSummary(cart);
                    setError("We could not refresh checkout right now.");
                    return null;
                }
            };

            async function startSquare() {
                const firstQuote = await requestQuote();

                if (!window.Square) throw new Error("Square.js failed to load.");
                if (!appId || !locationId) throw new Error("Square Application ID or Location ID is missing.");

                const payments = window.Square.payments(appId, locationId);
                card = await payments.card();
                await card.attach("#card-container");
                ensureCheckoutAttemptId();
                window.setTimeout(queueLeadCapture, 650);

                payButton.addEventListener("click", async () => {
                    if (isSubmitting) {
                        return;
                    }

                    setSubmittingState(true, "Processing payment...");
                    setError("");

                    try {
                        const customerError = validateCustomer();
                        if (customerError) throw new Error(customerError);

                        const quote = await requestQuote();
                        if (!quote) {
                            throw new Error(errorHost.textContent || "Checkout could not refresh right now.");
                        }

                        if (!quote.isValid) {
                            throw new Error(errorHost.textContent || "Checkout totals changed. Review the updated order before paying.");
                        }

                        const result = await card.tokenize();
                        if (result.status !== "OK") throw new Error("Unable to tokenize payment card.");

                        const payload = {
                            sourceId: result.token,
                            checkoutAttemptId: ensureCheckoutAttemptId(),
                            discountCode: store.readDiscountCode(),
                            customer: getCustomer(),
                            items: quote.items
                                .filter(item => Number(item.quantity || 0) > 0)
                                .map(item => ({
                                    id: item.id,
                                    size: item.size,
                                    quantity: item.quantity
                                }))
                        };

                        const response = await fetch("/store/checkout/pay", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": tokenInput?.value || ""
                            },
                            body: JSON.stringify(payload)
                        });

                        const text = await response.text();
                        const data = text ? JSON.parse(text) : {};

                        if (!response.ok || !data.success) {
                            throw new Error(data.error || "Payment failed.");
                        }

                        clearCheckoutAttemptId();
                        store.clearCart();
                        store.clearDiscountCode();
                        window.location.href = data.redirectUrl || "/store/success";
                    } catch (error) {
                        setError(error.message || "Payment failed.");
                        setSubmittingState(false, "Complete Purchase");
                    }
                });

                if (!firstQuote?.isValid) {
                    setPayButtonAvailability(false);
                }
            }

            Object.values(fields).forEach(field => {
                field?.addEventListener("input", queueLeadCapture);
                field?.addEventListener("change", queueLeadCapture);
                field?.addEventListener("blur", queueLeadCapture);
            });

            window.addEventListener("parfait-cart-updated", () => {
                requestQuote();
            });

            startSquare().catch(error => {
                setError(error.message || "Square checkout failed to initialize.");
                setPayButtonAvailability(false);
            });
        })();
    </script>
}
