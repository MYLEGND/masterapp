@model ParfaitApp.Models.ParfaitStorefrontViewModel
@{
    ViewData["Title"] = "Collection";
    ViewData["BodyClass"] = "sp-body";
    ViewData["ContentContainerClass"] = "container-fluid";
    ViewData["LayoutContentClass"] = "sp-layout-content";

}


@if (ViewData["CommerceStoreContext"] is ParfaitApp.Services.CommerceStoreContext { StorePageBeforeCatalog: not null, StorePageAfterCatalog: not null } authored)
{
    @Html.Raw(authored.StorePageBeforeCatalog)
    @await Html.PartialAsync("~/Views/Store/_CatalogCards.cshtml", Model)
    @Html.Raw(authored.StorePageAfterCatalog)
}
else
{
<section class="sp-store-page">
    <div class="sp-shell sp-shell--wide">
        <header class="sp-store-hero sp-store-hero--collection">
            <h1>@Model.StoreName</h1>
        </header>

        <section class="sp-shop-grid" aria-label="@Model.StoreName products">
            @await Html.PartialAsync("~/Views/Store/_CatalogCards.cshtml", Model)
        </section>
    </div>
</section>

}
