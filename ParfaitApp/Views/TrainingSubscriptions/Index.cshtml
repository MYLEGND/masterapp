@model IReadOnlyList<ParfaitApp.Services.TrainingPlanOfferViewModel>
@{
    ViewData["Title"] = "Training";
    ViewData["BodyClass"] = "sp-body";
    ViewData["ContentContainerClass"] = "container-fluid";
    ViewData["LayoutContentClass"] = "sp-layout-content";
    var preview = ViewData["TrainingPreview"] as bool? == true;
}
@section Styles {
    <link rel="stylesheet" href="/store-assets/css/storefront.css" asp-append-version="true" />
}
<section class="sp-store-page sp-training-page">
    <div class="sp-shell sp-transaction-page">
        <header class="sp-transaction-header">
            <div><p class="sp-transaction-kicker">Parfait training</p><h1>Build your Parfait Body.</h1></div>
            <a class="sp-button sp-button--ghost" href="/Contact">Talk to our team</a>
        </header>
        <p class="sp-training-intro">Explore coaching and training options for your goals. Training subscriptions are separate from LEGEND membership.</p>
        @if (TempData["TrainingRequestNotice"] is string notice)
        {
            <p class="sp-training-notice" role="status">@notice</p>
        }
        @if (Model.Count == 0)
        {
            <section class="sp-training-inquiry" aria-labelledby="training-inquiry-title">
                <h2 id="training-inquiry-title">Find your next step</h2>
                <p>Online enrollment is not available yet. Tell us about your goals and ask about training availability.</p>
                <div data-legend-public-inquiry-form data-owner-label="Parfait"></div>
            </section>
        }
        else
        {
            <div class="sp-training-plans">
            @foreach (var offer in Model)
            {
                var plan = offer.Product;
                var introductory = offer.IntroductoryOfferAvailable;
                var monthlyAmount = introductory ? (offer.IntroductoryMonthlyAmountCents ?? plan.PriceCents) : plan.PriceCents;
                var introductoryLimit = plan.Discounts.FirstOrDefault(d => string.Equals(d.Code, offer.IntroductoryPromotionCode, StringComparison.OrdinalIgnoreCase))?.UsageLimit;
                <section class="sp-training-plan" aria-labelledby="plan-@plan.Id">
                    <header><h2 id="plan-@plan.Id">@plan.Name</h2><p class="sp-training-price">$@((monthlyAmount / 100m).ToString("F2"))<span> / month</span></p></header>
                    @if (introductory)
                    {
                        @if (introductoryLimit is > 0)
                        {
                            <p class="sp-training-note">For the first @introductoryLimit members</p>
                        }
                        <p class="sp-training-note">Introductory member rate · Regular price $@((plan.PriceCents / 100m).ToString("F2")) / month</p>
                    }
                    <p class="sp-training-description">@plan.Description</p>
                    @if (!preview)
                    {
                        <form method="post" action="/store/training/request" class="sp-training-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@plan.Id" />
                            <label>Email<input type="email" name="email" maxlength="254" autocomplete="email" required /></label>
                            <input type="hidden" name="expectedMonthlyAmountCents" value="@monthlyAmount" />
                            @if (introductory)
                            {
                                <input type="hidden" name="promotionCode" value="@offer.IntroductoryPromotionCode" />
                            }
                            <label class="sp-training-consent"><input type="checkbox" name="emailConsent" value="true" required /><span>Email me a secure activation link for this plan. This does not subscribe me to marketing.</span></label>
                            <button type="submit" class="sp-button sp-button--primary">Review and subscribe</button>
                            <p class="sp-training-note">Review your price, billing schedule and cancellation terms before payment. No payment is taken here.</p>
                        </form>
                    }
                    else
                    {
                        <p>Online enrollment is not available yet.</p>
                        <a class="sp-button sp-button--secondary" href="/Contact">Ask about this plan</a>
                    }
                </section>
            }
            </div>
        }
    </div>
</section>
