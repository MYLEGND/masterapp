@{
    ViewData["Title"] = "Access Restricted";
    Layout = "_InternalAuthLayout";

    var signInFailed = Guid.TryParseExact(Context.Request.Query["reference"].ToString(), "N", out var reference);
    var introTitle = signInFailed ? "Microsoft Sign-In Failed" : "Access Restricted";
    var introCopy = signInFailed
        ? "Parfait could not complete Microsoft sign-in."
        : "This page is not assigned to your account. Ask a Full Control admin to update your Team access.";
    var cardTitle = signInFailed ? "Try Signing In Again" : "Restricted";
    var cardCopy = signInFailed
        ? $"If the problem continues, give your administrator this reference: {reference:N}."
        : "Your sign-in worked, but this route is not enabled for you.";
    var primaryHref = signInFailed ? "/internal/login" : "/internal";
    var primaryLabel = signInFailed ? "Retry Microsoft Sign-In" : "Return To Internal Home";
}

<section class="pf-auth-shell">
    <div class="pf-auth-intro">
        <div class="pf-auth-brand">PARFAIT</div>
        <h1 class="pf-auth-title">@introTitle</h1>
        <p class="pf-auth-copy">@introCopy</p>
    </div>

    <div class="pf-auth-card">
        <h2>@cardTitle</h2>
        <p>@cardCopy</p>
        <a class="pf-secondary-action pf-auth-action" href="@primaryHref">@primaryLabel</a>
        <form method="post" action="/internal/login">
            @Html.AntiForgeryToken()
            <button type="submit" class="pf-action pf-auth-action">Use another Microsoft account</button>
        </form>
    </div>
</section>
