@model Infrastructure.Commerce.Payments.MerchantConnectionsView
@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Payments";
    var ticket = ViewData["CommerceManagerTicket"] as string ?? "";
    string ActionUrl(string action) => "/commerce/manage/payments" + action + "?ticket=" + Uri.EscapeDataString(ticket);
}
<section class="pf-command-page">
    <div class="pf-command-heading">
        <h1>Payments</h1>
        <p>Connect your business’s processor account to accept customer payments. Square is our first supported connection. Your LEGEND® subscription billing is managed separately.</p>
    </div>
    <div class="pf-command-panel">
        <nav aria-label="Payment environment">
            <a class="pf-action" href="@(ActionUrl("") + "&environment=Production")">Live payments</a>
            <a class="pf-action" href="@(ActionUrl("") + "&environment=Sandbox")">Sandbox</a>
        </nav>
        <h2>@(Model.Environment == "Production" ? "Live payments" : "Sandbox — test payments only")</h2>
        @if (Model.DefaultConnectionId is null)
        {
            <p role="status">Online payments are inactive in this environment. Connect and verify your account, then select a default provider.</p>
        }
        <p>New payments use the selected default. Existing payments stay with their original processor for reconciliation and refunds.</p>
    </div>
    @foreach (var provider in Model.Providers)
    {
        <div class="pf-command-panel">
            <h2>@provider.Provider</h2>
            @{
                var dashboard = provider.Provider switch
                {
                    "Square" => Model.Environment == "Sandbox" ? "https://squareupsandbox.com/dashboard" : "https://squareup.com/dashboard",
                    "Stripe" => Model.Environment == "Sandbox" ? "https://dashboard.stripe.com/test/dashboard" : "https://dashboard.stripe.com/dashboard",
                    "PayPal" => Model.Environment == "Sandbox" ? "https://www.sandbox.paypal.com/businessmanage/home" : "https://www.paypal.com/businessmanage/home",
                    _ => null
                };
            }
            @if (dashboard is not null && provider.Available)
            { <p><a href="@dashboard" target="_blank" rel="noopener noreferrer">Open @provider.Provider dashboard</a></p> }
            @if (provider.Available)
            {
                <form method="post" action="@ActionUrl("/connect")" target="_blank" rel="noopener">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="@provider.Provider" />
                    <input type="hidden" name="environment" value="@Model.Environment" />
                    <p>Authorize a merchant account with your processor in a new tab, then refresh this page.</p>
                    <label><input type="checkbox" name="authorizeSharing" value="true" required /> I authorize sharing this business’s account details with the processor to connect payments.</label>
                    <button class="pf-action" type="submit">Connect @provider.Provider</button>
                </form>
            }
            else if (provider.Provider is "Stripe" or "PayPal")
            {
                <p><strong>Coming soon</strong></p>
                <p>Support for connecting this processor is coming soon.</p>
                <button class="pf-action" type="button" disabled>Coming soon</button>
            }
            else
            {
                <p>Square connection setup is pending in this environment. Once available, connect your existing Square account and select your business location.</p>
            }
        </div>
    }
    @foreach (var connection in Model.Connections)
    {
        <div class="pf-command-panel">
            <h2>@connection.Provider @(Model.DefaultConnectionId == connection.Id ? "· Default" : "")</h2>
            <dl>
                <dt>Authorized merchant account</dt><dd>@connection.AccountId</dd>
                <dt>Connection</dt><dd>@connection.State</dd>
                <dt>Payments</dt><dd>@(connection.Readiness.PaymentsEnabled ? "Provider ready" : "Not ready")</dd>
                <dt>Settlements</dt><dd>@(connection.Readiness.SettlementsEnabled ? "Provider ready" : "Not ready")</dd>
                <dt>Currencies</dt><dd>@(connection.Readiness.Currencies.Length > 0 ? string.Join(", ", connection.Readiness.Currencies) : "Not verified")</dd>
                <dt>Payment methods</dt><dd>@(connection.Readiness.PaymentMethods.Length > 0 ? string.Join(", ", connection.Readiness.PaymentMethods) : "Not verified")</dd>
                <dt>Location</dt><dd>@(connection.LocationId ?? "Not selected / not required")</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(connection.Readiness.RequiredAction))
            { <p role="status">@connection.Readiness.RequiredAction</p> }
            @if (connection.State != "Disconnected" &&
                 (connection.State == "PendingConfirmation" || !connection.Readiness.PaymentsEnabled || !connection.Readiness.SettlementsEnabled))
            {
                <form method="post" action="@ActionUrl("/resume")" target="_blank" rel="noopener">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="connectionId" value="@connection.Id" />
                    <input type="hidden" name="revision" value="@connection.Revision" />
                    <label><input type="checkbox" name="authorizeSharing" value="true" required /> I authorize sharing this business’s account details with the processor to continue onboarding.</label>
                    <button type="submit" class="pf-action">Resume account onboarding</button>
                </form>
            }
            @if (connection.State == "PendingConfirmation")
            {
            <form method="post" action="@ActionUrl("/confirm")" class="pf-command-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="connectionId" value="@connection.Id" />
                <input type="hidden" name="revision" value="@connection.Revision" />
                <input type="hidden" name="environment" value="@Model.Environment" />
                <input type="hidden" name="accountId" value="@connection.AccountId" />
                @if (connection.Readiness.Locations.Length > 0)
                {
                    <label>Merchant location
                        <select name="locationId" class="form-select" required>
                            <option value="">Select a verified location</option>
                            @foreach (var location in connection.Readiness.Locations)
                            { <option value="@location" selected="@(connection.LocationId == location)">@location</option> }
                        </select>
                    </label>
                }
                <label><input type="checkbox" name="confirmOwnership" value="true" required /> I confirm that this merchant account belongs to this business.</label>
                <button type="submit" class="pf-action">Confirm account and location</button>
            </form>
            }
            @if (connection.State != "Disconnected")
            {
            <form method="post" action="@ActionUrl("/refresh")" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="connectionId" value="@connection.Id" />
                <input type="hidden" name="revision" value="@connection.Revision" />
                <input type="hidden" name="environment" value="@Model.Environment" />
                <button type="submit" class="pf-action">Refresh readiness</button>
            </form>
            @if (connection.State == "Active" && connection.Readiness.PaymentsEnabled && connection.Readiness.SettlementsEnabled && Model.DefaultConnectionId != connection.Id)
            {
                <form method="post" action="@ActionUrl("/default")" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="connectionId" value="@connection.Id" />
                    <input type="hidden" name="revision" value="@connection.Revision" />
                    <input type="hidden" name="environment" value="@Model.Environment" />
                    <button type="submit" class="pf-action">Use for new payments</button>
                </form>
            }
            <details class="mt-3">
                <summary>Disconnect from new payments</summary>
                <p>New payments will stop using this connection. Historical access is retained for refunds and reconciliation; this does not revoke authorization at the processor.</p>
                <form method="post" action="@ActionUrl("/disconnect")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="connectionId" value="@connection.Id" />
                    <input type="hidden" name="revision" value="@connection.Revision" />
                    <input type="hidden" name="environment" value="@Model.Environment" />
                    <button type="submit" class="pf-action">Disconnect from new payments</button>
                </form>
            </details>
            }
        </div>
    }
    <div class="pf-command-panel">
        <h2>Recent customer payments</h2>
        @if (TempData["MerchantRefundStatus"] is string refundStatus)
        { <p role="status">@refundStatus</p> }
        <p>Amounts are in minor units (100 cents = 1 USD). Refunds go through the original processor account.</p>
        @foreach (var payment in ViewData["MerchantPayments"] as IReadOnlyList<ParfaitApp.Controllers.MerchantPaymentSummary> ?? [])
        {
            <article class="mb-3">
                <h3>@payment.OrderNumber · @payment.Provider</h3>
                <p>@payment.State · @payment.AmountMinor @payment.Currency minor units · Refunded: @payment.RefundedMinor</p>
                <form method="post" action="@ActionUrl("/reconcile")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@payment.OrderId" />
                    <input type="hidden" name="environment" value="@Model.Environment" />
                    <button type="submit" class="pf-action">Check processor status</button>
                </form>
                @if (payment.HasUnresolvedRefund)
                { <p role="status">A refund is pending or unknown. Reconcile the existing request before starting another.</p> }
                else if (payment.State == "Captured" && payment.RefundedMinor < payment.AmountMinor)
                {
                    <details>
                        <summary>Refund payment</summary>
                        <form method="post" action="@ActionUrl("/refund")" class="pf-command-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@payment.OrderId" />
                            <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                            <input type="hidden" name="environment" value="@Model.Environment" />
                            <label>Refund amount in @payment.Currency minor units
                                <input type="number" name="amountMinor" min="1" max="@(payment.AmountMinor - payment.RefundedMinor)" step="1" required class="form-control" />
                            </label>
                            <label><input type="checkbox" name="confirmRefund" value="true" required /> I confirm this refund to the customer.</label>
                            <button type="submit" class="pf-action">Submit refund</button>
                        </form>
                    </details>
                }
            </article>
        }
    </div>
</section>
