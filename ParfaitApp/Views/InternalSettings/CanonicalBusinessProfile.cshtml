@model Legend.Commerce.CommerceBusinessProfileViewModel
@{
    Layout = "_InternalLayout";
    ViewData["Title"] = "Business Profile";
    var ticket = ViewData["CommerceManagerTicket"] as string ?? "";
    var saveUrl = Legend.Commerce.CommerceManagementCapabilityPolicy.ManagementUrl(Context, "/commerce/manage/business-profile", ticket, "POST");
}
<section class="pf-command-page">
    <header class="pf-command-head">
        <div class="pf-command-copy">
        <h1 class="pf-command-title">Business profile</h1>
        <p class="pf-command-text">Shared LEGEND® business identity and storefront settings.</p>
        </div>
    </header>
    <form method="post" action="@saveUrl">
        @Html.AntiForgeryToken()
        <section class="pf-workspace-grid">
            <section class="pf-module-card pf-span-8">
                <h2 class="pf-module-title">Store identity</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="business-name" class="form-label fw-bold">Business name</label>
                        <input id="business-name" name="Name" required minlength="2" maxlength="160" value="@Model.Name" class="form-control" autocomplete="organization" />
                    </div>
                    <div class="col-md-6">
                        <label for="business-type" class="form-label fw-bold">Business type</label>
                        <input id="business-type" name="BusinessType" required minlength="2" maxlength="160" value="@Model.BusinessType" class="form-control" />
                    </div>
                </div>
            </section>
            <aside class="pf-module-card pf-span-4">
                <h2 class="pf-module-title">Connected account</h2>
                <div class="pf-focus-list">
                    <div><span>Account owner</span><strong>@Model.OwnerEmail</strong></div>
                    <div><span>Domain</span><strong>@(Model.PrimaryDomain ?? "Not configured")</strong></div>
                </div>
                <p>Manage your domain and published website in Website Studio.</p>
                <div class="pf-focus-actions mt-3"><button type="submit" class="pf-action">Save business profile</button></div>
            </aside>
        </section>
    </form>
</section>
