@inject Infrastructure.Data.MasterAppDbContext AnalyticsDb
@inject Microsoft.Extensions.Configuration.IConfiguration AnalyticsConfiguration
@inject Infrastructure.Analytics.MarketingBrowserConfigurationService BrowserMarketing
@inject Microsoft.Extensions.Logging.ILoggerFactory LoggerFactory
@{
    var commerce = ViewData["CommerceStoreContext"] as ParfaitApp.Services.CommerceStoreContext;
    var isManagementPreview = Context.Request.Path.StartsWithSegments("/commerce/manage");
    string metaPixelId = string.Empty;
    string openAiPixelId = string.Empty;
    try
    {
        if (!isManagementPreview && commerce is not null)
        {
            var owner = await Infrastructure.Analytics.CanonicalAdvertisingEventProjection.ResolveOwnerAsync(AnalyticsDb, AnalyticsConfiguration, commerce, Context.Request.Host.Host, Context.RequestAborted);
            if (owner is not null)
            {
                var browser = await BrowserMarketing.GetAsync(owner, Context.RequestAborted);
                metaPixelId = browser.MetaPixelId ?? string.Empty;
                openAiPixelId = browser.OpenAiPixelId ?? string.Empty;
            }
        }
    }
    catch (Exception ex)
    {
        LoggerFactory.CreateLogger("ParfaitCommerceTracking").LogError(ex, "Commerce optional marketing configuration unavailable.");
    }
    var hasMetaPixel = !string.IsNullOrWhiteSpace(metaPixelId);
}
@if (!isManagementPreview)
{
<script>
(() => {
 if (document.cookie.split(';').some(value=>value.trim().startsWith('pf_attribution='))) return;
 const params=new URLSearchParams(location.search), attribution={};
 for(const key of ['utm_source','utm_medium','utm_campaign','utm_id','utm_content','fbclid','oppref','meta_campaign_id','meta_adset_id','meta_ad_id']) {
   const value=params.get(key);if(value) attribution[key]=value.slice(0,256);
 }
 if(Object.keys(attribution).length) document.cookie='pf_attribution='+encodeURIComponent(JSON.stringify(attribution))+'; Path=/; Max-Age=7776000; SameSite=Lax; Secure';
})();
window.LEGEND_ANALYTICS_CONFIG = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    endpoint = "https://masterapp-protect.azurewebsites.net/api/tracking/ingest",
    siteKey = "commerce",
    allowedBrowserEvents = Shared.Analytics.AnalyticsEventCatalog.BrowserAllowedEventNames,
    criticalBrowserEvents = Shared.Analytics.AnalyticsEventCatalog.CriticalBrowserEventNames,
    signalAliases = Shared.Analytics.MetaSignalAnalyticsAliasCatalog.BrowserProjectionMap
}));
</script>
<script src="/store-assets/js/tracking.js" asp-append-version="true"></script>
<script>
(() => {
 const ids=window.LegendAnalytics?.ids;if(!ids)return;
 for(const [name,value] of Object.entries({pf_sid:ids.getSessionId(),pf_vid:ids.getVisitorId(),pf_oppref:ids.getAttribution()?.oppref}))
   if(value)document.cookie=name+'='+encodeURIComponent(String(value).slice(0,512))+'; Path=/; Max-Age=7776000; SameSite=Lax; Secure';
})();
</script>
@if (hasMetaPixel)
{
<script>
if (window.__legendTrackingInitialized) {
 !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
 const pixelId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metaPixelId));
 fbq('init',pixelId);

}
</script>
}
<script src="/store-assets/js/meta-signal-intelligence.js" asp-append-version="true"></script>
<script>
if(window.__legendTrackingInitialized) window.metaSignalIntelligence?.createLandingSession({
 enabled:true,sendBrowserEvents:true,sendServerEvents:true,persistEvents:true,
 siteKey:'commerce',pageKey:location.pathname,quoteType:'commerce',
 pixelId:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metaPixelId)),
 browserEventNames:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Shared.Analytics.MetaSignalEventCatalog.BrowserPixelEventNames)),
 browserSignalEventNames:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Shared.Analytics.AnalyticsEventCatalog.BrowserAllowedEventNames))
});
</script>
@if (!string.IsNullOrWhiteSpace(openAiPixelId))
{
<script src="/store-assets/js/openai-measurement.js" asp-append-version="true"></script>
<script>if(window.__legendTrackingInitialized) window.LegendOpenAiMeasurement?.configure({pixelId:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(openAiPixelId))});</script>
}
<script>
(() => {
 const product=document.querySelector('#spAddToCart');
 if (product) window.LegendAnalytics?.track({EventType:'ProductViewed',MetadataJson:JSON.stringify({
   productId:product.dataset.productId,productName:product.dataset.productName,
   productSlug:product.dataset.productSlug,priceCents:Number(product.dataset.productPriceCents||0)
 })});
})();
</script>
}
