@{
    ViewData["Title"] = "Contact Us";
    ViewData["PageKey"] = "contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contact-clarity" aria-label="Contact Parfait">
    <div class="contact-clarity__card">
        <div class="contact-clarity__header">
            <div class="contact-clarity__header-copy">
                <h1 class="contact-clarity__title">Contact Us</h1>
                <p class="contact-clarity__subtitle">Questions, support, and next steps.</p>
            </div>
        </div>
        <p>Send your message below. Your inquiry is saved to Parfait’s scoped CRM and routed to the business account’s primary email through the same LEGEND intake authority used by the platform websites.</p>
        <div data-legend-public-inquiry-form data-owner-label="Parfait"></div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/public-inquiry-form.css" asp-append-version="true" />
    <style>
        .contact-clarity{max-width:900px;margin:0 auto;padding:2.2rem 1rem 4rem}
        .contact-clarity__card{padding:clamp(1.25rem,3vw,2rem);border-radius:30px;border:1px solid rgba(179,131,97,.34);background:#fff;box-shadow:0 24px 64px rgba(43,28,22,.12)}
        .contact-clarity__header{margin-bottom:1rem}
        .contact-clarity__title{margin:0;font-size:clamp(2.2rem,4vw,3.3rem);line-height:1;letter-spacing:-.05em}
        .contact-clarity__subtitle{margin:.45rem 0 0;color:#6d5a50}
        .contact-clarity__card>p{margin:0 0 1.4rem;color:#6d5a50}
        @@media(max-width:640px){.contact-clarity{padding:1.3rem .85rem 3rem}.contact-clarity__card{padding:1rem;border-radius:24px}}
    </style>
}

@section Scripts {
    <script type="module" src="~/js/public-inquiry-form.mjs" asp-append-version="true"></script>
}
