<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <BaseIntermediateOutputPath>/tmp/masterapp/obj/ParfaitApp/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>/tmp/masterapp/obj/ParfaitApp/</MSBuildProjectExtensionsPath>
    <BaseOutputPath>/tmp/masterapp/bin/ParfaitApp/</BaseOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      bin/**;
      obj/**;
      publish/**;
      publish-*/**;
      publish-macos/**;
      publish-azure/**;
      **/*.zip;
    </DefaultItemExcludes>
    <UserSecretsId>b4ec2f48-a00d-4bab-b5dc-7defd3888ca8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <RazorGenerate Remove="publish/**" />
    <RazorGenerate Remove="publish-*/**" />
    <RazorGenerate Remove="publish-macos/**" />
    <RazorGenerate Remove="publish-azure/**" />

    <Content Remove="publish/**" />
    <Content Remove="publish-*/**" />
    <Content Remove="publish-macos/**" />
    <Content Remove="publish-azure/**" />
    <Content Remove="bin/**" />
    <Content Remove="obj/**" />
    <Content Remove="**/*.zip" />

    <None Remove="publish/**" />
    <None Remove="publish-*/**" />
    <None Remove="publish-macos/**" />
    <None Remove="publish-azure/**" />
    <None Remove="bin/**" />
    <None Remove="obj/**" />
    <None Remove="**/*.zip" />
  </ItemGroup>

  <ItemGroup>
    <!-- MailKit for SMTP -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />

    <!-- Microsoft Graph client library -->
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />

    <!-- Microsoft Identity Client (MSAL) -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.81.0" />

    <!-- Azure Identity for ClientSecretCredential -->
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- JWT & JsonWebTokens -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="PrunePublishArtifacts" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('bin/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('obj/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('publish/')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('publish-'))" />
    </ItemGroup>
  </Target>

</Project>
